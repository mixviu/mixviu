-- Static structures only: prose containing chord names is not a binding.
-- Shipped-default policy only. inputd_schema::is_user_key is the physical authority.
fn canonical_chord($text)
  $parts=split($text,"+");$key=$parts[len($parts)-1]
  if $key=="" or re_match($key,"\\s") then return nil end
  $flags={ctrl:false,alt:false,shift:false,super:false}
  for $part in slice($parts,0,len($parts)-1)
    $mod=lower($part)
    if contains(["control","command","maccmd"],$mod) then $mod="ctrl" end
    if not has_key($flags,$mod) or $flags[$mod] then return nil end
    $flags[$mod]=true
  end
  $aliases={left:"ArrowLeft",arrowleft:"ArrowLeft",right:"ArrowRight",arrowright:"ArrowRight",up:"ArrowUp",arrowup:"ArrowUp",down:"ArrowDown",arrowdown:"ArrowDown"}
  $key=$aliases[lower($key)] ?? $key
  return (if $flags.ctrl then "Ctrl+" else "" end)..(if $flags.alt then "Alt+" else "" end)..(if $flags.shift then "Shift+" else "" end)..(if $flags.super then "Super+" else "" end)..$key
end
fn reserved_chord($text)
  $text=canonical_chord($text)
  if $text==nil then return false end
  $parts=map(split($text,"+"),fn($p)=lower($p));$key=$parts[len($parts)-1]
  return re_match($key,"^f([1-9]|1[0-2])$") or (contains(["left","right","up","down","arrowleft","arrowright","arrowup","arrowdown"],$key) and not contains($parts,"shift") and any($parts,fn($p)=contains(["ctrl","control","command","maccmd","alt"],$p)))
end
fn check_default_chord($text,$path)
  if canonical_chord($text)==nil then raise("INVALID_DEFAULT_KEY",$path..": invalid default chord "..$text) end
  if reserved_chord($text) then raise("RESERVED_KEY",$path..": reserved default binding "..$text) end
end
fn inspect_bindings($v,$path,$binding=false)
  if type($v)=="map" then
    $command=has_key($v,"id") or has_key($v,"command") or has_key($v,"action")
    if type($v.key)=="string" and $command then
      $mods=$v.modifiers ?? []
      if type($mods)!="list" then $mods=[] end
      $mods=map($mods,fn($m)=lower($m))
      $chord=(if $v.ctrl==true or $v.command==true or $v.mac_cmd==true or any($mods,fn($m)=contains(["ctrl","control","command","maccmd"],$m)) then "Ctrl+" else "" end)..(if $v.alt==true or contains($mods,"alt") then "Alt+" else "" end)..(if $v.shift==true or contains($mods,"shift") then "Shift+" else "" end)..$v.key
      check_default_chord($chord,$path)
    end
    for $k in keys($v)
      if $binding then check_default_chord($k,$path) end
      inspect_bindings($v[$k],$path.."."..$k,contains(["shortcut","shortcut_binding","shortcuts","bindings","keymap"],$k) or ($k=="keys" and $command))
    end
  elif type($v)=="list" then
    for $item in $v inspect_bindings($item,$path,$binding) end
  elif $binding and type($v)=="string" then check_default_chord($v,$path)
  end
end
fn strip_group($tokens)
  while len($tokens)>=2 and $tokens[0].text=="(" and $tokens[len($tokens)-1].text==")"
    $depth=0;$outer=true
    for $i=0 to len($tokens)-2
      if $tokens[$i].text=="(" then $depth=$depth+1 elif $tokens[$i].text==")" then $depth=$depth-1 end
      if $depth==0 then $outer=false;break end
    end
    if not $outer then break end
    $tokens=slice($tokens,1,len($tokens)-1)
  end
  return $tokens
end
fn field_ref($tokens)
  $tokens=strip_group($tokens)
  if len($tokens)==3 and $tokens[0].kind=="variable" and $tokens[1].text=="." and $tokens[2].kind=="word" then return {owner:$tokens[0].text,name:$tokens[2].text} end
  return nil
end
fn join_branch($a,$b)
  for $flag in keys($b.flags)
    if has_key($a.flags,$flag) and $a.flags[$flag]!=$b.flags[$flag] then return nil end
    $a.flags[$flag]=$b.flags[$flag]
  end
  for $owner in keys($b.keys)
    $a.keys[$owner]=if has_key($a.keys,$owner) then filter($a.keys[$owner],fn($k)=contains($b.keys[$owner],$k)) else $b.keys[$owner] end
    if len($a.keys[$owner])==0 then return nil end
  end
  return $a
end
-- Bounded boolean branches: unknown predicates remain unconstrained. Only
-- explicit positive modifier requirements plus an explicit key guard count.
fn condition_branches($tokens,$negated=false)
  $tokens=strip_group($tokens)
  if len($tokens)==0 then return [{flags:{},keys:{}}] end
  for $op in ["or","and"]
    $depth=0
    for $i=0 to len($tokens)-1
      $text=$tokens[$i].text
      if contains(["(","[","{"],$text) then $depth=$depth+1 elif contains([")","]","}"],$text) then $depth=$depth-1 end
      if $depth==0 and $text==$op then
        $left=condition_branches(slice($tokens,0,$i),$negated);$right=condition_branches(slice($tokens,$i+1),$negated)
        if ($op=="or")!=$negated then
          if len($left)+len($right)>128 then raise("DEFAULT_CONDITION","condition exceeds 128 boolean branches") end
          return concat($left,$right)
        end
        $out=[]
        for $a in $left for $b in $right
          $merged=join_branch($a,$b)
          if $merged!=nil then push($out,$merged) end
          if len($out)>128 then raise("DEFAULT_CONDITION","condition exceeds 128 boolean branches") end
        end end
        return $out
      end
    end
  end
  if $tokens[0].text=="not" then return condition_branches(slice($tokens,1),not $negated) end
  $ref=field_ref($tokens);$positive=not $negated
  if $ref==nil then
    for $i=0 to len($tokens)-1
      if contains(["==","!="],$tokens[$i].text) then
        $left=slice($tokens,0,$i);$right=slice($tokens,$i+1)
        $ref=field_ref($left);$value=$right
        if $ref==nil then $ref=field_ref($right);$value=$left end
        if $ref!=nil and len($value)==1 then
          if contains(["true","false"],$value[0].text) then
            $positive=($value[0].text=="true")!=($tokens[$i].text=="!=")
            if $negated then $positive=not $positive end
          elif $ref.name=="key" and $value[0].kind=="string" and (($tokens[$i].text=="==")!=$negated) then
            $branch={flags:{},keys:{}};$branch.keys[$ref.owner]=[canonical_chord(token_value($value[0]))];return [$branch]
          else $ref=nil end
        else $ref=nil end
        break
      end
    end
  end
  if $ref!=nil and contains(["ctrl","alt","command","mac_cmd","shift"],$ref.name) then $branch={flags:{},keys:{}};$branch.flags[$ref.owner.."."..$ref.name]=$positive;return [$branch] end
  if not $negated and $tokens[0].text=="contains" and $tokens[1].text=="(" and $tokens[2].text=="[" then
    for $i=3 to len($tokens)-1
      if $tokens[$i].text=="]" and $tokens[$i+1].text=="," then
        $names=literal_value(slice($tokens,2,$i+1));$ref=field_ref(slice($tokens,$i+2,len($tokens)-1))
        if type($names)=="list" and $ref!=nil and $ref.name=="key" and all($names,fn($k)=type($k)=="string") then $branch={flags:{},keys:{}};$branch.keys[$ref.owner]=map($names,fn($k)=canonical_chord($k));return [$branch] end
        break
      end
    end
  end
  return [{flags:{},keys:{}}]
end
fn inspect_condition($tokens,$path,$line)
  $tokens=filter($tokens,fn($t)=$t.kind!="newline")
  for $branch in condition_branches($tokens)
    for $owner in keys($branch.keys)
      if $branch.flags[$owner..".shift"]==true then continue end
      if any(["ctrl","alt","command","mac_cmd"],fn($m)=$branch.flags[$owner.."."..$m]==true) and any($branch.keys[$owner],fn($k)=$k!=nil and reserved_chord("Ctrl+"..$k)) then
        raise("RESERVED_KEY",$path..":"..to_string($line)..": reserved default arrow condition")
      end
    end
  end
end
fn token_value($t)
  return if $t.kind=="string" then data_parse("["..$t.text.."]")[0] else $t.text end
end
fn literal_value($tokens)
  try return data_parse("["..join(map($tokens,fn($x)=$x.text)," ").."]")[0] catch $message
    -- Constant string concatenation in a binding field is still data.
    $text="";$string=true
    for $token in $tokens
      if $string and $token.kind=="string" then $text=$text..token_value($token)
      elif not $string and $token.text==".." then nil
      else return nil end
      $string=not $string
    end
    return if not $string then $text else nil end
  end
end
fn inspect_mix($source,$path)
  -- Scene wrappers are not Mix. Lex each complete code block, preserving
  -- token source coordinates; a fence inside a string cannot close a block.
  $tokens=[]
  if starts_with($source,"---\n") then
    $lines=split($source,"\n");$in_code=false;$body=[];$offset=0;$line_number=0
    for $line in $lines
      $line_number=$line_number+1
      if not $in_code and starts_with($line,"```mix") then $in_code=true;$offset=$line_number;$body=[]
      elif $line=="```" and $in_code then
        $lexed=nil
        try $lexed=mix_tokens(join($body,"\n")) catch $message $lexed=nil end
        if $lexed!=nil then
          for $t in $lexed $t.line=$t.line+$offset;push($tokens,$t) end
          $in_code=false
        else push($body,$line) end
      elif $in_code then push($body,$line) end
    end
    if $in_code then raise("RESERVED_KEY",$path..": unclosed scene code block") end
  else $tokens=mix_tokens($source) end
  $stack=[]
  for $i=0 to len($tokens)-1
    $t=$tokens[$i]
    if $t.text=="{" then push($stack,$i)
    elif $t.text=="}" and len($stack)>0 then
      $start=$stack[len($stack)-1];$stack=slice($stack,0,len($stack)-1)
      $object={};$locations={};$j=$start+1
      while $j<$i
        $key=$tokens[$j]
        if contains(["word","string"],$key.kind) and $tokens[$j+1].text==":" then
          $name=token_value($key);$end=$j+2;$nested=0
          while $end<$i
            $text=$tokens[$end].text
            if $nested==0 and $text=="," then break end
            if contains(["{","[","("],$text) then $nested=$nested+1 end
            if contains(["}","]",")"],$text) then $nested=$nested-1 end
            $end=$end+1
          end
          $value=literal_value(slice($tokens,$j+2,$end))
          $object[$name]=$value;$locations[$name]=$tokens[$j+2].line;$j=$end
        else $j=$j+1 end
      end
      $line=$locations.key ?? $locations.shortcut ?? $locations.keys ?? $tokens[$start].line
      $parent=if $start>=2 then $tokens[$start-2].text else "" end
      inspect_bindings($object,$path..":"..to_string($line),contains(["bindings","keymap","shortcuts"],$parent))
    end
  end
  $condition=[];$active=false;$line=1
  for $t in $tokens
    if $t.kind=="keyword" and contains(["if","elif"],$t.text) then
      $condition=[];$active=true;$line=$t.line
    elif $t.kind=="keyword" and $t.text=="then" and $active then
      inspect_condition($condition,$path,$line);$active=false
    elif $active then push($condition,$t) end
  end
end
