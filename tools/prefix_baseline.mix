-- SPDX-License-Identifier: MIT OR Apache-2.0
-- Counted baseline arithmetic shared by the gate, updater and selftest.
--
-- Maintenance. The baseline only shrinks: check_base compares the tree's
-- tools/prefix-baseline.json with the one at the base commit, and any new key
-- or raised count is growth, which fails CI on a pull request and on a push
-- to main alike. --update-baseline --allow-growth rewrites the file, but CI
-- still refuses the result; growth is by design not landable through CI.
-- A rename or move of baselined debt is a relocation, not growth: a new key
-- is accepted when a key with the same rule and text and an equal count
-- disappears in the same change. Every accepted swap is printed.
fn checked($value)
  if type($value) != "map" then
    raise("BASELINE", "baseline must be a map")
  end
  for $k in keys($value)
    $n = $value[$k]
    if type($n) != "number" or $n < 0 or floor($n) != $n then
      raise("BASELINE", "invalid count for " .. $k)
    end
  end
  return $value
end

fn growth($now, $base)
  checked($now)
  checked($base)
  $bad = []
  for $k in sort(keys($now))
    if not has_key($base, $k) or $now[$k] > $base[$k] then
      push($bad, $k)
    end
  end
  return $bad
end

-- [file, rule, text] for a finding key, nil for anything else.
fn key_parts($k)
  try
    $p = json_parse($k)
    if type($p) == "list" and len($p) == 3 then
      return $p
    end
  catch $message
    return nil
  end
  return nil
end

-- Growth that is not explained by a relocation, and the relocations used.
-- Only a NEW key can be a relocation; a raised count is always growth. Each
-- disappeared key explains at most one new key.
fn explained($now, $base)
  $bad = growth($now, $base)
  $gone = []
  for $k in sort(keys($base))
    if not has_key($now, $k) then
      push($gone, $k)
    end
  end
  $used = {}
  $left = []
  $moves = []
  for $k in $bad
    $found = nil
    $kp = has_key($base, $k) ? nil : key_parts($k)
    if $kp != nil then
      for $g in $gone
        $gp = key_parts($g)
        if not has_key($used, $g) and $gp != nil and $gp[1] == $kp[1] and $gp[2] == $kp[2] and $base[$g] == $now[$k] then
          $found = $g
          break
        end
      end
    end
    if $found == nil then
      push($left, $k)
    else
      $used[$found] = true
      push($moves, {from: $found, to: $k})
    end
  end
  return {growth: $left, relocations: $moves}
end

fn counts($findings)
  $out = {}
  for $f in $findings
    if $f.disabled ?? false then continue end
    $k = json_encode([$f.file, $f.rule, $f.text])
    $out[$k] = ($out[$k] ?? 0) + 1
  end
  return $out
end

fn git_line($root, $argv)
  $r = run_argv(concat(["git", "-C", $root], $argv))
  if not $r.ok or $r.stdout_truncated then
    return nil
  end
  $s = trim($r.stdout)
  return $s == "" ? nil : $s
end

-- The commit whose baseline the tree must not exceed.
--   push range: $before (GitHub's github.event.before on a push) when it is a
--     full object name, not all zeros and not HEAD; it must then be an
--     ancestor of HEAD, or the check fails closed (a force-pushed range);
--   merge base: merge-base HEAD origin/main, for a branch or PR merge ref;
--   first parent: when that merge base is HEAD itself (a push to main),
--     HEAD^1. No parent, or no merge base, fails closed.
fn base_commit($root, $before)
  $head = git_line($root, ["rev-parse", "--verify", "-q", "HEAD^{commit}"])
  if $head == nil then
    raise("BASELINE_BASE", "HEAD is not a commit")
  end
  $b = trim($before ?? "")
  if re_match($b, '^(?:[0-9a-f]{40}|[0-9a-f]{64})$') and not re_match($b, '^0+$') and $b != $head then
    $r = run_argv(["git", "-C", $root, "merge-base", "--is-ancestor", $b, "HEAD"])
    if $r.exit_code == 0 then
      return {sha: $b, how: "push range"}
    end
    -- A rewritten range (force push): HEAD^ would see only the last commit.
    raise("BASELINE_BASE", "push range base " .. $b .. " is not an ancestor of HEAD")
  end
  $r = run_argv(["git", "-C", $root, "merge-base", "HEAD", "origin/main"])
  if not $r.ok or $r.stdout_truncated or trim($r.stdout) == "" then
    raise("BASELINE_BASE", "cannot find merge base with origin/main: " .. $r.stderr)
  end
  $sha = trim($r.stdout)
  if $sha != $head then
    return {sha: $sha, how: "merge base"}
  end
  $parent = git_line($root, ["rev-parse", "--verify", "-q", "HEAD^1^{commit}"])
  if $parent == nil then
    raise("BASELINE_BASE", "merge base is HEAD and HEAD has no parent")
  end
  return {sha: $parent, how: "first parent"}
end

-- $now is the in-tree baseline, already read by the caller through its
-- no-follow, size-capped control-file read; the base copy is capped at $cap.
fn check_base($root, $before, $now, $cap)
  $b = base_commit($root, $before)
  $file = "tools/prefix-baseline.json"
  $tree = run_argv_must(["git", "-C", $root, "ls-tree", "--name-only", $b.sha, "--", $file])
  if trim($tree) == "" then
    return {base: $b.sha, how: $b.how, introduced: true, growth: [], relocations: []}
  end
  $r = run_argv(["git", "-C", $root, "show", $b.sha .. ":" .. $file], {max_output: $cap})
  if not $r.ok or $r.stdout_truncated or ($r.utf8_lossy ?? false) then
    raise("BASELINE_BASE", "base baseline unreadable, over " .. to_string($cap) .. " bytes or not UTF-8")
  end
  $base = checked(json_parse($r.stdout))
  $e = explained(checked($now), $base)
  return {base: $b.sha, how: $b.how, introduced: false, growth: $e.growth, relocations: $e.relocations}
end

-- $current is the existing file's map (read by the caller through the
-- control-file checks, {} when absent). Writes sorted, stable output to a
-- fresh mktemp file in the same directory and renames it over $path, so a
-- symlink at $path is replaced, never followed. Returns the relocations and
-- the growth it accepted so the caller prints them into the log.
fn update($path, $now, $allow_growth, $current)
  checked($now)
  $e = explained($now, checked($current))
  if not $allow_growth and len($e.growth) > 0 then
    raise("BASELINE_GROWTH", "update would add keys or raise counts; --allow-growth is required")
  end
  $tmp = trim(run_argv_must(["mktemp", "-p", dirname($path), ".prefix-baseline.XXXXXX"]))
  try
    write_file($tmp, json_encode($now, true) .. "\n")
    chmod($tmp, 0o644)
    rename($tmp, $path)
  catch $message, $error
    $cleanup = run_argv(["rm", "-f", "--", $tmp])
    if not $cleanup.ok then eprint("could not remove " .. $tmp) end
    raise("BASELINE", "cannot write " .. $path .. ": " .. $message)
  end
  return $e
end
