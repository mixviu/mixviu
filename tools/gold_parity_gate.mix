$rc=0
try
  for $a in [["cargo","fmt","-p","viu","-p","viu-engine","--","--check"],["cargo","check","-p","viu","-p","viu-engine","--all-targets"],["cargo","test","--locked","-p","viu","-p","viu-engine"],["cargo","clippy","--locked","-p","viu","-p","viu-engine","--all-targets"],["cargo","build","--locked","-p","viu-engine","--bin","viu"]]
    print({argv:$a})
    $r=run_argv($a,{timeout:3600,max_output:16000000,env:{CARGO_BUILD_JOBS:"6"}})
    print($r)
    if not $r.ok then $rc=$r.exit_code ?? 124;break end
  end
finally
  print("GOLD_PARITY_PATCH_BEGIN")
  print(run_argv_must(["git","diff","--binary"]))
  print("GOLD_PARITY_PATCH_END")
  print(run_argv_must(["git","checkout","-q","--","."]))
end
exit($rc)
