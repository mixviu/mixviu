#!/usr/bin/env mix
-- version: 0.1.0
-- tools/ci.mix: the one gate recipe, run by GitHub CI and by agents before a
-- PR (on CBC: cbc-build.mix --repo mixviu --commit SHA -- mix tools/ci.mix all).
--
--   mix tools/ci.mix STAGE [--mix PATH]
--   STAGE: fmt | env | mix-services | mix-hygiene | clippy | viud | foreign | test | mix-lint | mix-lint-baseline | release-mix | all
--   release-mix (not in all): release build of mix, refused if it links the test hooks.
--   stage-install [--dir DIR] (not in all): copy the built debug engine and
--   service binaries, by name, into DIR/bin (default target/stage-install,
--   never /tmp), write the registry's runtime defaults as DIR/env.mx (no
--   layout.mx), and print DIR. The caller removes DIR.
--   stage-smoke (in all, after test): stage into target/stage-smoke, check a
--   staged binary resolves an installed default, and remove the stage.
--
-- MixViu has four engines: mix, mixd, viu, viud. The `mix` package is built and tested apart from the
-- rest of the workspace: the workspace build would unify features and ship
-- a service-profile mix, which its compile guard refuses.
-- Mix-level tests run with the mix built from this tree (--mix, default
-- target/debug/mix, built on demand), never an installed mix.
-- mix-lint is a ratchet: diagnostics may only shrink against
-- tools/ci/mix-lint-baseline.json. Regenerate it only in a PR that fixes lint.

$o = getopt(args(), {mix: {arg: true}, dir: {arg: true}})
if len($o.errors) > 0 or len($o.rest) != 1 then
  eprint("usage: mix tools/ci.mix fmt|env|mix-services|mix-hygiene|clippy|viud|foreign|test|stage-smoke|mix-lint|mix-lint-baseline|release-mix|stage-install|all [--mix PATH] [--dir DIR]")
  exit(64)
end
$stage = $o.rest[0]
$mix = $o.opts.mix ?? "target/debug/mix"
$baseline_path = "tools/ci/mix-lint-baseline.json"

fn run_step($argv, $env = {})
  print("::group::" + join($argv, " "))
  $r = run_argv($argv, {timeout: 14400, stdout: "inherit", stderr: "inherit", env: $env})
  print("::endgroup::")
  if $r.exit_code != 0 then
    print("::error::step failed (rc " + to_string($r.exit_code ?? 124) + "): " + join($argv, " "))
    exit(1)
  end
end

fn ensure_mix($mix)
  -- CBC reuses target/: existence alone can select another commit's shell.
  -- Cargo checks this tree's inputs and preserves the separate shell profile.
  if $mix == "target/debug/mix" or not exists($mix) then
    run_step(["cargo", "build", "--locked", "-p", "mix", "--bin", "mix"])
  end
end

fn tracked_mix_files()
  $files = []
  for $p in split(trim(run_argv_must(["git", "ls-files", "*.mix"])), "\n")
    if $p != "" and not contains($p, "/fixtures/") then
      push($files, $p)
    end
  end
  return $files
end

-- {file: {code: count}} for every error and warning diagnostic.
fn lint_counts($mix)
  $r = run_argv(concat([$mix, "lint", "--json"], tracked_mix_files()), {timeout: 1800, max_output: 256000000})
  if $r.stdout == "" then
    print("::error::mix lint produced no JSON: " + $r.stderr)
    exit(1)
  end
  $counts = {}
  for $d in json_parse($r.stdout).diagnostics
    if $d.severity == "error" or $d.severity == "warning" then
      if not has_key($counts, $d.file) then
        $counts[$d.file] = {}
      end
      $counts[$d.file][$d.code] = ($counts[$d.file][$d.code] ?? 0) + 1
    end
  end
  return $counts
end

fn stage_fmt()
  run_step(["cargo", "fmt", "--all", "--", "--check"])
end

fn stage_clippy()
  run_step(["cargo", "clippy", "--locked", "--workspace", "--exclude", "mix", "--all-targets"])
  run_step(["cargo", "clippy", "--locked", "-p", "mix", "--all-targets"])
end

fn stage_test($mix)
  stage_mix_hygiene()
  -- Shell process tests hand --serve to the sibling service engine.
  run_step(["cargo", "build", "--locked", "-p", "mixd"])
  -- Tests that run a real interpreter get the one built from this tree,
  -- never an installed one; offline `cargo metadata` tests need every
  -- platform's crates in the cache.
  ensure_mix($mix)
  $abs = realpath($mix)
  run_step([$mix, "tools/reserved_keys.mix", $abs])
  run_step([$mix, "tools/reserved-policy-test.mix"])
  run_step([$mix, "tools/term-targets-test.mix"])
  $test_env = {MIX_TEST_E2E_EXE: $abs, MIX_TEST_MIX_EXE: $abs}
  run_step(["cargo", "fetch", "--locked"])
  run_step(["cargo", "test", "--locked", "-p", "mix", "--features", "test-hooks", "--no-fail-fast"], $test_env)
  run_step(["cargo", "test", "--locked", "--workspace", "--exclude", "mix", "--no-fail-fast"], $test_env)
  stage_mix_services($mix)
  run_step([$mix, "tools/mesh/tests/all.mix"])
  for $case in sort(glob("apps/term/*-test.mix"))
    run_step([$mix, $case])
  end
  for $case in ["apps/monitor/core-test.mix", "apps/monitor/history-test.mix", "apps/monitor/wire-test.mix", "apps/monitor/fetch-test.mix", "apps/screenshot/policy-test.mix"]
    if exists($case) then
      run_step([$mix, $case])
    end
  end
  -- The daily pipeline: a fixture repository and fake gh, then the citizen
  -- on a private broker (noded is built by the workspace tests above).
  run_step([$mix, "services/daily/tests/manifest_test.mix"], $test_env)
  run_step([$mix, "services/daily/tests/serve_test.mix"], merge($test_env, {MIX_TEST_NODED_EXE: realpath("target/debug/noded") ?? "target/debug/noded"}))
end

fn stage_mix_services($mix)
  ensure_mix($mix)
  run_step(["cargo", "build", "--locked", "-p", "mixd", "-p", "noded", "-p", "settingsd"])
  -- noded and settingsd are where that build put them: the workspace target
  -- directory's dev-profile output, not wherever --mix happens to live.
  $meta = json_parse(run_argv_must(["cargo", "metadata", "--no-deps", "--format-version", "1", "--locked"]))
  $bin = $meta.target_directory .. "/debug"
  for $exe in ["noded", "settingsd"]
    if not is_file($bin .. "/" .. $exe) then
      print("::error::mix-services: " .. $exe .. " was not built in " .. $bin)
      exit(1)
    end
  end
  run_step([$mix, "tools/mix_services_test.mix", "--mix", realpath($mix), "--bin", $bin])
end

-- Both normal binaries and opt-in fault-injection binaries are exercised.
fn stage_mix_hygiene()
  run_step(["cargo", "test", "--locked", "-p", "mix", "--test", "mix_hygiene"])
  run_step(["cargo", "test", "--locked", "-p", "mix", "--features", "test-hooks", "--test", "mix_hygiene"])
  run_step(["cargo", "test", "--locked", "-p", "mix", "--features", "test-hooks", "--test", "native_session_pty", "stage_d_"])
  run_step(["cargo", "test", "--locked", "-p", "mix", "--features", "test-hooks", "--test", "native_session_pty", "p4_termination_is_hard_and_the_outcome_names_the_policy"])
  run_step(["cargo", "test", "--locked", "-p", "mix-shell", "--lib", "test_hooks::tests"])
  run_step(["cargo", "test", "--locked", "-p", "mix-shell", "--features", "test-hooks", "--lib", "test_hooks::tests"])
  $r = run_argv(["cargo", "check", "--locked", "-p", "mix", "--release", "--features", "test-hooks"], {timeout: 1800, max_output: 4000000})
  print($r.stdout + $r.stderr)
  if $r.exit_code == 0 or not contains($r.stderr, "test-hooks is forbidden outside the debug test profile") then
    eprint("::error::release test-hooks build did not fail at the profile guard")
    exit(1)
  end
  -- The artefact marker is present exactly when the hooks are linked. The
  -- hook-free build comes last, so later stages get an ordinary binary.
  run_step(["cargo", "build", "--locked", "-p", "mix", "--bin", "mix", "--features", "test-hooks"])
  require_hooks_marker("target/debug/mix", true)
  run_step(["cargo", "build", "--locked", "-p", "mix", "--bin", "mix"])
  require_hooks_marker("target/debug/mix", false)
end

-- Must match MARKER in libraries/mix-shell/src/test_hooks.rs.
$hooks_marker = "mixviu-test-hooks-linked"

fn require_hooks_marker($bin, $want)
  $r = run_argv(["grep", "-a", "-F", "-q", $hooks_marker, $bin])
  if $r.exit_code != 0 and $r.exit_code != 1 then
    eprint("::error::cannot scan " + $bin + " for the test-hooks marker: " + $r.stderr)
    exit(1)
  end
  $found = $r.exit_code == 0
  if $found != $want then
    eprint("::error::" + $bin + ($want ? " lacks" : " carries") + " the test-hooks marker")
    exit(1)
  end
  print($bin + ": test-hooks marker " + ($found ? "present" : "absent") + " (expected)")
end

-- The shipped artefact: a release `mix` must not carry the test hooks.
-- Release recipes run this stage (or require_hooks_marker on their own
-- output) before installing a binary.
fn stage_release_mix()
  run_step(["cargo", "build", "--locked", "--release", "-p", "mix", "--bin", "mix"])
  require_hooks_marker("target/release/mix", false)
end

-- The MIX_* registry (Fable ruling, 2026-11-07): every MIX_* name in the tree
-- is listed in etc/env.conf.mix with owner, scope and meaning, every listed
-- name is still used, and MIXOS_ or /opt/mixos appears only on allowed paths
-- (gold comparison, provenance, the host's gold mix, desk gold-compat).
fn git_grep($args)
  $r = run_argv(concat(["git", "grep", "-I"], $args), {timeout: 300, max_output: 64000000})
  -- git grep exits 1 when nothing matches.
  if $r.exit_code > 1 then
    print("::error::git grep failed: " + $r.stderr)
    exit(1)
  end
  return $r.stdout
end

fn stage_env()
  $reg_path = "etc/env.conf.mix"
  if not exists($reg_path) then
    print("::error::" + $reg_path + " is missing: every MIX_* name must be registered")
    exit(1)
  end
  $reg = load_data($reg_path)
  $listed = {}
  for $v in $reg.vars
    if $v.scope != "runtime" and $v.scope != "test" then
      print("::error::" + $v.name + ": scope must be runtime or test")
      exit(1)
    end
    $listed[$v.name] = true
    if has_key($v, "default") and ($v.scope != "runtime" or type($v.default) != "string" or contains($v.meaning, "not an environment variable")) then
      print("::error::" .. $v.name .. ": default must be a runtime environment string")
      exit(1)
    end
  end
  -- The prefix gate's files arrive with PR #65 (a pathspec for an absent
  -- path excludes nothing). Its finding identities (both greps), its own
  -- recognisers (second grep only: the gate scripts stay in the first, so a
  -- MIX_ consumer cannot hide in them) and the exact fixtures that spell a
  -- MIX_ name (first grep) or an old spelling (second grep) are metadata,
  -- not variable consumers. Everything else stays in both greps.
  $baseline = [":!tools/prefix-baseline.json"]
  $recognisers = [":!tools/prefix_gate.mix", ":!tools/prefix.conf.mix"]
  $fixtures = ":!tools/test-support/prefix_gate/"
  $name_fixtures = map(["cases.conf.mix", "comment.txt", "digit.txt", "doc-word.txt", "env.txt", "env-upper.txt", "include-data.txt"], fn($f) = $fixtures + $f)
  $old_fixtures = map(["bare-opt.txt", "cases.conf.mix", "legacy-boundaries.txt", "legacy-names.txt", "recogniser.txt", "wrong-prefix.txt"], fn($f) = $fixtures + $f)
  $excluded = concat(concat(["--", ".", ":!vendor", ":!provenance", ":!Cargo.lock", ":!last.md", ":!" + $reg_path], $baseline), $name_fixtures)
  $used = {}
  $prefix_used = {}
  for $tok in split(git_grep(concat(["-o", "-h", "-w", "-E", "MIX_[A-Z0-9_]+"], $excluded)), "\n")
    -- A token ending in _ is a prefix code matches against, not a name;
    -- it must be one of the registry's listed prefixes.
    if $tok != "" and ends_with($tok, "_") then
      $prefix_used[$tok] = true
    elif $tok != "" then
      $used[$tok] = true
    end
  end
  $bad = []
  for $n in sort(keys($used))
    if not has_key($listed, $n) then
      push($bad, "unregistered " + $n)
    end
  end
  for $n in sort(keys($listed))
    if not has_key($used, $n) then
      push($bad, "registered but unused " + $n)
    end
  end
  $prefixes = $reg.prefixes ?? []
  for $n in sort(keys($prefix_used))
    if not contains($prefixes, $n) then
      push($bad, "unlisted prefix " + $n)
    end
  end
  $old_excluded = concat(concat(["--", ".", ":!vendor", ":!Cargo.lock", ":!last.md", ":!" + $reg_path], concat($baseline, $recognisers)), $old_fixtures)
  for $f in split(git_grep(concat(["-l", "-E", "MIXOS_|/opt/mixos"], $old_excluded)), "\n")
    if $f != "" then
      $ok = false
      for $re in $reg.mixos_allowed ?? []
        if re_match($f, $re) then
          $ok = true
        end
      end
      if not $ok then
        push($bad, "MIXOS_ or /opt/mixos outside the allowed paths: " + $f)
      end
    end
  end
  -- The layout manifest names only sources that are in the tree.
  for $f in load_data("share/layout/templates.mx").files
    if not is_file("share/layout/" .. $f.source) then
      push($bad, "share/layout/templates.mx source missing: " .. $f.source)
    end
  end
  for $line in $bad
    print("::error::env registry: " + $line)
  end
  print("env registry: " + to_string(len(keys($listed))) + " names, " + to_string(len($bad)) + " problems")
  if len($bad) > 0 then
    exit(1)
  end
end

-- viud is compd without the egui widget toolkit; keep it that way.
fn stage_viud_egui_free()
  $r = run_argv(["cargo", "tree", "--locked", "-p", "viud", "-e", "normal", "--prefix", "none"], {timeout: 600})
  if $r.exit_code != 0 then
    print("::error::cargo tree -p viud failed: " + $r.stderr)
    exit(1)
  end
  $bad = []
  for $line in split($r.stdout, "\n")
    $crate = split($line, " ")[0]
    if $crate == "egui" or $crate == "egui-wgpu" or $crate == "egui-winit" or $crate == "eframe" or $crate == "toolkit" then
      push($bad, $line)
    end
  end
  if len($bad) > 0 then
    print("::error::viud links the egui toolkit: " + join($bad, "; "))
    exit(1)
  end
  print("viud: no egui/toolkit crates in its normal dependency tree")
end

-- Foreign code (tools/foreign.conf.mix): every C-building crate is allowed or
-- debt, the strict mix crates reach allow entries only and no desktop crate,
-- and the built shell loads no display, GPU, input or audio library (ldd).
fn stage_foreign($mix)
  ensure_mix($mix)
  run_step([$mix, "tools/foreign_gate.mix", "--locked", "--elf", realpath($mix)])
end

fn stage_mix_lint($mix)
  ensure_mix($mix)
  $now = lint_counts($mix)
  $base = {}
  if exists($baseline_path) then
    $base = json_parse(read_file($baseline_path))
  end
  $worse = []
  $better = 0
  for $file in keys($now)
    for $code in keys($now[$file])
      $was = 0
      if has_key($base, $file) then
        $was = $base[$file][$code] ?? 0
      end
      if $now[$file][$code] > $was then
        push($worse, $file + " " + $code + ": " + to_string($was) + " -> " + to_string($now[$file][$code]))
      end
      if $now[$file][$code] < $was then
        $better = $better + 1
      end
    end
  end
  for $line in $worse
    print("::error::mix lint regression " + $line)
  end
  print("mix lint: " + to_string(len(keys($now))) + " files with diagnostics, " + to_string(len($worse)) + " regressions, " + to_string($better) + " improvements")
  if len($worse) > 0 then
    print("Fix the new diagnostics (run: mix lint FILE). The baseline only shrinks.")
    exit(1)
  end
end

fn stage_mix_lint_baseline($mix)
  ensure_mix($mix)
  mkdir("tools/ci")
  $json = json_encode(lint_counts($mix)) + "\n"
  write_file($baseline_path, $json)
  -- Printed between markers so a CBC run can hand the file back.
  print("== mix-lint baseline begin ==")
  print($json)
  print("== mix-lint baseline end ==")
  print("wrote " + $baseline_path)
end

-- The engine and service binaries the workspace builds, by name: every bin
-- target of a package under engines/ or services/.
fn staged_binary_names()
  $r = run_argv(["cargo", "metadata", "--locked", "--no-deps", "--format-version", "1"], {timeout: 600, max_output: 64000000})
  if $r.exit_code != 0 then
    print("::error::cargo metadata failed: " + $r.stderr)
    exit(1)
  end
  $meta = json_parse($r.stdout)
  $names = []
  for $p in $meta.packages
    $rel = replace($p.manifest_path, $meta.workspace_root .. "/", "")
    if starts_with($rel, "engines/") or starts_with($rel, "services/") then
      for $t in $p.targets
        if contains($t.kind, "bin") and not contains($names, $t.name) then
          push($names, $t.name)
        end
      end
    end
  end
  return sort($names)
end

-- Never stage on a temporary filesystem: on 2026-11-11 a stage of every
-- target/debug executable filled a worker's /tmp tmpfs for hours.
-- A stage lives under this tree's target/ and nowhere else. The check is on
-- resolved paths, not spellings: target/ is canonicalised, the name below it
-- is plain components only, and an existing stage must resolve inside it.
fn stage_refuse($dir, $why)
  print("::error::stage-install refuses " .. $dir .. ": " .. $why)
  exit(1)
end

fn stage_dir($dir)
  $root = realpath("target")
  if $root == nil then stage_refuse($dir, "target/ does not exist; build first") end
  $tmp = env("TMPDIR") ?? ""
  $tmp_real = if $tmp != "" then realpath($tmp) else nil end
  if $root == "/tmp" or starts_with($root, "/tmp/") or ($tmp_real != nil and ($root == $tmp_real or starts_with($root, $tmp_real .. "/"))) then
    stage_refuse($dir, "target/ resolves to " .. $root .. ", a temporary filesystem")
  end
  if not starts_with($dir, "target/") then stage_refuse($dir, "the stage must be a path under target/") end
  $parts = split(substr($dir, len("target/")), "/")
  for $p in $parts
    if $p == "" or $p == "." or $p == ".." then stage_refuse($dir, "only plain path components are allowed") end
  end
  $abs = $root .. "/" .. join($parts, "/")
  -- Every existing ancestor, and the stage itself, must still be inside
  -- target/ once symlinks are resolved.
  $probe = $root
  for $p in $parts
    $probe = $probe .. "/" .. $p
    $real = realpath($probe)
    if $real == nil then break end
    if $real != $probe then stage_refuse($dir, $probe .. " resolves to " .. $real) end
  end
  return $abs
end

-- Optional staging only: {prefix, commit}. Callers choose when to use this
-- install and remove the directory when done.
fn stage_install($dir)
  $prefix = stage_dir($dir)
  if is_dir($prefix) and len(ls($prefix)) > 0 then
    if not is_file($prefix .. "/.mix-stage") then
      print("::error::stage-install: " .. $prefix .. " is not empty and is not a previous stage")
      exit(1)
    end
    remove_dir($prefix)
  end
  if not is_file("target/debug/mix") then
    print("::error::stage-install: target/debug/mix is not built")
    exit(1)
  end
  mkdir($prefix .. "/bin")
  write_file($prefix .. "/.mix-stage", "")
  $copied = []
  for $name in staged_binary_names()
    if is_file("target/debug/" .. $name) then
      run_argv_must(["cp", "--", "target/debug/" .. $name, $prefix .. "/bin/" .. $name])
      push($copied, $name)
    end
  end
  -- The snapshot commit is the staged binary's own stamp, not HEAD, so a
  -- stale target/ is never paired with this tree's defaults.
  $commit = json_parse(run_argv_must([$prefix .. "/bin/mix", "--version", "--json"], {clear_env: true})).git_sha_full
  if type($commit) != "string" or not re_match($commit, "^[0-9a-f]{40}$") then
    print("::error::stage-install: staged mix has no full commit stamp")
    exit(1)
  end
  $head = trim(run_argv_must(["git", "rev-parse", "HEAD"]))
  if $commit != $head and trim(run_argv_must(["git", "status", "--porcelain"])) == "" then
    print("::error::stage-install: target/debug/mix was built from " .. $commit .. ", not HEAD " .. $head .. ": rebuild it")
    exit(1)
  end
  if $commit != $head then
    eprint("stage-install: warning: the tree is dirty and target/debug/mix was built from " .. $commit .. ", not HEAD " .. $head)
  end
  $defaults = {schema: 1, commit: $commit}
  for $v in load_data("etc/env.conf.mix").vars
    if $v.scope == "runtime" and has_key($v, "default") then $defaults[$v.name] = $v.default end
  end
  write_file($prefix .. "/env.mx", data_encode($defaults))
  eprint("staged into " .. $prefix .. "/bin: " .. join($copied, " "))
  return {prefix: $prefix, commit: $commit}
end

-- A staged binary resolves an installed default from the staged env.mx.
-- No engine reads a setting yet, so the staged program is this tree's paths
-- unit-test binary, copied into the stage's bin/ and run with a cleared
-- environment: it must find the prefix from its own location.
fn paths_test_exe()
  $r = run_argv(["cargo", "test", "--locked", "-p", "paths", "--lib", "--no-run", "--message-format", "json"], {timeout: 1800, max_output: 64000000})
  if $r.exit_code != 0 then
    print("::error::cannot build the paths test binary: " + $r.stderr)
    exit(1)
  end
  $exe = nil
  for $line in split($r.stdout, "\n")
    if starts_with($line, "{") then
      $m = json_parse($line)
      if $m.reason == "compiler-artifact" and $m.executable != nil and $m.target.name == "paths" then
        $exe = $m.executable
      end
    end
  end
  if $exe == nil then
    print("::error::cargo named no paths test binary")
    exit(1)
  end
  return $exe
end

fn stage_smoke()
  $dir = "target/stage-smoke"
  $exe = paths_test_exe()
  try
    $s = stage_install($dir)
    run_argv_must(["cp", "--", $exe, $s.prefix .. "/bin/paths-smoke"])
    $test = "env_tests::staged_install_resolves_installed_defaults"
    $r = run_argv([$s.prefix .. "/bin/paths-smoke", "--exact", $test], {clear_env: true, env: {MIX_TEST_PATH_CACHE: "staged:" .. $s.commit}, timeout: 300})
    print($r.stdout + $r.stderr)
    if $r.exit_code != 0 or not contains($r.stdout, "test result: ok. 1 passed") then
      print("::error::stage-smoke: the staged binary did not resolve its installed defaults")
      exit(1)
    end
    print("stage-smoke: staged binary resolved its installed defaults")
  finally
    if is_file($dir .. "/.mix-stage") then remove_dir($dir) end
  end
end

if $stage == "stage-install" then
  print(stage_install($o.opts.dir ?? "target/stage-install").prefix)
elif $stage == "stage-smoke" then
  stage_smoke()
elif $stage == "fmt" then
  stage_fmt()
elif $stage == "clippy" then
  stage_clippy()
elif $stage == "test" then
  stage_test($mix)
elif $stage == "mix-services" then
  stage_mix_services($mix)
elif $stage == "mix-hygiene" then
  stage_mix_hygiene()
elif $stage == "release-mix" then
  stage_release_mix()
elif $stage == "viud" then
  stage_viud_egui_free()
elif $stage == "foreign" then
  stage_foreign($mix)
elif $stage == "env" then
  stage_env()
elif $stage == "mix-lint" then
  stage_mix_lint($mix)
elif $stage == "mix-lint-baseline" then
  stage_mix_lint_baseline($mix)
elif $stage == "all" then
  stage_fmt()
  stage_env()
  stage_clippy()
  stage_viud_egui_free()
  stage_foreign($mix)
  stage_test($mix)
  stage_smoke()
  stage_mix_lint($mix)
else
  eprint("unknown stage: " + $stage)
  exit(64)
end
