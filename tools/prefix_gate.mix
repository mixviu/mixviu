-- SPDX-License-Identifier: MIT OR Apache-2.0
-- version: 0.4.0
-- Lexical prefix ratchet; run from the repository root. No runtime evaluation.
-- Limitations. Cannot see paths assembled from non-literal pieces (even a
-- constant P in concat!(P, "opt/mix")), compressed embedded data, generated
-- OUT_DIR files not in the source tree, or includes with non-literal filenames.
-- Macro bodies and #[cfg] items are not understood: they are scanned as plain
-- tokens, so a DEFAULT_PREFIX-shaped item in a macro or a cfg(test) item can
-- use the single allowed /opt/mix slot. A local variable that shadows a
-- same-file constant is read as the constant. Any `.env(..)` or
-- `.env_remove(..)` call is treated as Command's, whatever the receiver (a
-- deliberate over-approximation; no receiver tracking). `.envs(..)` is not
-- understood: names passed in its pairs are not seen. Snapshot mode allows
-- the exact string /opt/mix any number of times (it is the compiled-in
-- default). vendor/ is scanned here (vendor-path, old names) but excluded
-- from the env stage, whose MIX_ registry covers only this project's code.
-- Rust comments contribute path findings, but not MIX-word findings; ordinary/raw
-- strings, byte strings, escapes and literal concat! arguments are decoded, and
-- the decoded values are checked for paths, MIX_ words and old names.
-- Format macros expose their format literal through the same token scan.
-- Environment reads: std::env::{var, var_os, set_var, remove_var} through a
-- path, a `use` alias or a bare imported name, Command .env/.env_remove, env!
-- and option_env!. The name is a literal, a literal concat!, or a same-file
-- `const`/`static NAME: &str = "..."`; a constant from another file is not seen.
-- Input safety: files come from `git ls-files -s -z` split as bytes. Symlinks
-- (tracked, or swapped into the working tree), non-regular files, files over
-- limits.max_file_bytes and non-UTF-8 names are findings and are never read.
-- Names and matched text are printed with control characters escaped.
-- Control files (policy, baseline, baseline module, selftest cases) get the
-- same no-follow regular-file read, capped by $hard.control_bytes, before
-- they are parsed. The policy cannot raise any cap past the $hard bounds.
-- Baseline identities omit line numbers so unrelated edits do not reset debt.
-- --json emits ALL findings, even in baseline mode. --strict ignores debt.
--
-- Baseline maintenance (see tools/prefix_baseline.mix). The baseline only
-- shrinks; growth cannot pass CI on a PR or on a push to main, by design.
-- A file rename or move of baselined debt is accepted as a relocation (same
-- rule and text, equal count, old key gone in the same change) and printed.
-- The deferred bare-mixos rule is computed and reported as DISABLED. It is
-- switched on, once the domain and app-id rename is done, by a PR that sets
-- enabled:true in tools/prefix.conf.mix with no remaining active bare-mixos
-- finding (fixed, or an exact reviewed exception): enabling it never needs
-- baseline growth, and a PR that tried would fail --check-baseline.

$root = dirname(dirname(realpath($0)))
$scan_root = $root
$support = $root .. "/tools/test-support/prefix_gate"
-- Hard bounds live in code, not policy: a PR's policy cannot raise them.
$hard = {control_bytes: 4194304, listing_bytes: 67108864, max_file_bytes: 16777216, max_snapshot_bytes: 1073741824}
-- Control characters, C1 controls and bidi overrides would reach CI logs.
$unsafe_chars = '[\x00-\x1f\x7f-\x9f\x{2028}\x{2029}\x{202a}-\x{202e}\x{2066}-\x{2069}]'
$policy = load_policy($root .. "/tools/prefix.conf.mix")
control_text($root .. "/tools/prefix_baseline.mix")
$baseline = require("prefix_baseline.mix")
$limits = $policy.limits

-- A control file's text: regular, not a symlink, within $hard.control_bytes,
-- UTF-8. Checked before anything parses it.
fn control_text($path)
  $read = read_regular($path, $hard.control_bytes)
  if $read.problem != nil then
    raise("CONTROL", "control file " .. shown($path) .. ": " .. $read.problem.text)
  end
  try
    return bytes_to_string($read.bytes)
  catch $message
    raise("CONTROL", "control file " .. shown($path) .. " is not UTF-8")
  end
end

fn load_policy($path)
  $p = data_parse(control_text($path))
  if type($p) != "map" then raise("POLICY", "policy must be a map") end
  for $e in $p.exceptions ?? []
    if trim($e.file ?? "") == "" or trim($e.rule ?? "") == "" or $e.text == nil or trim($e.reason ?? "") == "" then
      raise("POLICY", "every exception needs an exact file, rule, text and reason")
    end
  end
  for $file in keys($p.excluded_files ?? {})
    if trim($p.excluded_files[$file]) == "" then
      raise("POLICY", "excluded file needs a reason: " .. $file)
    end
  end
  $l = $p.limits ?? {}
  for $k in ["max_file_bytes", "max_snapshot_bytes"]
    if type($l[$k] ?? nil) != "number" or $l[$k] < 1 or floor($l[$k]) != $l[$k] then
      raise("POLICY", "limits." .. $k .. " must be a positive whole number of bytes")
    end
    if $l[$k] > $hard[$k] then
      raise("POLICY", "limits." .. $k .. " exceeds the hard bound of " .. to_string($hard[$k]) .. " bytes")
    end
  end
  return $p
end

-- The in-tree baseline, or {} when no file of that name exists at all.
fn load_baseline_file($path)
  $exists = true
  try
    stat($path, {follow_symlinks: false})
  catch $message
    $exists = false
  end
  if not $exists then return {} end
  return $baseline.checked(json_parse(control_text($path)))
end

-- check_base with the in-tree copy read through the control-file checks.
fn check_repo($repo, $before = "")
  return $baseline.check_base($repo, $before, load_baseline_file($repo .. "/tools/prefix-baseline.json"), $hard.control_bytes)
end
$o = getopt(args(), {json: {}, strict: {}, snapshot: {arg: true}, "check-baseline": {}, "update-baseline": {}, "allow-growth": {}})
if len($o.errors) > 0 or len($o.rest) > 1 then
  eprint("usage: mix tools/prefix_gate.mix [selftest] [--json] [--strict] [--snapshot DIR] [--check-baseline] [--update-baseline [--allow-growth]]")
  eprint("  --update-baseline --allow-growth only rewrites the file; CI still refuses growth.")
  exit(1)
end
if $o.opts["allow-growth"] and not $o.opts["update-baseline"] then
  raise("USAGE", "--allow-growth requires --update-baseline")
end
if $o.opts["update-baseline"] and $o.opts.snapshot != nil then
  raise("USAGE", "snapshot findings do not use the source baseline")
end
if $o.opts["check-baseline"] and (len($o.rest) > 0 or $o.opts.snapshot != nil or $o.opts["update-baseline"]) then
  raise("USAGE", "--check-baseline is a separate mode")
end
if len($o.rest) > 0 and ($o.opts.snapshot != nil or $o.opts["update-baseline"]) then
  raise("USAGE", "selftest is a separate mode")
end
$findings = []
$seen_includes = {}
$prefix_hits = 0
$rust_patterns = {}
$disabled_findings = []
$scanned_rust = {}
$old_files = {}
$disabled = {}
for $d in $policy.disabled_rules
  if not ($d.enabled ?? false) then
    $disabled[$d.rule] = $d.reason
  end
end
$env_functions = ["var", "var_os", "set_var", "remove_var"]
-- Safe rejection before lexing: hex/Unicode escapes, line continuations
-- and concat! can hide a spelling. Comments may separate a macro and !.
$rust_prefilter = '/opt/|/(?:etc|run)/mix|/var/(?:lib|cache)/mix|/root|/tmp/mix-run|(?i:mix_)|\b(?:concat|include|include_str|include_bytes|env|option_env|var|var_os|set_var|remove_var|env_remove)\b|\x5c(?:x|u|\r?\n)'
for $name in $policy.foreign_env_names
  if not re_match($name, '^[A-Z_][A-Z0-9_]*$') then
    raise("POLICY", "foreign_env_names must be plain environment names: " .. $name)
  end
  $rust_prefilter = $rust_prefilter .. '|\b' .. $name .. '\b'
end

fn shown($s)
  $s = to_string($s)
  if not re_match($s, $unsafe_chars) then
    return $s
  end
  $digits = "0123456789abcdef"
  $out = ""
  $pos = 0
  for $m in re_find($s, $unsafe_chars)
    $n = ord($m.match)
    $hex = ""
    while $n > 0 or $hex == ""
      $hex = slice($digits, $n % 16, $n % 16 + 1) .. $hex
      $n = floor($n / 16)
    end
    $out = $out .. slice($s, $pos, $m.start) .. "\\u{" .. $hex .. "}"
    $pos = $m.end
  end
  return $out .. slice($s, $pos)
end

fn record_hit($file, $line, $rule, $text)
  global $findings, $disabled_findings
  for $e in $policy.exceptions
    if $e.file == $file and $e.rule == $rule and $e.text == $text then
      return
    end
  end
  $f = {file: $file, line: $line, rule: $rule, text: $text}
  if has_key($disabled, $rule) then
    $f.disabled = true
    push($disabled_findings, $f)
  else
    push($findings, $f)
  end
end

fn path_hits($file, $line, $text, $scope, $constant = false)
  global $prefix_hits
  if not contains($text, "/opt/") and not contains($text, "/etc/mix") and not contains($text, "/run/mix") and not contains($text, "/var/lib/mix") and not contains($text, "/var/cache/mix") and not contains($text, "/tmp/mix-run") and not contains($text, "/root") then
    return
  end
  -- Match complete whitespace-delimited URLs first so /opt/ inside them is
  -- never reconsidered as a path. Rust regex has no lookbehind/lookahead.
  -- ':' ends a path, so PATH-style lists still match each element.
  for $m in re_find($text, '[A-Za-z][A-Za-z0-9+.-]*://[^\s"\x00<>]+|(^|[^\w/])(/opt/[^\s"\x27\x00<>;,:)}\]]*|/(?:etc|run|var/(?:lib|cache|run))/mix(?:os)?(?:/[^\s"\x27\x00<>;,:)}\]]*|\b)|/tmp/mix-run(?:/[^\s"\x27\x00<>;,:)}\]]*|\b)|/root(?:/[^\s"\x27\x00<>;,:)}\]]*|\b))')
    if re_match($m.match, '^[A-Za-z][A-Za-z0-9+.-]*://') then
      continue
    end
    $hit = $m.groups[1]
    -- A word boundary alone also permits '-' and '.', which remain part of
    -- a filename. Require end, slash, whitespace, ':' or a string delimiter.
    if not starts_with($hit, "/opt/") then
      $after = slice($text, $m.end, $m.end + 1)
      if $after != "" and not re_match($after, '[\s"\x27\x00<>;,:)}\]]') then
        continue
      end
    end
    if $constant and $scope == "rust" and $file == $policy.prefix_constant.file and $text == "/opt/mix" then
      $prefix_hits = $prefix_hits + 1
      if $prefix_hits == 1 then
        continue
      end
    end
    if $scope == "snapshot" and $hit == "/opt/mix" then
      continue
    end
    record_hit($file, $line, $scope .. "-path", $hit)
  end
end

fn old_matches($text)
  $out = []
  for $m in re_find($text, '\b(?:MIXOS_[A-Za-z0-9_]*|COSMIX_[A-Za-z0-9_]*|cosmix)\b')
    push($out, {rule: "old-name", match: $m.match, start: $m.start})
  end
  for $m in re_find($text, '\bmixos\b')
    push($out, {rule: "bare-mixos", match: $m.match, start: $m.start})
  end
  return $out
end

fn old_hits($file, $line, $text, $line_numbers = true)
  for $m in old_matches($text)
    $here = $line_numbers ? $line + len(split(slice($text, 0, $m.start), "\n")) - 1 : $line
    record_hit($file, $here, $m.rule, $m.match)
  end
end

fn decode_rust($s)
  if starts_with($s, "b") then
    $s = slice($s, 1)
  end
  if starts_with($s, "r") then
    $q = index_of($s, '"')
    return slice($s, $q + 1, len($s) - $q)
  end
  $s = slice($s, 1, -1)
  $out = ""
  $pos = 0
  for $m in re_find($s, '\x5c(?:x[0-9a-fA-F]{2}|u\{[0-9a-fA-F_]+\}|\r?\n\s*|.)')
    $out = $out .. slice($s, $pos, $m.start)
    $e = slice($m.match, 1)
    if starts_with($e, "x") then
      $out = $out .. chr(hex_number(slice($e, 1)))
    elif starts_with($e, "u{") then
      $out = $out .. chr(hex_number(replace(slice($e, 2, -1), "_", "")))
    elif $e == "n" then
      $out = $out .. "\n"
    elif $e == "r" then
      $out = $out .. "\r"
    elif $e == "t" then
      $out = $out .. "\t"
    elif $e == "0" then
      $out = $out .. chr(0)
    elif not starts_with($e, "\n") and not starts_with($e, "\r") then
      $out = $out .. $e
    end
    $pos = $m.end
  end
  return $out .. slice($s, $pos)
end

fn hex_number($s)
  $n = 0
  for $c in split(lower($s), "")
    if $c != "" then
      $n = $n * 16 + index_of("0123456789abcdef", $c)
    end
  end
  return $n
end

fn rust_tokens($source, $file = "", $scope = "rust", $base_line = 0)
  global $rust_patterns
  -- Longest raw delimiter first. Rust permits up to 255 hashes.
  $max_hash = 0
  for $m in re_find($source, 'b?r(#{0,255})"')
    $max_hash = max($max_hash, len($m.groups[0]))
  end
  $cache_key = to_string($max_hash)
  if not has_key($rust_patterns, $cache_key) then
  $raw = []
  $hashes = ""
  for $n = 0 to $max_hash
    push($raw, 'b?r' .. $hashes .. '"(?s:.*?)"' .. $hashes)
    $hashes = $hashes .. "#"
  end
  $rust_patterns[$cache_key] = join(reverse($raw), "|") .. '|//[^\n]*|/\*|\*/|b?"(?:\x5c(?s:.)|[^"\x5c])*"|b?\x27(?:\x5c(?:u\{[^}]*\}|x..|.)|[^\x27\x5c])\x27|[0-9][0-9A-Za-z_]*(?:\.[0-9][0-9A-Za-z_]*)?|[A-Za-z_][A-Za-z0-9_]*|[^\s]|\s+'
  end
  $out = []
  $skip_until = 0
  $line = 1 + $base_line
  $marks = contains($source, "/*") ? re_find($source, '/\*|\*/') : []
  $mark_count = len($marks)
  $mark_i = 0
  for $m in re_find($source, $rust_patterns[$cache_key])
    $s = $m.match
    $here = $line
    $line = $line + len(split($s, "\n")) - 1
    if $m.start < $skip_until then
      if $m.end > $skip_until then
        -- A quote or // inside a block comment must not consume real code
        -- after its closing delimiter. Re-lex that suffix at the boundary.
        $offset = $base_line + len(split(slice($source, 0, $skip_until), "\n")) - 1
        $tail = rust_tokens(slice($source, $skip_until), $file, $scope, $offset)
        for $t in $tail
          push($out, $t)
        end
        return $out
      end
      continue
    end
    if $s == "/*" then
      $depth = 1
      $skip_until = len($source)
      while $mark_i < $mark_count and $marks[$mark_i].start < $m.end
        $mark_i = $mark_i + 1
      end
      while $mark_i < $mark_count
        $mark = $marks[$mark_i]
        $mark_i = $mark_i + 1
        $depth = $depth + ($mark.match == "/*" ? 1 : -1)
        if $depth == 0 then
          $skip_until = $mark.end
          break
        end
      end
      path_hits($file, $here, slice($source, $m.start, $skip_until), $scope)
    elif starts_with($s, "//") then
      path_hits($file, $here, $s, $scope)
    elif not starts_with($s, "//") and trim($s) != "" then
      -- At this point the lexer has already separated strings, characters,
      -- identifiers and punctuation. Avoid compiling a regex per token.
      $literal = contains($s, '"') or (len($s) > 1 and (starts_with($s, "'") or starts_with($s, "b'")))
      push($out, {text: $s, line: $here, literal: $literal, value: $literal ? decode_rust($s) : $s})
    end
  end
  return $out
end

fn prefix_item($ts, $i)
  -- Visibility and attributes precede const/static, so they do not change
  -- this item recogniser. Initialisers must still be a direct string literal.
  $j = $i - 1
  if $j < 0 or $ts[$j].text != "=" then return false end
  $j = $j - 1
  if $j < 0 or $ts[$j].text != "str" then return false end
  $j = $j - 1
  if $j >= 1 and $ts[$j].text == "static" and $ts[$j - 1].text == "'" then
    $j = $j - 2
  end
  if $j < 3 or $ts[$j].text != "&" or $ts[$j - 1].text != ":" or $ts[$j - 2].text != $policy.prefix_constant.name then
    return false
  end
  return contains(["const", "static"], $ts[$j - 3].text) or ($j >= 4 and $ts[$j - 3].text == "mut" and $ts[$j - 4].text == "static")
end

fn standard_env($name)
  for $p in $policy.standard_env_names
    if $name == $p or (ends_with($p, "*") and starts_with($name, slice($p, 0, -1))) then
      return true
    end
  end
  return false
end

-- $form is how the name is read: env!, option_env!, var, var_os, set_var,
-- remove_var, .env or .env_remove.
fn environment_hit($file, $line, $name, $form)
  if re_match($name, '^(?i:mix_)') then
    if not starts_with($file, "libraries/paths/") then
      record_hit($file, $line, "rust-env", $form .. "(" .. $name .. ")")
    end
    return
  end
  if not re_match($name, '^[A-Z_][A-Z0-9_]*$') then return end
  if contains($policy.foreign_env_names, $name) then
    -- The literal/identifier pass reports catalogued names even when a
    -- constant or derive hides the eventual std::env read.
    return
  elif not standard_env($name) then
    record_hit($file, $line, "rust-unknown-env", $name)
  end
end

-- Evaluate only literal expressions and nested concat!, never Rust code.
fn literal_expr($ts, $i)
  if $i >= len($ts) then
    return nil
  end
  if $ts[$i].literal then
    return {value: $ts[$i].value, next: $i + 1}
  end
  if re_match($ts[$i].text, '^(?:[0-9][0-9A-Za-z_.]*|true|false)$') then
    return {value: $ts[$i].text, next: $i + 1}
  end
  if $i + 2 >= len($ts) or $ts[$i].text != "concat" or $ts[$i + 1].text != "!" or not contains(["(", "[", "{"], $ts[$i + 2].text) then
    return nil
  end
  $closing = {"(": ")", "[": "]", "{": "}"}[$ts[$i + 2].text]
  $j = $i + 3
  $value = ""
  while $j < len($ts) and $ts[$j].text != $closing
    $v = literal_expr($ts, $j)
    if $v == nil then
      return nil
    end
    $value = $value .. $v.value
    $j = $v.next
    if $j < len($ts) and $ts[$j].text == "," then
      $j = $j + 1
    elif $j >= len($ts) or $ts[$j].text != $closing then
      return nil
    end
  end
  return $j < len($ts) ? {value: $value, next: $j + 1} : nil
end

-- Same-file `const|static [mut] NAME: &['static ]str = <literal expr>;`.
fn rust_constants($ts)
  $out = {}
  $n = len($ts)
  for $k = 0 to $n - 1
    if $ts[$k].text != "const" and $ts[$k].text != "static" then continue end
    $j = $k + 1
    if $j < $n and $ts[$j].text == "mut" then $j = $j + 1 end
    if $j + 1 >= $n or $ts[$j + 1].text != ":" or not re_match($ts[$j].text, '^[A-Za-z_][A-Za-z0-9_]*$') then continue end
    $name = $ts[$j].text
    $j = $j + 2
    while $j < $n and contains(["&", "'", "static", "str"], $ts[$j].text)
      $j = $j + 1
    end
    if $j < $n and $ts[$j].text == "=" then
      $v = literal_expr($ts, $j + 1)
      if $v != nil and $v.next < $n and $ts[$v.next].text == ";" then
        $out[$name] = $v.value
      end
    end
  end
  return $out
end

-- Module names that mean std::env, and bare names imported from it
-- (local name -> std::env function), from this file's `use std::...` items.
fn env_imports($ts)
  $mods = {env: true}
  $fns = {}
  $n = len($ts)
  $k = 0
  while $k < $n
    if $ts[$k].text != "use" then
      $k = $k + 1
      continue
    end
    $items = []
    $k = $k + 1
    while $k < $n and $ts[$k].text != ";"
      push($items, $ts[$k].text)
      $k = $k + 1
    end
    $first = 0
    while $first < len($items) and $items[$first] == ":"
      $first = $first + 1
    end
    if $first >= len($items) or $items[$first] != "std" then continue end
    $m = len($items)
    for $p = 0 to $m - 1
      if $items[$p] != "env" then continue end
      $q = $p + 1
      if $q + 1 < $m and $items[$q] == ":" and $items[$q + 1] == ":" then
        $q = $q + 2
        $names = []
        if $q < $m and $items[$q] == "{" then
          $q = $q + 1
          while $q < $m and $items[$q] != "}"
            $nm = $items[$q]
            $alias = $nm
            if $q + 2 < $m and $items[$q + 1] == "as" then
              $alias = $items[$q + 2]
              $q = $q + 2
            end
            push($names, {name: $nm, alias: $alias})
            $q = $q + 1
            if $q < $m and $items[$q] == "," then $q = $q + 1 end
          end
        elif $q < $m then
          $alias = $items[$q]
          if $q + 2 < $m and $items[$q + 1] == "as" then $alias = $items[$q + 2] end
          push($names, {name: $items[$q], alias: $alias})
        end
        for $x in $names
          if $x.name == "*" then
            for $f in $env_functions
              $fns[$f] = $f
            end
          elif $x.name == "self" then
            $mods[$x.alias == "self" ? "env" : $x.alias] = true
          elif contains($env_functions, $x.name) then
            $fns[$x.alias] = $x.name
          end
        end
      elif $q + 1 < $m and $items[$q] == "as" then
        $mods[$items[$q + 1]] = true
      end
    end
  end
  return {mods: $mods, fns: $fns}
end

fn env_name($ts, $j, $consts)
  $v = literal_expr($ts, $j)
  if $v != nil then
    return $v.value
  end
  if $j + 1 < len($ts) and has_key($consts, $ts[$j].text) and contains([")", ","], $ts[$j + 1].text) then
    return $consts[$ts[$j].text]
  end
  return nil
end

fn scan_rust($file, $source)
  global $seen_includes, $scanned_rust, $old_files
  if has_key($scanned_rust, $file) then return end
  $scanned_rust[$file] = true
  if not re_match($source, $rust_prefilter) then
    return
  end
  $scope = starts_with($file, "vendor/") ? "vendor" : "rust"
  $ts = rust_tokens($source, $file, $scope)
  $nt = len($ts)
  $consts = $scope == "rust" ? rust_constants($ts) : {}
  $imports = $scope == "rust" ? env_imports($ts) : {mods: {}, fns: {}}
  $env_args = {}
  $i = -1
  $skip_next = 0
  for $t in $ts
    $i = $i + 1
    if $i < $skip_next then
      continue
    end
    -- Terminal macro identifiers also cover ::include_str! and
    -- core::include_str!: the preceding qualification remains separate tokens.
    if $i + 3 < $nt and contains(["include", "include_str", "include_bytes"], $t.text) and $ts[$i + 1].text == "!" then
      $v = literal_expr($ts, $i + 3)
      if $v != nil then
        $abs = realpath(starts_with($v.value, "/") ? $v.value : dirname($scan_root .. "/" .. $file) .. "/" .. $v.value)
        if $abs == nil then
          record_hit($file, $t.line, $scope .. "-include", "missing include: " .. $v.value)
          continue
        end
        if not starts_with($abs, $scan_root .. "/") then
          record_hit($file, $t.line, $scope .. "-include", "include outside repository: " .. $v.value)
          continue
        end
        $inc = slice($abs, len($scan_root) + 1)
        if not has_key($seen_includes, $inc) then
          $seen_includes[$inc] = true
          $read = read_regular($abs, $limits.max_file_bytes)
          if $read.problem != nil then
            record_hit($inc, 1, $read.problem.rule, $read.problem.text)
            continue
          end
          $inc_bytes = $read.bytes
          $included = bytes_to_string($inc_bytes, {lossy: true})
          $inc_text = text_data($inc, $inc_bytes, $included)
          if ends_with($inc, ".rs") then
            scan_rust($inc, $included)
          else
            if $inc_text then
              scan_data($inc, $included, $scope)
            else
              path_hits($inc, 1, $included, $scope)
            end
            if $scope == "rust" and not starts_with($inc, "libraries/paths/") then
              for $m in re_find($included, '\bMIX_[A-Z0-9_]+\b')
                record_hit($inc, len(split(slice($included, 0, $m.start), "\n")), "rust-mix-token", $m.match)
              end
            end
          end
          if not has_key($old_files, $inc) then
            $old_files[$inc] = true
            old_hits($inc, 1, $included, $inc_text)
          end
        end
      end
    end
    if $scope == "rust" and $i + 3 < $nt and ($t.text == "env" or $t.text == "option_env") and $ts[$i + 1].text == "!" then
      -- Same name resolution as the var forms: literal, concat! or const.
      $name = env_name($ts, $i + 3, $consts)
      if $name != nil then
        environment_hit($file, $t.line, $name, $t.text .. "!")
        if re_match($name, '^(?i:mix_)') and literal_expr($ts, $i + 3) != nil then $env_args[to_string($i + 3)] = true end
      end
    end
    if $scope == "rust" and $i + 2 < $nt and $ts[$i + 1].text == "(" then
      $form = nil
      $prev = $i > 0 ? $ts[$i - 1].text : ""
      if contains($env_functions, $t.text) and $i >= 3 and $prev == ":" and $ts[$i - 2].text == ":" and has_key($imports.mods, $ts[$i - 3].text) then
        $form = $t.text
      elif has_key($imports.fns, $t.text) and $prev != ":" and $prev != "." and $prev != "fn" then
        $form = $imports.fns[$t.text]
      elif ($t.text == "env" or $t.text == "env_remove") and $prev == "." then
        $form = "." .. $t.text
      end
      if $form != nil then
        $name = env_name($ts, $i + 2, $consts)
        if $name != nil then environment_hit($file, $t.line, $name, $form) end
        if $name != nil and re_match($name, '^(?i:mix_)') and literal_expr($ts, $i + 2) != nil then
          $env_args[to_string($i + 2)] = true
        end
      end
    end
    $v = nil
    if $t.literal then
      $v = {value: $t.value, next: $i + 1}
    elif $t.text == "concat" then
      $v = literal_expr($ts, $i)
    end
    $text = $v != nil ? $v.value : $t.text
    if $v != nil then
      $constant = false
      if $file == $policy.prefix_constant.file and $text == "/opt/mix" then
        $constant = $t.literal and prefix_item($ts, $i)
      end
      path_hits($file, $t.line, $text, $scope, $constant)
      -- Raw source already gave the spellings that appear verbatim; a decoded
      -- escape or a concat! join can produce one that does not.
      if contains($text, "MIXOS_") or contains($text, "COSMIX_") or contains($text, "cosmix") or contains($text, "mixos") then
        $raw = join(map(slice($ts, $i, $v.next), fn($x) = $x.text), " ")
        for $m in old_matches($text)
          if not contains($raw, $m.match) then
            record_hit($file, $t.line, $m.rule, $m.match)
          end
        end
      end
    end
    -- A literal already reported as an environment read (rust-env) is not
    -- counted again as a token.
    if $scope == "rust" and contains($text, "MIX_") and not starts_with($file, "libraries/paths/") and not has_key($env_args, to_string($i)) then
      for $m in re_find($text, '\bMIX_[A-Z0-9_]+\b')
        record_hit($file, $t.line, "rust-mix-token", $m.match)
      end
    end
    if $scope == "rust" then
      for $name in $policy.foreign_env_names
        if ($v != nil and contains($text, $name)) or $t.text == $name then
          for $m in re_find($text, '\b' .. $name .. '\b')
            record_hit($file, $t.line, "rust-foreign-env", $m.match)
          end
        end
      end
    end
    $skip_next = $v != nil ? $v.next : $i + 1
  end
end

fn scan_data($file, $source, $scope)
  $line = 0
  for $s in split($source, "\n")
    $line = $line + 1
    path_hits($file, $line, $s, $scope)
    if $scope == "data" then
      for $m in re_find($s, '^\s*(?:Runtime|State|Cache|Logs|Configuration)Directory\s*=([^#\r\n]*)')
        for $part in re_find($m.groups[0], '[^\s"\x27]+')
          if re_match($part.match, '^mix(?:os)?(?:[-/]|$)') then
            record_hit($file, $line, "unit-directory", trim($m.match))
          end
        end
      end
      for $m in re_find($s, '%[StCE]/mix(?:os)?(?:/[^\s"\x27;]*)?\b')
        $after = slice($s, $m.end, $m.end + 1)
        if $after == "" or re_match($after, '[\s"\x27;]') then
          record_hit($file, $line, "unit-specifier", $m.match)
        end
      end
    end
  end
end

-- Read a regular file without following a symlink, at most $cap bytes.
-- Returns {bytes} or {problem: {rule, text}}; never opens anything else.
fn read_regular($abs, $cap)
  $st = nil
  try
    $st = stat($abs, {follow_symlinks: false})
  catch $message
    return {problem: {rule: "file-type", text: "missing or unreadable"}}
  end
  if $st.is_symlink then
    return {problem: {rule: "symlink", text: "symlink"}}
  end
  if not $st.is_file then
    return {problem: {rule: "file-type", text: "not a regular file"}}
  end
  -- A symlinked parent directory reaches outside the tree the same way.
  $real = nil
  try
    $real = realpath($abs)
  catch $message
    return {problem: {rule: "file-type", text: "missing or unreadable"}}
  end
  if $real != $abs then
    return {problem: {rule: "symlink", text: "symlink"}}
  end
  $over = {problem: {rule: "file-size", text: "over " .. to_string($cap) .. " bytes"}}
  if $st.size > $cap then
    return $over
  end
  $bytes = read_file_bytes($abs, $cap + 1)
  if bytes_len($bytes) > $cap then
    return $over
  end
  return {bytes: $bytes}
end

fn scan_file($file)
  global $old_files
  $read = read_regular($scan_root .. "/" .. $file, $limits.max_file_bytes)
  if $read.problem != nil then
    record_hit($file, 1, $read.problem.rule, $read.problem.text)
    return
  end
  $bytes = $read.bytes
  $source = bytes_to_string($bytes, {lossy: true})
  $is_text = text_data($file, $bytes, $source)
  -- Old spellings are forbidden anywhere, including comments and docs.
  if not has_key($old_files, $file) then
    $old_files[$file] = true
    old_hits($file, 1, $source, $is_text)
  end
  if ends_with($file, ".rs") then
    scan_rust($file, $source)
  elif data_file($file) then
    -- Binary assets still get byte-wise old-name recognition, but no line
    -- splitting/path scan. Fonts and images are not unit or text templates.
    if $is_text then scan_data($file, $source, "data") end
  end
end

-- Units by suffix; tmpfiles and sysusers by directory or exact file name.
fn data_file($file)
  return starts_with($file, "share/") or (starts_with($file, "apps/") and ends_with($file, ".mix")) or re_match($file, '\.(service|socket|slice|timer|target|path|mount|automount|swap|device|desktop)$|(^|/)(?:tmpfiles|sysusers)\.d/|(^|/)(?:[^/]+\.)?(?:tmpfiles|sysusers)\.conf$')
end

fn text_data($file, $bytes, $source)
  if re_match(lower($file), '\.(png|jpg|jpeg|gif|webp|ico|ttf|otf|woff2?|gz|zip|zst)$') then return false end
  if contains($source, chr(0)) then return false end
  try
    return not contains(bytes_to_string($bytes), chr(0))
  catch $message
    return false
  end
end

-- NUL-separated output of $argv as a list of raw byte strings. The output
-- goes to a private file, so a non-UTF-8 name never reaches a string. A
-- listing over $hard.listing_bytes is refused before it is read.
fn nul_listing($argv)
  $tmp = trim(run_argv_must(["mktemp", "-d", "/var/tmp/prefix-list-XXXXXX"]))
  try
    $r = run_argv($argv, {timeout: 600, stdout: {file: $tmp .. "/list"}})
    if not $r.ok then
      raise("CAPTURE", $argv[0] .. " listing failed: " .. $r.stderr)
    end
    $size = stat($tmp .. "/list", {follow_symlinks: false}).size
    if $size > $hard.listing_bytes then
      raise("CAPTURE", $argv[0] .. " listing is over " .. to_string($hard.listing_bytes) .. " bytes")
    end
    $raw = read_file_bytes($tmp .. "/list", $hard.listing_bytes + 1)
  finally
    run_argv_must(["rm", "-rf", "--", $tmp])
  end
  return filter(bytes_split($raw, 0), fn($b) = bytes_len($b) > 0)
end

-- {mode, path, bad_name} per `git ls-files -s -z` entry.
fn parse_entries($pieces)
  $out = []
  for $piece in $pieces
    $tab = bytes_find($piece, 9)
    if $tab < 0 then
      raise("CAPTURE", "malformed git ls-files -s entry")
    end
    $mode = split(bytes_to_string(slice($piece, 0, $tab)), " ")[0]
    $name_bytes = slice($piece, $tab + 1)
    $name = nil
    try
      $name = bytes_to_string($name_bytes)
    catch $message
      $name = nil
    end
    push($out, {mode: $mode, path: $name ?? bytes_to_string($name_bytes, {lossy: true}), bad_name: $name == nil})
  end
  return $out
end

fn scan_tree($dir)
  global $scan_root
  $scan_root = $dir
  $seen = {}
  for $e in parse_entries(nul_listing(["git", "-C", $dir, "ls-files", "-s", "-z"]))
    if has_key($seen, $e.path) then continue end
    $seen[$e.path] = true
    if $e.bad_name then
      record_hit($e.path, 1, "file-name", "non-UTF-8 name")
    elif $e.mode == "120000" then
      record_hit($e.path, 1, "symlink", "symlink")
    elif $e.mode == "160000" then
      -- A submodule is an unscanned subtree: visible, never read.
      record_hit($e.path, 1, "gitlink", "submodule")
    elif has_key($policy.excluded_files, $e.path) then
      continue
    else
      scan_file($e.path)
    end
  end
end

fn identity($f)
  return json_encode([$f.file, $f.rule, $f.text])
end

fn finding_line($f)
  return shown($f.file) .. ":" .. to_string($f.line) .. " " .. $f.rule .. " " .. shown($f.text)
end

fn summary($fs, $off)
  $counts = {}
  $totals = {}
  for $f in concat($fs, $off)
    $p = split($f.file, "/")
    $crate = len($p) > 1 ? join(slice($p, 0, 2), "/") : $p[0]
    $label = ($f.disabled ?? false) ? "DISABLED " .. $f.rule : $f.rule
    $key = shown($crate) .. " | " .. $label
    if not ($f.disabled ?? false) then
      $counts[$key] = ($counts[$key] ?? 0) + 1
    end
    $totals[$label] = ($totals[$label] ?? 0) + 1
  end
  print("crate/scope | rule | hits")
  print("--- | --- | ---")
  for $k in sort(keys($counts))
    print($k .. " | " .. to_string($counts[$k]))
  end
  for $k in sort(keys($totals))
    print("TOTAL | " .. $k .. " | " .. to_string($totals[$k]))
  end
end

-- A selftest fixture: resolved, inside the fixture directory, regular and
-- within the size limit.
fn fixture_source($dir, $name)
  $base = realpath($dir)
  $abs = realpath($dir .. "/" .. $name)
  if $base == nil or $abs == nil or not starts_with($abs, $base .. "/") then
    raise("SELFTEST_FIXTURE", "fixture outside " .. $dir .. ": " .. shown($name))
  end
  $read = read_regular($abs, $limits.max_file_bytes)
  if $read.problem != nil then
    raise("SELFTEST_FIXTURE", "fixture " .. shown($name) .. ": " .. $read.problem.text)
  end
  return bytes_to_string($read.bytes)
end

fn reset_scan()
  global $findings, $prefix_hits, $seen_includes, $scanned_rust, $disabled_findings, $old_files
  $findings = []
  $prefix_hits = 0
  $seen_includes = {}
  $scanned_rust = {}
  $disabled_findings = []
  $old_files = {}
end

fn selftest()
  global $findings, $disabled_findings
  $cases = data_parse(control_text($support .. "/cases.conf.mix"))
  $deferred_rules = map($policy.disabled_rules, fn($d) = $d.rule)
  for $c in $cases.cases
    reset_scan()
    $source = fixture_source($support, $c.fixture)
    old_hits($c.file, 1, $source)
    if ends_with($c.file, ".rs") then
      scan_rust($c.file, $source)
    elif data_file($c.file) then
      scan_data($c.file, $source, "data")
    end
    -- Dedicated deferred-rule cases follow policy activation. Other fixtures
    -- assert their own rules even when they also contain a deferred spelling.
    $rules = []
    for $f in $findings
      if has_key($c, "disabled") or not contains($deferred_rules, $f.rule) then
        push($rules, $f.rule)
      end
    end
    $expected = $c.rules
    for $rule in $c.disabled ?? []
      if not has_key($disabled, $rule) then push($expected, $rule) end
    end
    if not deep_eq(sort($rules), sort($expected)) then
      eprint("FAIL " .. $c.fixture .. " as " .. $c.file .. ": " .. json_encode($findings))
      exit(1)
    end
    if has_key($c, "texts") then
      $texts = map(filter($findings, fn($f) = not contains($deferred_rules, $f.rule)), fn($f) = $f.text)
      if not deep_eq(sort($texts), sort($c.texts)) then
        eprint("FAIL " .. $c.fixture .. " texts: " .. json_encode($findings))
        exit(1)
      end
    end
    $expected_disabled = filter($c.disabled ?? [], fn($rule) = has_key($disabled, $rule))
    if has_key($c, "disabled") and not deep_eq(sort(map($disabled_findings, fn($f) = $f.rule)), sort($expected_disabled)) then
      raise("SELFTEST", "disabled findings mismatch: " .. $c.fixture)
    end
  end
  comparison_selftest()
  integration_selftest()
  print("prefix_gate selftest: " .. to_string(len($cases.cases)) .. " cases and the integration checks passed")
end

fn expect_raise($code, $f)
  try
    $f()
  catch $message, $error
    return $error.code == $code
  end
  return false
end

fn comparison_selftest()
  $base = {a: 2, b: 1}
  for $c in [{now: {a: 2, b: 1, c: 1}, bad: ["c"]}, {now: {a: 3, b: 1}, bad: ["a"]}, {now: {a: 2}, bad: []}, {now: {a: 1, b: 1}, bad: []}, {now: {a: 2, b: 1, c: 0}, bad: ["c"]}]
    if not deep_eq($baseline.growth($c.now, $base), $c.bad) then
      raise("SELFTEST", "baseline shrink arithmetic failed")
    end
  end
  $k1 = json_encode(["x/old.rs", "rust-path", "/opt/a"])
  $k2 = json_encode(["x/f.rs", "rust-path", "/opt/b"])
  $moved = json_encode(["y/new.rs", "rust-path", "/opt/a"])
  $retext = json_encode(["y/new.rs", "rust-path", "/opt/c"])
  $other = json_encode(["z/two.rs", "rust-path", "/opt/a"])
  $base = {}
  $base[$k1] = 1
  $base[$k2] = 2
  $now = {}
  $now[$moved] = 1
  $now[$k2] = 2
  $e = $baseline.explained($now, $base)
  if len($e.growth) != 0 or len($e.relocations) != 1 or $e.relocations[0].from != $k1 or $e.relocations[0].to != $moved then
    raise("SELFTEST", "a same-rule, same-text, equal-count move was not a relocation")
  end
  $now[$moved] = 2
  if not deep_eq($baseline.explained($now, $base).growth, [$moved]) then
    raise("SELFTEST", "a relocation with a raised count was accepted")
  end
  $now = {}
  $now[$retext] = 1
  $now[$k2] = 2
  if not deep_eq($baseline.explained($now, $base).growth, [$retext]) then
    raise("SELFTEST", "a re-texted key was accepted as a relocation")
  end
  $now = {}
  $now[$moved] = 1
  $now[$other] = 1
  $now[$k2] = 2
  $e = $baseline.explained($now, $base)
  if len($e.growth) != 1 or len($e.relocations) != 1 then
    raise("SELFTEST", "one disappeared key explained two new keys")
  end
  $now = {}
  $now[$k1] = 1
  $now[$k2] = 3
  if not deep_eq($baseline.explained($now, $base).growth, [$k2]) then
    raise("SELFTEST", "a raised count was explained away")
  end
  $sample = [{file: "a", rule: "x", text: "v"}, {file: "a", rule: "x", text: "v"}, {file: "b", rule: "x", text: "v", disabled: true}]
  $counted = $baseline.counts($sample)
  if len(keys($counted)) != 1 or $counted[json_encode(["a", "x", "v"])] != 2 then
    raise("SELFTEST", "occurrence counting included a disabled rule or lost a duplicate")
  end
  if not elf_file(chr(127) .. "ELF") or elf_file("text") then
    raise("SELFTEST", "ELF magic classification failed")
  end
  $ctl = "a" .. chr(27) .. "[31m\nb" .. chr(155) .. chr(8238)
  if re_match(shown($ctl), $unsafe_chars) or shown("plain/name.rs") != "plain/name.rs" then
    raise("SELFTEST", "control characters reached printed output")
  end
end

fn elf_file($head)
  return $head == chr(127) .. "ELF"
end

-- $lossy_ok: strings output may carry high-bit bytes; the patterns are ASCII,
-- so a lossy decode loses nothing they could match.
fn complete_capture($r, $label, $lossy_ok = false)
  if not $r.ok or $r.stdout_truncated or (not $lossy_ok and ($r.utf8_lossy ?? false)) then
    raise("CAPTURE", $label .. " failed, truncated or was not UTF-8: " .. $r.stderr)
  end
  return $r.stdout
end

-- True for a regular ELF file. A file that vanished or became unreadable
-- between the listing and here is a file-type finding, not a crash.
fn snapshot_elf($name, $bin)
  try
    $st = stat($bin, {follow_symlinks: false})
    if $st.is_symlink or not $st.is_file then
      return false
    end
    return elf_file(bytes_to_string(read_file_bytes($bin, 4), {lossy: true}))
  catch $message
    record_hit($name, 1, "file-type", "missing or unreadable")
    return false
  end
end

fn scan_snapshot($dir)
  for $raw in nul_listing(["find", "-P", $dir, "-type", "f", "-print0"])
    $bin = nil
    try
      $bin = bytes_to_string($raw)
    catch $message
      record_hit(bytes_to_string($raw, {lossy: true}), 1, "file-name", "non-UTF-8 name")
      continue
    end
    $name = slice($bin, len($dir) + 1)
    if not snapshot_elf($name, $bin) then
      continue
    end
    -- strings reads the whole file: the same regular-file and size checks.
    $read = read_regular($bin, $limits.max_snapshot_bytes)
    if $read.problem != nil then
      record_hit($name, 1, $read.problem.rule, $read.problem.text)
      continue
    end
    $s = complete_capture(run_argv(["strings", "-a", $bin], {max_output: $limits.max_snapshot_bytes}), "strings", true)
    scan_data($name, $s, "snapshot")
    old_hits($name, 1, $s)
  end
end

fn git_fixture($repo, $argv)
  return run_argv_must(concat(["git", "-C", $repo, "-c", "user.name=Gate Fixture", "-c", "user.email=user@example.org", "-c", "commit.gpgsign=false"], $argv))
end

fn git_commit($repo, $message)
  git_fixture($repo, ["add", "-A"])
  git_fixture($repo, ["commit", "-q", "--allow-empty", "-m", $message])
  return trim(git_fixture($repo, ["rev-parse", "HEAD"]))
end

fn baseline_selftest($tmp)
  $path = $tmp .. "/baseline.json"
  write_file($path, json_encode({b: 2, a: 2}))
  if not expect_raise("BASELINE_GROWTH", fn() = update_baseline_file($path, {a: 3, b: 2}, false)) then
    raise("SELFTEST", "updater accepted count growth")
  end
  update_baseline_file($path, {a: 1}, false)
  if read_file($path) != json_encode({a: 1}, true) .. "\n" then raise("SELFTEST", "unstable baseline output") end
  update_baseline_file($path, {b: 3, a: 2}, true)
  if read_file($path) != json_encode({a: 2, b: 3}, true) .. "\n" then raise("SELFTEST", "growth override or sorting failed") end
  -- A symlinked baseline is refused and its target is never written.
  write_file($tmp .. "/victim.txt", "untouched")
  run_argv_must(["ln", "-s", $tmp .. "/victim.txt", $tmp .. "/linked.json"])
  if not expect_raise("CONTROL", fn() = update_baseline_file($tmp .. "/linked.json", {}, true)) or read_file($tmp .. "/victim.txt") != "untouched" then
    raise("SELFTEST", "the updater followed a symlinked baseline")
  end
  $k1 = json_encode(["x/old.rs", "rust-path", "/opt/a"])
  $k2 = json_encode(["x/f.rs", "rust-path", "/opt/b"])
  $moved = json_encode(["y/new.rs", "rust-path", "/opt/a"])
  $grown = json_encode(["x/f.rs", "rust-path", "/opt/new"])
  $b0 = {}
  $b0[$k1] = 1
  $b0[$k2] = 2
  $b1 = {}
  $b1[$moved] = 1
  $b1[$k2] = 2
  $b2 = {}
  $b2[$k1] = 1
  $b2[$k2] = 2
  $b2[$grown] = 1
  $file = "/tools/prefix-baseline.json"

  $repo = $tmp .. "/repo"
  run_argv_must(["git", "init", "-q", "-b", "main", $repo])
  if not expect_raise("BASELINE_BASE", fn() = check_repo($repo)) then
    raise("SELFTEST", "an unborn repository did not fail closed")
  end
  $a = git_commit($repo, "fixture base")
  git_fixture($repo, ["update-ref", "refs/remotes/origin/main", "HEAD"])
  mkdir($repo .. "/tools")
  write_file($repo .. $file, json_encode($b0))
  -- A push to main of a root commit: merge base is HEAD with no parent.
  if not expect_raise("BASELINE_BASE", fn() = check_repo($repo)) then
    raise("SELFTEST", "merge base HEAD without a parent did not fail closed")
  end
  git_fixture($repo, ["checkout", "-q", "-b", "topic"])
  $b = git_commit($repo, "fixture baseline")
  $r = check_repo($repo)
  if not $r.introduced or $r.base != $a then raise("SELFTEST", "initial introduction was rejected") end
  git_fixture($repo, ["update-ref", "refs/remotes/origin/main", $b])
  write_file($repo .. "/other.txt", "unrelated")
  $c = git_commit($repo, "fixture branch work")
  $cases = [{now: $b2, growth: [$grown]}, {now: {}, growth: []}, {now: $b1, growth: []}]
  $raised = {}
  $raised[$k1] = 1
  $raised[$k2] = 3
  push($cases, {now: $raised, growth: [$k2]})
  for $case in $cases
    write_file($repo .. $file, json_encode($case.now))
    $r = check_repo($repo)
    if $r.how != "merge base" or $r.base != $b or not deep_eq($r.growth, $case.growth) then
      raise("SELFTEST", "branch comparison against the merge base failed: " .. json_encode($r))
    end
  end
  write_file($repo .. $file, json_encode($b1))
  if len(check_repo($repo).relocations) != 1 then raise("SELFTEST", "relocation was not reported") end
  -- A local run: the push-range variable is unset, env() gives "".
  if check_repo($repo, env("PREFIX_GATE_SELFTEST_UNSET_VARIABLE")).how != "merge base" then
    raise("SELFTEST", "an unset push range variable changed the base")
  end
  -- Push to main: the pushed commit grows the baseline and is origin/main.
  write_file($repo .. $file, json_encode($b2))
  $c2 = git_commit($repo, "fixture growth")
  git_fixture($repo, ["update-ref", "refs/remotes/origin/main", "HEAD"])
  $r = check_repo($repo)
  if $r.how != "first parent" or $r.base != $c or not deep_eq($r.growth, [$grown]) then
    raise("SELFTEST", "a push to main compared the baseline with itself: " .. json_encode($r))
  end
  -- A two-commit push hides growth from HEAD^; github.event.before does not.
  write_file($repo .. "/other.txt", "more")
  $d = git_commit($repo, "fixture follow-up")
  git_fixture($repo, ["update-ref", "refs/remotes/origin/main", "HEAD"])
  if len(check_repo($repo).growth) != 0 then raise("SELFTEST", "first-parent fallback changed") end
  $r = check_repo($repo, $b)
  if $r.how != "push range" or not deep_eq($r.growth, [$grown]) then
    raise("SELFTEST", "the push range base was not used: " .. json_encode($r))
  end
  -- A force-pushed range (before is not an ancestor) fails closed.
  $orphan = trim(git_fixture($repo, ["commit-tree", "HEAD^{tree}", "-m", "orphan"]))
  if not expect_raise("BASELINE_BASE", fn() = check_repo($repo, $orphan)) then
    raise("SELFTEST", "a non-ancestor push range base fell back to the first parent")
  end
  for $before in ["0000000000000000000000000000000000000000", $d, "not-a-sha"]
    if check_repo($repo, $before).how != "first parent" then
      raise("SELFTEST", "an absent push range base was not ignored: " .. $before)
    end
  end
  -- The base copy is capped; an in-tree symlink is refused before parsing.
  if not expect_raise("BASELINE_BASE", fn() = $baseline.check_base($repo, "", {}, 8)) then
    raise("SELFTEST", "an over-cap base baseline was read")
  end
  run_argv_must(["rm", "--", $repo .. $file])
  run_argv_must(["ln", "-s", "/dev/zero", $repo .. $file])
  if not expect_raise("CONTROL", fn() = check_repo($repo)) then
    raise("SELFTEST", "a symlinked in-tree baseline was read")
  end
end

fn update_baseline_file($path, $now, $allow_growth)
  return $baseline.update($path, $now, $allow_growth, load_baseline_file($path))
end

fn control_selftest($tmp)
  global $hard
  $dir = $tmp .. "/control"
  mkdir($dir)
  $policy_text = control_text($root .. "/tools/prefix.conf.mix")
  write_file($dir .. "/policy.conf.mix", $policy_text)
  if load_policy($dir .. "/policy.conf.mix").limits.max_file_bytes != $limits.max_file_bytes then
    raise("SELFTEST", "a copied policy did not load")
  end
  run_argv_must(["ln", "-s", $dir .. "/policy.conf.mix", $dir .. "/linked.conf.mix"])
  run_argv_must(["ln", "-s", "/dev/zero", $dir .. "/zero.json"])
  if not expect_raise("CONTROL", fn() = load_policy($dir .. "/linked.conf.mix")) then
    raise("SELFTEST", "a symlinked policy was read")
  end
  if not expect_raise("CONTROL", fn() = load_baseline_file($dir .. "/zero.json")) then
    raise("SELFTEST", "a symlinked baseline was read")
  end
  for $k in ["max_file_bytes", "max_snapshot_bytes"]
    $bad = re_replace($policy_text, '"' .. $k .. '": [0-9]+', '"' .. $k .. '": ' .. to_string($hard[$k] + 1))
    if $bad == $policy_text then raise("SELFTEST", "policy fixture edit missed " .. $k) end
    write_file($dir .. "/raised.conf.mix", $bad)
    if not expect_raise("POLICY", fn() = load_policy($dir .. "/raised.conf.mix")) then
      raise("SELFTEST", "a policy raised " .. $k .. " past the hard bound")
    end
  end
  $saved = $hard
  try
    $hard.control_bytes = 64
    $refused = expect_raise("CONTROL", fn() = load_policy($dir .. "/policy.conf.mix"))
  finally
    $hard = $saved
  end
  if not $refused then raise("SELFTEST", "an oversize control file was parsed") end
  -- The listing itself is capped.
  $saved = $hard
  try
    $hard.listing_bytes = 16
    $refused = expect_raise("CAPTURE", fn() = nul_listing(["git", "-C", $root, "ls-files", "-z", "--", "tools"]))
  finally
    $hard = $saved
  end
  if not $refused then raise("SELFTEST", "an over-cap listing was read") end
end

fn tree_selftest($tmp)
  global $limits, $findings, $disabled_findings, $scan_root
  $repo = $tmp .. "/tree"
  run_argv_must(["git", "init", "-q", "-b", "main", $repo])
  write_file($repo .. "/ok.rs", "const P: &str = \"/opt/fixture\";\n")
  $ctl = "ctl" .. chr(27) .. "[31m\nname.rs"
  write_file($repo .. "/" .. $ctl, "const P: &str = \"/opt/control\";\n")
  write_file($repo .. "/big.txt", "/opt/never-read padding padding padding padding padding padding padding padding\n")
  write_file($repo .. "/swap.rs", "const P: &str = \"/opt/swapped\";\n")
  run_argv_must(["ln", "-s", "/dev/zero", $repo .. "/evil.rs"])
  run_argv_must(["mkdir", $repo .. "/linkdir"])
  write_file($repo .. "/linkdir/inner.rs", "const P: &str = \"/opt/inner\";\n")
  $first = git_commit($repo, "fixture tree")
  git_fixture($repo, ["update-index", "--add", "--cacheinfo", "160000," .. $first .. ",submodule"])
  $patch = 'diff --git "a/bad\377.rs" "b/bad\377.rs"' .. "\nnew file mode 100644\n--- /dev/null\n" .. '+++ "b/bad\377.rs"' .. "\n@@ -0,0 +1 @@\n+x\n"
  write_file($tmp .. "/name.diff", $patch)
  git_fixture($repo, ["apply", "--cached", $tmp .. "/name.diff"])
  -- Working-tree swaps after checkout: a tracked file and a tracked
  -- directory replaced by symlinks reaching outside the tree.
  run_argv_must(["rm", "--", $repo .. "/swap.rs"])
  run_argv_must(["ln", "-s", "/proc/self/environ", $repo .. "/swap.rs"])
  run_argv_must(["mv", "--", $repo .. "/linkdir", $tmp .. "/outside"])
  run_argv_must(["ln", "-s", $tmp .. "/outside", $repo .. "/linkdir"])
  $saved = $limits
  $saved_root = $scan_root
  reset_scan()
  try
    $limits.max_file_bytes = 64
    scan_tree($repo)
  finally
    $limits = $saved
    $scan_root = $saved_root
  end
  $got = sort(map($findings, fn($f) = $f.rule .. " " .. $f.file))
  $want = sort(["rust-path ok.rs", "rust-path " .. $ctl, "file-size big.txt", "symlink evil.rs", "symlink swap.rs", "symlink linkdir/inner.rs", "file-name bad" .. chr(65533) .. ".rs", "gitlink submodule"])
  if not deep_eq($got, $want) then
    raise("SELFTEST", "tree scan input safety failed: " .. shown(json_encode($got)))
  end
  for $f in $findings
    if re_match(finding_line($f), $unsafe_chars) then
      raise("SELFTEST", "a control character in a file name reached the output")
    end
  end
  -- --json output: C1 controls and bidi overrides, which JSON leaves raw.
  $odd = {file: "c1" .. chr(155) .. "bidi" .. chr(8238) .. ".rs", line: 1, rule: "rust-path", text: "/opt/" .. chr(8233)}
  if re_match(json_output(concat($findings, [$odd])), $unsafe_chars) then
    raise("SELFTEST", "a control character reached the --json output")
  end
end

-- --json: names and matched text get the same escaping as the summary.
fn json_output($fs)
  return json_encode(map($fs, fn($f) = {file: shown($f.file), line: $f.line, rule: $f.rule, text: shown($f.text), disabled: $f.disabled ?? false}))
end

fn fixture_selftest($tmp)
  global $limits
  if not expect_raise("SELFTEST_FIXTURE", fn() = fixture_source($support, "../../../../dev/zero")) then
    raise("SELFTEST", "fixture path escape was accepted")
  end
  $dir = $tmp .. "/fixtures"
  mkdir($dir)
  write_file($dir .. "/ok.txt", "fixture")
  write_file($dir .. "/large.txt", "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0")
  run_argv_must(["ln", "-s", "/dev/zero", $dir .. "/zero.txt"])
  run_argv_must(["ln", "-s", "../baseline.json", $dir .. "/alias.txt"])
  if fixture_source($dir, "ok.txt") != "fixture" then raise("SELFTEST", "a contained fixture was refused") end
  for $bad in ["zero.txt", "alias.txt", "../fixtures/../baseline.json"]
    if not expect_raise("SELFTEST_FIXTURE", fn() = fixture_source($dir, $bad)) then
      raise("SELFTEST", "fixture escape or symlink was accepted: " .. $bad)
    end
  end
  $saved = $limits
  try
    $limits.max_file_bytes = 64
    $refused = expect_raise("SELFTEST_FIXTURE", fn() = fixture_source($dir, "large.txt"))
  finally
    $limits = $saved
  end
  if not $refused then raise("SELFTEST", "an oversize fixture was read") end
end

fn snapshot_selftest($tmp)
  global $findings, $disabled_findings, $limits
  reset_scan()
  $snap = $tmp .. "/snapshot"
  mkdir($snap)
  $elf = $snap .. "/libfixture\n.so"
  write_file($elf, read_file_bytes("/usr/bin/true"))
  append_file($elf, chr(0) .. "/opt/fixture" .. chr(0) .. "cosmix" .. chr(0))
  chmod($elf, 0o644)
  write_file($snap .. "/text.txt", "/opt/fixture")
  -- find -P: a symlink to an ELF outside the snapshot is not followed.
  $outside = $tmp .. "/outside.so"
  write_file($outside, read_file_bytes("/usr/bin/true"))
  append_file($outside, chr(0) .. "/opt/outside" .. chr(0))
  run_argv_must(["ln", "-s", $outside, $snap .. "/link.so"])
  scan_snapshot($snap)
  if not deep_eq(sort(map($findings, fn($f) = $f.rule)), ["old-name", "snapshot-path"]) or contains(json_encode($findings), "outside") then
    raise("SELFTEST", "non-executable ELF snapshot failed: " .. shown(json_encode($findings)))
  end
  reset_scan()
  $saved = $limits
  try
    $limits.max_snapshot_bytes = 1024
    scan_snapshot($snap)
  finally
    $limits = $saved
  end
  if not deep_eq(map($findings, fn($f) = $f.rule), ["file-size"]) then
    raise("SELFTEST", "an oversize snapshot ELF reached strings: " .. shown(json_encode($findings)))
  end
  -- A file listed by find but gone before stat.
  reset_scan()
  if snapshot_elf("gone.so", $snap .. "/gone.so") or not deep_eq(map($findings, fn($f) = $f.rule), ["file-type"]) then
    raise("SELFTEST", "a vanished snapshot file was not a file-type finding")
  end
  reset_scan()
end

fn integration_selftest()
  global $findings, $disabled_findings, $disabled
  $tmp = realpath(trim(run_argv_must(["mktemp", "-d", "/var/tmp/prefix-selftest-XXXXXX"])))
  try
    baseline_selftest($tmp)
    control_selftest($tmp)
    tree_selftest($tmp)
    fixture_selftest($tmp)
    snapshot_selftest($tmp)
    $findings = []
    $disabled_findings = []
    $saved = $disabled
    $disabled["bare-mixos"] = "selftest disabled state"
    old_hits("fixture.txt", 1, "mixos")
    if len($findings) != 0 or len($disabled_findings) != 1 then raise("SELFTEST", "disabled rule failed") end
    $disabled = {}
    old_hits("fixture.txt", 1, "mixos")
    $disabled = $saved
    if len($findings) != 1 then raise("SELFTEST", "enabling deferred rule failed") end
    $findings = []
    $disabled_findings = []
    for $partial in [{ok: true, stdout_truncated: true, stderr: ""}, {ok: true, stdout_truncated: false, utf8_lossy: true, stderr: ""}]
      if not expect_raise("CAPTURE", fn() = complete_capture($partial, "find")) then
        raise("SELFTEST", "incomplete listing was accepted")
      end
    end
    -- The real process path: run_argv's own max_output and lossy flags.
    $r = run_argv(["printf", "%s", "0123456789"], {max_output: 4})
    if $r.stdout != "0123" or not expect_raise("CAPTURE", fn() = complete_capture($r, "printf")) then
      raise("SELFTEST", "a real truncated capture was accepted")
    end
    $r = run_argv(["printf", "\\377"])
    if not expect_raise("CAPTURE", fn() = complete_capture($r, "printf")) then
      raise("SELFTEST", "a real non-UTF-8 capture was accepted")
    end
    -- strings output: high-bit bytes decode lossily instead of failing.
    if complete_capture(run_argv(["printf", "/opt/x\\377"]), "strings", true) != "/opt/x" .. chr(65533) then
      raise("SELFTEST", "lossy strings output was refused or mangled")
    end
    if complete_capture(run_argv(["printf", "%s", "0123"], {max_output: 4}), "printf") != "0123" then
      raise("SELFTEST", "a capture exactly at max_output was refused")
    end
    $bytes = read_file_bytes("/usr/bin/true")
    if text_data("share/font.bin", $bytes, bytes_to_string($bytes, {lossy: true})) then raise("SELFTEST", "binary data classified as text") end
  finally
    run_argv_must(["rm", "-rf", "--", $tmp])
  end
end

if len($o.rest) > 0 then
  if $o.rest[0] != "selftest" then
    exit(1)
  end
  selftest()
  exit(0)
end

if $o.opts["check-baseline"] then
  -- GitHub sets PREFIX_GATE_BEFORE to github.event.before on a push.
  $b = check_repo($root, env("PREFIX_GATE_BEFORE"))
  for $m in $b.relocations
    print("prefix baseline relocation: " .. shown($m.from) .. " -> " .. shown($m.to))
  end
  for $k in $b.growth
    eprint("prefix baseline grew relative to " .. $b.how .. ": " .. shown($k))
  end
  print("prefix baseline: base " .. $b.base .. " (" .. $b.how .. ")" .. ($b.introduced ? "; initial introduction allowed" : "; shrink-only") .. "; " .. to_string(len($b.relocations)) .. " relocations; " .. to_string(len($b.growth)) .. " growth entries")
  exit(len($b.growth) > 0 ? 1 : 0)
end

if $o.opts.snapshot != nil then
  $dir = realpath($o.opts.snapshot)
  if $dir == nil or not is_dir($dir) then raise("SNAPSHOT", "snapshot directory does not exist") end
  scan_snapshot($dir)
else
  scan_tree($root)
end

if $o.opts["update-baseline"] then
  $e = update_baseline_file($root .. "/tools/prefix-baseline.json", $baseline.counts($findings), $o.opts["allow-growth"])
  for $m in $e.relocations
    print("relocated: " .. shown($m.from) .. " -> " .. shown($m.to))
  end
  for $k in $e.growth
    print("grown (CI will refuse this): " .. shown($k))
  end
  print("updated tools/prefix-baseline.json")
  exit(0)
end

$failed = len($findings) > 0
if not $o.opts.strict and $o.opts.snapshot == nil then
  $base = load_baseline_file($root .. "/tools/prefix-baseline.json")
  $now = $baseline.counts($findings)
  $failed = false
  for $k in sort(keys($now))
    if $now[$k] > ($base[$k] ?? 0) then
      eprint("prefix regression: " .. shown($k))
      $failed = true
    end
  end
  for $k in sort(keys($base))
    if not has_key($now, $k) or $now[$k] < $base[$k] then
      eprint("stale prefix baseline: " .. shown($k) .. "; shrink the baseline")
      $failed = true
    end
  end
end
if $o.opts.json then
  print(json_output(concat($findings, $disabled_findings)))
else
  summary($findings, $disabled_findings)
  if $o.opts.snapshot != nil then
    for $f in $findings
      print(finding_line($f))
    end
  end
end
exit($failed ? 1 : 0)
