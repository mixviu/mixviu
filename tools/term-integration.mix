-- CBC preparation: return the worker's lockfile/format patch, then restore it.
$prepare_rc = 0
try
  for $cmd in [["cargo", "update", "--workspace"], ["cargo", "fmt", "--all"]]
    $r = run_argv($cmd, {timeout: 1800, stdout: "inherit", stderr: "inherit"})
    if $r.exit_code != 0 then
      $prepare_rc = $r.exit_code
      break
    end
  end
  print("TERM_INTEGRATION_PATCH_BEGIN")
  print(run_argv_must(["git", "diff"]))
  print("TERM_INTEGRATION_PATCH_END")
finally
  print(run_argv(["git", "checkout", "-q", "--", "."]))
end
exit($prepare_rc)
