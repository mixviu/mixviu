-- CBC-only final gates. The outer comp_oracle wrapper captures/restores locks.
$a = args()
if len($a) != 1 then raise("USAGE", "gate_comp_split.mix native|default|clippy") end
fn gate_run($command)
  print("STEP_BEGIN " .. join($command, " "))
  $r = run_argv(concat(["env", "CARGO_BUILD_JOBS=6"], $command), {timeout: 7000, max_output: 64000000})
  print($r.stdout)
  print($r.stderr)
  print("STEP_RC=" .. to_string($r.exit_code) .. " " .. join($command, " "))
  if $r.exit_code != 0 then exit($r.exit_code) end
end
if $a[0] == "native" then
  $features = "backend-native,backend-headless"
  gate_run(["cargo", "build", "-p", "compd", "--no-default-features", "--features", $features, "--locked"])
  $tree = run_argv(["cargo", "tree", "-p", "compd", "--no-default-features", "--features", $features, "-e", "normal", "--locked"], {max_output: 64000000})
  print($tree.stderr)
  $matches = filter(lines($tree.stdout), fn($line) = contains($line, "egui"))
  print(join($matches, "\n"))
  print("EGUI_MATCH_LINES=" .. to_string(len($matches)))
  print("TREE_RC=" .. to_string($tree.exit_code))
  if $tree.exit_code != 0 or len($matches) != 0 then exit(1) end
  gate_run(["cargo", "test", "-p", "compd", "-p", "headless", "--no-default-features", "--features", "compd/backend-native,compd/backend-headless", "--locked"])
  -- These runtime tests start only owned headless children, never a VT/display.
  -- Broker/app-dependent and long timing tests retain their upstream ignores.
  if is_file("/dev/dri/renderD128") then
    print("HEADLESS_GPU_AVAILABLE=/dev/dri/renderD128")
    for $target in ["boot", "render_node", "feedback"]
      gate_run(["cargo", "test", "-p", "headless", "--test", $target, "--locked", "--", "--ignored", "--test-threads=1"])
    end
  else
    print("HEADLESS_GPU_SKIPPED=no renderD128 on worker; run refusal tests only")
    gate_run(["cargo", "test", "-p", "headless", "--test", "boot", "--locked", "--", "--ignored", "render_node_", "--test-threads=1"])
  end
elif $a[0] == "default" then
  gate_run(["cargo", "build", "-p", "compd", "--features", "backend-all", "--locked"])
  $cmd = ["cargo", "test", "--no-fail-fast", "--locked", "-p", "compd"]
  for $p in walk("engines/compd/crates")
    if ends_with($p, "/Cargo.toml") then push($cmd, "-p"); push($cmd, basename(dirname($p))) end
  end
  gate_run($cmd)
elif $a[0] == "clippy" then
  gate_run(["cargo", "fmt", "--all", "--", "--check"])
  gate_run(["cargo", "clippy", "-p", "compd", "--features", "backend-all", "--all-targets", "--locked"])
else
  raise("USAGE", "gate_comp_split.mix native|default|clippy")
end
