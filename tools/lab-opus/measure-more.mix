$root = "/tmp/mixviu-opus-l2-spike"
$bin = "tools/lab-opus/target/release/opus-spike"
fn invoke($args, $name)
  $r = run_argv($args, {timeout: 900, max_output: 1000000})
  write_file($root .. "/" .. $name .. ".log", json_encode($r))
  print($name .. " RC=" .. $r.exit_code .. " " .. $r.stdout .. $r.stderr)
  return $r
end
$build = invoke(["cargo", "build", "--release", "--manifest-path", "tools/lab-opus/Cargo.toml"], "build")
if not $build.ok then exit(1) end
if env("OPUS_SKIP_CONFORMANCE","")!="1" then
 print(run_argv_must(["/opt/mix/bin/mix","tools/lab-opus/conformance.mix"], {timeout:3600,max_output:4000000}))
end
for $signal in ["sweep", "bursts"]
  for $rate in [64000,96000,128000]
    $id = $signal .. "-" .. $rate
    $input = $root .. "/" .. $signal .. ".f32"
    $oracle = $root .. "/libopus-" .. $id
    for $repeat in [1,2,3]
      invoke([$bin, "measure", "ffmpeg", "-v", "error", "-y", "-f", "f32le", "-ar", "48000", "-ac", "2", "-i", $input, "-c:a", "libopus", "-b:a", to_string($rate), "-frame_duration", "20", $oracle .. ".ogg"], "oracle-encode-" .. $id .. "-" .. $repeat)
      invoke([$bin, "measure", "ffmpeg", "-v", "error", "-y", "-c:a", "libopus", "-i", $oracle .. ".ogg", "-f", "s16le", $oracle .. ".pcm"], "oracle-decode-" .. $id .. "-" .. $repeat)
    end
    for $candidate in ["rusty-opus", "opus-rs", "ruopus", "opus-decoder", "opus-pure", "cranpose-opus-pure", "hiraku-opus", "ps-rusty-opus", "mousiki", "oporus", "moosicbox_opus_native", "opuscule", "filmcraft-opus",  "opus-wave", "symphonia-opus", "oxideav-opus"]
      if env("OPUS_CANDIDATE","")!="" and $candidate!=env("OPUS_CANDIDATE") then continue end
      $out = $root .. "/" .. $candidate .. "-" .. $id
      for $repeat in [1,2,3]
        invoke([$bin, "measure", $bin, "decode", $candidate, "2", $oracle .. ".ogg", $out .. "-reverse.pcm"], $candidate .. "-reverse-" .. $id .. "-" .. $repeat)
        if not contains(["opus-decoder","symphonia-opus","moosicbox_opus_native","opuscule","filmcraft-opus"], $candidate) then
          $e = invoke([$bin, "measure", $bin, "encode", $candidate, to_string($rate), $input, $out .. ".ogg"], $candidate .. "-encode-" .. $id .. "-" .. $repeat)
          if $e.ok then invoke([$bin, "measure", "ffmpeg", "-v", "error", "-y", "-c:a", "libopus", "-i", $out .. ".ogg", "-f", "s16le", $out .. ".pcm"], $candidate .. "-forward-" .. $id .. "-" .. $repeat) end
        end
      end
      if is_file($out .. ".pcm") then invoke([$bin, "metrics", $input, $out .. ".pcm", $oracle .. ".pcm"], $candidate .. "-metrics-" .. $id) end
      if is_file($out .. "-reverse.pcm") then invoke([$bin, "metrics", $input, $out .. "-reverse.pcm", $oracle .. ".pcm"], $candidate .. "-reverse-metrics-" .. $id) end
    end
  end
end
