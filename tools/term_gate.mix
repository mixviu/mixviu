-- SPDX-License-Identifier: MIT OR Apache-2.0
-- Run on a CBC worker through cbc-build, never on the client machine.
$prepare=contains(args(),"--prepare")
$rc=0
try
  $mix_tests=run_argv(["/opt/mixos/bin/mix","apps/term/core-test.mix"]);print($mix_tests)
  if not $mix_tests.ok then exit($mix_tests.exit_code ?? 1) end
  $wire_tests=run_argv(["/opt/mixos/bin/mix","apps/term/wire-test.mix"]);print($wire_tests)
  if not $wire_tests.ok then exit($wire_tests.exit_code ?? 1) end
  $model_tests=run_argv(["/opt/mixos/bin/mix","apps/term/model-test.mix"]);print($model_tests)
  if not $model_tests.ok then exit($model_tests.exit_code ?? 1) end
  $layout_tests=run_argv(["/opt/mixos/bin/mix","apps/term/protected-layout-test.mix"]);print($layout_tests)
  if not $layout_tests.ok then exit($layout_tests.exit_code ?? 1) end
  $bus_tests=run_argv(["/opt/mixos/bin/mix","apps/term/bus-test.mix"]);print($bus_tests)
  if not $bus_tests.ok then exit($bus_tests.exit_code ?? 1) end
  $actions_tests=run_argv(["/opt/mixos/bin/mix","apps/term/actions-test.mix"]);print($actions_tests)
  if not $actions_tests.ok then exit($actions_tests.exit_code ?? 1) end
  $font_tests=run_argv(["/opt/mixos/bin/mix","apps/term/font-persistence-test.mix"]);print($font_tests)
  if not $font_tests.ok then exit($font_tests.exit_code ?? 1) end
  $clipboard_tests=run_argv(["/opt/mixos/bin/mix","apps/term/clipboard-test.mix"]);print($clipboard_tests)
  if not $clipboard_tests.ok then exit($clipboard_tests.exit_code ?? 1) end
  for $argv in [["cargo","fmt","-p","viu","--","--check"],["cargo","test","--locked","-p","viu","--test","term_bundle"],["cargo","test","--locked","-p","viu","--test","runtime","--test","calls","--test","timers"],["cargo","test","--locked","-p","viu","--lib","terminal::"],["cargo","test","--locked","-p","viu","--lib","input::tests::"],["cargo","test","--locked","-p","viu","--lib","editor_controls::"],["cargo","test","--locked","-p","viu","--lib","rich::tests::"]]
    if $prepare and $argv[1]=="fmt" then $argv=["cargo","fmt","-p","viu"] end
    if $prepare and $argv[1]=="test" then $argv=filter($argv,fn($v)=$v!="--locked") end
    $r=run_argv($argv,{timeout:1800,max_output:16000000});print($r)
    if not $r.ok then $rc=$r.exit_code ?? 124;break end
  end
  if $rc==0 then
    $foreign=run_argv(["/opt/mixos/bin/mix","tools/foreign_gate.mix","--locked"],{timeout:1800,max_output:16000000});print($foreign)
    if not $foreign.ok then $rc=$foreign.exit_code ?? 124 end
  end
  if $rc==0 then
    $host=run_argv(["cargo","build","--locked","-p","viu-engine","--bin","viu"],{timeout:1800,max_output:16000000});print($host)
    if not $host.ok then $rc=$host.exit_code ?? 124 end
  end
  if $rc==0 then
    $sha=trim(run_argv_must(["git","rev-parse","HEAD"]))
    $artifact="/build/term-artifacts/"..$sha
    mkdir($artifact,{parents:true})
    copy("target/debug/viu",$artifact.."/viu")
    write_file($artifact.."/viu.json",json_encode({source:$sha,profile:"debug",sha256:hash_file($artifact.."/viu","sha256")}))
    print({artifact:$artifact,profile:"debug",acceptance:false})
  end
finally
  print("TERM_PATCH_BEGIN")
  print(run_argv_must(["git","diff","--binary"]))
  print("TERM_PATCH_END")
  print(run_argv_must(["git","checkout","-q","--","."]))
end
exit($rc)
