-- CBC only; isolated clients, brokers and headless compositor.
fn inhibit_check($argv, $environment = {})
  print("STEP_BEGIN " .. join($argv, " "))
  $r = run_argv($argv, {timeout: 7200, max_output: 64000000, env: merge({CARGO_BUILD_JOBS: "6"}, $environment)})
  print($r.stdout)
  print($r.stderr)
  print("STEP_RC=" .. to_string($r.exit_code ?? 124))
  if not $r.ok then raise("INHIBIT_GATE", "step failed") end
end
inhibit_check(["cargo", "check", "--locked", "-p", "viud", "--features", "backend-all", "--all-targets"])
inhibit_check(["cargo", "test", "--locked", "-p", "world", "comp::blank"])
inhibit_check(["cargo", "test", "--locked", "-p", "comp-model"])
inhibit_check(["cargo", "test", "--locked", "-p", "testkit", "--test", "idle_inhibit"])
inhibit_check(["cargo", "build", "--locked", "-p", "mix", "--bin", "mix"])
inhibit_check(["cargo", "build", "--locked", "-p", "noded", "--bin", "noded"])
inhibit_check(["cargo", "build", "--locked", "-p", "viud", "--features", "backend-headless"])
inhibit_check(["cargo", "test", "--locked", "-p", "headless", "--test", "capture", "idle_inhibitor", "--", "--ignored", "--nocapture", "--test-threads=1"], {MIX_TEST_MIX_EXE: realpath("target/debug/mix")})
print("IDLE_INHIBIT_GATE_OK")
