-- Focused CBC regression recipe; always uses the interpreter from this tree.
fn run_step($argv)
  print(join($argv," "))
  $r=run_argv($argv,{stdout:"inherit",stderr:"inherit",timeout:14400})
  if $r.exit_code!=0 then exit($r.exit_code ?? 124) end
end
run_step(["cargo","build","--locked","-p","mix"])
run_step(["target/debug/mix","tools/ci.mix","fmt"])
run_step(["target/debug/mix","tools/ci.mix","env"])
run_step(["target/debug/mix","tools/ci.mix","mix-lint-baseline"])
run_step(["git","checkout","-q","--","tools/ci/mix-lint-baseline.json"])
run_step(["cargo","test","--locked","-p","lib-mix","--test","lint_viu"])
run_step(["cargo","test","--locked","-p","lib-mix","--test","lint_analyzer"])
run_step(["cargo","test","--locked","-p","lib-viu","--test","ced_bus","--test","ced_editor"])
run_step(["cargo","test","--locked","-p","lib-viu"])
run_step(["cargo","test","--locked","-p","viu"])
run_step(["cargo","test","--locked","-p","viu-dopus"])
for $p in split(trim(run_argv_must(["git","ls-files","apps/*-test.mix"])),"\n")
  run_step(["target/debug/mix",$p])
end
