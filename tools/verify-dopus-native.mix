-- version: 0.1.0
$root=dirname(dirname(script_path()))
$manifest=json_parse(read_file($root.."/provenance/dopus-native.json"))
for $file in $manifest.files
  if $file.removed ?? false then
    if exists($root.."/"..$file.destination) then raise("IMPORT_RESTORED_UNUSED",$file.destination) end
  else
    $actual=hash_file($root.."/"..$file.destination,"sha256")
    if $actual!=($file.adapted_sha256 ?? $file.imported_sha256) then raise("IMPORT_CHANGED",$file.destination) end
  end
end
print("Dopus native imports verified: "..to_string(len($manifest.files)))
