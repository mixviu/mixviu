-- Track A smoke: the shell-profile mix refuses a service builtin and names
-- mixd; mixd runs the same script; doctor reports each profile.
-- usage: mix tools/engine_split_smoke.mix MIX_BIN MIXD_BIN
$a = args()
$mix = $a[0]
$mixd = $a[1]
$dir = trim(run_argv_must(["mktemp", "-d"]))
$script = path_join($dir, "svc.mix")
write_file($script, "print(markdown(\"# hi\"))\n")
$fails = 0
fn check($label, $ok, $detail)
  $tag = if $ok then "PASS " else "FAIL " end
  print $tag .. $label .. " :: " .. $detail
  return if $ok then 0 else 1 end
end

$r = run_argv([$mix, $script], {timeout: 30})
$fails = $fails + check("mix refuses markdown and names mixd", not $r.ok and contains($r.stderr, "mixd run"), trim($r.stderr))
$r = run_argv([$mixd, "run", $script], {timeout: 30})
$fails = $fails + check("mixd run renders markdown", $r.ok and contains($r.stdout, "<h1>hi</h1>"), trim($r.stdout))
$r = run_argv([$mixd, $script], {timeout: 30})
$fails = $fails + check("mixd FILE equals mixd run FILE", $r.ok and contains($r.stdout, "<h1>hi</h1>"), trim($r.stdout))
$r = run_argv([$mix, "-c", "print(1 + 1)"], {timeout: 30})
$fails = $fails + check("mix -c still works", $r.ok and trim($r.stdout) == "2", trim($r.stdout))
$r = run_argv([$mixd, "-c", "print(udp_send != nil)"], {timeout: 30})
$fails = $fails + check("mixd -c works", $r.ok, trim($r.stdout .. $r.stderr))
$r = run_argv([$mixd, "--personalities"], {timeout: 30})
$fails = $fails + check("mixd --personalities", $r.ok and starts_with($r.stdout, "mixd "), trim($r.stdout))
$r = run_argv([$mixd, "run"], {timeout: 30})
$fails = $fails + check("mixd run without FILE is usage error", $r.exit_code == 2, trim($r.stderr))
-- handoff: a `host: mixd` script given to mix runs under mixd (mixd beside mix)
$declared = path_join($dir, "declared.mix")
write_file($declared, "-- host: mixd\nprint(markdown(\"# hand\"))\n")
$r = run_argv([$mix, $declared], {timeout: 30})
$fails = $fails + check("mix hands a host: mixd script to mixd", $r.ok and contains($r.stdout, "<h1>hand</h1>"), trim($r.stdout .. $r.stderr))
-- lint codes: D3025 no header, D3026 host mix, D3027 unknown host
$r = run_argv([$mix, "lint", $script], {timeout: 30})
$fails = $fails + check("lint D3025 for undeclared service builtin", contains($r.stdout .. $r.stderr, "MIX-D3025"), "")
$wrong = path_join($dir, "wrong.mix")
write_file($wrong, "-- host: mix\nprint(markdown(\"x\"))\n")
$r = run_argv([$mix, "lint", $wrong], {timeout: 30})
$fails = $fails + check("lint D3026 for host: mix with service builtin", contains($r.stdout .. $r.stderr, "MIX-D3026"), "")
$typo = path_join($dir, "typo.mix")
write_file($typo, "-- host: mixdd\nprint(1)\n")
$r = run_argv([$mix, "lint", $typo], {timeout: 30})
$fails = $fails + check("lint D3027 for unknown host", contains($r.stdout .. $r.stderr, "MIX-D3027"), "")
$r = run_argv([$mix, "lint", $declared], {timeout: 30})
$fails = $fails + check("lint quiet on host: mixd", not contains($r.stdout .. $r.stderr, "MIX-D302"), "")
for $pair in [[$mix, "shell (mix)"], [$mixd, "service (mixd)"]]
  $r = run_argv([$pair[0], "doctor"], {timeout: 60, env: {MIX_DOCTOR_SKIP_BUS: "1"}})
  $fails = $fails + check("doctor profile " .. $pair[1], contains($r.stdout, "profile    " .. $pair[1]), trim(join(filter(lines($r.stdout), fn($l) = contains($l, "profile")), " | ")))
end
remove_dir($dir)
print "SMOKE_FAILS=" .. to_string($fails)
exit(if $fails == 0 then 0 else 1 end)
