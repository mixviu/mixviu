-- LAB EVIDENCE ONLY: a pre-cut-over parity or engine-split driver, kept as
-- the record of those gates (tools/cutover_gate.mix is the four-engine gate).
-- Any compd or compd-oracle step needs gold compd from mixos 8779f33: the
-- compd package no longer exists here (viud is its successor).
$failed = false
for $cmd in [
  ["cargo", "check", "-p", "compd", "--features", "backend-all"],
  ["cargo", "check", "-p", "compd", "--no-default-features", "--features", "backend-native,backend-headless"]
]
  $r = run_argv(concat(["env", "CARGO_BUILD_JOBS=6"], $cmd), {timeout: 7000, max_output: 64000000})
  print($r.stdout)
  print($r.stderr)
  print("PROFILE_RC=" .. to_string($r.exit_code) .. " " .. join($cmd, " "))
  if $r.exit_code != 0 then $failed = true end
end
$tree = run_argv(["cargo", "tree", "-p", "compd", "--no-default-features", "--features", "backend-native,backend-headless", "-e", "normal", "--locked"], {max_output: 64000000})
print($tree.stderr)
print("EGUI_MATCH_LINES=" .. to_string(len(filter(lines($tree.stdout), fn($l) = contains($l, "egui")))))
print("TREE_RC=" .. to_string($tree.exit_code))
if $failed then exit(1) end
