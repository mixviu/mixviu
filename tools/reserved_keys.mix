-- SPDX-License-Identifier: MIT OR Apache-2.0
-- Shipped data and generated terminal bindings must respect desk ownership.
fn reserved_chord($text)
  $parts=split($text,"+");$key=lower($parts[len($parts)-1])
  return re_match($key,"^f([1-9]|1[0-2])$") or (contains(["left","right","up","down","arrowleft","arrowright","arrowup","arrowdown"],$key) and not contains($parts,"Shift") and (contains($parts,"Ctrl") or contains($parts,"Alt")))
end
fn inspect_bindings($v,$path,$binding=false)
  if type($v)=="map" then
    if type($v.key)=="string" then
      $mods=$v.modifiers ?? []
      if type($mods)!="list" then $mods=[] end
      $chord=(if $v.ctrl==true or contains($mods,"ctrl") or contains($mods,"command") then "Ctrl+" else "" end)..(if $v.alt==true or contains($mods,"alt") then "Alt+" else "" end)..(if $v.shift==true or contains($mods,"shift") then "Shift+" else "" end)..$v.key
      if reserved_chord($chord) then raise("RESERVED_KEY",$path..": reserved binding "..$chord) end
    end
    for $k in keys($v) inspect_bindings($v[$k],$path.."."..$k,contains(["shortcut","shortcuts","keys","key"],$k)) end
  elif type($v)=="list" then
    for $item in $v inspect_bindings($item,$path,$binding) end
  elif $binding and type($v)=="string" and reserved_chord($v) then
    raise("RESERVED_KEY",$path..": reserved binding "..$v)
  end
end
for $p in split(trim(run_argv_must(["git","ls-files","apps","share/scenes"])),"\n")
  if ends_with($p,".json") then inspect_bindings(json_parse(read_file($p)),$p) end
  if ends_with($p,".mix") and not ends_with($p,"-test.mix") then
    $source=join(filter(split(read_file($p),"\n"),fn($line)=not starts_with($line,"```")),"\n")
    for $token in mix_tokens($source)
      if $token.kind=="string" and reserved_chord(substr($token.text,1,len($token.text)-2)) then
        raise("RESERVED_KEY",$p..":"..to_string($token.line)..": reserved key literal "..$token.text)
      end
    end
  end
end
$r=run_argv([args()[0] ?? "mix","apps/term/reserved-test.mix"],{stdout:"inherit",stderr:"inherit"})
if $r.exit_code!=0 then exit(1) end
print("reserved app bindings: clean")
