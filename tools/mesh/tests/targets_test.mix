-- SPDX-License-Identifier: MIT OR Apache-2.0
$targets = require("../_lib/targets.mix")
fn check($condition, $message)
  if not $condition then raise("TEST", $message) end
end
fn refuses($document)
  try
    $targets.parse_targets($document)
    return false
  catch $message, $error
    return $error.code == "MESH_TARGET"
  end
end
$system = {node:"node-a",host:"host-a",kind:"system"}
$desk = {node:"desk-a",host:"host-a",kind:"desk",machine:"desk-a",profile:"/var/lib/example/profile-a",session:3,account:"user-a"}
$document = {schema_version:1,project:"example",targets:[$system,$desk]}
$parsed = $targets.parse_targets($document)
$first = $targets.plan($parsed.targets[0])
$second = $targets.plan($parsed.targets[1])
check($first.inventory == "/var/lib/example/noded/inventory.signed", "system state root")
check($first.unit == "noded.service", "system service")
check(not $first.mutation_supported and $first.system_mutation_eligible, "policy eligibility is not implemented mutation")
check($second.inventory == "/var/lib/example/profile-a/var/noded/inventory.signed", "desk state root")
check($second.seed == "/var/lib/example/profile-a/etc/noded/d2.seed", "desk private path")
check($second.unit == "noded@3.service" and $second.account == "user-a", "desk account/unit")
check(not $second.mutation_supported, "no partial desk write path")
$bad = $document
$bad.targets[1].profile = "/var/lib/example/../elsewhere"
check(refuses($bad), "traversal refused")
$bad = $document
$bad.targets[1].host = "-proxy-command"
check(refuses($bad), "option-shaped host refused")
$bad = $document
$bad.targets[1].session = 3.5
check(refuses($bad), "fractional session refused")
$bad = $document
$bad.targets[1].node = "node-a"
check(refuses($bad), "duplicate identity refused")
$bad = $document
$bad.targets[0].machine = "desk-a"
check(refuses($bad), "system/desk confusion refused")
$bad = $document
$bad.targets[1].unexpected = true
check(refuses($bad), "unknown field refused")
$bad = $document
$bad.targets[1].account = "root"
check(refuses($bad), "privileged desk account refused")
$bad = $document
$other = $desk
$other.node = "desk-b"
$bad.targets = push($document.targets, $other)
check(refuses($bad), "duplicate broker endpoint refused")
$bad = $document
$other = $desk
$other.node = "desk-b"
$other.session = 4
$bad.targets = push($document.targets, $other)
check(refuses($bad), "duplicate profile store refused across different sessions")
$bad = $document
$bad.targets[1].host = "host-a\n"
check(refuses($bad), "trailing newline refused")
for $session in [0,7]
  $bad = $document
  $bad.targets[1].session = $session
  check(refuses($bad), "session bounds refused")
end
$refused = false
try
  $targets.require_system_mutation($document)
catch $message, $error
  $refused = $error.code == "MESH_TARGET"
end
check($refused, "desk mutation must refuse before any I/O")
check(len($targets.require_system_mutation({schema_version:1,project:"example",targets:[$system]}).targets) == 1, "system mutation policy")
$marker = "synthetic-private-fixture"
$job = $targets.stdin_job($parsed.targets[1], "print(uid())", {payload:$marker}, "admin", "/srv/example/bin/mix", {node:$parsed.targets[1].node,mix_bin:"/srv/example/bin/mix",prefix:"/srv/example"})
check(not contains(json_encode($job.argv), $marker), "private fixture must never enter process argv")
check(contains($job.stdin, $marker), "private fixture travels through stdin")
check(contains($job.argv, "--machine=desk-a") and contains($job.argv, "--uid=root"), "admin namespace and identity")
$citizen = $targets.stdin_job($parsed.targets[1], "print(uid())", {}, "citizen", "/srv/example/bin/mix", {node:$parsed.targets[1].node,mix_bin:"/srv/example/bin/mix",prefix:"/srv/example"})
check(contains($citizen.argv, "--uid=user-a"), "citizen runs as session account")
check(contains($citizen.stdin, "/var/lib/example/profile-a/etc"), "profile environment follows namespace")
check(contains($citizen.stdin, "/run/example/session/3"), "session runtime follows namespace")
$system_job = $targets.stdin_job($parsed.targets[0], "print(uid())", {}, "admin", "/srv/example/bin/mix", {node:$parsed.targets[0].node,mix_bin:"/srv/example/bin/mix",prefix:"/srv/example"})
check(deep_eq($system_job.argv, ["/srv/example/bin/mix","-"]), "system dispatch stays direct native stdin")
$ct = {node:"desk-ct",host:"pve-host",kind:"desk",transport:"pct",ct:123,profile:"/opt/mix/var/lib/example/desk-bus",session:5,account:"desktop",admission:"enforce"}
$ctdoc = {schema_version:1,project:"example",targets:[$ct]}
$cttarget = $targets.parse_targets($ctdoc).targets[0]
check($cttarget.run == "/opt/mix/run/session/5","CT runtime follows release prefix")
$layout = {checked_roots:fn($roots,$node)=$roots,node_settings:fn($node)={roots:{prefix:"/opt/mix",etc:"/opt/mix/etc",var:"/opt/mix/var"}},remote_roots:fn($node,$host)=raise("TEST","CT layout queried PVE host")}
check($targets.node_prefix($cttarget,$layout)=="/opt/mix","CT layout must not query PVE host")
for $role in ["admin","citizen"]
  $job = $targets.stdin_job($cttarget,"print(1)",{secret:$marker},$role,"/opt/mix/bin/mix",{node:"desk-ct",mix_bin:"/opt/mix/bin/mix",prefix:"/opt/mix"})
  check(deep_eq(take($job.argv,4),["pct","exec","123","--"]),"CT namespace argv")
  check(contains($job.argv,"runuser") == ($role == "citizen"),"CT citizen identity")
  check(contains($job.argv,"--property=KillMode=control-group") and contains($job.argv,"--property=RuntimeMaxSec=135s") and contains($job.argv,"--property=TimeoutStopSec=5s"),"CT timeout and group kill")
  check(not contains(json_encode($job.argv),$marker) and contains($job.stdin,$marker),"CT private stdin")
end
for $changes in [{ct:99},{ct:123.5},{ct:"123"},{machine:"other"},{transport:"ssh"},{profile:"/var/lib/example/wrong"}]
  $bad = $ctdoc
  for $key in keys($changes) $bad.targets[0][$key] = $changes[$key] end
  check(refuses($bad),"invalid CT target accepted")
end
print("PASS native mesh target model: paths, identity boundaries and desk mutation refusal")
