-- SPDX-License-Identifier: MIT OR Apache-2.0
-- Raw systemctl show property-text fixtures, including an omitted sequence.
$w = require("../_lib/desk_worker.mix")
$targets = require("../_lib/targets.mix")
$prep = require("../_lib/desk_prepare.mix")
$root = trim(run_argv_must(["mktemp","-d"]))
fn check($ok,$message)
  if not $ok then raise("UNIT_PROPERTIES_TEST",$message) end
end
fn refused($action)
  try
    $action()
    return false
  catch $failure
    return true
  end
end
try
  $fixtures = dirname(realpath($0)) .. "/fixtures"
  $nspawn = read_file($fixtures .. "/nspawn-unit-show.txt")
  $pct = read_file($fixtures .. "/pct-unit-show.txt")
  check(not contains($nspawn,"ExecStartPre="),"nspawn fixture must omit unset sequence")
  for $transport in ["nspawn","pct"]
    $text = if $transport=="pct" then $pct else $nspawn end
    $names = ["User","EnvironmentFiles","UnsetEnvironment","ExecStart","Type","KillMode","RuntimeDirectory"]
    if $transport=="pct" then $names=concat($names,["RequiresMountsFor","ExecStartPre"]) end
    $argv = ["systemctl","show","noded@5.service"]
    for $name in $names push($argv,"--property=" .. $name) end
    push($argv,"--no-pager")
    $source = '$fixture_text = ' .. data_encode($text) .. chr(10) .. '$fixture_argv = ' .. data_encode($argv) .. chr(10) .. 'fn fixture_command($argv,$options)
  if not deep_eq($argv,$fixture_argv) or $options.timeout != 10 then raise("UNIT_FIXTURE","unexpected systemctl query") end
  return $fixture_text
end
'
    $source = $source .. replace(read_file(dirname(dirname(realpath($0))) .. "/_lib/desk_worker.mix"),"run_argv_must(","fixture_command(")
    $file = $root .. "/" .. $transport .. ".mix"
    write_file($file,$source)
    $worker = require($file)
    $properties = $worker.unit_properties("noded@5.service",$transport)
    check(len(keys($properties))==len($names),"transport property count differs")
    $raw = {node:"desk",host:"host",kind:"desk",session:5,account:"desktop",admission:"enforce"}
    if $transport=="pct" then
      $raw.transport="pct"
      $raw.ct=123
      $raw.profile="/opt/mix/var/lib/example/desk-bus"
    else
      $raw.machine="desk"
      $raw.profile="/var/lib/example/desk-bus"
    end
    $target = $targets.parse_targets({schema_version:1,project:"example",targets:[$raw]}).targets[0]
    $w.validate_service($target,1000,{present:true,uid:0,gid:1000,perm:0o640},$properties,$prep.service_text($target))
  end
  check(refused(fn()=$w.parse_unit_properties($nspawn,"pct")),"CT accepted missing required sequence properties")
  check(refused(fn()=$w.parse_unit_properties($pct,"nspawn")),"nspawn accepted unsolicited CT properties")
  check(refused(fn()=$w.parse_unit_properties($nspawn .. "User=other\n","nspawn")),"duplicate property accepted")
finally
  run_argv_must(["rm","-rf",$root])
end
print("PASS transport-specific systemctl show text, query argv, native binding and incomplete/duplicate refusals")
