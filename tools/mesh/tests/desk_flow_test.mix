-- SPDX-License-Identifier: MIT OR Apache-2.0
-- No SSH, namespace, systemctl or secret store is contacted by this fixture.
$ops = require("../_lib/desk_ops.mix")
$targets = require("../_lib/targets.mix")
$w = require("../_lib/desk_worker.mix")

fn check($condition,$message)
  if not $condition then raise("DESK_FLOW_TEST",$message) end
end

fn refused($action)
  try
    $action()
    return false
  catch $failure
    return true
  end
end

fn distributor_refused($action)
  try
    $action()
    return false
  catch $failure, $detail
    return $detail.code == "DESK_DISTRIBUTOR"
  end
end

fn simulated($job,$path)
  $state = json_parse(read_file($path))
  check(not contains(json_encode($job.argv),"synthetic-secret"),"private fixture reached argv")
  $state.calls = push($state.calls,$job.operation)
  $value = nil
  $ok = true
  if len($state.calls) == $state.fail_at then
    $ok = false
  elif $job.operation == "preflight" then
    $value = $state.ctx
  elif $job.operation == "seed" then
    $state.ctx.states = $state.seed_states
    $value = {status:"placed",receipt:"protected-fixture/seed"}
  elif $job.operation == "sync" then
    $state.ctx.states = $state.sync_states
    $value = {status:"placed",receipt:"protected-fixture/sync"}
  elif $job.operation == "activate" then
    $value = {restarted:$state.ctx.target.unit,live:{pid:42},authority:{verified:$state.hash=="canonical-fixture",epoch:7,hash:$state.hash}}
  elif $job.operation == "live" then
    $value = {pid:42,uid:1000,sha256:"fixture-native-binary"}
  end
  write_file($path,json_encode($state))
  $reply = {ok:$ok,value:$value,reason:"synthetic injected failure"}
  if $job.operation == "authority" and $ok then
    $reply = {info:{rc:0,value:{node:$state.ctx.target.node,wg_ip:"192.0.2.14"}},inventory:{rc:0,value:{posture:"verified",mesh:"example.internal",epoch:7,hash:$state.hash}}}
  end
  return {ok:true,stdout:json_encode($reply),stdout_truncated:false,stderr_truncated:false}
end

fn flow($base,$program,$execute)
  $before = $ops.preflight($base,$program,$execute)
  $ops.place_seed($base,$before,"synthetic-secret","AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=",$program,$execute)
  $before = $ops.preflight($base,$program,$execute)
  $placed = $ops.place_sync($base,$before,"synthetic-roster","synthetic-signed",$program,$execute,7,"canonical-fixture")
  check($placed.authority.verified,"activation authority failed")
  return $placed.authority
end

$root = trim(run_argv_must(["mktemp","-d"]))
$description = {schema_version:1,project:"example",targets:[{node:"desk",host:"host",kind:"desk",machine:"desk",profile:"/var/lib/example/desk-bus",session:3,account:"desktop",admission:"observe"}]}
$target = $targets.parse_targets($description).targets[0]
$inventory = {mesh:"example.internal",epoch:7,members:[{name:"desk",mesh_ip:"192.0.2.14",status:"active",bus:true,credentials:[{kind:"d2",from_epoch:1,pubkey:"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="}]}]}
$base = $ops.request($target,$inventory,"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=","/srv/example/bin/mix","/srv/example")
$ctx = {target:$target,uid:1000,gid:1000,writer:0,dirs:{},binding:{},config:{},paths:{},binary:{},states:{seed:{present:false},seed_receipt:{present:false},roster:{present:false},inventory:{present:false}}}
$ctx.states.genesis = {present:true,uid:0,gid:1000,perm:0o640,sha256:hash_sha256($base.genesis .. chr(10))}
$seed_states = $ctx.states
$proof = json_encode({node:"desk",mesh:"example.internal",seed_sha256:hash_sha256("synthetic-secret"),public_key:"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="},true)
$seed_states.seed = {present:true,uid:0,gid:1000,perm:0o640,sha256:hash_sha256("synthetic-secret")}
$seed_states.seed_receipt = {present:true,uid:0,gid:1000,perm:0o640,sha256:hash_sha256($proof)}
$sync_states = $seed_states
$sync_states.roster = {present:true,uid:0,gid:1000,perm:0o640,sha256:hash_sha256("synthetic-roster")}
$sync_states.inventory = {present:true,uid:0,gid:1000,perm:0o640,sha256:hash_sha256("synthetic-signed")}
$state = {ctx:$ctx,seed_states:$seed_states,sync_states:$sync_states,calls:[],fail_at:0,hash:"canonical-fixture"}
$path = $root .. "/state.json"
$execute = fn($job)=simulated($job,$path)
$program = $ops.worker_program(dirname(dirname(realpath($0))) .. "/_lib/desk_worker.mix")
write_file($path,json_encode($state))
check(flow($base,$program,$execute).verified,"complete simulated flow failed")
$expected = ["preflight","seed","preflight","preflight","sync","preflight","activate"]
check(deep_eq(json_parse(read_file($path)).calls,$expected),"unexpected distributor stage order")
for $index = 1 to len($expected)
  $fault = $state
  $fault.fail_at = $index
  write_file($path,json_encode($fault))
  check(refused(fn()=flow($base,$program,$execute)),"injected stage failure was accepted")
  check(len(json_parse(read_file($path)).calls)==$index,"commands continued after failed stage")
end
$fault = $state
$fault.hash = "wrong-canonical"
write_file($path,json_encode($fault))
check(refused(fn()=flow($base,$program,$execute)),"stale authority hash accepted")

-- Parseable but incomplete native evidence must produce the owning refusal,
-- rather than an incidental nil-field runtime error.
$empty_success = fn($job)={ok:true,stdout:'{"ok":true}',stdout_truncated:false,stderr_truncated:false}
check(distributor_refused(fn()=$ops.preflight($base,$program,$empty_success)),"empty native success escaped owning refusal")
for $reply in ['{}','{"info":{},"inventory":{}}','[]']
  $bad_authority = fn($job)={ok:true,stdout:$reply,stdout_truncated:false,stderr_truncated:false}
  check(distributor_refused(fn()=$ops.verify_authority($base,7,"canonical-fixture",$bad_authority)),"malformed authority escaped owning refusal")
end
$missing_state = $ctx
$missing_state.states.seed = nil
check(distributor_refused(fn()=$ops.stable_after($ctx,$missing_state,[$ops.payload("seed","synthetic-secret")])),"missing payload state escaped owning refusal")
$new_state = $ctx
$new_state.states.unexpected = {present:false}
check(distributor_refused(fn()=$ops.stable_after($ctx,$new_state,[])),"unexpected authority state accepted")
check(distributor_refused(fn()=$ops.stable_after($ctx,nil,[])),"missing preflight map escaped owning refusal")

-- Target configuration is complete, explicit and cannot omit a rostered node.
$config_path = $root .. "/targets.conf.mix"
write_file($config_path,data_encode($description))
check(has_key($ops.load_targets($config_path,"example",["desk"]),"desk"),"valid target map rejected")
check(refused(fn()=$ops.load_targets($config_path,"example",["desk","omitted"])),"partial target map accepted")
$old = $description
$old.targets[0].admission = nil
write_file($config_path,data_encode($old))
check(refused(fn()=$ops.load_targets($config_path,"example",["desk"])),"implicit admission policy accepted")

-- Effective unit/environment validation is pure over one captured unit reply.
$text = "EXAMPLE_ETC=/var/lib/example/desk-bus/etc\nEXAMPLE_VAR=/var/lib/example/desk-bus/var\nEXAMPLE_NODE_CONFIG=/var/lib/example/desk-bus/etc/node.conf.mix\nEXAMPLE_RUN=/run/example/session/3\nEXAMPLE_BROKER_ACCOUNT=desktop\nEXAMPLE_NODED_URL=\n"
$metadata = {present:true,uid:0,gid:1000,perm:0o640}
$properties = {Type:"simple",KillMode:"control-group",RuntimeDirectory:["example/session/3/noded"],User:"desktop",EnvironmentFiles:[{path:"/var/lib/example/desk-bus/etc/noded/service.env",ignore_errors:false}],UnsetEnvironment:[],ExecStart:[$w.parse_exec_property("{ path=/srv/example/bin/noded ; argv[]=/srv/example/bin/noded serve --no-monitor --no-log ; ignore_errors=no ; start_time=[old] ; pid=42 }")]}
$w.validate_service($target,1000,$metadata,$properties,$text,$base.native)
for $bad in [{User:"root"},{EnvironmentFiles:[{path:"/evil/var/lib/example/desk-bus/etc/noded/service.env",ignore_errors:false}]},{EnvironmentFiles:concat($properties.EnvironmentFiles,[{path:"/tmp/later.env",ignore_errors:false}])},{UnsetEnvironment:["EXAMPLE_ETC"]},{ExecStart:[{path:"/srv/example/bin/noded",argv:["/srv/example/bin/noded","serve","--node","other"],ignore_errors:false}]}]
  $changed = $properties
  for $key in keys($bad) $changed[$key]=$bad[$key] end
  check(refused(fn()=$w.validate_service($target,1000,$metadata,$changed,$text,$base.native)),"unsafe service binding accepted")
end
check(refused(fn()=$w.validate_service($target,1000,$metadata,$properties,$text .. "EXAMPLE_ETC=/tmp/other\n",$base.native)),"duplicate environment assignment accepted")
check(refused(fn()=$w.validate_service($target,1000,{present:true,uid:1000,gid:1000,perm:0o640},$properties,$text,$base.native)),"user-owned service environment accepted")

-- Exercise actual generated source parsing/RPC without any namespace I/O:
-- the invalid operation is rejected before dispatch can inspect a target.
$source = "$request = {operation: \"invalid-fixture\"}\n" .. $program
$generated = $root .. "/generated.mix"
write_file($generated,$source)
$native_mix = realpath("/proc/self/exe")
check(type($native_mix)=="string" and starts_with($native_mix,"/"),"running interpreter must resolve to an absolute path")
run_argv_must([$native_mix,"lint",$generated])
$rpc = json_parse(run_argv_must([$native_mix,$generated]))
check($rpc.ok==false and $rpc.error=="DESK_DISTRIBUTOR","generated native RPC refusal failed")
$prep = require("../_lib/desk_prepare.mix")
$ctdoc = $description
$ctdoc.targets[0] = {node:"desk",host:"pve-host",kind:"desk",transport:"pct",ct:123,profile:"/opt/mix/var/lib/example/desk-bus",session:5,account:"desktop",admission:"observe"}
$ct = $targets.parse_targets($ctdoc).targets[0]
$ctbase = $ops.request($ct,$inventory,$base.genesis,"/opt/mix/bin/mix","/opt/mix")
$ctstate = $state
$ctstate.ctx.target = $ct
write_file($path,json_encode($ctstate))
check(flow($ctbase,$program,$execute).verified,"CT typed flow failed")
$ctbase.endpoint = "192.0.2.1:51822"
$ctbase.hub_key = $base.genesis
$ctbase.subnet = "192.0.2.0/24"
$ctbase.wg_keys = [$base.genesis]
$wg = $prep.wireguard_text($ctbase,$base.genesis,$base.genesis)
check(contains($wg,"Address = 192.0.2.14/32") and contains($wg,"Endpoint = 192.0.2.1:51822") and contains($wg,"AllowedIPs = 192.0.2.0/24"),"desk WG recipe")
check(refused(fn()=$prep.wireguard_text($ctbase,$base.genesis,"wrong-key")),"unadmitted WG key accepted")
$files = $prep.files($ctbase)
check(len($files)==3 and $files[2].bytes == "[Service]\nEnvironmentFile=/opt/mix/var/lib/example/desk-bus/etc/noded/service.env\n","preparation drop-in")
$ctprops = $properties
$ctprops.ExecStart = [$w.parse_exec_property("{ path=/opt/mix/bin/noded ; argv[]=/opt/mix/bin/noded serve --no-monitor --no-log ; ignore_errors=no }")]
$ctprops.RuntimeDirectory = []
$ctprops.RequiresMountsFor = [$ct.run .. "/noded"]
$ctprops.ExecStartPre = [$w.parse_exec_property("{ path=/usr/bin/install ; argv[]=/usr/bin/install -d -m 0711 " .. $ct.run .. "/noded ; ignore_errors=no }")]
$ctprops.EnvironmentFiles = [{path:"/opt/mix/etc/session/5.env",ignore_errors:false},{path:"/opt/mix/var/lib/example/desk-bus/etc/noded/service.env",ignore_errors:false}]
$w.validate_service($ct,1000,$metadata,$ctprops,$files[0].bytes,$ctbase.native)
$wrong_runtime = $ctprops
$wrong_runtime.ExecStartPre = []
check(refused(fn()=$w.validate_service($ct,1000,$metadata,$wrong_runtime,$files[0].bytes,$ctbase.native)),"CT missing runtime creation accepted")
$ctprops.EnvironmentFiles = push($ctprops.EnvironmentFiles,{path:"/tmp/later",ignore_errors:false})
check(refused(fn()=$w.validate_service($ct,1000,$metadata,$ctprops,$files[0].bytes,$ctbase.native)),"CT final environment refusal")
$flattened = $root .. "/prepare-generated.mix"
write_file($flattened,$prep.program(dirname(dirname(realpath($0))) .. "/_lib") .. chr(10) .. "print(1)")
run_argv_must([$native_mix,"lint",$flattened])
check(trim(run_argv_must([$native_mix,$flattened]))=="1","generated preparation source failed")
print("PASS hermetic desk flow: exact namespace stages, ten fail-stop boundaries, policy, effective unit and generated RPC")
run_argv_must(["rm","-rf",$root])
