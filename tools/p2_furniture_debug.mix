-- LAB EVIDENCE ONLY: a pre-cut-over parity or engine-split driver, kept as
-- the record of those gates (tools/cutover_gate.mix is the four-engine gate).
-- Any compd or compd-oracle step needs gold compd from mixos 8779f33: the
-- compd package no longer exists here (viud is its successor).
-- CBC-only process reproduction against a newly built native compositor.
$oracle=args()[0]
fn debug_gate($argv)
  $r=run_argv($argv,{timeout:7200,max_output:64000000,env:{CARGO_BUILD_JOBS:"6"}})
  print($r.stdout);print($r.stderr)
  if not $r.ok then exit($r.exit_code ?? 124) end
end
debug_gate(["cargo","build","-p","viud","--locked"])
$sha=trim(run_argv_must(["git","rev-parse","HEAD"]))
$dir="/build/es-artifacts/"..$sha
mkdir($dir,{parents:true})
copy("target/debug/viud",$dir.."/viud-debug")
debug_gate(["env","COMPD_NATIVE_TEST_BINARY="..$dir.."/viud-debug","COMPD_INPROC_TEST_BINARY="..$oracle,"cargo","test","-p","viu","--test","furniture","--locked","--","--ignored","--nocapture","--test-threads=1"])
