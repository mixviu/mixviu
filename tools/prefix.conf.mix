-- Exact recogniser exceptions apply throughout the named maintainer-only files.
-- foreign_env_names classify known project settings as findings, not exemptions.
-- disabled_rules are computed; enabled:true enforces the deferred rule.
-- limits: files over max_file_bytes (sources, units, data, fixtures, includes)
-- and snapshot ELF files over max_snapshot_bytes are findings, never read.
-- standard_env_names: a trailing * only for namespaces their tools reserve.
{
  "limits": {
    "max_file_bytes": 2097152,
    "max_snapshot_bytes": 268435456
  },
  "prefix_constant": {
    "file": "libraries/paths/src/lib.rs",
    "name": "DEFAULT_PREFIX",
    "reason": "The sole compiled fallback prefix; at most one decoded /opt/mix literal."
  },
  "exceptions": [
    {
      "file": "tools/prefix_gate.mix",
      "rule": "old-name",
      "text": "MIXOS_",
      "reason": "The recogniser must spell the forbidden variable prefix."
    },
    {
      "file": "tools/prefix_gate.mix",
      "rule": "old-name",
      "text": "COSMIX_",
      "reason": "The recogniser must spell the forbidden variable prefix."
    },
    {
      "file": "tools/prefix_gate.mix",
      "rule": "old-name",
      "text": "cosmix",
      "reason": "The recogniser must spell the forbidden old name."
    },
    {
      "file": "tools/prefix.conf.mix",
      "rule": "old-name",
      "text": "MIXOS_",
      "reason": "Exact recogniser exceptions must name their matched text."
    },
    {
      "file": "tools/prefix.conf.mix",
      "rule": "old-name",
      "text": "COSMIX_",
      "reason": "Exact recogniser exceptions must name their matched text."
    },
    {
      "file": "tools/prefix.conf.mix",
      "rule": "old-name",
      "text": "cosmix",
      "reason": "Exact recogniser exceptions must name their matched text."
    },
    {
      "file": "tools/prefix_gate.mix",
      "rule": "bare-mixos",
      "text": "mixos",
      "reason": "Maintainer-only recogniser and selftest needles must spell the deferred token."
    },
    {
      "file": "tools/prefix.conf.mix",
      "rule": "bare-mixos",
      "text": "mixos",
      "reason": "The deferred rule and its exact exceptions must name the token."
    }
  ],
