-- SPDX-License-Identifier: MIT OR Apache-2.0
$c = require("core.mix")
$s = require("suites.mix")
$ep=require("episode_support.mix")
fn check($b)
  if not $b then raise("TEST","media bench assertion failed") end
end
check(deep_eq($c.summary([3,1,2]),{median:2,p95:3}))
check(deep_eq($c.summary([4,1,3,2]),{median:2.5,p95:4}))
check(deep_eq($c.summary([100,1,2]),{median:2,p95:100}))
check(deep_eq($c.summary([100,1,3,2]),{median:2.5,p95:100}))
check($c.summary(range(1,20)).p95==19)
check(deep_eq($c.process_time("1.25 2.50 0.25 4096\n"),{wall_s:1.25,cpu_s:2.75,peak_rss_kib:4096}))
for $text in ["", "1 2 3", "1 2 bad 4", "Command exited with non-zero status 1\n1 2 3 4"]
  $refused=false
  try $c.process_time($text) catch $error $refused=true end
  check($refused)
end
check($c.ratio(10,4)==2.5)
check($c.ratio(10,0)==nil)
check($s.loudnorm_json("log before\n{\"input_i\":\"-18\",\"output_i\":\"-14\"}\nlog after").output_i=="-14")
$fixtures=dirname(script_path()).."/fixtures/"
check($s.capture_number(read_file($fixtures.."ebur128.txt"),'I:\s+([-0-9.]+) LUFS')==-18)
check($s.capture_number(read_file($fixtures.."ebur128.txt"),'Peak:\s+([-0-9.]+) dBFS')==-10.7)
check($s.capture_number(read_file($fixtures.."astats.txt"),'RMS level dB: ([-0-9.]+)')==-20.165646)
check($s.capture_number(read_file($fixtures.."video.txt"),'All:([-0-9.]+)')==0.999163)
check($s.capture_number(read_file($fixtures.."video.txt"),'average:([-0-9.]+)')==57.003417)
check($s.loudnorm_json(read_file($fixtures.."loudnorm.txt")).input_i=="-17.99")
$a = [{quality:70,rate:100},{quality:80,rate:200},{quality:90,rate:400},{quality:100,rate:800}]
$b = map($a,fn($p)={quality:$p.quality,rate:$p.rate*1.25})
check(abs($c.bd_rate($a,$b)-25)<0.000001)
check(abs($c.bd_rate($a,$a))<0.000001)
-- Same exponential curve, shifted rate and partially overlapping quality.
$partial=[{quality:75,rate:pow(2,0.5)*80},{quality:85,rate:pow(2,1.5)*80},{quality:95,rate:pow(2,2.5)*80},{quality:105,rate:pow(2,3.5)*80}]
check(abs($c.bd_rate(reverse($a),$partial)+20)<0.000001)
check($c.bd_details($a,$partial).overlap_lo==75)
check($c.bd_details($a,$partial).overlap_hi==100)
$badcurve=$a; $badcurve[2].rate=150
check($c.bd_result($a,$badcurve).status=="unavailable")
$tiny=map($a,fn($p)={quality:98+($p.quality-70)/100,rate:$p.rate})
check($c.bd_result($a,$tiny).status=="unavailable")
check($c.fps({wall_samples_s:[1,2,4],status:"ok"},60).p5==15)
check($c.bits_per_second(60,2)==240)
check($s.item_id("/corpus/a/same.wav","/corpus")!=$s.item_id("/corpus/b/same.wav","/corpus"))
for $path in ["/tmp/x:y","/tmp/x;y","/tmp/x,y","/tmp/x[y]","/tmp/x'y","-input","../input"]
  $refused=false
  try $c.safe_path($path) catch $error $refused=true end
  check($refused)
end
$fake={input_i:"-18",input_tp:"-2",input_lra:"1",input_thresh:"-28",target_offset:"0"}
check(contains($s.loudnorm_filter($fake),"measured_I=-18"))
$fake.input_i="-18,anull"
$refused=false
try $s.loudnorm_filter($fake) catch $error $refused=true end
check($refused)
for $case in [{time:2330,ps:""},{time:100,ps:""},{time:1600,ps:"42 /usr/bin/google-chrome --headless=new"},{time:1600,ps:"42 /opt/mix/bin/mix /example/media/pipeline/build.mix"},{time:1600,ps:"42 mix --flag build.mix --run /example"},{time:1600,ps:"42 mix /example/episode.mix"}]
  $refused = false
  try $c.guard_at($case.time,$case.ps) catch $error $refused = true end
  check($refused)
end
$c.guard_at(300,"")
$c.guard_at(2329,"42 /opt/mix/bin/mix unrelated.mix")
$r = {suite:"opus",engine:"ffmpeg",variant:"default",tool_versions:{},host:"example",cpu_model:"example",items:[{id:"tone",metrics:{encode:{wall_s:{median:4,p95:5}},status:"ok"}}]}
$c.validate_result($r)
$peer = $r; $peer.engine="rust"; $peer.items[0].metrics.encode.wall_s.median=2
check(contains($c.report($r,$peer),"| encode.wall_s.median | 4 | 2 |"))
$r.items[0].metrics.encode.status="below_resolution"
check(not contains($c.report($r,$peer),"| encode.wall_s.median | 4 | 2 |"))
$bad=$r; $bad.extra=true
$refused=false
try $c.validate_result($bad) catch $error $refused=true end
check($refused)
$bad=$r; $bad.items=concat($bad.items,$bad.items)
$refused=false
try $c.validate_result($bad) catch $error $refused=true end
check($refused)
for $argv in [["--out","-flag"],["--corpus","--out"]]
  $refused=false
  try $c.options($argv) catch $error $refused=true end
  check($refused)
end
$refused=false
try $c.bd_rate($a,[{quality:110,rate:100},{quality:120,rate:200},{quality:130,rate:400},{quality:140,rate:800}]) catch $error $refused=true end
check($refused)
check(contains(join($c.scope_for(["ffmpeg"],"4","2-5")," "),"nice -n 10 taskset --cpu-list 2,3,4,5 ffmpeg"))
check(not contains($c.scope_for(["ffmpeg"],"unrestricted","0-1"),"taskset"))
check($c.options(["--budget","unrestricted","--keep"]).keep)
check($c.options([]).budget=="4")
check($c.absolute_path("./out","/tmp/work")=="/tmp/work/out")
for $cwd in ["/tmp/has'quote","/tmp/has:colon","/tmp/has space"]
  $refused=false
  try $c.absolute_path("out",$cwd) catch $e $refused=true end
  check($refused)
end
$refused=false
try $c.concat_entry("/tmp/has'quote.wav") catch $e $refused=true end
check($refused)
check($c.concat_entry("/tmp/normal.wav")=="file '/tmp/normal.wav'")
for $line in ["42 mix build.mix","42 /usr/local/bin/mix episode.mix","42 mix ./build.mix","42 mix --flag build.mix","42 mixd build.mix","42 /opt/mix/bin/mixd episode.mix"]
  $refused=false
  try $c.guard_at(1600,$line) catch $e $refused=true end
  check($refused)
end
for $line in ["42 mix rebuild.mix","42 mix episode.mix.old","42 other build.mix","42 remix episode.mix","42 tmix build.mix"]
  $c.guard_at(1600,$line)
end
check(deep_eq($s.budget_argv(["ffmpeg","-threads","4","n_threads=4"],{budget:"4"}),["ffmpeg","-threads","4","n_threads=4"]))
check(deep_eq($s.budget_argv(["ffmpeg","-threads","4","n_threads=4"],{budget:"unrestricted"}),["ffmpeg","-threads","0","n_threads=4"]))
check($c.excluded({curve:{status:"unavailable",overlap_lo:1}},"curve.overlap_lo"))
check($c.excluded({curve:{status:"ok",bd_rate_percent:10}},"curve.bd_rate_percent"))
check(not contains($c.report($r,nil),"Round-1"))
-- Copy/rebase/snapshot tests use files only, never a media pipeline or live CPU mask.
$tmp=trim(run_argv_must(["mktemp","-d","/tmp/media-bench-episode-test-XXXXXX"]))
$copy=nil
try
  $original=$tmp.."/run"; $alias=$tmp.."/linked"
  mkdir($original)
  run_argv_must(["ln","-s","--",$original,$alias])
  for $out in [$original.."/new-evidence",$alias.."/new-evidence"]
    $refused=false
    try $ep.check_output($alias,$out) catch $e $refused=true end
    check($refused)
  end
  $ep.check_output($alias,$tmp.."/outside-evidence")
  $ep.create_output($alias,$tmp.."/outside-evidence")
  check(realpath($tmp.."/outside-evidence")!=nil)
  run_argv_must(["ln","-s","--",$original.."/missing",$tmp.."/dangling"])
  $refused=false
  try $ep.create_output($alias,$tmp.."/dangling/new") catch $e $refused=true end
  check($refused and not is_dir($original.."/missing"))
  write_file($original.."/episode.mix",data_encode([{kind:"clip",path:$alias.."/take.mp4"}]))
  write_file($original.."/meta.json",json_encode({real:$original.."/file",alias:$alias.."/file",alias_dot:$tmp.."/./linked/file",sibling:$original.."-other/file",alias_sibling:$alias.."-other/file",root:$alias}))
  write_file($original.."/actions.jsonl",json_encode({path:$alias.."/file"}).."\n")
  -- A real run also holds Mix scripts that are not strict data.
  mkdir($original.."/tools")
  $script="print(\""..$alias.."/file\")\n"
  write_file($original.."/tools/check.mix",$script)
  $before=$ep.run_snapshot($original)
  $copied=$ep.copy_run(realpath($alias),[$original,$alias,$tmp.."/./linked"],$before)
  $copy=$copied.path
  check($copied.copy_consistent and $copied.snapshot.content_sha256==$before.content_sha256)
  $meta=json_parse(read_file($copy.."/meta.json"))
  check($ep.rebase_value($alias.."/file",[$alias.."/"],$copy)==$copy.."/file")
  check($meta.real==$copy.."/file" and $meta.alias==$copy.."/file" and $meta.root==$copy)
  check($meta.alias_dot==$copy.."/file")
  check($meta.sibling==$original.."-other/file" and $meta.alias_sibling==$alias.."-other/file")
  check(load_data($copy.."/episode.mix")[0].path==$copy.."/take.mp4")
  check(read_file($copy.."/tools/check.mix")==$script)
  check(json_parse(trim(read_file($copy.."/actions.jsonl"))).path==$copy.."/file")
  check($ep.take_entries($copy)[0].id=="assemble-root")
  check($before.sha256==$ep.run_snapshot($original).sha256)
  write_file($original.."/new-file","changed")
  check($before.sha256!=$ep.run_snapshot($original).sha256)
  $ep.remove_copy($copy,true); check(is_dir($copy))
  $ep.remove_copy($copy,false); check(not is_dir($copy)); $copy=nil
  -- Restore the source's bytes and mtime after a transient copy-time change:
  -- the original before/after check passes, but copy consistency must fail.
  run_argv_must(["cp","-p","--",$original.."/new-file",$tmp.."/saved"])
  $before=$ep.run_snapshot($original)
  write_file($original.."/new-file","mutated")
  $refused=false
  try $ep.copy_run($original,[$original],$before) catch $e
    $refused=contains(to_string($e),"source changed during copy")
  end
  run_argv_must(["cp","-p","--",$tmp.."/saved",$original.."/new-file"])
  check($refused and $before.sha256==$ep.run_snapshot($original).sha256)
  -- A truncated running order must refuse the copy, never pass with stale paths.
  $good=read_file($original.."/episode.mix")
  write_file($original.."/episode.mix","[{kind:\"clip\",path:")
  $stale=glob("/var/tmp/media-bench/episode-*")
  $refused=false
  try $ep.copy_run($original,[$original],$ep.run_snapshot($original)) catch $e
    $refused=contains(to_string($e),"episode.mix")
  end
  write_file($original.."/episode.mix",$good)
  check($refused and len(glob("/var/tmp/media-bench/episode-*"))==len($stale))
finally
  if $copy!=nil then $ep.remove_copy($copy,false) end
  run_argv_must(["rm","-rf","--",$tmp])
end
print("PASS media bench: statistics, schema, ratios, BD-rate, host guard and scope")
