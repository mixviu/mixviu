-- SPDX-License-Identifier: MIT OR Apache-2.0
$c = require("core.mix")
$s = require("suites.mix")
fn check($b)
  if not $b then raise("TEST","media bench assertion failed") end
end
check(deep_eq($c.summary([3,1,2]),{median:2,p95:3}))
check(deep_eq($c.summary([4,1,3,2]),{median:2.5,p95:4}))
check(deep_eq($c.summary([100,1,2]),{median:2,p95:100}))
check(deep_eq($c.summary([100,1,3,2]),{median:2.5,p95:100}))
check($c.summary(range(1,20)).p95==19)
check(deep_eq($c.process_time("1.25 2.50 0.25 4096\n"),{wall_s:1.25,cpu_s:2.75,peak_rss_kib:4096}))
for $text in ["", "1 2 3", "1 2 bad 4", "Command exited with non-zero status 1\n1 2 3 4"]
  $refused=false
  try $c.process_time($text) catch $error $refused=true end
  check($refused)
end
check($c.ratio(10,4)==2.5)
check($c.ratio(10,0)==nil)
check($s.loudnorm_json("log before\n{\"input_i\":\"-18\",\"output_i\":\"-14\"}\nlog after").output_i=="-14")
$fixtures=dirname(script_path()).."/fixtures/"
check($s.capture_number(read_file($fixtures.."ebur128.txt"),'I:\s+([-0-9.]+) LUFS')==-18)
check($s.capture_number(read_file($fixtures.."ebur128.txt"),'Peak:\s+([-0-9.]+) dBFS')==-10.7)
check($s.capture_number(read_file($fixtures.."astats.txt"),'RMS level dB: ([-0-9.]+)')==-20.165646)
check($s.capture_number(read_file($fixtures.."video.txt"),'All:([-0-9.]+)')==0.999163)
check($s.capture_number(read_file($fixtures.."video.txt"),'average:([-0-9.]+)')==57.003417)
check($s.loudnorm_json(read_file($fixtures.."loudnorm.txt")).input_i=="-17.99")
$a = [{quality:70,rate:100},{quality:80,rate:200},{quality:90,rate:400},{quality:100,rate:800}]
$b = map($a,fn($p)={quality:$p.quality,rate:$p.rate*1.25})
check(abs($c.bd_rate($a,$b)-25)<0.000001)
check(abs($c.bd_rate($a,$a))<0.000001)
-- Same exponential curve, shifted rate and partially overlapping quality.
$partial=[{quality:75,rate:pow(2,0.5)*80},{quality:85,rate:pow(2,1.5)*80},{quality:95,rate:pow(2,2.5)*80},{quality:105,rate:pow(2,3.5)*80}]
check(abs($c.bd_rate(reverse($a),$partial)+20)<0.000001)
check($c.bd_details($a,$partial).overlap_lo==75)
check($c.bd_details($a,$partial).overlap_hi==100)
$badcurve=$a; $badcurve[2].rate=150
check($c.bd_result($a,$badcurve).status=="unavailable")
$tiny=map($a,fn($p)={quality:98+($p.quality-70)/100,rate:$p.rate})
check($c.bd_result($a,$tiny).status=="unavailable")
check($c.fps({wall_samples_s:[1,2,4],status:"ok"},60).p5==15)
check($c.bits_per_second(60,2)==240)
check($s.item_id("/corpus/a/same.wav","/corpus")!=$s.item_id("/corpus/b/same.wav","/corpus"))
for $path in ["/tmp/x:y","/tmp/x;y","/tmp/x,y","/tmp/x[y]","/tmp/x'y","-input","../input"]
  $refused=false
  try $c.safe_path($path) catch $error $refused=true end
  check($refused)
end
$fake={input_i:"-18",input_tp:"-2",input_lra:"1",input_thresh:"-28",target_offset:"0"}
check(contains($s.loudnorm_filter($fake),"measured_I=-18"))
$fake.input_i="-18,anull"
$refused=false
try $s.loudnorm_filter($fake) catch $error $refused=true end
check($refused)
for $case in [{time:2330,ps:""},{time:100,ps:""},{time:1600,ps:"42 /usr/bin/google-chrome --headless=new"},{time:1600,ps:"42 /opt/mix/bin/mix /example/media/pipeline/build.mix"},{time:1600,ps:"42 mix --flag build.mix --run /example"},{time:1600,ps:"42 mix /example/episode.mix"}]
  $refused = false
  try $c.guard_at($case.time,$case.ps) catch $error $refused = true end
  check($refused)
end
$c.guard_at(300,"")
$c.guard_at(2329,"42 /opt/mix/bin/mix unrelated.mix")
$r = {suite:"opus",engine:"ffmpeg",variant:"default",tool_versions:{},host:"example",cpu_model:"example",items:[{id:"tone",metrics:{encode:{wall_s:{median:4,p95:5}},status:"ok"}}]}
$c.validate_result($r)
$peer = $r; $peer.engine="rust"; $peer.items[0].metrics.encode.wall_s.median=2
check(contains($c.report($r,$peer),"| encode.wall_s.median | 4 | 2 |"))
$r.items[0].metrics.encode.status="below_resolution"
check(not contains($c.report($r,$peer),"| encode.wall_s.median | 4 | 2 |"))
$bad=$r; $bad.extra=true
$refused=false
try $c.validate_result($bad) catch $error $refused=true end
check($refused)
$bad=$r; $bad.items=concat($bad.items,$bad.items)
$refused=false
try $c.validate_result($bad) catch $error $refused=true end
check($refused)
for $argv in [["--out","-flag"],["--corpus","--out"]]
  $refused=false
  try $c.options($argv) catch $error $refused=true end
  check($refused)
end
$refused=false
try $c.bd_rate($a,[{quality:110,rate:100},{quality:120,rate:200},{quality:130,rate:400},{quality:140,rate:800}]) catch $error $refused=true end
check($refused)
check(contains(join($c.scope(["ffmpeg"])," "),"MemoryMax=24G -p CPUWeight=20 nice -n 10 taskset --cpu-list"))
print("PASS media bench: statistics, schema, ratios, BD-rate, host guard and scope")
