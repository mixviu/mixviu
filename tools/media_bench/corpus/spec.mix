-- Lossless, deterministic demo sources. No copyrighted source material.
fn generators()
  $video = ["-t","120","-an","-c:v","ffv1","-level","3","-threads","2","-pix_fmt","yuv420p","-fflags","+bitexact","-flags:v","+bitexact","-map_metadata","-1"]
  return [
    {id:"sync",file:"sync.mkv",duration:120,format:"3840x2160 30fps FFV1 + stereo 48kHz PCM",description:"One white frame and 1kHz beep every second; burned-in frame number",args:concat(["-f","lavfi","-i","color=c=black:s=3840x2160:r=30,drawbox=c=white:t=fill:enable='eq(mod(n,30),0)',drawtext=fontfile=/usr/share/fonts/TTF/DejaVuSans.ttf:text='%{n}':x=80:y=80:fontsize=80:fontcolor=red", "-f","lavfi","-i","aevalsrc='if(lt(mod(t,1),0.033333333333),0.25*sin(2*PI*1000*t),0)|if(lt(mod(t,1),0.033333333333),0.25*sin(2*PI*1000*t),0)':s=48000:d=120"],concat(filter($video,fn($x)=$x!="-an"),["-c:a","pcm_s16le"]))},
    {id:"ui-synth",file:"ui-synth.mkv",duration:120,format:"3840x2160 30fps FFV1 yuv420p",description:"Stand-in for desk ui-static/ui-motion; scrolling text and moving rectangles",args:concat(["-f","lavfi","-i","color=c=0x152335:s=3840x2160:r=30,drawgrid=w=240:h=120:t=2:c=gray,drawtext=fontfile=/usr/share/fonts/TTF/DejaVuSans.ttf:text='MixViu demo scrolling list 0123456789':x=100:y=h-mod(t*240\\,h+200):fontsize=64:fontcolor=white,drawbox=x=120:y=200:w=800:h=300:c=blue:t=fill,drawbox=x=2200:y=1300:w=700:h=400:c=orange:t=fill,scroll=horizontal=0.001:vertical=0"],$video)},
    {id:"music-synth",file:"music-synth.wav",duration:120,format:"48000Hz stereo PCM s16le WAV",description:"Generated chords with seeded noise percussion; replacement until a licensed bed is named",args:["-f","lavfi","-i","aevalsrc=0.08*(sin(2*PI*220*t)+sin(2*PI*277.182631*t)+sin(2*PI*329.627557*t))|0.08*(sin(2*PI*220*t)+sin(2*PI*261.625565*t)+sin(2*PI*329.627557*t)):s=48000:d=120","-f","lavfi","-i","anoisesrc=c=white:s=48000:d=120:seed=42:a=0.05,volume='if(lt(mod(t,0.5),0.03),1,0)':eval=frame","-filter_complex","[0:a][1:a]amix=inputs=2:normalize=0","-t","120","-ar","48000","-ac","2","-c:a","pcm_s16le","-fflags","+bitexact","-flags:a","+bitexact","-map_metadata","-1"]}
  ]
end
