fn options($argv)
  $o = {runs:3, variant:"default"}
  $i = 0
  while $i < len($argv)
    $k = replace($argv[$i], "--", "")
    if not starts_with($argv[$i], "--") or $i + 1 >= len($argv) then raise("ARGS", "expected --option value") end
    if not contains(["suite","engine","variant","corpus","out","runs","compare"], $k) then raise("ARGS", "unknown option " .. $k) end
    $o[$k] = $argv[$i+1]
    $i = $i + 2
  end
  $o.runs = to_number($o.runs)
  if $o.runs < 1 or floor($o.runs) != $o.runs then raise("ARGS", "runs must be a positive integer") end
  return $o
end
fn summary($xs)
  if len($xs) == 0 then raise("STATS", "empty sample") end
  $s = sort($xs)
  $n = len($s)
  $mid = floor($n / 2)
  $median = if $n % 2 == 1 then $s[$mid] else ($s[$mid-1] + $s[$mid])/2 end
  return {median:$median, p95:$s[ceil($n*0.95)-1]}
end
fn ratio($oracle, $rust)
  if $rust == 0 then return nil end
  return $oracle / $rust
end
-- Exact integral of piecewise linear log(rate) over overlapping quality.
-- This deliberately avoids unstable cubic fits; requires four distinct points.
fn curve_integral($points, $lo, $hi)
  $p = sort_by($points, fn($a) = $a.quality)
  $area = 0
  for $i in range(1,len($p)-1)
    $a = $p[$i-1]
    $b = $p[$i]
    if $b.quality <= $a.quality or $a.rate <= 0 or $b.rate <= 0 then raise("BDRATE", "invalid curve") end
    $l = max($lo,$a.quality)
    $h = min($hi,$b.quality)
    if $h > $l then
      $slope = (log($b.rate, exp(1))-log($a.rate, exp(1)))/($b.quality-$a.quality)
      $area = $area + log($a.rate, exp(1))*($h-$l) + $slope*(pow($h-$a.quality,2)-pow($l-$a.quality,2))/2
    end
  end
  return $area
end
fn bd_rate($reference, $test)
  if len($reference) < 4 or len($test) < 4 then raise("BDRATE", "four rate points required") end
  $a = sort_by($reference, fn($x) = $x.quality)
  $b = sort_by($test, fn($x) = $x.quality)
  $lo = max($a[0].quality,$b[0].quality)
  $hi = min($a[len($a)-1].quality,$b[len($b)-1].quality)
  if $hi <= $lo then raise("BDRATE", "no quality overlap") end
  return 100*(exp((curve_integral($b,$lo,$hi)-curve_integral($a,$lo,$hi))/($hi-$lo))-1)
end
fn guard_at($hhmm, $processes)
  if $hhmm >= 2330 or $hhmm < 300 then raise("GUARD", "nightly window 23:30–03:00") end
  for $line in split($processes,"\n")
    -- Ignore command text embedded in agent briefs; inspect actual executable argv.
    if re_match($line, '^[0-9]+ [^ ]*(chrome|chromium)[^ ]* .*--headless') or re_match($line, '^[0-9]+ [^ ]*mix(d)? (run )?[^ ]*media/pipeline/build\.mix( |$)') then
      raise("GUARD", "episode build or headless Chrome: " .. $line)
    end
  end
end
fn guard()
  $time = trim(run_argv_must(["date","+%H%M"]))
  $p = run_argv(["pgrep","-a","."])
  if $p.exit_code != 0 and $p.exit_code != 1 then raise("GUARD", $p.stderr) end
  guard_at(to_number($time),$p.stdout)
end
fn scope($argv)
  return concat(["systemd-run","--user","--scope","-p","MemoryMax=24G","-p","CPUWeight=20","nice","-n","10"],$argv)
end
fn timed($argv, $base)
  guard()
  $cmd = scope(concat(["/usr/bin/time","-f","%e %U %S %M","-o",$base..".time"],$argv))
  write_file($base..".command.json",json_encode($cmd))
  $r = run_argv($cmd,{timeout:21600, stdout:{file:$base..".stdout"},stderr:{file:$base..".stderr"},env:{LC_ALL:"C"}})
  if not $r.ok then raise("TOOL", "command failed; see "..$base..".stderr") end
  $t = re_split(trim(read_file($base..".time")),"\\s+")
  if len($t) != 4 then raise("TIME", "invalid process counters") end
  return {wall_s:to_number($t[0]), cpu_s:to_number($t[1])+to_number($t[2]), peak_rss_kib:to_number($t[3]),command:$cmd}
end
fn speed($argv,$base,$runs)
  $wall = []; $cpu = []; $rss = []; $cmds = []
  for $n in range(1,$runs)
    $r = timed($argv,$base.."-"..to_string($n))
    push($wall,$r.wall_s); push($cpu,$r.cpu_s); push($rss,$r.peak_rss_kib); push($cmds,$r.command)
  end
  return {wall_s:summary($wall),cpu_s:summary($cpu),peak_rss_kib:summary($rss),wall_samples_s:$wall,commands:$cmds}
end
fn validate_result($r)
  if not deep_eq(sort(keys($r)), sort(["suite","engine","variant","tool_versions","host","cpu_model","items"])) then raise("SCHEMA", "unexpected result keys") end
  for $item in $r.items
    if not deep_eq(sort(keys($item)), ["id","metrics"]) then raise("SCHEMA", "invalid item") end
  end
end
fn flatten($m,$prefix)
  $out = {}
  for $k in keys($m)
    $name = if $prefix == "" then $k else $prefix.."."..$k end
    if type($m[$k]) == "map" then
      $out = merge($out,flatten($m[$k],$name))
    elif type($m[$k]) == "number" or type($m[$k]) == "string" then
      $out[$name] = $m[$k]
    end
  end
  return $out
end
fn report($result,$other)
  validate_result($result)
  $text = "# Media bench: "..$result.suite.." / "..$result.engine.."\n\nOracle-to-Rust = ffmpeg / rust; zero denominators are unavailable. p95 is nearest rank.\n\n| Item | Metric | Value | Oracle-to-Rust |\n|---|---|---:|---:|\n"
  for $item in $result.items
    $peer = {}
    if $other != nil then
      if $other.suite != $result.suite or $other.engine == $result.engine then raise("COMPARE", "requires same suite and opposite engines") end
      for $p in $other.items
        if $p.id == $item.id then $peer = flatten($p.metrics,"") end
      end
    end
    $metrics = flatten($item.metrics,"")
    for $key in sort(keys($metrics))
      $v = $metrics[$key]; $r = nil
      if type($v) == "number" and type($peer[$key]) == "number" then
        $r = if $result.engine == "ffmpeg" then ratio($v,$peer[$key]) else ratio($peer[$key],$v) end
      end
      $text = $text.."| "..$item.id.." | "..$key.." | "..replace(to_string($v),"|","/").." | "..to_string($r).." |\n"
    end
  end
  return $text
end
