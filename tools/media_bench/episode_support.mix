$core=require("core.mix")
fn check_output($given,$out)
  $source=realpath($given)
  if $source==nil then raise("EPISODE","episode source does not exist") end
  -- Resolve existing ancestors too: --out may not exist yet, and a parent
  -- symlink must not redirect evidence writes into the original run.
  $ancestor=$out; $suffix=[]
  while realpath($ancestor)==nil
    $entry=nil
    try $entry=stat($ancestor,{follow_symlinks:false}) catch $error end
    if $entry!=nil and $entry.is_symlink then raise("EPISODE","--out has a dangling symlink component") end
    push($suffix,basename($ancestor))
    $parent=dirname($ancestor)
    if $parent==$ancestor then raise("EPISODE","cannot resolve output parent") end
    $ancestor=$parent
  end
  $resolved=path_join(realpath($ancestor),join(reverse($suffix),"/"))
  if $resolved==$source or starts_with($resolved,$source.."/") then raise("EPISODE","--out must be outside the original run") end
end
fn create_output($given,$out)
  check_output($given,$out)
  mkdir($out)
  $resolved=realpath($out)
  if $resolved==nil then raise("EPISODE","cannot resolve created output directory") end
  check_output($given,$resolved)
end
fn rebase_value($value,$origins,$copy)
  if type($value)=="string" then
    for $raw_origin in $origins
      $origin=re_replace($raw_origin,'/+$',"")
      if $origin!="" and ($value==$origin or starts_with($value,$origin.."/")) then return $copy..substr($value,len($origin)) end
    end
  elif type($value)=="list" then
    return map($value,fn($v)=rebase_value($v,$origins,$copy))
  elif type($value)=="map" then
    $out={}
    for $key in keys($value)
      $out[$key]=rebase_value($value[$key],$origins,$copy)
    end
    return $out
  end
  return $value
end
fn run_snapshot($root)
  $raw=run_argv_must(["find",$root,"(","-type","f","-o","-type","l",")","-print0"],{timeout:600})
  $files=[]; $content=[]
  for $path in sort(filter(split($raw,"\0"),fn($p)=$p!=""))
    $s=stat($path,{follow_symlinks:false})
    $relative=substr($path,len($root)+1)
    $digest=substr(run_argv_must(["sha256sum","--zero","--",$path],{timeout:600}),0,64)
    push($files,{path:$relative,size:$s.size,mtime:$s.mtime,mtime_nsec:$s.mtime_nsec,symlink:$s.is_symlink,sha256:$digest})
    push($content,{path:$relative,size:stat($path).size,sha256:$digest})
  end
  $hash=split(run_argv_must(["sha256sum"],{stdin:json_encode($files)})," ")[0]
  $content_hash=split(run_argv_must(["sha256sum"],{stdin:json_encode($content)})," ")[0]
  return {sha256:$hash,files:$files,content_sha256:$content_hash,content:$content}
end
fn remove_copy($copy,$keep)
  if $keep then return end
  if not starts_with($copy,"/var/tmp/media-bench/episode-") then raise("EPISODE","refusing to remove a non-bench copy") end
  run_argv_must(["rm","-rf","--",$copy],{timeout:600})
end
fn copy_run($source,$origins,$before)
  mkdir("/var/tmp/media-bench")
  $copy=trim(run_argv_must(["mktemp","-d","/var/tmp/media-bench/episode-XXXXXX"]))
  try
    run_argv_must(["cp","-aL","--reflink=auto","--",$source.."/.",$copy],{timeout:600})
    -- Compare the unmodified copy: rebasing below intentionally changes files.
    $snapshot=run_snapshot($copy)
    if $snapshot.content_sha256!=$before.content_sha256 then raise("EPISODE","source changed during copy") end
    for $file in sort(concat(glob($copy.."/**/*.json"),concat(glob($copy.."/**/*.jsonl"),glob($copy.."/**/*.mix"))))
      if ends_with($file,".jsonl") then
        $lines=[]
        for $line in split(read_file($file),"\n")
          if trim($line)!="" then push($lines,json_encode(rebase_value(json_parse($line),$origins,$copy))) end
        end
        write_file($file,join($lines,"\n").."\n")
      elif ends_with($file,".json") then
        write_file($file,json_encode(rebase_value(json_parse(read_file($file)),$origins,$copy)))
      else
        -- A real run also holds Mix scripts (check-native.mix, tools/*.mix);
        -- only strict-data .mix files carry paths to rebase. Leave the rest,
        -- but the root episode.mix is the running order: it must parse.
        if $file==$copy.."/episode.mix" then
          write_file($file,data_encode(rebase_value(load_data($file),$origins,$copy)))
        else
          $data=nil; $strict=true
          try $data=load_data($file) catch $e $strict=false end
          if $strict then write_file($file,data_encode(rebase_value($data,$origins,$copy))) end
        end
      end
    end
  catch $error
    remove_copy($copy,false)
    raise("EPISODE",$error)
  end
  return {path:$copy,snapshot:$snapshot,copy_consistent:true}
end
fn take_entries($copy)
  $out=[]; $seen={}
  for $file in sort(glob($copy.."/**/actions.jsonl"))
    $take=dirname($file)
    $relative=if $take==$copy then "root" else substr($take,len($copy)+1) end
    $id="assemble-"..$core.safe_path($relative)
    if contains($relative,"__") then raise("ID","ambiguous take separator") end
    $id=replace($id,"/","__")
    if has_key($seen,$id) then raise("ID","duplicate take id") end
    $seen[$id]=true
    push($out,{id:$id,path:$take})
  end
  return $out
end
