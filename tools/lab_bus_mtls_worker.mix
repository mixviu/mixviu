-- Lab-only CBC command. Restore only the generated changes in this job.
$fmt = run_argv(["cargo", "fmt", "-p", "mesh", "-p", "bus", "-p", "noded", "-p", "test-broker"])
print($fmt.stdout)
print($fmt.stderr)
$fmt_lab = run_argv(["rustfmt", "--edition", "2024", "services/noded/src/mtls_lab.rs"])
print($fmt_lab.stderr)
$test = run_argv(["cargo", "test", "-p", "noded", "--lib", "mtls_lab", "--", "--nocapture"], {timeout: 600})
print($test.stdout)
print($test.stderr)
print("LAB_DIFF_BEGIN")
print(run_argv(["git", "diff", "--binary"]).stdout)
print("LAB_DIFF_END")
print(run_argv(["git", "checkout", "-q", "--", "."]).stderr)
exit($test.exit_code)
