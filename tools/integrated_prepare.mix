$rc=0
try
  for $argv in [["cargo","build","--locked","-p","system","--bin","mix"],["target/debug/mix","docs/_build/gen-builtins-md.mix","--mix","target/debug/mix"]]
    $r=run_argv($argv,{timeout:1800,max_output:16000000,env:{CARGO_BUILD_JOBS:"6"}});print($r)
    if not $r.ok then raise("PREPARE",to_string($r.exit_code ?? 124)) end
  end
catch $message
  print($message);$rc=1
finally
  print("INTEGRATION_PATCH_BEGIN");print(run_argv_must(["git","diff","--binary"]));print("INTEGRATION_PATCH_END")
  run_argv_must(["git","checkout","-q","--","."])
end
exit($rc)
