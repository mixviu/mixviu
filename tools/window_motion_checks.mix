-- SPDX-License-Identifier: MIT OR Apache-2.0
-- Focused CBC worker entry point. Never launches on a desk or host desktop.
fn checked($argv)
  print(join($argv, " "))
  $r = run_argv($argv, {timeout:1800, stdout:"inherit", stderr:"inherit"})
  if not $r.ok then exit($r.exit_code ?? 124) end
end
$mode = args()[0] ?? "native"
export MIX_TEST_REQUIRE_RECORD="1"
export MIX_TEST_MIX_EXE=realpath(".") .. "/target/release/mix"
export MIX_TEST_VIUD_EXE=realpath(".") .. "/target/release/viud"
if $mode == "native" then
  -- mix's login-shell feature boundary requires a separate Cargo invocation.
  checked(["cargo","build","--release","--locked","-p","mix"])
  -- VFL is unconditional in mixd; unrelated service personalities are not
  -- needed to exercise its production exporter.
  checked(["cargo","build","--release","--locked","-p","mixd","--no-default-features"])
  checked(["cargo","build","--release","--locked","-p","noded","-p","testkit","--bins"])
  checked(["cargo","test","--release","--locked","-p","viud","--features","test-support","--test","recorder_binary"])
  checked(["cargo","test","--release","--locked","-p","headless","--test","capture","--","--nocapture","--test-threads=1"])
  checked(["cargo","test","--release","--locked","-p","headless","--test","capture","window_motion::benchmark_window_motion_1_8_32","--","--ignored","--exact","--nocapture","--test-threads=1"])
  export MIX_TEST_CAPTURE_SECONDS="40"
  checked(["cargo","test","--release","--locked","-p","headless","--test","capture","benchmark_record_changing_4k_zero_drop","--","--ignored","--exact","--nocapture","--test-threads=1"])
elif $mode == "unit" then
  checked(["cargo","test","--locked","-p","world","-p","decor","-p","policy-host","--lib"])
  checked(["cargo","test","--locked","-p","testkit","--test","window_control","--test","interactive"])
elif $mode == "motion" then
  checked(["cargo","test","--release","--locked","-p","headless","--test","capture","window_motion::","--","--nocapture","--test-threads=1"])
elif $mode == "bench" then
  checked(["cargo","test","--release","--locked","-p","headless","--test","capture","window_motion::benchmark_window_motion_1_8_32","--","--ignored","--exact","--nocapture","--test-threads=1"])
else
  raise("MOTION_CHECK", "expected native, unit, motion or bench")
end
