#!/opt/mix/bin/mix
-- SPDX-License-Identifier: MIT OR Apache-2.0
-- version: 0.2.0
-- Launcher template: tools/apps_bundle.mix writes one copy per app that
-- carries a desktop entry, as /opt/mix/bin/<app>, naming that app's directory.
-- Arguments are forwarded to viu run (host options first, then the app's).
exec_argv(concat(["/opt/mix/bin/viu", "run", "/opt/mix/share/mixviu/apps/__APP__"], args()))
