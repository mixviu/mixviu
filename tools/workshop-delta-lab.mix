-- Disposable discovery specimen; never land this file.
fn difference($before,$after,$path=[])
  if deep_eq($before,$after) then return [] end
  if type($before)=="map" and type($after)=="map" then
    $out=[]
    for $k in keys($before)
      if not has_key($after,$k) then push($out,{op:"remove",path:concat($path,[$k])}) end
    end
    for $k in keys($after)
      if has_key($before,$k) then $out=concat($out,difference($before[$k],$after[$k],concat($path,[$k])))
      else push($out,{op:"set",path:concat($path,[$k]),value:$after[$k]}) end
    end
    return $out
  end
  if type($before)=="list" and type($after)=="list" then
    -- Traffic's presentation ids are positional. Learn whether preserving
    -- overlapping rows plus tiny id edits beats replacing the entire list.
    if len($before)>1 and len($after)>1 and type($before[0])=="map" and has_key($before[0],"id") then
      for $drop=1 to len($before)-1
        $overlap=min(len($before)-$drop,len($after))
        if not deep_eq(delete($before[$drop],"id"),delete($after[0],"id")) then continue end
        $equal=true
        for $i=0 to $overlap-1
          if not deep_eq(delete($before[$drop+$i],"id"),delete($after[$i],"id")) then $equal=false;break end
        end
        if $equal then
          $out=[{op:"splice",path:$path,index:0,remove:$drop,items:[]}]
          for $i=0 to $overlap-1
            if $before[$drop+$i].id!=$after[$i].id then push($out,{op:"set",path:concat($path,[$i,"id"]),value:$after[$i].id}) end
          end
          push($out,{op:"splice",path:$path,index:$overlap,remove:len($before)-$drop-$overlap,items:slice($after,$overlap)})
          return $out
        end
      end
    end
    $prefix=0;$suffix=0
    while $prefix<min(len($before),len($after)) and deep_eq($before[$prefix],$after[$prefix]) $prefix=$prefix+1 end
    while $suffix<min(len($before),len($after))-$prefix and deep_eq($before[len($before)-1-$suffix],$after[len($after)-1-$suffix]) $suffix=$suffix+1 end
    return [{op:"splice",path:$path,index:$prefix,remove:len($before)-$prefix-$suffix,items:slice($after,$prefix,len($after)-$suffix)}]
  end
  return [{op:"set",path:$path,value:$after}]
end
fn apply_one($value,$parts,$op)
  if len($parts)>0 then
    $k=$parts[0]
    if len($parts)==1 and $op.op=="remove" then return delete($value,$k) end
    $value[$k]=apply_one($value[$k],slice($parts,1),$op)
    return $value
  end
  if $op.op=="set" then return $op.value end
  if $op.op=="splice" then return concat(concat(slice($value,0,$op.index),$op.items),slice($value,$op.index+$op.remove)) end
  raise("LAB","unknown operation")
end
$paths=sort(glob("target/workshop-model-captures/*.json"))
if len($paths)==0 then raise("LAB","no captured models; refusing a vacuous replay") end
$previous={}
for $path in $paths
  $next=json_parse(read_file($path));$start=monotonic();$ops=difference($previous,$next);$diff_ms=(monotonic()-$start)*1000
  $start=monotonic();$replayed=$previous
  for $op in $ops $replayed=apply_one($replayed,$op.path,$op) end
  $apply_ms=(monotonic()-$start)*1000
  if not deep_eq($replayed,$next) then raise("LAB","replay differs from full model") end
  write_file($path..".patch",json_encode($ops))
  print({file:basename($path),full_bytes:byte_length(json_encode($next)),patch_bytes:byte_length(json_encode($ops)),operations:len($ops),diff_ms:$diff_ms,apply_ms:$apply_ms,equivalent:true})
  $previous=$next
end
