-- SPDX-License-Identifier: MIT OR Apache-2.0
$proc = require("proc.mix")
$cli = getopt(args(), {seconds:{arg:true}, output:{arg:true}, workload:{arg:true}, node:{arg:true}, steps:{arg:true}, workloads:{arg:true}})
if len($cli.errors) > 0 or len($cli.rest) == 0 or $cli.opts.output == nil then
  raise("USAGE", "mix tools/bench/viu_baseline.mix --output result.json [--seconds 60] [--workload NAME] [--node ID --steps N] [--workloads FILE] PID|SERVICE ...")
end
$seconds = to_number($cli.opts.seconds ?? "60")
if $seconds <= 0 or $seconds > 86400 then raise("ARGUMENT", "seconds must be in (0, 86400]") end
$name = $cli.opts.workload ?? "idle"
$workloads = load_data(dirname(realpath($0)) .. "/workloads.conf.mix")
if $cli.opts.workloads != nil then
  $workloads = merge($workloads, load_data($cli.opts.workloads))
end
$work = $workloads[$name]
if $work == nil or not contains(["idle", "scroll"], $work.kind) then raise("WORKLOAD", "unknown workload") end
if $cli.opts.steps != nil then $work.steps = $proc.number($cli.opts.steps) end
if $work.kind == "scroll" then
  $work = validate($work, {kind:{type:"string"}, steps:{type:"number"}, dy:{type:"number"}, pause_seconds:{type:"number"}})
  if $work.steps < 1 or $work.steps > 100000 or floor($work.steps) != $work.steps or $work.pause_seconds < 0 then raise("WORKLOAD", "invalid scroll bounds") end
end
if $work.kind == "scroll" and $cli.opts.node == nil then raise("WORKLOAD", "scroll requires --node (AccessKit id)") end
fn rpc($service, $suffix, $body)
  $command = $service .. "." .. $suffix
  $payload = json_encode($body)
  send $service $command body=$payload timeout=2
  if $rc != 0 then return {available:false, rc:$rc} end
  $value = $result
  if type($value) == "string" then $value = json_parse($value) end
  return $value
end
fn inventory()
  send noded noded.list timeout=2
  if $rc != 0 then raise("BUS", "cannot read local service inventory") end
  $v = $result
  if type($v) == "string" then $v = json_parse($v) end
  if type($v) == "map" then return $v.services end
  return $v
end
$hz = run_argv_must(["getconf", "CLK_TCK"])
$hz = $proc.number(trim($hz))
$services = []
try $services = inventory() catch $m $services = [] end
$targets = []
for $target in $cli.rest
  $pid = nil
  $service = nil
  $sha = nil
  if re_match($target, "^[0-9]+$") then
    $pid = $proc.number($target)
    for $entry in $services
      if type($entry) == "map" and $entry.pid == $pid and $service == nil then
        $service = $entry.name
        $sha = $entry.git_sha
      end
    end
  else
    for $entry in $services
      if type($entry) == "map" and $entry.name == $target then
        $pid = $entry.pid
        $sha = $entry.git_sha
        $service = $target
      end
    end
  end
  if $pid == nil or $pid <= 0 then raise("TARGET", "no readable local pid for " .. $target) end
  $exe = read_link("/proc/" .. to_string($pid) .. "/exe")
  $size = stat("/proc/" .. to_string($pid) .. "/exe").size
  $build_id = nil
  if which("readelf") != nil then
    $r = run_argv(["readelf", "-n", "/proc/" .. to_string($pid) .. "/exe"])
    $matches = re_find($r.stdout, "Build ID: ([0-9a-fA-F]+)")
    if len($matches) > 0 then $build_id = $matches[0].groups[0] end
  end
  $stats = {available:false}
  if $service != nil then $stats = rpc($service, "ui.stats", {}) end
  if $work.kind == "scroll" and $service == nil then raise("WORKLOAD", "scroll needs a service target") end
  push($targets, {target:$target, pid:$pid, service:$service, executable:$exe, executable_bytes:$size,
    build_id:$build_id, git_sha:$sha, frames_before:$stats, before:$proc.snapshot($pid)})
end
sleep($seconds)
$runs = {}
if $work.kind == "scroll" then
  for $t in $targets
    $tree = rpc($t.service, "ui.tree", {id:$cli.opts.node})
    -- Locate the explicit node; the drive's scroll contract takes a point.
    $nodes = $tree.nodes ?? []
    $rect = nil
    for $n in $nodes
      if to_string($n.id) == $cli.opts.node or $n.label == $cli.opts.node then
        if $rect != nil then raise("WORKLOAD", "ambiguous node; use its id") end
        $rect = $n.rect
      end
    end
    if $rect == nil then raise("WORKLOAD", "scroll node is absent or has no rectangle") end
    $frames_start = rpc($t.service, "ui.stats", {})
    $started = monotonic()
    $started_unix = time()
    for $i = 1 to $work.steps
      $r = rpc($t.service, "ui.scroll", {x:($rect[0]+$rect[2])/2, y:($rect[1]+$rect[3])/2, dx:0, dy:$work.dy})
      if $r.available == false then raise("WORKLOAD", "ui.scroll failed") end
      sleep($work.pause_seconds)
    end
    $ended = monotonic()
    $ended_unix = time()
    $frames_end = rpc($t.service, "ui.stats", {})
    $run = {started_unix_seconds:$started_unix, ended_unix_seconds:$ended_unix, elapsed_seconds:$ended-$started,
      frames_before:$frames_start, frames_after:$frames_end}
    if $frames_start.available == true and $frames_end.available == true and $frames_start.frames_drawn != nil and $frames_end.frames_drawn != nil then
      $run.frames_drawn = $frames_end.frames_drawn - $frames_start.frames_drawn
      if $run.elapsed_seconds > 0 then $run.frames_per_second = $run.frames_drawn / $run.elapsed_seconds end
      if $frames_start.cpu_frame_total_ms != nil and $frames_end.cpu_frame_total_ms != nil then
        $run.cpu_frame_total_ms = $frames_end.cpu_frame_total_ms - $frames_start.cpu_frame_total_ms
        if $run.frames_drawn > 0 then $run.cpu_frame_mean_ms = $run.cpu_frame_total_ms / $run.frames_drawn end
      end
    end
    $runs[to_string($t.pid)] = $run
  end
end
$rows = []
for $t in $targets
  $after = $proc.snapshot($t.pid)
  $b = $t.before
  if $b.cpu.start != $after.cpu.start then raise("TARGET", "pid reused") end
  $elapsed = $after.at - $b.at
  $cpu_seconds = ($after.cpu.ticks - $b.cpu.ticks) / $hz
  $switches = {}
  $thread_rates = {}
  if len(keys($b.threads)) != len(keys($after.threads)) then raise("TARGET", "thread set changed during sample; retry") end
  for $key in ["voluntary_ctxt_switches", "nonvoluntary_ctxt_switches"]
    $total = 0
    for $tid in keys($b.threads)
      if $after.threads[$tid] == nil then raise("TARGET", "thread exited during sample; retry") end
      $delta = $after.threads[$tid][$key] - $b.threads[$tid][$key]
      if $delta < 0 then raise("TARGET", "thread identity changed; retry") end
      if $thread_rates[$tid] == nil then $thread_rates[$tid] = {} end
      $thread_rates[$tid][$key] = $delta / $elapsed
      $total = $total + $delta
    end
    $switches[$key] = $total / $elapsed
  end
  $t.elapsed_seconds = $elapsed
  $t.cpu_seconds = $cpu_seconds
  $t.cpu_percent_one_core = 100 * $cpu_seconds / $elapsed
  $t.context_switches_per_second = $switches
  $t.thread_context_switches_per_second = $thread_rates
  $t.after = $after
  $t.workload_run = $runs[to_string($t.pid)]
  $t.frames_after = if $t.service != nil then rpc($t.service, "ui.stats", {}) else {available:false} end
  push($rows, $t)
end
write_file($cli.opts.output, json_encode({schema:"viu.baseline.v1", collector_mix:mix_version(), created_unix_seconds:time(), workload:$name, workload_definition:$work, idle_seconds:$seconds, clk_tck:$hz, targets:$rows}))
print("| Target | RSS KiB | PSS KiB | Private dirty KiB | Swap KiB | CPU % | voluntary/s | involuntary/s | Threads | Bytes |")
print("|---|---:|---:|---:|---:|---:|---:|---:|---:|---:|")
for $t in $rows
  $m = $t.after.memory_kib
  print("| " .. $t.target .. " | " .. $m.Rss .. " | " .. $m.Pss .. " | " .. $m.Private_Dirty .. " | " .. $m.Swap .. " | " .. $t.cpu_percent_one_core .. " | " .. $t.context_switches_per_second.voluntary_ctxt_switches .. " | " .. $t.context_switches_per_second.nonvoluntary_ctxt_switches .. " | " .. $t.after.status.Threads .. " | " .. $t.executable_bytes .. " |")
end
