-- CBC worker with the headless Weston capability.
for $cmd in [["cargo", "build", "-p", "mix"],
  ["cargo", "build", "-p", "viu"],
  ["cargo", "build", "-p", "viud"],
  ["cargo", "build", "-p", "mixd"],
  ["target/debug/mix", "tools/bench/headless_test.mix"]]
  $r = run_argv($cmd, {timeout:3600, stderr:"stdout"})
  print($r.stdout)
  if $r.exit_code != 0 then exit($r.exit_code) end
end
