-- SPDX-License-Identifier: MIT OR Apache-2.0
-- CBC-only end-to-end collector test through the chooser's native harness.
$n = require("../../tests/desktop/nested_host_lib.mix")
$pb = require("../../tests/lib/private_bus.mix")
$root = dirname(dirname(dirname(realpath($0))))
$bin = env("MIX_TEST_BIN", $root .. "/target/debug")
$run = $n.new_run("/tmp/viu-baseline")
$bus = nil
$session = nil
$app = nil
$passed = false
try
  -- mixd dispatches by executable name.
  run_argv_must(["ln", "-s", $bin .. "/mixd", $run.path .. "/noded"])
  $bus = $n.private_bus({dir:$run.path .. "/broker", name:"baseline-test", noded:$run.path .. "/noded"})
  $session = $n.start({bin:$bin .. "/viud", run:$run, config:$root .. "/tests/desktop/smoke-settings.json"})
  if not $n.wait_ready($session,40) then raise("HEADLESS", "viud failed: " .. $session.log) end
  $client = $n.client_env($session, merge($pb.client_env($bus), {HOME:$run.path .. "/home",
    XDG_CONFIG_HOME:$run.path .. "/config", XDG_STATE_HOME:$run.path .. "/state", XDG_CACHE_HOME:$run.path .. "/cache",
    LIBGL_ALWAYS_SOFTWARE:"1", LP_NUM_THREADS:"2", RAYON_NUM_THREADS:"2", WGPU_BACKEND:"gl", MESA_VK_WSI_PRESENT_MODE:"mailbox"}))
  $app = spawn([$bin .. "/viu", "run", $root .. "/apps/gallery", $run.path .. "/profile"],
    {env:$client, stdout:{file:$run.path .. "/app.log"}, stderr:"stdout", detach:true})
  $ready = false
  for $i = 1 to 200
    $s = $n.call("gallery", "gallery.ui.stats", {})
    if $s.rc == 0 and ($s.result.frames_drawn ?? 0) > 0 then $ready = true; break end
    sleep(0.1)
  end
  if not $ready then raise("HEADLESS", "app drew no observed frame: " .. $run.path .. "/app.log") end
  $first = $s.result.frames_drawn
  $scroll = $n.call("gallery", "gallery.ui.scroll", {x:200,y:200,dx:0,dy:40})
  $drawn = $n.call("gallery", "gallery.ui.stats", {})
  if $scroll.rc != 0 or $drawn.result.frames_drawn <= $first then raise("FRAMES", "input did not advance drawn frame count") end
  sleep(3)
  $out = $run.path .. "/baseline.json"
  $result = run_argv([$bin .. "/mix", $root .. "/tools/bench/viu_baseline.mix", "--seconds", "2", "--output", $out, "gallery"], {timeout:30})
  print($result.stdout)
  if $result.exit_code != 0 then raise("BASELINE", $result.stderr) end
  $json = json_parse(read_file($out))
  $t = $json.targets[0]
  if $t.frames_before.frames_drawn != $t.frames_after.frames_drawn then raise("IDLE", "idle app drew frames") end
  print(read_file($out))
  -- The process-only path also runs with installed gold Mix and no broker.
  $pid_out = $run.path .. "/pid.json"
  $pid_result = run_argv(["mix", $root .. "/tools/bench/viu_baseline.mix", "--seconds", "0.2", "--output", $pid_out, to_string($app)],
    {timeout:10, env:{MIX_NODED_URL:"ws://127.0.0.1:1/ws"}})
  if $pid_result.exit_code != 0 then raise("GOLD_PROC", $pid_result.stderr) end
  $tree = $n.call("gallery", "gallery.ui.tree", {})
  $node = nil
  for $item in $tree.result.nodes
    if $item.rect != nil then $node = $item.id; break end
  end
  if $node == nil then raise("SCROLL", "no bounded node in real widget tree") end
  $scroll_out = $run.path .. "/scroll.json"
  $scroll_result = run_argv([$bin .. "/mix", $root .. "/tools/bench/viu_baseline.mix", "--seconds", "0.1",
    "--workload", "scroll", "--steps", "2", "--node", $node, "--output", $scroll_out, "gallery"], {timeout:30})
  if $scroll_result.exit_code != 0 then raise("SCROLL", $scroll_result.stderr) end
  $scroll_json = json_parse(read_file($scroll_out))
  $st = $scroll_json.targets[0]
  if $st.frames_after.frames_drawn <= $st.frames_before.frames_drawn then raise("SCROLL", "named workload drew no frames") end
  print("PASS idle, named scroll workload, and broker-free installed-Mix process sampling")
  $passed = true
finally
  if $app != nil and process_alive($app) then kill($app,15) end
  if $session != nil then $n.stop($session) end
  if $bus != nil then $pb.stop($bus) end
  $n.finish_run($run,$passed)
end
