-- SPDX-License-Identifier: MIT OR Apache-2.0
-- Run on an owned CBC checkout; return formatting as a reviewable patch.
try
  for $cmd in [["cargo", "fmt", "-p", "toolkit", "-p", "lib-viu"],
    ["cargo", "fmt", "--manifest-path", "vendor/eframe/Cargo.toml"],
    ["cargo", "fmt", "--manifest-path", "vendor/egui-wgpu/Cargo.toml"]]
    $r = run_argv($cmd, {timeout:120, stderr:"stdout"})
    print($r.stdout)
    if $r.exit_code != 0 then exit($r.exit_code) end
  end
  print("BASELINE_FMT_BEGIN")
  print(run_argv_must(["git", "diff"]).stdout)
  print("BASELINE_FMT_END")
finally
  run_argv_must(["git", "checkout", "-q", "--", "."])
end
