-- CBC only; compare the two existing contracts without changing tests.
$commands = [
  ["cargo", "test", "-p", "world", "--lib", "an_unengaged_press_is_not_consumed_and_another_output_resets", "--locked"],
  ["cargo", "test", "-p", "scene-host", "--lib", "hotspot_click_is_consumed_before_dwell_and_fires_on_release", "--locked"]
]
for $command in $commands
  print("STEP_BEGIN " .. join($command, " "))
  $r = run_argv(concat(["env", "CARGO_BUILD_JOBS=6"], $command), {timeout: 1800, max_output: 64000000})
  print($r.stdout)
  print($r.stderr)
  print("STEP_RC=" .. to_string($r.exit_code) .. " " .. join($command, " "))
  if $r.exit_code != 0 then exit($r.exit_code) end
end
