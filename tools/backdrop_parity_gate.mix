-- version: 0.1.0
-- CBC only. Contract checkpoint, not full app or visual acceptance.
if contains(args(),"--prepare") then
  print(run_argv(["cargo","fmt","-p","viu"]))
  print("==LOCKDIFF==")
  print(run_argv_must(["git","diff","--binary"]))
  print("==ENDLOCKDIFF==")
  print(run_argv_must(["git","checkout","-q","--","."]))
end
for $case in ["core","document","schedule","launch","engine"]
  $result=run_argv(["/opt/mixos/bin/mix","apps/backdrop/"..$case.."-test.mix"])
  print($result)
  if not $result.ok then exit($result.exit_code ?? 1) end
end
for $file in ["app","core","document","document-test","schedule","schedule-test","launch","launch-test","engine","engine-test","projection","runtime","decode-job"]
  $argv=["/opt/mixos/bin/mix","lint","apps/backdrop/"..$file..".mix"]
  for $builtin in ["viu_context","viu_app_dirs","viu_read_optional","viu_raster","viu_reply","viu_ui_state","viu_store","viu_timer","viu_action_event"] push($argv,"--allow-function");push($argv,$builtin) end
  $result=run_argv($argv)
  print($result)
  if not $result.ok then exit($result.exit_code ?? 1) end
end
for $argv in [["cargo","fmt","-p","viu","--","--check"],["cargo","test","--locked","-p","viu","--lib","raster"],["cargo","test","--locked","-p","viu","--test","app_ports","--test","backdrop"],["cargo","clippy","--locked","-p","viu","--all-targets"]]
  if contains(args(),"--prepare") and $argv[1]=="fmt" then continue end
  $result=run_argv($argv,{timeout:3600,max_output:16000000,env:{CARGO_BUILD_JOBS:"4"}})
  print($result)
  if not $result.ok then exit($result.exit_code ?? 124) end
end
