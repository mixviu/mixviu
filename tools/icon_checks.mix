-- Run only through CBC. Snapshot candidates before fmt so even pre-existing
-- edits in a formatted file are preserved. Restore only files fmt changed.
$files = filter(lines(trim(run_argv_must(["git", "ls-files", "--cached", "--others", "--", "engines/viu", "libraries/icons"]))), fn($f) = ends_with($f, ".rs"))
$before = {}
for $f in $files $before[$f] = read_file($f) end
$fmt = run_argv(["cargo", "fmt", "-p", "viu", "-p", "icons"], {timeout:120})
print($fmt.stdout)
print($fmt.stderr)
$changed = []
for $f in $files
  if not is_file($f) or read_file($f) != $before[$f] then push($changed, $f) end
end
if len($changed) > 0 then
  print("FMT_PATCH_BEGIN")
  $diff = run_argv(concat(["git", "diff", "--"], $changed))
  print($diff.stdout)
  print($diff.stderr)
  print("FMT_PATCH_END")
  for $f in $changed write_file($f, $before[$f]) end
  print("FORMAT_DRIFT=" .. to_string(len($changed)))
  exit(1)
end
if not $fmt.ok then exit($fmt.exit_code ?? 1) end
$r = run_argv(["env", "CARGO_BUILD_JOBS=2", "cargo", "test", "--locked", "-p", "viu", "-p", "icons", "--lib"], {timeout:3600})
print($r.stdout)
print($r.stderr)
if not $r.ok then exit($r.exit_code ?? 1) end
if contains(args(), "--frames") then
  $r = run_argv(["/opt/mixos/bin/mix", "tools/icon_frames.mix"], {timeout:3600, max_output:16000000})
  print($r.stdout)
  print($r.stderr)
  if not $r.ok then exit($r.exit_code ?? 1) end
end
$r = run_argv(["env", "CARGO_BUILD_JOBS=2", "cargo", "clippy", "--locked", "-p", "viu", "--lib"], {timeout:3600})
print($r.stdout)
print($r.stderr)
if not $r.ok then exit($r.exit_code ?? 1) end
