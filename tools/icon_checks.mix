-- Run only through CBC. Print and restore worker-only rustfmt changes.
$fmt = run_argv(["cargo", "fmt", "-p", "viu"], {timeout:120})
print($fmt.stdout)
print($fmt.stderr)
print(run_argv_must(["git", "diff"]))
print(run_argv_must(["git", "checkout", "-q", "--", "."]))
if not $fmt.ok then exit($fmt.exit_code ?? 1) end
$r = run_argv(["env", "CARGO_BUILD_JOBS=2", "cargo", "test", "--locked", "-p", "viu", "--lib"], {timeout:3600})
print($r.stdout)
print($r.stderr)
if not $r.ok then exit($r.exit_code ?? 1) end
$r = run_argv(["env", "CARGO_BUILD_JOBS=2", "cargo", "clippy", "--locked", "-p", "viu", "--lib"], {timeout:3600})
print($r.stdout)
print($r.stderr)
if not $r.ok then exit($r.exit_code ?? 1) end
