-- SPDX-License-Identifier: MIT OR Apache-2.0
-- Manual CBC regression soak. Invoke through cbc-build at a pushed commit.
-- No retry: the first failing process ends the run.
-- --backdrop soaks the whole backdrop target without building/running portal.
fn checked($argv)
  $r = run_argv($argv, {timeout: 900, max_output: 16000000})
  print($r.stdout)
  print($r.stderr)
  if not $r.ok then raise("CHECK_FAILED", json_encode($r)) end
  return $r.stdout
end

$backdrop_only = deep_eq(args(), ["--backdrop"])
if len(args()) != 0 and not $backdrop_only then raise("USAGE", "expected no arguments or --backdrop") end
$build = ["cargo", "test", "--locked", "-p", "lib-viu", "--test", "backdrop"]
if not $backdrop_only then $build = concat($build, ["-p", "portald", "--test", "portal"]) end
$built = checked(concat($build, ["--no-run", "--message-format=json"]))
$binaries = {}
for $line in split($built, "\n")
  if starts_with($line, "{") then
    $event = json_parse($line)
    if $event.reason == "compiler-artifact" and $event.executable != nil then
      $binaries[$event.target.name] = $event.executable
    end
  end
end
$cases = [
  {binary: "backdrop", test: "view_reply_survives_native_model_and_job_sends"},
  {binary: "backdrop", test: "backdrop_colours_modes_outputs_and_refusals_use_mix"},
  {binary: "backdrop", test: "decode_refusal_and_replaced_source_preserve_transactional_pixels_and_storage"},
  {binary: "backdrop", test: "slideshow_next_skips_failed_entries_and_keeps_source_document"},
  {binary: "portal", test: "native_recovers_when_broker_returns_after_the_initial_attempt_budget"},
  {binary: "portal", test: "native_startup_live_change_and_settingsd_restart_without_broker_reconnect"}
]
if $backdrop_only then $cases = [{binary: "backdrop", test: nil}] end
for $case in $cases
  $label = $case.test ?? $case.binary
  $argv = if $case.test == nil then [$binaries[$case.binary], "--nocapture"] else [$binaries[$case.binary], "--exact", $case.test, "--nocapture"] end
  for $iteration = 1 to 30
    print("SOAK " .. $label .. " " .. to_string($iteration))
    checked($argv)
  end
  $jobs = []
  for $copy = 1 to 8 push($jobs, $argv) end
  print("LOAD " .. $label .. " 8 concurrent copies")
  for $r in run_parallel($jobs, {max: 8, timeout: 180})
    print($r.stdout)
    print($r.stderr)
    print("elapsed_ms=" .. to_string($r.duration_ms))
    if not $r.ok then raise("LOAD_FAILED", json_encode($r)) end
  end
end
