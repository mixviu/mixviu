-- Fixture-only policy/replay tests. Each process finishes within 5 seconds.
$q = require("quarantine.mix")
$mix = realpath("/proc/self/exe")
$fixture = path_join(dirname(realpath(script_path())), "quarantine_fixture.mix")
$today = $q.day("2026-11-22")
fn entry($test)
  return {package: "fixture", target: "fixture", test: $test, owner: "owner",
    ledger: "ledger", evidence: "20 rounds, job", brief: "fix", cosign: "Fable",
    added: "2026-11-21", expires: "2026-11-28"}
end
fn check($ok, $why)
  if not $ok then raise("TEST", $why) end
end
fn rejects($f)
  $caught = false
  try
    $f()
  catch $err
    $caught = true
  end
  check($caught, "expected validation failure")
end
$temp = trim(run_argv_must(["mktemp", "-d", "/var/tmp/quarantine-test-XXXXXX"]))
fn fixture_entries($entries)
  $path = $temp .. "/fixture.conf.mix"
  write_file($path, data_encode({entries: $entries}))
  return $q.load($path, $today)
end
fn prepare_fixture($job, $entries)
  return $q.prepare($job, fixture_entries($entries), "fixture", "fixture", $today)
end
fn record_fixture($summary, $result)
  return {package: "fixture", target: "fixture", test: "module::tests::fixture",
    result: $result, expires: "2026-11-28", owner: "owner", summary: $summary}
end
try
  -- Clean standalone test stages have no target directory yet.
  $q.outside($temp .. "/records", nil)
  rejects(fn() = $q.outside($temp .. "/records", $temp))
  for $path in ["", $temp .. "/.", $temp .. "/..", $temp .. "/", $temp, "/proc/quarantine-records.jsonl"]
    rejects(fn() = $q.record_path($path, "/not-the-checkout", nil))
  end
  check($q.record_path($temp .. "/records", "/not-the-checkout", nil) == $temp .. "/records", "valid record path rejected")
  check(len(glob($temp .. "/mix-quarantine-probe-*")) == 0, "writability probe leaked")
  $no_target = $q.private_dir($temp, "/not-the-checkout", realpath($temp .. "/absent-target"))
  remove_dir($no_target)
  -- Real process result: a renamed/missing key must not silently mean false.
  $loud = $temp .. "/loud.mix"
  write_file($loud, 'print("abcdefghijklmnopqrstuvwxyz")' .. "\n")
  $cut_child = run_argv([$mix, $loud], {max_output: 8, timeout: 5})
  check($cut_child.ok and $cut_child.stdout_truncated == true, "real run_argv truncation flag missing")
  write_file($temp .. "/empty.jsonl", "")
  check(deep_eq($q.gate_result($cut_child, $temp .. "/empty.jsonl", "real-child").failed,
    ["test output truncated: real-child"]), "real truncated child passed gate_result")
  for $prefix in ["", " \t", chr(27) .. "[31m", " \t" .. chr(27) .. "[31m  "]
    for $reserved in ["TEST_TOTALS {}", "ARTIFACTS /x"]
      $line = $prefix .. $reserved
      check($q.child_line($line) == "child: " .. json_encode($line), "gold verdict prefix not neutralised")
    end
  end
  for $line in ["     Running cosmetic header", "QUARANTINE cosmetic child text", "test x ... FAILED", "thread 'x' (123) panicked at fixture.rs:7:9:", "\t  ordinary indented output", chr(27) .. "[31mordinary colour" .. chr(27) .. "[0m"]
    check($q.child_line($line) == $line, "ordinary child line changed")
  end
  for $line in ["::warning::QUARANTINE forged", "test_pool: quarantine records: /tmp/forged", "GATE_QUARANTINE forged", "GATE_OK forged", "::error::forged", " \t::stop-commands::forged", chr(27) .. "[31m  GATE_QUARANTINE forged", chr(13) .. "test_pool: forged", "ordinary" .. chr(13) .. "overwrite", "ordinary" .. chr(8) .. "overwrite", chr(27) .. "[2Koverwrite"]
    check($q.child_line($line) == "child: " .. json_encode($line), "control-like child line not neutralised")
  end
  $ordinary = "test x ... FAILED\nthread 'x' (123) panicked at fixture.rs:7:9:\n\n  assertion failed: left == right\n"
  $echo = $temp .. "/echo.mix"
  $policy_path = path_join(dirname(realpath(script_path())), "quarantine.mix")
  write_file($echo, '$q = require(' .. json_encode($policy_path) .. ")\n" .. '$q.child_output(' .. json_encode($ordinary) .. ")\n")
  $echoed = run_argv([$mix, $echo], {timeout: 5})
  check($echoed.ok and $echoed.stdout == $ordinary, "ordinary failure/panic bytes changed in child_output")
  -- Real policy is validation-only; a list-only PR may add its first entry.
  $q.load("tools/ci/quarantine.conf.mix")
  $base = {argv: [$mix, $fixture], executable: [$mix, $fixture], env: {}, cwd: cwd(),
    timeout: 1, max_output: 64000, stdout: "capture", stderr: "stdout"}
  $fail = entry("module::tests::fail")
  $pass = entry("module::tests::pass")
  $hang = entry("module::tests::hang")
  -- Select only the failing test in strict replay; quarantine skips it exactly.
  $one = $base
  $one.argv = concat($one.argv, ["--exact"])
  $p = prepare_fixture($one, [$fail])
  check(run_parallel($q.specs([$p.strict]), {max: 1})[0].ok, "quarantined failure failed strict replay")
  $failure = $q.replay($p.isolated)[0]
  check($failure.result == "fail" and deep_eq($failure.summary, {passed: 0, failed: 1, ignored: 0}), "failure summary wrong")
  $p = prepare_fixture($one, [$fail, $pass])
  check(run_parallel($q.specs([$p.strict]), {max: 1})[0].ok, "two entries or existing --exact duplicated libtest flag")
  -- A different failure in the same binary remains strict.
  $other = $base
  $other.argv = concat($other.argv, ["module::tests::other_fail", "--exact"])
  rejects(fn() = prepare_fixture($other, [$fail]))
  for $flags in [["--"], ["module"], ["--skip", "pass", "module"], ["--unknown"], ["--skip", $fail.test], ["--skip=module"], ["--exact", "--skip", $fail.test]]
    $filtered = $base
    $filtered.argv = concat($base.argv, $flags)
    rejects(fn() = prepare_fixture($filtered, [$fail]))
  end
  $strict_other = prepare_fixture($base, [$pass])
  check(not run_parallel($q.specs([$strict_other.strict]), {max: 1})[0].ok, "another failure masked")
  $p = prepare_fixture($base, [$hang])
  $js = $p.isolated
  $js[0].timeout = 0.1
  $timeout = $q.replay($js)[0]
  check($timeout.result == "timeout" and $timeout.summary == nil, "hang summary must be nil")
  $p = prepare_fixture($base, [$pass])
  check(deep_eq($q.replay($p.isolated)[0].summary, {passed: 1, failed: 0, ignored: 0}), "pass summary wrong")
  for $case in ["ignored", "missing"]
    $p = prepare_fixture($base, [entry("module::tests::" .. $case)])
    $record = $q.replay($p.isolated)[0]
    check($record.result == $case, "zero tests reported as pass")
    check(deep_eq($record.summary, {passed: 0, failed: 0, ignored: (if $case == "ignored" then 1 else 0 end)}), "final summary wrong")
  end
  $flagged = $base
  $flagged.argv = concat($base.argv, ["--include-ignored", "--test-threads", "1", "--nocapture"])
  $p = prepare_fixture($flagged, [entry("module::tests::ignored")])
  check(deep_eq($p.isolated[0].argv, concat($flagged.argv, ["--color", "never", "--format", "pretty", "--exact", "--", "module::tests::ignored"])), "harness flags lost")
  check($q.replay($p.isolated)[0].result == "pass", "include-ignored lost")
  for $flags in [["--format", "json", "--color", "always"], ["--format=terse", "--color=always"]]
    $styled = $base
    $styled.argv = concat($base.argv, $flags)
    $p = prepare_fixture($styled, [$pass])
    check(deep_eq($p.isolated[0].argv, concat($base.argv, ["--color", "never", "--format", "pretty", "--exact", "--", $pass.test])), "format/color not forced")
    check($q.replay($p.isolated)[0].result == "pass", "formatted replay misclassified")
  end
  $result = {ok: true, timed_out: false, stdout_truncated: false,
    stdout: "test result: ok. 1 passed; 0 failed; 0 ignored;\ntest result: ok. 0 passed; 0 failed; 0 ignored;"}
  check($q.classification($result) == "missing", "fake earlier summary won")
  $result.stdout = "prefix test result: ok. 1 passed; 0 failed; 0 ignored;"
  check($q.classification($result) == "missing", "unanchored summary accepted")
  $result.stdout = "test result: ok. 1 passed; 0 failed; 0 ignored;"
  $result.stdout_truncated = true
  check($q.classification($result) == "missing", "truncated output reported pass")
  -- No full summary here, independently of truncation/signal.
  check($q.summary($result) == nil, "incomplete summary accepted")
  $result.stdout_truncated = false
  $result.signal = 9
  check($q.summary($result) == nil, "crash summary accepted")
  $result.signal = nil
  $result.stdout = "no summary"
  check($q.summary($result) == nil, "absent summary accepted")
  $stream = "test result: FAILED. 8 passed; 2 failed; 3 ignored; 0 measured; 5 filtered out\n"
  $stream = $stream .. "test result: FAILED. 0 passed; 1 failed; 0 ignored; 0 measured; 9 filtered out\n"
  $stream = $stream .. "test result: ok. 1 passed; 0 failed; 0 ignored; 0 measured; 9 filtered out\n"
  $stream = $stream .. "test result: ok. 0 passed; 0 failed; 1 ignored; 0 measured; 9 filtered out\n"
  $records_path = $temp .. "/counts.jsonl"
  $counts = [record_fixture({passed: 0, failed: 1, ignored: 0}, "fail"),
    record_fixture({passed: 1, failed: 0, ignored: 0}, "pass"),
    record_fixture({passed: 0, failed: 0, ignored: 1}, "ignored"), record_fixture(nil, "timeout")]
  write_file($records_path, join(map($counts, fn($r) = json_encode($r)), "\n") .. "\n")
  $report = $q.gate_report($stream, $records_path, "workspace")
  check(deep_eq($report.totals, {passed: 8, failed: 2, ignored: 3, filtered: 32, quarantined: {passed: 1, failed: 1, ignored: 1}}), "gate totals arithmetic wrong")
  check(len($report.failed) == 0 and len($report.records) == 4, "gate records lost")
  check(len(filter($report.records, fn($r) = $r.step != "workspace")) == 0, "step missing")
  -- The missing tail may contain isolated summaries. None may be subtracted,
  -- even when the observed strict counts are large enough to hide the loss.
  for $output in [$stream, "test result: FAILED. 8 passed; 2 failed; 3 ignored; 0 measured; 5 filtered out\n", ""]
    $r = {stdout: $output, stdout_truncated: true, ok: true}
    $cut = $q.gate_result($r, $records_path, "workspace")
    $observed = if $output == $stream then {passed: 9, failed: 3, ignored: 4, filtered: 32} elif $output == "" then {passed: 0, failed: 0, ignored: 0, filtered: 0} else {passed: 8, failed: 2, ignored: 3, filtered: 5} end
    check(deep_eq($cut.failed, ["test output truncated: workspace"]), "truncation must fail even with rc 0")
    for $k in keys($observed)
      check($cut.totals[$k] == $observed[$k], "truncated stream subtracted " .. $k)
    end
    check(deep_eq($cut.totals.quarantined, {passed: 0, failed: 0, ignored: 0}), "truncated stream moved counts")
    check(deep_eq($cut.records, $report.records), "truncated stream lost completion records")
  end
  $whole = $q.gate_result({stdout: $stream, stdout_truncated: false}, $records_path, "workspace")
  check(deep_eq($whole, $report), "complete step accounting changed")
  $missing = $q.gate_report($stream, $temp .. "/absent.jsonl", "mix")
  check(deep_eq($missing.failed, ["quarantine records missing: mix"]), "missing records not reported")
  write_file($records_path, "")
  $empty = $q.gate_report($stream, $records_path, "mix")
  check(len($empty.failed) == 0 and len($empty.records) == 0 and $empty.totals.failed == 3, "empty list changed totals")
  $strict = "test result: FAILED. 8 passed; 2 failed; 3 ignored; 0 measured; 5 filtered out\n"
  $final_fail = "test result: FAILED. 0 passed; 1 failed; 0 ignored; 0 measured; 0 filtered out"
  $raw = {ok: false, timed_out: false, stdout_truncated: false, signal: nil, stdout: ""}
  for $fake in ["test result: FAILED. 0 passed; 100 failed; 0 ignored;",
      $final_fail .. chr(13), $final_fail .. chr(8), $final_fail .. "; finished in 0.01s" .. chr(27),
      $final_fail .. " trailing junk",
      "test result: FAILED. 0 passed; 100 failed; 0 ignored; 0 measured; 0 filtered out",
      "test result: FAILED. 1 passed; 0 failed; 0 ignored; 0 measured; 0 filtered out"]
    $raw.stdout = $fake .. "\n"
    $s = $q.summary($raw)
    check($s == nil, "forged, over-bound or result-inconsistent summary accepted")
    write_file($records_path, json_encode(record_fixture($s, "fail")) .. "\n")
    $output = $strict .. $q.child_line($fake) .. "\n"
    $report = $q.gate_report($output, $records_path, "mix")
    check($report.totals.failed >= 2 and $report.totals.quarantined.failed == 0, "fake summary laundered strict failures")
  end
  -- Both parsers accept the real libtest tail, and only a final summary wins.
  check($q.parse_summary($final_fail .. "; finished in 0.01s").failed == 1, "real libtest tail rejected")
  $raw.stdout = $final_fail .. "\ntest result: FAILED. 0 passed; 100 failed; 0 ignored;\n"
  check($q.summary($raw) == nil, "earlier complete summary won over invalid final summary")
  for $mode in ["timeout", "signal", "truncated"]
    $raw.stdout = $final_fail .. "; finished in 0.01s\n"
    $raw.timed_out = $mode == "timeout"
    $raw.signal = if $mode == "signal" then 9 else nil end
    $raw.stdout_truncated = $mode == "truncated"
    $s = $q.summary($raw)
    check(deep_eq($s, {passed: 0, failed: 1, ignored: 0}), "printed summary lost after " .. $mode)
    write_file($records_path, json_encode(record_fixture($s, $q.classification($raw))) .. "\n")
    $report = $q.gate_report($strict .. $raw.stdout, $records_path, "workspace")
    check($report.totals.failed == 2 and $report.totals.quarantined.failed == 1 and len($report.failed) == 0, "printed summary not moved exactly once")
  end
  -- A real child prints its final summary, then hangs until the timeout.
  write_file($echo, "print(" .. json_encode($final_fail) .. ")\nsleep(2000)\n")
  $late = $base
  $late.argv = [$mix, $echo]
  $late.entry = $fail
  $late.timeout = 0.3
  $late_record = $q.replay([$late])[0]
  check($late_record.result == "timeout" and deep_eq($late_record.summary, {passed: 0, failed: 1, ignored: 0}), "real post-summary timeout lost counts")
  write_file($records_path, json_encode($late_record) .. "\n")
  $report = $q.gate_report($strict .. $final_fail .. "\n", $records_path, "mix")
  check($report.totals.failed == 2 and $report.totals.quarantined.failed == 1, "real timeout summary not moved once")
  write_file($records_path, json_encode(record_fixture({passed: 0, failed: 1, ignored: 0}, "fail")) .. "\n")
  $report = $q.gate_report("", $records_path, "mix")
  check(deep_eq($report.failed, ["quarantine totals underflow: mix"]), "underflow not reported")
  check($report.totals.failed == 0 and $report.totals.quarantined.failed == 0, "underflow subtraction applied")
  -- Each invalid record is caught; a later valid record is still processed.
  $invalid_records = ["{broken", "null", "[]", "1", json_encode({summary: nil})]
  for $field in keys(record_fixture(nil, "timeout"))
    $invalid = record_fixture(nil, "timeout")
    $invalid = delete($invalid, $field)
    push($invalid_records, json_encode($invalid))
    $invalid = record_fixture(nil, "timeout")
    $invalid[$field] = 12
    push($invalid_records, json_encode($invalid))
  end
  for $s in [{passed: -1, failed: 0, ignored: 0}, {passed: 0, failed: 100, ignored: 0},
      {passed: 0.5, failed: 0, ignored: 0}, {passed: 1, failed: 1, ignored: 0},
      {passed: 1, failed: 0, ignored: 0}, {failed: 1}, []]
    push($invalid_records, json_encode(record_fixture($s, "fail")))
  end
  $invalid = record_fixture(nil, "unknown")
  push($invalid_records, json_encode($invalid))
  for $line in $invalid_records
    write_file($records_path, $line .. "\n" .. json_encode(record_fixture({passed: 0, failed: 1, ignored: 0}, "fail")) .. "\n")
    $report = $q.gate_report($final_fail .. "\n", $records_path, "mix")
    check(deep_eq($report.failed, ["quarantine record invalid: mix"]), "invalid record did not fail cleanly")
    check(len($report.records) == 1 and $report.totals.quarantined.failed == 1, "invalid record stopped later processing")
  end
  $gate = read_file("tools/cutover_gate.mix")
  $verdict = index_of($gate, 'print("TEST_TOTALS ')
  $records_line = index_of($gate, 'print("GATE_QUARANTINE_RECORDS ')
  $failed_line = index_of($gate, 'print("GATE_FAILED ')
  check($verdict > index_of($gate, 'print("STEP_RC="') and $records_line > $verdict and $failed_line > $records_line, "verdict order wrong")
  $tail = substr($gate, $verdict)
  check(len(re_find($tail, "gate_step\\(|run_argv|env_mx_bundle_probe\\(|STEP_RC=|STEP_BEGIN")) == 0, "child step after verdict")
  check(len(split($gate, 'print("TEST_TOTALS ')) == 2 and len(split($gate, 'print("GATE_QUARANTINE_RECORDS ')) == 2, "duplicate authoritative verdict")
  for $name in ["module::tests::typo", "tests::fail", "module::tests::fa"]
    rejects(fn() = prepare_fixture($base, [entry($name)]))
  end
  $expired = $fail
  $expired.added = "2026-11-08"
  $expired.expires = "2026-11-22"
  fixture_entries([$expired])
  $p = prepare_fixture($one, [$expired])
  check(len($p.isolated) == 0 and not run_parallel($q.specs([$p.strict]), {max: 1})[0].ok, "expired test not strict")
  $p = prepare_fixture($other, [$expired])
  check(deep_eq($p.strict, $other), "expired entry rejected or changed existing filter")
  $long = $fail
  $long.expires = "2026-12-06"
  rejects(fn() = fixture_entries([$long]))
  rejects(fn() = fixture_entries([entry("--nocapture")]))
  for $field in keys($fail)
    for $control in [chr(0), chr(10), chr(13), chr(27), chr(127), chr(133)]
      $bad_string = $fail
      $bad_string[$field] = $bad_string[$field] .. $control
      rejects(fn() = fixture_entries([$bad_string]))
    end
  end
  $renewed = $expired
  $renewed.renewals = [{until: "2026-11-29", by: "fable", evidence: "fresh-1", cosign: "Fable"}]
  for $control in [chr(0), chr(10), chr(13), chr(27), chr(127), chr(133)]
    for $field in ["until", "by", "evidence", "cosign"]
      $invalid = $renewed
      $invalid.renewals[0][$field] = $invalid.renewals[0][$field] .. $control
      rejects(fn() = fixture_entries([$invalid]))
    end
    $invalid = $renewed
    $invalid["bad" .. $control] = "key"
    rejects(fn() = fixture_entries([$invalid]))
    $invalid = $renewed
    $invalid.renewals[0]["bad" .. $control] = "nested key"
    rejects(fn() = fixture_entries([$invalid]))
  end
  $invalid = $renewed
  $invalid.renewals[0].evidence = "  20   rounds,   job  "
  rejects(fn() = fixture_entries([$invalid]))
  check(len(prepare_fixture($base, [$renewed]).isolated) == 1, "effective expiry not used")
  check($q.expiry_date($renewed) == "2026-11-29", "wrong effective expiry")
  $twice = $renewed
  $twice.renewals = concat($twice.renewals, [{until: "2026-12-06", by: "mark", evidence: "fresh-2", cosign: "Mark"}])
  fixture_entries([$twice])
  check($q.effective_expiry($twice) == $q.day($twice.added) + 28, "28-day boundary rejected")
  check(len($q.prepare($base, [$renewed], "fixture", "fixture", $q.day("2026-11-29")).isolated) == 0, "renewal expiry not strict")
  $one_day = $renewed
  $one_day.renewals[0].until = "2026-11-23"
  fixture_entries([$one_day])
  $invalid = $twice
  $invalid.expires = "2026-11-23"
  rejects(fn() = fixture_entries([$invalid]))
  $invalid = $twice
  $invalid.renewals[1].until = "2026-12-07"
  rejects(fn() = fixture_entries([$invalid]))
  for $field in ["by", "evidence", "cosign", "until"]
    $values = if $field == "by" then ["", "mark"] elif $field == "evidence" then ["", $fail.evidence] elif $field == "until" then ["", "wrong", "2026-11-22", "2026-11-30"] else [""] end
    for $value in $values
      $invalid = $renewed
      $invalid.renewals[0][$field] = $value
      rejects(fn() = fixture_entries([$invalid]))
    end
  end
  $invalid = $twice
  $invalid.renewals[1].evidence = "fresh-1"
  rejects(fn() = fixture_entries([$invalid]))
  $invalid.renewals[0].evidence = "fresh    evidence"
  $invalid.renewals[1].evidence = " fresh evidence "
  rejects(fn() = fixture_entries([$invalid]))
  $invalid = $twice
  $invalid.renewals = concat($invalid.renewals, [$invalid.renewals[1]])
  rejects(fn() = fixture_entries([$invalid]))
  $bad = $fail
  $bad.added = "2026-02-30"
  rejects(fn() = fixture_entries([$bad]))
  $future = $fail
  $future.added = "2026-11-23"
  $future.expires = "2026-11-30"
  rejects(fn() = fixture_entries([$future]))
  $metadata = {workspace_members: ["fixture-id", "unselected-id"], packages: [
    {id: "fixture-id", name: "fixture"}, {id: "unselected-id", name: "unselected"},
    {id: "dependency-id", name: "dependency"}]}
  $q.validate_packages(fixture_entries([$fail]), $metadata)
  $unselected = $fail
  $unselected.package = "unselected"
  $q.validate_packages(fixture_entries([$unselected]), $metadata)
  for $package in ["fxiture", "dependency"]
    $unknown = $fail
    $unknown.package = $package
    rejects(fn() = $q.validate_packages(fixture_entries([$unknown]), $metadata))
  end
  for $field in keys($fail)
    $missing = $fail
    $missing = delete($missing, $field)
    rejects(fn() = fixture_entries([$missing]))
  end
  rejects(fn() = fixture_entries([$fail, $fail]))
  rejects(fn() = fixture_entries([$fail, $pass, $hang]))
  $six = []
  for $i = 1 to 6
    $e = $fail
    $e.package = to_string($i)
    push($six, $e)
  end
  rejects(fn() = fixture_entries($six))
  check(len(fixture_entries([$fail, $pass])) == 2, "expected two valid entries to load")
  check(len(fixture_entries([])) == 0, "empty fixture did not load")
  -- Missing executable proves empty entries perform no listing or extra run.
  $empty = $base
  $empty.executable = ["/no/such/executable"]
  $p = prepare_fixture($empty, [])
  check(deep_eq($p.strict, $empty) and len($p.isolated) == 0, "empty list changed replay")
  print("quarantine fixtures: PASS")
finally
  remove_dir($temp)
end
