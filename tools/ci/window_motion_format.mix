-- Owned CBC checkout only: return worker formatting as a patch, then restore.
$status = run_argv_must(["git", "status", "--porcelain"])
if trim($status) != "" then
  eprint("worker formatting refuses a dirty checkout")
  exit(1)
end
try
  $metadata = run_argv(["cargo", "metadata", "--offline", "--format-version", "1"], {timeout:120})
  if not $metadata.ok then print($metadata.stderr); exit($metadata.exit_code ?? 1) end
  $r = run_argv(["cargo", "fmt", "--all"], {timeout:120, stderr:"stdout"})
  print($r.stdout)
  if not $r.ok then exit($r.exit_code ?? 1) end
  print("MOTION_FMT_BEGIN")
  print(run_argv_must(["git", "diff"]))
  print("MOTION_FMT_END")
finally
  run_argv_must(["git", "checkout", "-q", "--", "."])
end
