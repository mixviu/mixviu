-- End-to-end pool fixture: fake cargo/rustc, real recorder and child processes.
-- No Rust build, network or installed worker tooling needed.
$mix = realpath("/proc/self/exe")
$dir = dirname(realpath(script_path()))
$q = require("quarantine.mix")
$q.load("tools/ci/quarantine.conf.mix")
$temp = trim(run_argv_must(["mktemp", "-d", "/var/tmp/quarantine-report-XXXXXX"]))
fn check($ok, $why)
  if not $ok then raise("TEST", $why) end
end
$repo = $temp .. "/repo"
try
  $suite = run_argv([$mix, $dir .. "/quarantine_test.mix"], {timeout: 10, stderr: "stdout"})
  check($suite.ok, "policy fixture suite failed: " .. $suite.stdout)
  for $warning in ["::warning::QUARANTINE expired:", "::warning::QUARANTINE over 10 days old:", "::warning::QUARANTINE second entry within 14 days:"]
    check(contains($suite.stdout, $warning), "missing warning " .. $warning)
  end
  check(len(re_find($suite.stdout, "QUARANTINE expired:")) >= 2, "expiry must warn on every load")
  mkdir($repo .. "/tools/ci", {parents: true})
  mkdir($repo .. "/bin")
  mkdir($repo .. "/target")
  $fixture = $repo .. "/target/fixture"
  write_file($fixture, replace(read_file($dir .. "/quarantine_fixture.mix"), "#!/usr/local/bin/mix", "#!" .. $mix))
  chmod($fixture, 0o700)
  for $name in ["cargo", "rustc"]
    write_file($repo .. "/bin/" .. $name, "#!" .. $mix .. "\n" .. read_file($dir .. "/quarantine_cargo_fixture.mix"))
    chmod($repo .. "/bin/" .. $name, 0o700)
  end
  write_file($temp .. "/changed", "README.md\n")
  $today = floor(time() / 86400)
  $entry = {package: "fixture", target: "fixture", test: "module::tests::fail", owner: "fixture-owner",
    ledger: "ledger", evidence: "20 rounds", brief: "fix", cosign: "Fable",
    added: date_format($today * 86400, "%Y-%m-%d", {utc: true}),
    expires: date_format(($today + 7) * 86400, "%Y-%m-%d", {utc: true})}
  for $mode in ["empty", "active", "retry"]
    $active = $mode != "empty"
    $out = $temp .. "/" .. $mode .. ".jsonl"
    write_file($out, "old file, replaced atomically")
    write_file($repo .. "/tools/ci/quarantine.conf.mix", data_encode({entries: (if $active then [$entry] else [] end)}))
    write_file($temp .. "/calls", "")
    write_file($temp .. "/retry", "")
    $r = run_argv([$mix, $dir .. "/test_pool.mix", "--jobs", "1", "--quarantine-out", $out, "--", "--lib"],
      {cwd: $repo, timeout: 20, stderr: "stdout", env: {PATH: $repo .. "/bin:" .. env("PATH"),
        FIXTURE_RETRY: (if $mode == "retry" then "1" else "0" end), FIXTURE_CALLS: $temp .. "/calls", TEST_POOL_RETRY_REPORT: $temp .. "/retry",
        TEST_POOL_CHANGED_PATHS_FILE: $temp .. "/changed", GITHUB_ACTIONS: "false"}})
    print($r.stdout)
    check($r.ok == $active, "pool fixture exit status wrong")
    check(contains($r.stdout, "retry one retry"), "retry policy was not enabled")
    check(contains($r.stdout, "::warning::FLAKY:") == ($mode == "retry"), "wrong retry/FLAKY policy")
    check((read_file($temp .. "/retry") != "") == ($mode == "retry"), "wrong retry report")
    $records = map(filter(lines(read_file($out)), fn($l) = $l != ""), fn($l) = json_parse($l))
    check(not re_match($r.stdout, "(?m)^(test_pool: quarantine records:|GATE_QUARANTINE .*forged|::stop-commands::|::error::forged)"), "child impersonated pool output")
    check(contains($r.stdout, "child: \"test_pool: quarantine records:"), "spoofed pointer fixture absent")
    check(contains($r.stdout, "child: " .. json_encode("ordinary text" .. chr(13) .. "test_pool: overwritten")), "CR overwrite not neutralised")
    check(contains($r.stdout, "\ntest module::tests::fail ... FAILED\n"), "libtest failure line changed")
    check(contains($r.stdout, "\nthread 'module::tests::fail' (123) panicked at fixture.rs:7:9:\n"), "panic line changed")
    check(trim(run_argv_must(["stat", "-c", "%a", $out])) == "600", "record permissions not private")
    check(len($records) == (if $active then 1 else 0 end), "record count wrong or child forged record accepted")
    if $active then
      check($records[0].result == "fail" and $records[0].test == $entry.test, "wrong pool record")
      check(read_file($temp .. "/calls") == (if $mode == "retry" then "fail\nretry-write\n" else "fail\n" end), "quarantined failure retried")
      check(contains($r.stdout, "(retry, alone)") == ($mode == "retry"), "wrong retry count")
      if $mode == "retry" then check(read_file($repo .. "/target/quarantine-decoy.jsonl") == "forged retry records\n", "retry did not write decoy") end
      check(deep_eq(sort(keys($records[0])), sort(["package", "target", "test", "result", "summary", "expires", "owner"])), "record schema wrong")
      check(deep_eq($records[0].summary, {passed: 0, failed: 1, ignored: 0}), "pool failure summary wrong")
    end
  end
  for $case in ["target", "record"]
    $out = if $case == "record" then $repo .. "/bad.jsonl" else $temp .. "/bad.jsonl" end
    $r = run_argv([$mix, $dir .. "/test_pool.mix", "--quarantine-out", $out, "--", "--lib"],
      {cwd: $repo, timeout: 20, stderr: "stdout", env: {PATH: $repo .. "/bin:" .. env("PATH"),
        FIXTURE_TARGET: (if $case == "target" then $temp else $repo .. "/target" end)}})
    check(not $r.ok, "unsafe " .. $case .. " path accepted")
    check(contains($r.stdout, (if $case == "target" then "target_directory must be under" else "record path must be outside" end)), "wrong path refusal")
    check(not exists($out), "unsafe path was written")
  end
  run_argv_must(["ln", "-s", $temp, $repo .. "/escaped-target"])
  $r = run_argv([$mix, $dir .. "/test_pool.mix", "--quarantine-out", $temp .. "/escaped.jsonl", "--", "--lib"],
    {cwd: $repo, timeout: 20, stderr: "stdout", env: {PATH: $repo .. "/bin:" .. env("PATH"), FIXTURE_TARGET: $repo .. "/escaped-target/new-target"}})
  check(not $r.ok and contains($r.stdout, "target_directory must be under"), "symlink target escape accepted")
  check(not exists($temp .. "/new-target"), "target escape wrote before validation")
  mkdir($temp .. "/defaults")
  write_file($repo .. "/tools/ci/quarantine.conf.mix", data_encode({entries: []}))
  $out = $temp .. "/zero.jsonl"
  $r = run_argv([$mix, $dir .. "/test_pool.mix", "--quarantine-out", $out, "--", "--lib"],
    {cwd: $repo, timeout: 20, stderr: "stdout", env: {PATH: $repo .. "/bin:" .. env("PATH"), FIXTURE_NO_BINARIES: "1"}})
  check($r.ok and is_file($out) and read_file($out) == "", "zero binaries did not publish empty records")
  write_file($repo .. "/tools/ci/quarantine.conf.mix", data_encode({entries: [$entry]}))
  $r = run_argv([$mix, $dir .. "/test_pool.mix", "--", "--lib"],
    {cwd: $repo, timeout: 20, stderr: "stdout", env: {PATH: $repo .. "/bin:" .. env("PATH"), TMPDIR: $temp .. "/defaults"}})
  check($r.ok, "default private output failed")
  check(not re_match($r.stdout, "(?m)^test_pool: quarantine records:"), "pool advertised default records")
  check(contains($r.stdout, "GATE_QUARANTINE "), "default run did not print records")
  check(len(glob($temp .. "/defaults/mix-quarantine-*")) == 0, "default output directory leaked")
  for $destination in [$temp .. "/.", $temp .. "/..", $temp .. "/", $temp, "/proc/quarantine-records.jsonl"]
    write_file($temp .. "/calls", "")
    $r = run_argv([$mix, $dir .. "/test_pool.mix", "--quarantine-out", $destination, "--", "--lib"],
      {cwd: $repo, timeout: 20, stderr: "stdout", env: {PATH: $repo .. "/bin:" .. env("PATH"), FIXTURE_CALLS: $temp .. "/calls"}})
    check(not $r.ok and contains($r.stdout, "quarantine: record"), "bad record destination accepted: " .. $r.stdout)
    check(read_file($temp .. "/calls") == "", "test ran before record path refusal")
  end
  -- Exercise the real gate's outer catch after it has started its checks.
  -- Fake cargo succeeds; the absent target/debug/mix aborts the first pool.
  -- No Rust command is run, and the caller-owned quarantine dir is cleaned.
  write_file($repo .. "/bin/cargo", "#!" .. $mix .. "\nprint(\"fake cargo step\")\nexit(0)\n")
  mkdir($temp .. "/gate-temp")
  $r = run_argv([$mix, realpath($dir .. "/../cutover_gate.mix"), "gate"],
    {cwd: $repo, timeout: 10, stderr: "stdout", env: {PATH: $repo .. "/bin:" .. env("PATH"), TMPDIR: $temp .. "/gate-temp"}})
  check($r.exit_code == 1, "aborted gate did not exit 1: " .. $r.stdout)
  check(contains($r.stdout, "fake cargo step"), "gate did not reach checks")
  for $prefix in ["TEST_TOTALS ", "GATE_QUARANTINE_RECORDS ", "GATE_FAILED "]
    $verdict = filter(lines($r.stdout), fn($l) = starts_with($l, $prefix))
    check(len($verdict) == 1, "aborted gate lacks unique " .. $prefix .. ": " .. $r.stdout)
    json_parse(substr($verdict[0], len($prefix)))
  end
  check(contains($r.stdout, "gate aborted: ") and contains($r.stdout, "target/debug/mix"), "abort reason missing: " .. $r.stdout)
  check(len(glob($temp .. "/gate-temp/mix-quarantine-*")) == 0, "aborted gate leaked quarantine directory")
  -- Exercise the actual tree check with a small capture cap. Earlier cargo
  -- and pool steps are fixtures; stop after tree checking at missing release_set.
  mkdir($repo .. "/target/debug")
  write_file($repo .. "/target/debug/mix", "#!" .. $mix .. "\n" ..
    '$o = getopt(args(), {"quarantine-out": {arg: true}})' .. "\n" ..
    'write_file($o.opts["quarantine-out"], "")' .. "\n")
  chmod($repo .. "/target/debug/mix", 0o700)
  copy($dir .. "/quarantine.mix", $repo .. "/tools/ci/quarantine.mix")
  write_file($repo .. "/tools/cutover_gate.mix", replace(read_file($dir .. "/../cutover_gate.mix"), "max_output: 64000000", "max_output: 128"))
  for $truncated in [false, true]
    write_file($repo .. "/bin/cargo", "#!" .. $mix .. "\n" ..
      'if contains(args(), "tree") then' .. "\n" ..
      (if $truncated then 'for $i = 1 to 20 print("ordinary dependency v1.0") end' else 'print("viud v1.0")' end) .. "\nend\n")
    $r = run_argv([$mix, $repo .. "/tools/cutover_gate.mix", "gate"],
      {cwd: $repo, timeout: 10, stderr: "stdout", env: {PATH: $repo .. "/bin:" .. env("PATH"), TMPDIR: $temp .. "/gate-temp"}})
    check(contains($r.stdout, "VIUD_EGUI_MATCH_LINES=0"), "gate did not reach egui tree check: " .. $r.stdout)
    check(contains($r.stdout, "viud egui tree check output truncated") == $truncated, "wrong tree truncation verdict: " .. $r.stdout)
  end
  print("quarantine report contract: PASS")
finally
  remove_dir($temp)
end
