-- Quarantine policy shared by the pool and fixture-only tests.
fn bad($message)
  raise("QUARANTINE", "quarantine: " .. $message)
end

fn day($s)
  if type($s) != "string" or not re_match($s, '^\d{4}-\d{2}-\d{2}$') then bad("bad date " .. json_encode($s)) end
  $t = date_parse($s .. "T00:00:00Z")
  if $t == nil or date_format($t, "%Y-%m-%d", {utc: true}) != $s then bad("bad date " .. json_encode($s)) end
  return $t / 86400
end

fn checked($entries, $today)
  if type($entries) != "list" then bad("entries must be a list") end
  if len($entries) > 5 then bad("at most 5 entries") end
  $seen = {}
  $packages = {}
  for $e in $entries
    if type($e) != "map" then bad("entry must be a map") end
    clean_strings($e)
    for $field in ["package", "target", "test", "owner", "ledger", "evidence", "brief", "added", "expires", "cosign"]
      if type($e[$field]) != "string" or trim($e[$field]) == "" then bad("missing/non-string field " .. $field) end
    end
    if starts_with($e.test, "-") then bad("test must not start with '-'") end
    $added = day($e.added)
    $expires = day($e.expires)
    if $expires <= $added or $expires - $added > 14 then bad("expiry must be 1..14 days after added") end
    if $added > $today then bad("added date is in the future") end
    $expires = effective_expiry($e)
    $key = json_encode([$e.package, $e.target, $e.test])
    if has_key($seen, $key) then bad("duplicate " .. $key) end
    $seen[$key] = true
    $packages[$e.package] = ($packages[$e.package] ?? 0) + 1
    if $packages[$e.package] > 2 then bad("at most 2 entries per package: " .. json_encode($e.package)) end
    if $expires <= $today then
      print("::warning::QUARANTINE expired: " .. $key .. "; runs strict (expires " .. json_encode(expiry_date($e)) .. ")")
    end
    if $today - $added > 10 then print("::warning::QUARANTINE over 10 days old: " .. $key) end
  end
  for $pkg in keys($packages)
    $es = filter($entries, fn($e) = $e.package == $pkg)
    if len($es) == 2 and abs(day($es[0].added) - day($es[1].added)) <= 14 then
      print("::warning::QUARANTINE second entry within 14 days: " .. json_encode($pkg))
    end
  end
  return $entries
end

-- Check even optional/unknown string fields, including renewal fields.
fn clean_strings($v)
  if type($v) == "string" then
    if re_match($v, "[\\x00-\\x1f\\x7f-\\x9f]") then bad("control character in " .. json_encode($v)) end
  elif type($v) == "map" then
    for $k in keys($v)
      clean_strings($k)
      clean_strings($v[$k])
    end
  elif type($v) == "list" then
    for $item in $v
      clean_strings($item)
    end
  end
end

fn effective_expiry($e)
  $expiry = day($e.expires)
  $renewals = $e.renewals ?? []
  if type($renewals) != "list" or len($renewals) > 2 then bad("at most two renewals") end
  $evidence = [normal_evidence($e.evidence)]
  for $i = 0 to len($renewals) - 1
    $r = $renewals[$i]
    if type($r) != "map" then bad("renewal must be a map") end
    for $field in ["until", "by", "evidence", "cosign"]
      if type($r[$field]) != "string" or trim($r[$field]) == "" then bad("missing renewal field " .. $field) end
    end
    if $r.by != ["fable", "mark"][$i] then bad("renewals require fable then mark") end
    $until = day($r.until)
    if $until - $expiry < 1 or $until - $expiry > 7 then bad("renewal must extend expiry by 1..7 days") end
    if $until > day($e.added) + 28 then bad("renewal exceeds added + 28 days") end
    if contains($evidence, normal_evidence($r.evidence)) then bad("renewal needs fresh evidence") end
    push($evidence, normal_evidence($r.evidence))
    $expiry = $until
  end
  return $expiry
end

fn normal_evidence($s)
  return re_replace(trim($s), "\\s+", " ")
end

fn expiry_date($e)
  return date_format(effective_expiry($e) * 86400, "%Y-%m-%d", {utc: true})
end

fn load($path, $today = floor(time() / 86400))
  $data = load_data($path)
  if not has_key($data, "entries") then bad("missing entries in " .. $path) end
  return checked($data.entries, $today)
end

fn validate_packages($entries, $metadata)
  -- metadata.packages can contain non-members; membership is authoritative.
  $members = map(filter($metadata.packages, fn($p) = contains($metadata.workspace_members, $p.id)), fn($p) = $p.name)
  for $e in $entries
    if not contains($members, $e.package) then bad("unknown workspace package " .. json_encode($e.package)) end
  end
end

-- Exact line parsing: no substring matches, and benchmarks are not tests.
fn names($output)
  return map(filter(lines($output), fn($l) = ends_with($l, ": test")), fn($l) = substr($l, 0, len($l) - 6))
end

fn specs($jobs)
  return map($jobs, fn($j) = {argv: $j.argv, env: $j.env, cwd: $j.cwd,
    clear_env: $j.clear_env ?? true, timeout: $j.timeout, max_output: $j.max_output,
    stdout: $j.stdout, stderr: $j.stderr})
end

fn prepare($job, $entries, $package, $target, $today)
  $es = filter($entries, fn($e) = $e.package == $package and $e.target == $target)
  $strict = $job
  $isolated = []
  if len($es) == 0 then return {strict: $strict, isolated: []} end
  $active = filter($es, fn($e) = effective_expiry($e) > $today)
  $flags = slice($job.argv, len($job.executable), len($job.argv))
  $isolated_flags = if len($active) > 0 then harness_flags($flags) else [] end
  -- List from the executable, without cargo's harness filters or flags.
  $listing = $job
  $listing.argv = concat($job.executable, ["--list", "--format", "terse"])
  $listing.timeout = 10
  $r = run_parallel(specs([$listing]), {max: 1})[0]
  if not $r.ok or $r.stdout_truncated then bad("cannot list " .. json_encode([$package, $target])) end
  $names = names($r.stdout)
  for $e in $es
    if not contains($names, $e.test) then bad("unknown full test name " .. json_encode([$package, $target, $e.test])) end
    if effective_expiry($e) > $today then
      $strict.argv = concat($strict.argv, ["--skip", $e.test])
      -- libtest accepts --exact only once; it applies to every --skip.
      if not contains($strict.argv, "--exact") then $strict.argv = concat($strict.argv, ["--exact"]) end
      $one = $job
      $one.argv = concat(concat($job.executable, $isolated_flags), ["--color", "never", "--format", "pretty", "--exact", "--", $e.test])
      $one.timeout = 60
      $one.entry = $e
      push($isolated, $one)
    end
  end
  return {strict: $strict, isolated: $isolated}
end

-- Value-taking flags are explicit: unknown options fail closed too.
fn harness_flags($flags)
  $value = nil
  $out = []
  for $f in $flags
    if $value != nil then
      if starts_with($f, "-") then bad("missing harness flag value") end
      if not contains(["--color", "--format"], $value) then $out = concat($out, [$value, $f]) end
      $value = nil
    elif $f == "--skip" or starts_with($f, "--skip=") then
      bad("active entry refuses carried --skip: it could exclude the entry or change meaning under --exact")
    elif contains(["--test-threads", "--format", "--color", "--logfile", "--shuffle-seed"], $f) then
      $value = $f
    elif contains(["--exact", "--ignored", "--include-ignored", "--nocapture", "--show-output", "--quiet", "-q", "--test", "--bench", "--report-time", "--ensure-time", "--shuffle"], $f) then
      if $f != "--exact" then push($out, $f) end
    elif re_match($f, "^--(format|color)=.+$") then
      nil
    elif re_match($f, "^--(test-threads|logfile|shuffle-seed)=.+$") then
      push($out, $f)
    else
      bad("active entry refuses harness filter, '--' or unsupported flag: " .. json_encode($f))
    end
  end
  if $value != nil then bad("missing harness flag value") end
  return $out
end

-- Keep libtest failures and panic sites readable by humans and hub parsers.
-- Reserved control prefixes: test_pool:, GATE_, TEST_TOTALS, ARTIFACTS and ::
-- Actions commands (warning/error/notice).
fn child_line($line)
  -- SGR colour is harmless; any other escape/control could rewrite the line.
  $plain = re_replace($line, "\\x1b\\[[0-9;:]*m", "")
  $start = trim($plain)
  if starts_with($start, "test_pool:") or starts_with($start, "GATE_") or starts_with($start, "TEST_TOTALS") or starts_with($start, "ARTIFACTS") or starts_with($start, "::") or re_match($plain, "[\\x00-\\x08\\x0b-\\x1f\\x7f-\\x9f]") then
    return "child: " .. json_encode($line)
  end
  return $line
end

fn child_output($output)
  -- split preserves raw CR (lines() removes CR in CRLF), and join preserves
  -- blank lines and the original final newline.
  write_stdout(join(map(split($output, "\n"), fn($line) = child_line($line)), "\n"))
  if $output != "" and not ends_with($output, "\n") then print("") end
end

fn final_summary_line($output)
  $summaries = filter(split($output, "\n"), fn($l) = starts_with($l, "test result:"))
  return if len($summaries) == 0 then "" else $summaries[len($summaries) - 1] end
end

-- Real libtest appends "; finished in 0.01s". Fixtures may omit that tail.
-- Use exactly this parser for both raw isolated output and the echoed stream.
fn parse_summary($line)
  if child_line($line) != $line then return nil end
  $found = re_find($line, '^test result: [a-zA-Z]+\. ([0-9]+) passed; ([0-9]+) failed; ([0-9]+) ignored; [0-9]+ measured; ([0-9]+) filtered out(; finished in [^\x00-\x1f\x7f]*)?$')
  if len($found) == 0 then return nil end
  $m = $found[0].groups
  return {passed: to_number($m[0]), failed: to_number($m[1]), ignored: to_number($m[2]), filtered: to_number($m[3])}
end

fn valid_summary($s, $result)
  if type($s) != "map" then return false end
  if not deep_eq(sort(keys($s)), sort(["passed", "failed", "ignored"])) then return false end
  for $k in ["passed", "failed", "ignored"]
    if type($s[$k]) != "number" or not contains([0, 1], $s[$k]) then return false end
  end
  if $s.passed + $s.failed + $s.ignored > 1 then return false end
  if $result == "pass" then return deep_eq($s, {passed: 1, failed: 0, ignored: 0}) end
  if $result == "fail" then return deep_eq($s, {passed: 0, failed: 1, ignored: 0}) end
  if $result == "ignored" then return deep_eq($s, {passed: 0, failed: 0, ignored: 1}) end
  return contains(["timeout", "missing"], $result)
end

fn summary($r)
  $s = parse_summary(final_summary_line($r.stdout))
  if $s == nil then return nil end
  $s = delete($s, "filtered")
  -- A summary echoed before a later kill/truncation still entered the totals.
  return if valid_summary($s, classification($r)) then $s else nil end
end

fn validate_record($record)
  if type($record) != "map" then bad("record must be a map") end
  for $k in ["package", "target", "test", "result", "expires", "owner"]
    if type($record[$k]) != "string" then bad("invalid record field " .. $k) end
  end
  if not contains(["pass", "fail", "timeout", "ignored", "missing"], $record.result) then bad("invalid record result") end
  if not has_key($record, "summary") then bad("record lacks summary") end
  if $record.summary != nil and not valid_summary($record.summary, $record.result) then bad("invalid record summary") end
end

-- Account one pool's output and its caller-owned completion file together.
-- Isolated summaries are printed in the stream too: move exactly their counts.
fn gate_report($output, $path, $step, $subtract = true)
  $totals = {passed: 0, failed: 0, ignored: 0, filtered: 0, quarantined: {passed: 0, failed: 0, ignored: 0}}
  for $line in split($output, "\n")
    $s = parse_summary($line)
    if $s != nil then
      for $k in ["passed", "failed", "ignored", "filtered"]
        $totals[$k] = $totals[$k] + $s[$k]
      end
    end
  end
  if not is_file($path) then
    return {totals: $totals, records: [], failed: ["quarantine records missing: " .. $step]}
  end
  $records = []
  $failed = []
  for $line in filter(split(read_file($path), "\n"), fn($l) = trim($l) != "")
    $record = nil
    try
      $record = json_parse($line)
      validate_record($record)
    catch $err
      push($failed, "quarantine record invalid: " .. $step)
      continue
    end
    $record.step = $step
    if $subtract and $record.summary != nil then
      $underflow = false
      for $k in ["passed", "failed", "ignored"]
        if $totals[$k] < $record.summary[$k] then $underflow = true end
      end
      if $underflow then
        push($failed, "quarantine totals underflow: " .. $step)
      else
        for $k in ["passed", "failed", "ignored"]
          $totals[$k] = $totals[$k] - $record.summary[$k]
          $totals.quarantined[$k] = $totals.quarantined[$k] + $record.summary[$k]
        end
      end
    end
    push($records, $record)
  end
  return {totals: $totals, records: $records, failed: $failed}
end

-- A cut stream cannot prove which isolated summaries reached its totals.
-- Still validate/list completion records, but subtract none of them.
fn gate_result($r, $path, $step)
  $truncated = $r.stdout_truncated ?? false
  $report = gate_report($r.stdout, $path, $step, not $truncated)
  if $truncated then $report.failed = concat($report.failed, ["test output truncated: " .. $step]) end
  return $report
end

fn classification($r)
  if $r.timed_out then return "timeout" end
  if not $r.ok then return "fail" end
  if $r.stdout_truncated then return "missing" end
  $final = final_summary_line($r.stdout)
  if re_match($final, "^test result: ok\\. 1 passed; 0 failed; 0 ignored;.*$") then return "pass" end
  if re_match($final, "^test result: ok\\. 0 passed; 0 failed; 1 ignored;.*$") then return "ignored" end
  return "missing"
end

fn outside($path, $root)
  if $path == $root or starts_with($path, $root .. "/") then bad("record path must be outside checkout/build tree") end
end

fn record_path($path, $root, $target)
  $parent = realpath(dirname($path))
  if $parent == nil then bad("record parent must exist") end
  $out = path_join($parent, basename($path))
  outside($out, $root)
  outside($out, $target)
  return $out
end

fn private_dir($parent, $root, $target)
  $parent = realpath($parent)
  if $parent == nil then bad("temporary parent must exist") end
  outside($parent, $root)
  outside($parent, $target)
  return trim(run_argv_must(["mktemp", "-d", path_join($parent, "mix-quarantine-XXXXXX")]))
end

-- Called last, after doc-tests and retries. mktemp creates 0700/0600 from
-- creation; staging beside the destination guarantees same-filesystem rename.
fn publish_records($records, $out, $root, $target)
  $stage = private_dir(dirname($out), $root, $target)
  try
    $file = trim(run_argv_must(["mktemp", path_join($stage, "records-XXXXXX")]))
    write_file($file, join(map($records, fn($r) = json_encode($r)), "\n") .. (if len($records) > 0 then "\n" else "" end))
    rename($file, $out)
  finally
    remove_dir($stage)
  end
end

fn replay($jobs)
  $records = []
  for $j in $jobs
    $r = run_parallel(specs([$j]), {max: 1})[0]
    child_output($r.stdout)
    $e = $j.entry
    $result = classification($r)
    $record = {package: $e.package, target: $e.target, test: $e.test,
      result: $result, summary: summary($r), expires: expiry_date($e), owner: $e.owner}
    push($records, $record)
    print("GATE_QUARANTINE " .. json_encode($record))
  end
  return $records
end
