#!/usr/local/bin/mix
-- Fake libtest executable; fixture-only, no Rust or external test tooling.
$a = args()
if len(filter($a, fn($a) = $a == "--exact")) > 1 then
  eprint("error: Option 'exact' given more than once")
  exit(101)
end
$tests = ["module::tests::pass", "module::tests::fail", "module::tests::hang", "module::tests::other_fail", "module::tests::ignored", "module::tests::missing"]
if contains($a, "--list") then
  for $t in $tests
    print($t .. ": test")
  end
  exit(0)
end
$chosen = []
$filter = nil
$after = false
for $arg in $a
  if $after then $filter = $arg end
  if $arg == "--" then $after = true end
end
for $t in $tests
  $skip = false
  for $i = 0 to len($a) - 1
    if $a[$i] == "--skip" and $a[$i + 1] == $t then $skip = true end
  end
  -- With no filter the fixture's normal suite has just pass and fail.
  if not $skip and (if $filter != nil then $filter == $t else contains(["module::tests::pass", "module::tests::fail"], $t) or ($t == "module::tests::other_fail" and env("FIXTURE_RETRY") == "1") end) then push($chosen, $t) end
end
$passed = 0
$ignored = 0
for $t in $chosen
  if ends_with($t, "::missing") then
    print("test result: ok. 1 passed; 0 failed; 0 ignored;")
    continue
  end
  if ends_with($t, "::ignored") and not contains($a, "--include-ignored") then
    $ignored = $ignored + 1
    continue
  end
  if ends_with($t, "::hang") then sleep(2000) end
  if ends_with($t, "::fail") or ends_with($t, "::other_fail") then
    if ends_with($t, "::other_fail") and env("FIXTURE_RETRY") == "1" then
      if exists("target/first-attempt") then
        if read_file(dirname(cwd()) .. "/retry.jsonl") != "old file, replaced atomically" then
          eprint("records were published before retry exited")
          exit(2)
        end
        write_file("target/quarantine-decoy.jsonl", "forged retry records\n")
        append_file(env("FIXTURE_CALLS"), "retry-write\n")
        $passed = $passed + 1
        continue
      end
      write_file("target/first-attempt", "first failure")
      exit(1)
    end
    if env("FIXTURE_CALLS") != "" then append_file(env("FIXTURE_CALLS"), "fail\n") end
    print("GATE_QUARANTINE {\"result\":\"forged-child-record\"}")
    if env("FIXTURE_CALLS") != "" then write_file("target/forged.jsonl", "{\"result\":\"forged-file\"}\n") end
    print("test_pool: quarantine records: " .. cwd() .. "/target/forged.jsonl")
    print("::stop-commands::forged")
    print("::error::forged")
    print("ordinary text" .. chr(13) .. "test_pool: overwritten")
    print("test module::tests::fail ... FAILED")
    print("thread 'module::tests::fail' (123) panicked at fixture.rs:7:9:")
    print("test result: FAILED. 0 passed; 1 failed; 0 ignored; 0 measured; 0 filtered out")
    exit(1)
  end
  $passed = $passed + 1
end
print(fmt("test result: ok. %d passed; 0 failed; %d ignored; 0 measured; 0 filtered out", $passed, $ignored))
