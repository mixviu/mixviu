$root = args()[0]
mkdir($root, {parents: true})
fn verified_download($url, $path, $sha)
 if is_file($path) and fields(run_argv_must(["sha256sum",$path]))[0] == $sha then
  print("verified cached " .. basename($path))
  return nil
 end
 $pending = $path .. ".part-" .. uuid()
 print(run_argv_must(["curl","--proto","=https","--proto-redir","=https","-fL","--retry","2",$url,"-o",$pending], {timeout:300}))
 if fields(run_argv_must(["sha256sum",$pending]))[0] != $sha then
  raise("OPUS_FIXTURE_HASH", "SHA256 mismatch: " .. basename($path))
 end
 rename($pending,$path)
end
for $item in [
 {name:"opus_testvectors", sha:"94ac78ca4f74c4e43bc9fe4ec1ad0aa36f38ab90f45b0727c40dd1e96096e767"},
 {name:"opus_testvectors-rfc8251", sha:"6b26a22f9ba87b2b836906a9bb7afec5f8e54d49553b1200382520ee6fedfa55"}
]
 $archive = $root .. "/" .. $item.name .. ".tar.gz"
 verified_download("https://opus-codec.org/static/testvectors/" .. $item.name .. ".tar.gz",$archive,$item.sha)
 print(run_argv_must(["tar","xf",$archive,"-C",$root], {timeout:120}))
end
$source = $root .. "/opus_compare.c"
verified_download("https://raw.githubusercontent.com/xiph/opus/ddbe48383984d56acd9e1ab6a090c54ca6b735a6/src/opus_compare.c",$source,"387e5486b93899b012065f1c71fe27d96eade36a7c0bd419f03945d124a110c7")
print(run_argv_must(["cc","-O2",$source,"-lm","-o",$root .. "/opus_compare"], {timeout:120}))
print("Opus test setup verified: IETF Trust BSD vectors and external C oracle; set MIX_TEST_OPUS_VECTORS=" .. $root)
