-- Four-engine gate (mix, mixd, viu, viud). Run on CBC only, through
-- ~/.mix/_bin/cbc-build.mix --repo mixviu --commit SHA -- /opt/mixos/bin/mix tools/cutover_gate.mix [MODE]
--   gate: fmt, clippy, tests per engine boundary, the viud egui check and a
--         release build of each engine with its size, then the release set
--         /build/cutover-artifacts/<sha>/{mix,mixd,viu,viud,apps.tar,SHA256SUMS}
--         (tools/apps_bundle.mix), then the env.mx smoke check: the bundle's
--         env.mx is a root 0644 member listed in its manifest, carries the
--         release mix's git_sha_full and, unpacked under target/ with the
--         engines in bin/, supplies a defaulted setting to `mix layout setting`
--         (and its absence is refused). Every step runs; the gate fails if any
--         did. The tree must stay clean.
--   env-mx: the env.mx smoke check alone, with a debug mix and no bundle.
--   fmt:  run cargo fmt and print the diff to apply locally, then restore.
--   lint DIR...: build mix and lint every tracked .mix file under DIR.
--   mixtest FILE...: run Mix test scripts with this tree's debug mix.
--   bundle [STORE]: build a debug mix and pack apps.tar to /tmp as a light
--         check, with STORE as the asset store (rebuilt from the pins).
--   builtins: build mix, regenerate docs/mix/builtins.md, print the diff.
--   lock: re-resolve the workspace packages only and print the Cargo.lock
--         diff, then restore the tree (apply the diff locally).
$mode = args()[0] ?? "gate"
$failed = []
$totals = {passed: 0, failed: 0, ignored: 0, filtered: 0}

fn gate_step($argv, $jobs, $env = {})
  print("STEP_BEGIN " .. join($argv, " "))
  $env.CARGO_BUILD_JOBS = $jobs
  $r = run_argv($argv, {timeout: 7200, max_output: 64000000, env: $env})
  print($r.stdout)
  print($r.stderr)
  print("STEP_RC=" .. to_string($r.exit_code ?? 124) .. " " .. join($argv, " "))
  return $r
end

-- env.mx smoke check in PREFIX (bin/mix plus env.mx): the file carries the
-- commit the mix there reports, a defaulted setting resolves to its registry
-- value with an empty environment (MIX_PREFIX unset: the prefix is the
-- binary's own), and without the file the same setting is refused.
-- Returns the failures.
fn env_mx_probe($prefix)
  $bad = []
  $mix = $prefix .. "/bin/mix"
  $stamp = json_parse(run_argv_must([$mix, "--version", "--json"], {clear_env: true})).git_sha_full
  $staged = load_data($prefix .. "/env.mx")
  print("ENV_MX_COMMIT binary=" .. $stamp .. " env.mx=" .. to_string($staged.commit))
  if $staged.commit != $stamp then push($bad, "env.mx commit " .. to_string($staged.commit) .. " is not the binaries' " .. $stamp) end
  -- The staged file holds exactly the registry's defaults, each with its value.
  $all = filter(load_data("etc/env.conf.mix").vars, fn($v) = has_key($v, "default"))
  $want = {}
  for $v in $all $want[$v.name] = $v.default end
  for $k in keys($staged)
    if $k != "schema" and $k != "commit" and not has_key($want, $k) then push($bad, "env.mx carries " .. $k .. ", which has no registry default") end
  end
  for $k in keys($want)
    if not has_key($staged, $k) then
      push($bad, "env.mx lacks " .. $k)
    elif $staged[$k] != $want[$k] then
      push($bad, "env.mx has " .. $k .. "=" .. to_string($staged[$k]) .. ", the registry says " .. $want[$k])
    end
  end
  -- Every plain default resolves through the binary to its registry value
  -- (a `mix:` default names another setting; the file check above covers it).
  $vars = filter($all, fn($v) = not starts_with($v.default, "mix:"))
  if len($vars) == 0 then
    push($bad, "the registry has no plain default to probe")
    return $bad
  end
  for $v in $vars
    $with = run_argv([$mix, "layout", "setting", $v.name], {clear_env: true})
    print("ENV_MX_SETTING " .. $v.name .. " rc=" .. to_string($with.exit_code) .. " out=" .. trim($with.stdout) .. " err=" .. trim($with.stderr))
    if not $with.ok or $with.stdout != $v.default .. "\n" then push($bad, "env.mx did not supply " .. $v.name .. "=" .. $v.default) end
  end
  remove($prefix .. "/env.mx")
  for $v in $vars
    $without = run_argv([$mix, "layout", "setting", $v.name], {clear_env: true})
    print("ENV_MX_ABSENT " .. $v.name .. " rc=" .. to_string($without.exit_code) .. " out=" .. trim($without.stdout) .. " err=" .. trim($without.stderr))
    if $without.ok or not contains($without.stderr, $v.name .. " is not set and has no installed default") then push($bad, "without env.mx " .. $v.name .. " was not refused") end
  end
  return $bad
end

-- The asset store apps_bundle.mix rebuilds from the pins when anything is missing.
fn asset_store()
  return if is_dir("/build") then "/build/mixviu-assets" else "/tmp/mixviu-assets" end
end

if $mode == "lock" then
  $r = gate_step(["cargo", "update", "--workspace"], "6")
  print("LOCK_PATCH_BEGIN")
  print(run_argv_must(["git", "diff", "--", "Cargo.lock"]))
  print("LOCK_PATCH_END")
  run_argv_must(["git", "checkout", "-q", "--", "."])
  exit(if $r.ok then 0 else 1 end)
end
if $mode == "fmt" then
  $r = gate_step(["cargo", "fmt", "--all"], "6")
  print("FMT_PATCH_BEGIN")
  print(run_argv_must(["git", "diff"]))
  print("FMT_PATCH_END")
  run_argv_must(["git", "checkout", "-q", "--", "."])
  exit(if $r.ok then 0 else 1 end)
end
if $mode == "builtins" then
  $b = gate_step(["cargo", "build", "--locked", "-p", "mix"], "6")
  $r = gate_step(["target/debug/mix", "docs/_build/gen-builtins-md.mix", "--mix", "target/debug/mix"], "6")
  print("BUILTINS_PATCH_BEGIN")
  print(run_argv_must(["git", "diff"]))
  print("BUILTINS_PATCH_END")
  run_argv_must(["git", "checkout", "-q", "--", "."])
  exit(if $b.ok and $r.ok then 0 else 1 end)
end
if $mode == "bundle" then
  -- Light check of the apps.tar step with a debug mix; prints the summary.
  $b = gate_step(["cargo", "build", "--locked", "-p", "mix"], "6")
  if not $b.ok then exit(1) end
  $r = gate_step(["target/debug/mix", "tools/apps_bundle.mix", "/tmp/cutover-apps-check.tar", "--mix", "target/debug/mix", "--assets", args()[1] ?? asset_store()], "6")
  exit(if $r.ok then 0 else 1 end)
end
if $mode == "env-mx" then
  -- Light check of env_mx_probe with a debug mix and a freshly written env.mx.
  $b = gate_step(["cargo", "build", "--locked", "-p", "mix", "--bin", "mix"], "6")
  if not $b.ok then exit(1) end
  $dir = realpath(".") .. "/target/env-mx-check"
  $bad = []
  try
    remove_dir($dir)
    mkdir($dir .. "/bin", {parents: true})
    copy("target/debug/mix", $dir .. "/bin/mix")
    chmod($dir .. "/bin/mix", 0o755)
    $env_mx = require("env_mx.mix")
    $env_mx.write($dir .. "/env.mx", "etc/env.conf.mix", trim(run_argv_must(["git", "rev-parse", "HEAD"])))
    $bad = env_mx_probe($dir)
  catch $msg
    push($bad, "env.mx check raised: " .. $msg)
  finally
    remove_dir($dir)
  end
  print("ENV_MX_FAILED " .. json_encode($bad))
  exit(if len($bad) == 0 then 0 else 1 end)
end
if $mode == "mixtest" then
  -- Run Mix test scripts with this tree's (debug) mix.
  $b = gate_step(["cargo", "build", "--locked", "-p", "mix"], "6")
  if not $b.ok then exit(1) end
  $bad = 0
  for $f in slice(args(), 1)
    print("STEP_BEGIN " .. $f)
    $r = run_argv(["target/debug/mix", $f], {timeout: 1800, max_output: 64000000, env: {MIX_TEST_MIX_EXE: realpath("target/debug/mix")}})
    print($r.stdout)
    print($r.stderr)
    print("STEP_RC=" .. to_string($r.exit_code ?? 124) .. " " .. $f)
    if not $r.ok then $bad = $bad + 1 end
  end
  print("MIXTEST_FAILED " .. to_string($bad))
  exit(if $bad == 0 then 0 else 1 end)
end
if $mode == "lint" then
  -- Lint the tracked .mix files under the given directories with this tree's mix.
  $b = gate_step(["cargo", "build", "--locked", "-p", "mix"], "6")
  if not $b.ok then exit(1) end
  $bad = 0
  for $dir in slice(args(), 1)
    for $f in filter(lines(trim(run_argv_must(["git", "ls-files", $dir]))), fn($x) = ends_with($x, ".mix"))
      $r = run_argv(["target/debug/mix", "lint", $f])
      $out = lines(trim($r.stdout .. $r.stderr))
      $summary = filter($out, fn($l) = contains($l, " error(s), "))
      print("LINT " .. $f .. " | " .. join($summary, " "))
      if not $r.ok then
        $bad = $bad + 1
        print(join($out, "\n"))
      end
    end
  end
  print("LINT_FAILED " .. to_string($bad))
  exit(if $bad == 0 then 0 else 1 end)
end
if $mode != "gate" then raise("USAGE", "cutover_gate.mix gate|lock|fmt|builtins|env-mx|lint DIR...") end

$checks = [
  ["cargo", "fmt", "--all", "--", "--check"],
  ["cargo", "clippy", "--locked", "--workspace", "--exclude", "mix", "--all-targets"],
  ["cargo", "clippy", "--locked", "-p", "mix", "--all-targets"],
  -- Shell process tests hand --serve to the sibling service engine.
  ["cargo", "build", "--locked", "-p", "mixd"],
  -- Tests that start a real interpreter get the one built from this tree,
  -- never an installed one (tools/ci.mix does the same).
  ["cargo", "build", "--locked", "-p", "mix", "--bin", "mix"],
  ["cargo", "test", "--locked", "-p", "mix", "--no-fail-fast"],
  ["cargo", "test", "--locked", "--workspace", "--exclude", "mix", "--no-fail-fast"]
]
$test_mix = realpath(".") .. "/target/debug/mix"
for $argv in $checks
  $env = if $argv[1] == "test" then {MIX_TEST_E2E_EXE: $test_mix, MIX_TEST_MIX_EXE: $test_mix} else {} end
  $r = gate_step($argv, "6", $env)
  if not $r.ok then push($failed, join($argv, " ")) end
  if $argv[1] == "test" then
    for $line in lines($r.stdout)
      $found = re_find($line, "^test result: [a-zA-Z]+\\. ([0-9]+) passed; ([0-9]+) failed; ([0-9]+) ignored; [0-9]+ measured; ([0-9]+) filtered out")
      if len($found) > 0 then
        $m = $found[0].groups
        $totals.passed = $totals.passed + to_number($m[0])
        $totals.failed = $totals.failed + to_number($m[1])
        $totals.ignored = $totals.ignored + to_number($m[2])
        $totals.filtered = $totals.filtered + to_number($m[3])
      end
    end
  end
end
print("TEST_TOTALS " .. json_encode($totals))

-- viud is egui-free by construction (default features).
$tree = run_argv(["cargo", "tree", "--locked", "-p", "viud", "-e", "normal"], {max_output: 64000000})
$egui = filter(lines($tree.stdout), fn($line) = re_match($line, "(^|[^a-z_-])(egui|egui-wgpu|egui-winit|toolkit) v[0-9]"))
print("VIUD_EGUI_MATCH_LINES=" .. to_string(len($egui)))
if not $tree.ok or len($egui) != 0 then
  print(join($egui, "\n"))
  push($failed, "viud egui tree check")
end

-- Release engines, one package per command; cold release builds stay capped.
$sizes = {}
for $pair in [["mix", "mix"], ["mixd", "mixd"], ["viu", "viu"], ["viud", "viud"]]
  $r = gate_step(["cargo", "build", "--release", "--locked", "-p", $pair[0]], "2")
  if $r.ok then
    $sizes[$pair[1]] = stat("target/release/" .. $pair[1]).size
  else
    push($failed, "release " .. $pair[0])
  end
end
print("RELEASE_SIZES " .. json_encode($sizes))

-- The release set the desk migration installs: the four engines and apps.tar,
-- each named in SHA256SUMS, under /build/cutover-artifacts/<sha>.
if len(keys($sizes)) == 4 then
  $sha = trim(run_argv_must(["git", "rev-parse", "HEAD"]))
  $art = "/build/cutover-artifacts/" .. $sha
  mkdir($art, {parents: true})
  for $engine in ["mix", "mixd", "viu", "viud"] copy("target/release/" .. $engine, $art .. "/" .. $engine) end
  $b = gate_step(["target/release/mix", "tools/apps_bundle.mix", $art .. "/apps.tar", "--mix", "target/release/mix", "--assets", asset_store()], "2")
  if $b.ok then
    $sums = ""
    for $name in ["mix", "mixd", "viud", "viu", "apps.tar"] $sums = $sums .. hash_file($art .. "/" .. $name, "sha256") .. "  " .. $name .. "\n" end
    write_file($art .. "/SHA256SUMS", $sums)
    print("ARTIFACTS " .. $art .. "\n" .. $sums)
    -- env.mx: a root-owned 0644 member at the archive root, in the manifest,
    -- stamped with the release engines' commit and supplying a defaulted
    -- setting, checked in the unpacked bundle with the four engines in bin/.
    print("STEP_BEGIN env.mx smoke check")
    $smoke = realpath(".") .. "/target/env-mx-smoke"
    $bad = []
    try
      $member = trim(run_argv_must(["tar", "--numeric-owner", "-tvf", $art .. "/apps.tar", "env.mx"]))
      print("ENV_MX_MEMBER " .. $member)
      if not re_match($member, "^-rw-r--r-- 0/0 ") then push($bad, "env.mx member is not root:root 0644: " .. $member) end
      remove_dir($smoke)
      mkdir($smoke .. "/bin", {parents: true})
      run_argv_must(["tar", "-xf", $art .. "/apps.tar", "-C", $smoke], {timeout: 600})
      $listed = filter(load_data($smoke .. "/share/mixviu/BUNDLE.conf.mix").files, fn($row) = $row.path == "env.mx")
      if len($listed) != 1 or $listed[0].sha256 != hash_file($smoke .. "/env.mx", "sha256") then push($bad, "env.mx is not in the bundle manifest with its hash") end
      for $engine in ["mix", "mixd", "viu", "viud"]
        copy("target/release/" .. $engine, $smoke .. "/bin/" .. $engine)
        chmod($smoke .. "/bin/" .. $engine, 0o755)
      end
      $bad = concat($bad, env_mx_probe($smoke))
    catch $msg
      push($bad, "smoke check raised: " .. $msg)
    finally
      remove_dir($smoke)
    end
    print("ENV_MX_FAILED " .. json_encode($bad))
    print("STEP_RC=" .. (if len($bad) == 0 then "0" else "1" end) .. " env.mx smoke check")
    if len($bad) != 0 then push($failed, "env.mx") end
  else
    push($failed, "apps.tar")
  end
end

$dirty = run_argv_must(["git", "status", "--porcelain", "--untracked-files=no"])
if $dirty != "" then
  print("DIRTY_TREE\n" .. $dirty)
  push($failed, "tree changed")
  run_argv_must(["git", "checkout", "-q", "--", "."])
end
print("GATE_FAILED " .. json_encode($failed))
exit(if len($failed) == 0 then 0 else 1 end)
