-- SPDX-License-Identifier: MIT OR Apache-2.0
$guard = require("host_roots.mix")
$layout = require("../share/layout/files.mix")
$renderer = require("../share/layout/render.mix")
$release = require("release_set.mix")
$roots = {prefix: "/srv/mixtest", etc: "/srv/mixtest/etc", var: "/srv/mixtest/var", run: "/srv/mixtest/run", cache: "/srv/mixtest/cache", share: "/srv/mixtest/share", lib: "/srv/mixtest/lib"}
$guard.check_sources()
$paths = lines(trim(run_argv_must(["git", "ls-files"])))
$sources = map($layout.entries("share/layout"), fn($e) = realpath("share/layout/" .. $e.source))
for $path in $paths
  if $guard.shipped_unit($path) then
    if not contains($sources, realpath($path)) then raise("HOST_ROOT_TEST", "shipped template missing from layout: " .. $path) end
    $text = $renderer.external(read_file($path), $roots, "unit")
    $guard.check_text($path, $text)
    if contains($text, "/opt/mix") then raise("HOST_ROOT_TEST", "hardwired prefix in " .. $path) end
    for $m in re_find(read_file($path), "(?m)^ExecStartPre=/usr/bin/find ([^\n]+) -mindepth 1 -delete$")
      if not contains(read_file($path), "ExecStopPost=-/usr/bin/find " .. $m.groups[0] .. " -mindepth 1 -delete\n") then raise("HOST_ROOT_TEST", "runtime leaf lacks stop cleanup: " .. $path) end
    end
  end
end
if not contains(read_file("services/hostd/units/hostd.socket"), "RemoveOnStop=yes\n") then raise("HOST_ROOT_TEST", "host socket must be removed on stop") end
for $entry in $layout.plan("share/layout", $roots)
  $guard.check_text($entry.path, $entry.text)
  if contains($entry.text, "/opt/mix") then raise("HOST_ROOT_TEST", "hardwired layout prefix") end
end
for $path in $paths
  if ends_with($path, "tmpfiles.conf") and ($guard.shipped_unit($path) or starts_with($path, "share/layout/")) then
    for $line in lines(read_file($path))
      if not starts_with(trim($line), "#") and contains($line, "%") then raise("HOST_ROOT_TEST", "tmpfiles cannot expand unit instances: " .. $path) end
    end
  end
end
$mail = read_file("services/maild/units/maild@.service")
if not contains($mail, "ReadWritePaths=@{var}/maild/%i @{run}/maild/%i\n") or not contains($mail, "Requires=noded@%i.service maild-prepare@%i.service") or not contains($mail, "After=network-online.target noded@%i.service maild-prepare@%i.service") then
  raise("HOST_ROOT_TEST", "mail instance must prepare leaves before applying its exact write whitelist")
end
for $bad in ["ListenStream=/run/" .. "mix/hostd.sock", "StateDirectory=" .. "mix/test", "RuntimeDirectory=" .. "mix/test", "Environment=X=/etc/" .. "mix", "d /var/lib/" .. "mix 0750 root root -", "X=/var/cache/" .. "mix", "WorkingDirectory=%S/" .. "mix/test"]
  $refused = false
  try $guard.check_text("planted.service", $bad) catch $msg, $err
    if $err.code != "HOST_ROOT" then raise("HOST_ROOT_TEST", $msg) end
    $refused = true
  end
  if not $refused then raise("HOST_ROOT_TEST", "accepted planted unit: " .. $bad) end
end
$dir = "/tmp/host-roots-test-" .. to_string(pid())
mkdir($dir)
try
  for $name in $release.members() write_file($dir .. "/" .. $name, $name) end
  $sums = $release.checksums($dir)
  write_file($dir .. "/SHA256SUMS", $sums)
  $names = []
  for $line in lines(trim($sums)) push($names, split($line, "  ")[1]) end
  if not deep_eq($names, $release.members()) then raise("HOST_ROOT_TEST", "checksum members differ") end
  for $b in $release.binaries()
    if not is_file("engines/" .. $b.package .. "/Cargo.toml") and not is_file("services/" .. $b.package .. "/Cargo.toml") then raise("HOST_ROOT_TEST", "missing release package") end
  end
  $guard.check_bundle($dir)
  for $directive in ["CacheDirectory=", "LogsDirectory="]
    if len($guard.violations($directive .. "mix/test")) == 0 then raise("HOST_ROOT_TEST", "missed cache/log escape") end
  end
  mkdir($dir .. "/.hidden")
  write_file($dir .. "/.hidden/planted.service", "\u{0000}ListenStream=/run/" .. "mix/bad")
  $refused = false
  try $guard.check_bundle($dir) catch $msg, $err
    if $err.code != "HOST_ROOT" then raise("HOST_ROOT_TEST", $msg) end
    $refused = true
  end
  if not $refused then raise("HOST_ROOT_TEST", "accepted bad bundle") end
  remove_dir($dir .. "/.hidden")
  if uid() != 0 then
    mkdir($dir .. "/unreadable")
    chmod($dir .. "/unreadable", 0o000)
    $refused = false
    try
      $guard.check_bundle($dir)
    catch $msg, $err
      if $err.code != "WALK_UNREADABLE" then raise("HOST_ROOT_TEST", $msg) end
      $refused = true
    finally
      chmod($dir .. "/unreadable", 0o700)
    end
    if not $refused then raise("HOST_ROOT_TEST", "silently skipped unreadable bundle directory") end
  end
finally
  remove_dir($dir)
end
print("HOST_ROOTS_TEST passed: relocated templates, planted units/bundle, release checksums")
