-- Focused worker-only checks for listed-window recording.
$mode = args()[0] ?? "test"
$packages = ["comp-model", "screencopy", "frames", "policy-host", "headless", "native", "nested", "world", "seat", "recorder", "paths"]
$command = ["cargo", if $mode == "fmt" then "fmt" elif $mode == "clippy" then "clippy" else "test" end]
for $package in $packages
  $command = concat($command, ["-p", $package])
end
try
  if $mode == "capture" or $mode == "bench" or $mode == "accept" or $mode == "probe" or $mode == "all" then
    $runtime_build = if $mode == "probe" or $mode == "all" then ["cargo","build","-p","viud","--features","headless/test-support"] else ["cargo","build","--release","-p","viud","--features","headless/test-support"] end
    for $cmd in [["cargo","build","-p","mix","-p","noded","-p","testkit","--bins"], $runtime_build]
      $r = run_argv($cmd, {timeout:1800,stdout:"inherit",stderr:"inherit"})
      if not $r.ok then exit($r.exit_code ?? 1) end
    end
    export MIX_TEST_REQUIRE_RECORD=1
    export MIX_TEST_MIX_EXE=realpath("target/debug/mix")
    export MIX_TEST_VIUD_EXE=realpath(if $mode == "probe" or $mode == "all" then "target/debug/viud" else "target/release/viud" end)
    if $mode == "bench" or $mode == "accept" then
      -- Release test binaries locate their broker beside the release runtime.
      -- Build that fixture here rather than depending on a previous worker job.
      $r = run_argv(["cargo","build","--release","-p","noded","--bin","noded"],{timeout:1800,stdout:"inherit",stderr:"inherit"})
      if not $r.ok then exit($r.exit_code ?? 1) end
    end
    $command = ["cargo","test","-p","headless","--test","capture","record_","--","--nocapture","--test-threads=1"]
    if $mode == "all" then
      $command = ["cargo","test"]
      for $package in $packages
        $command = concat($command,["-p",$package])
      end
      $command = concat($command,["--all-targets","--","--nocapture","--test-threads=1"])
    elif $mode == "probe" then
      $command = ["cargo","test","-p","headless","--test","capture","record_privacy","--","--nocapture","--test-threads=1"]
    end
    if $mode == "bench" then
      export MIX_TEST_CAPTURE_SECONDS=40
      $command = ["cargo","test","--release","-p","headless","--test","capture","benchmark_record_changing_4k_zero_drop","--","--ignored","--nocapture","--test-threads=1"]
    end
  elif $mode == "clippy" then
    $command = concat($command, ["--all-targets"])
  elif $mode != "fmt" then
    $command = concat($command, ["--all-targets"])
  end
  $r = run_argv($command, {timeout:1800,stdout:"inherit",stderr:"inherit"})
  if $r.ok and $mode == "accept" then
    export MIX_TEST_CAPTURE_SECONDS=40
    $r = run_argv(["cargo","test","--release","-p","headless","--test","capture","benchmark_record_changing_4k_zero_drop","--","--ignored","--nocapture","--test-threads=1"],{timeout:1800,stdout:"inherit",stderr:"inherit"})
  end
  exit($r.exit_code ?? 1)
finally
  print("LISTED_DIFF_BEGIN")
  print(run_argv(["git","diff"]).stdout)
  print("LISTED_DIFF_END")
  print(run_argv(["git","checkout","-q","--","."]).stderr)
end
