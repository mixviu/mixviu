-- version: 0.1.0
$rc=0
try
  for $a in [["cargo","fmt","--all"],["cargo","test","-p","viu","--lib","http::tests","--","--nocapture"],["cargo","build","-p","viu-client","--bin","viu"]]
    $r=run_argv($a,{env:{CARGO_BUILD_JOBS:"6",RUSTC_WRAPPER:""},timeout:1800,max_output:8000000});print($r)
    if not $r.ok then $rc=$r.exit_code ?? 124;break end
  end
  if $rc==0 then
    $sha=trim(run_argv_must(["git","rev-parse","HEAD"]))
    $dir="/var/tmp/viu-email-"..$sha;mkdir($dir,{parents:true});copy("target/debug/viu",$dir.."/viu")
    print({artifact:$dir,sha256:hash_file($dir.."/viu","sha256")})
  end
finally
  print("EMAIL_WIRE_PATCH_BEGIN");print(run_argv_must(["git","diff","--binary"]));print("EMAIL_WIRE_PATCH_END")
  print(run_argv_must(["git","checkout","-q","--","."]))
end
exit($rc)
