-- SPDX-License-Identifier: MIT OR Apache-2.0
-- Headless services: owned loopback brokers, fake agents and HTTP fixtures.
$g = getopt(args(), {mix: {arg: true}, bin: {arg: true}})
if len($g.errors) != 0 or $g.opts.mix == nil or $g.opts.bin == nil then
  raise("USAGE", "mix_services_test.mix --mix EXE --bin DIR")
end
$mix = realpath($g.opts.mix)
$bin = realpath($g.opts.bin)
$bundle = run_argv([$mix, "tests/mix_services_bundle_test.mix"], {timeout: 30, stdout: "inherit", stderr: "inherit"})
if not $bundle.ok then raise("BUNDLE", "installed template closure failed") end
$failed = []
for $svc in ["agentd", "peersd", "releasesd", "daylight"]
  $passed_checks = 0
  $failed_checks = 0
  $scripts = 0
  for $case in sort(glob("services/" .. $svc .. "/tests/*_test.mix"))
    print("::group::" .. $case)
    -- The installer refuses root; retain the oracle runner's nobody path.
    $argv = if $svc == "releasesd" and uid() == 0 then
      ["runuser", "-u", "nobody", "--", $mix, $case]
    else [$mix, $case] end
    $r = run_argv($argv, {timeout: 1800, max_output: 16000000,
      env: {MIX_TEST_MIX_EXE: $mix, MIX_TEST_NODED_EXE: $bin .. "/noded",
        MIX_TEST_SETTINGSD_EXE: $bin .. "/settingsd", MIX_STATS: "off", TZ: "UTC"}})
    print($r.stdout .. $r.stderr)
    $passed_checks = $passed_checks + len(filter(lines($r.stdout), fn($line) = starts_with($line, "PASS ")))
    $failed_checks = $failed_checks + len(filter(lines($r.stdout), fn($line) = starts_with($line, "FAIL ")))
    $scripts = $scripts + 1
    print("SERVICE_TEST " .. json_encode({service: $svc, case: $case, rc: $r.exit_code}))
    print("::endgroup::")
    if not $r.ok then push($failed, $case) end
  end
  print("SERVICE_TOTAL " .. json_encode({service: $svc, scripts: $scripts,
    passed: $passed_checks, failed: $failed_checks}))
end
if len($failed) > 0 then raise("SERVICE_TEST", join($failed, ", ")) end
