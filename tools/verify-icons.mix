-- version: 0.1.0
$repo=dirname(dirname(script_path()))
$manifest=json_parse(read_file($repo.."/provenance/icons.json"))
for $file in $manifest.files
  if hash_file($repo.."/"..$file.path,"sha256")!=$file.sha256 then raise("ICON_IMPORT_CHANGED",$file.path) end
end
print("icon assets verified: "..to_string(len($manifest.files)))
