-- SPDX-License-Identifier: MIT OR Apache-2.0
-- CBC-only recipes for the section projection/redaction change.
$mode=$1 ?? "focused"
fn checked($argv)
  $r=run_argv($argv,{timeout:7200,stderr:"stdout",max_output:64000000});print($r.stdout)
  if not $r.ok then exit($r.exit_code ?? 1) end
end
if $mode=="format" then
  try
    checked(["cargo","fmt","-p","lib-viu"])
    checked(["git","diff"])
  finally print(run_argv_must(["git","checkout","-q","--","."])) end
elif $mode=="oracle" or $mode=="section-negative" then
  $p="apps/workshop/app.mix";$source=read_file($p)
  $needle="  $projection=$frame.project($s,$presentation.project_dirty($s,$publication.model,$sections));$persist=$saved.project($s)"
  $replacement=<<EOF
  $clock=require("mesh.mix");$now=$clock.now_ms()
  $pc=viu_test_cpu()
  $candidate=$presentation.project_dirty($s,$publication.model,$sections,$now)
  $section_cpu=(viu_test_cpu()-$pc)*1000000;$pc=viu_test_cpu()
  $oracle=$presentation.project($s,$now)
  print("WORKSHOP_BUILD "..json_encode({section_cpu_us:$section_cpu,full_cpu_us:(viu_test_cpu()-$pc)*1000000,dirty:$sections,rows:len($candidate.tree.initial.rows)}))
  if not deep_eq($candidate,$oracle) then raise("SECTION_ORACLE","section-dirty projection differs from full oracle") end
  $projection=$frame.project($s,$candidate);$persist=$saved.project($s)
EOF
  if $mode=="section-negative" then $replacement="  \$sections.tree=false\n"..$replacement end
  $changed=replace($source,$needle,$replacement)
  if $changed==$source then raise("PROBE","section oracle source drift") end
  try
    write_file($p,$changed)
    $r=run_argv(["cargo","test","-p","lib-viu","--features","test-support","--test","workshop_bus","workshop_answers_during_discovery","--","--nocapture"],{timeout:600,stderr:"stdout",max_output:16000000});print($r.stdout)
    if $mode=="oracle" and not $r.ok then exit($r.exit_code ?? 1) end
    if $mode=="section-negative" and ($r.ok or not contains($r.stdout,"section-dirty projection differs from full oracle")) then raise("PROBE","forgotten tree mark missed real-fixture oracle") end
  finally write_file($p,$source) end
elif $mode=="validate" then
  checked(["cargo","fmt","-p","lib-viu","--","--check"])
  for $feature in [[],["--features","test-support"]]
    checked(concat(["cargo","clippy","-p","lib-viu","--all-targets","--no-deps"],$feature))
    checked(concat(["cargo","test","-p","lib-viu","--all-targets","--no-fail-fast"],$feature))
    checked(concat(["cargo","test","-p","lib-viu","--doc"],$feature))
  end
elif $mode=="width-negative" then
  $p="libraries/viu/src/app_host.rs";$source=read_file($p)
  $changed=replace($source,"while self.model_receipts.len() < self.runtime.capacity() {","while self.model_receipts.len() < 32 {")
  if $changed==$source then raise("PROBE","receipt control source drift") end
  try
    write_file($p,$changed)
    $r=run_argv(["cargo","test","-p","lib-viu","--lib","receipt_limit_tracks_configured_runtime_width","--","--nocapture"],{timeout:600,stderr:"stdout",max_output:16000000});print($r.stdout)
    if $r.ok or not contains($r.stdout,"width-eight receipt saturation must pause completion retirement") then raise("PROBE","literal-32 receipt control missed assertion") end
  finally write_file($p,$source) end
else
  checked(["cargo","test","-p","lib-viu","--lib","receipt_limit_tracks_configured_runtime_width","--","--nocapture"])
  for $path in ["apps/workshop/section-test.mix","apps/workshop/redaction-budget-test.mix","apps/workshop/traffic-test.mix","apps/workshop/publication-test.mix"] checked(["mix",$path]) end
  checked(["cargo","test","-p","lib-viu","--features","test-support","--test","workshop_bus","--","--nocapture"])
end
