-- SPDX-License-Identifier: MIT OR Apache-2.0
-- Run through CBC, not on the developer desktop. All instrumentation is in
-- lib-viu/test-support or the integration fixture, never the shipped app.
$mode=$1 ?? "baseline"
$test=["cargo","test","-p","lib-viu","--features","test-support","--test","workshop_bus","workshop_answers_during_discovery","--","--nocapture"]
fn checked($argv)
  $r=run_argv($argv,{timeout:3600,stderr:"stdout",max_output:64000000})
  print($r.stdout)
  if not $r.ok then exit($r.exit_code ?? 1) end
end
if $mode=="format" then
  $r=run_argv(["cargo","fmt","-p","lib-viu"],{timeout:600,stderr:"stdout"})
  print($r.stdout);print(run_argv_must(["git","diff"]))
  print(run_argv_must(["git","checkout","-q","--","."]))
  if not $r.ok then exit(1) end
elif $mode=="negative" then
  $paths=["apps/workshop/discovery.mix","apps/workshop/controller.mix","apps/workshop/work.mix"]
  $original={}
  for $path in $paths $original[$path]=read_file($path) end
  try
    for $case in ["expansion","scan"]
      for $path in $paths write_file($path,$original[$path]) end
      for $path in (if $case=="expansion" then $paths else ["apps/workshop/work.mix"] end)
        write_file($path,run_argv_must(["git","show","be270734:"..$path]))
      end
      $r=run_argv(concat(slice($test,0,8),["discovery_turns_bound_expansion_and_blocked_admission_scans","--","--exact","--nocapture"]),{timeout:120,stderr:"stdout"})
      print("NEGATIVE "..$case);print($r.stdout)
      $expected=if $case=="expansion" then "list expanded in its receive turn" else "scanned the entire blocked queue" end
      if $r.exit_code!=101 or not contains($r.stdout,$expected) then raise("PROBE","negative control did not fail at the work bound") end
    end
  finally
    for $path in $paths write_file($path,$original[$path]) end
    print(run_argv_must(["git","diff"]))
  end
elif $mode=="validate" then
  checked(["cargo","fmt","-p","lib-viu","--","--check"])
  checked(["cargo","clippy","-p","lib-viu","--features","test-support","--all-targets","--no-deps"])
  checked(["cargo","test","-p","lib-viu","--features","test-support","--all-targets","--no-fail-fast"])
  checked(["cargo","test","-p","lib-viu","--features","test-support","--doc"])
elif $mode=="pool" then
  for $iteration=1 to 12
    print("WORKSHOP_POOL_ITERATION "..$iteration)
    -- Keep the whole crate queued, with default intra-binary threading, so
    -- contention lasts into the 200-peer phase rather than just startup.
    checked(["mix","tools/ci/test_pool.mix","--jobs","4","--","-p","lib-viu","--features","test-support","--","--nocapture"])
  end
else
  checked(concat(slice($test,0,8),["--no-run"]))
  print("STANDALONE")
  $alone=run_argv($test,{timeout:120,stderr:"stdout",max_output:64000000});print($alone.stdout)
  $jobs=[{argv:$test,timeout:120,stderr:"stdout",max_output:64000000}]
  for $i=1 to 8
    push($jobs,{argv:["timeout","60","sha256sum","/dev/zero"],timeout:70,stderr:"stdout"})
  end
  $results=run_parallel($jobs,{max:9})
  print("LOADED (eight CPU workers)");print($results[0].stdout)
  if not $alone.ok or not $results[0].ok then exit(1) end
end
