-- host: viu
-- SPDX-License-Identifier: MIT OR Apache-2.0
-- version: 0.1.0
$policy=require("macro-policy.mix")
$panel=$policy.panel
on macros.call
  try
    $s=$panel;$a=$event.args
    if $a.command=="open" then
      if $s.form.open then raise("BUSY","Macro panel is already open") end
      $s.epoch=$a.epoch;$s.filter="";$s=$policy.macro_catalogue($s)
    elif $a.command=="edit" then
      if not $s.form.open or type($a.value)!="string" then raise("INVALID_ARGUMENT","No editable macro form") end
      $s.form.field=$a.value
      if $s.page=="catalogue" then $s.filter=$a.value;$s=$policy.macro_catalogue($s) end
    elif $a.command=="answer" then
      if not $s.form.open or not deep_eq($a.instance,$s.form.instance) then raise("STALE_FORM","Read the current dialog instance") end
      if not any($s.form.choices,fn($c)=$c.id==$a.choice and $c.enabled) then raise("INVALID_ARGUMENT","Disabled or unknown form choice") end
      if $a.field!=nil then
        if type($a.field)!="string" or len($a.field)>($s.form.max_field_bytes ?? 4096) then raise("INVALID_ARGUMENT","Invalid form text") end
        $s.form.field=$a.field
      end
      $s=$policy.macro_answer($s,$a.choice)
    elif $a.command=="refresh" then
      $instance=$s.form.instance
      if $s.page=="output" then $s=$policy.macro_output($s)
      elif $s.page=="detail" then $s=$policy.macro_detail($s) end
      $s.form.instance=$instance
    else raise("UNKNOWN_COMMAND","Unknown macro panel command") end
    $panel=$s;$policy.macro_publish($panel);reply(0,json_encode({ok:true}))
  catch $message,$error
    $panel.form.error=$message;$policy.macro_publish($panel)
    reply(10,json_encode({error_code:$error.code,message:$message}))
  end
end
