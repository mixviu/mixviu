-- Pure scene-data policy. Host inputs continue to use full publication.
fn requires_full($before,$after)
  if type($before)!="map" or type($after)!="map" or long_changed_key($before,$after) then return true end
  for $key in unique(concat(keys($before),keys($after)))
    if starts_with($key,"__viu_") or contains(["presentation","native_root","native_windows","surfaces","appearance","theme_choice","window_settings","window_title","window_close","macros_open","native_overlays","native_focus","layer","local_theme","local_mode","theme_values","theme_refresh_key","settings_reload","keyboard_events","on_shortcut"],$key) then
      if has_key($before,$key)!=has_key($after,$key) or not deep_eq($before[$key],$after[$key]) then return true end
    end
  end
  return false
end
fn long_changed_key($before,$after)
  if deep_eq($before,$after) then return false end
  if type($before)=="map" or type($after)=="map" then
    $a=if type($before)=="map" then $before else {} end
    $b=if type($after)=="map" then $after else {} end
    for $key in unique(concat(keys($a),keys($b)))
      if has_key($a,$key)!=has_key($b,$key) or not deep_eq($a[$key],$b[$key]) then
        if byte_length($key)>256 or long_changed_key($a[$key],$b[$key]) then return true end
      end
    end
  elif type($before)=="list" and type($after)=="list" then
    for $i=0 to max(len($before),len($after))-1
      if long_changed_key($before[$i],$after[$i]) then return true end
    end
  end
  return false
end
fn difference($before,$after,$path=[])
  if deep_eq($before,$after) then return [] end
  if len($path)>=32 then return [{op:"set",path:$path,value:$after}] end
  if type($before)=="map" and type($after)=="map" then
    $out=[]
    for $key in keys($before)
      if not has_key($after,$key) then push($out,{op:"remove",path:concat($path,[$key])}) end
    end
    for $key in keys($after)
      if has_key($before,$key) then $out=concat($out,difference($before[$key],$after[$key],concat($path,[$key])))
      else push($out,{op:"set",path:concat($path,[$key]),value:$after[$key]}) end
    end
    return $out
  end
  if type($before)=="list" and type($after)=="list" then
    $out=[];$current=$before;$i=0
    while $i<len($after)
      if $i<len($current) and deep_eq($current[$i],$after[$i]) then $i=$i+1;continue end
      $anchor=nil
      for $j=$i+1 to len($current)-1
        if deep_eq($current[$j],$after[$i]) then $anchor=$j;break end
      end
      if $anchor!=nil then
        push($out,{op:"splice",path:$path,index:$i,remove:$anchor-$i,items:[]})
        $current=concat(slice($current,0,$i),slice($current,$anchor))
      elif $i<len($current) and type($current[$i])=="map" and type($after[$i])=="map" and $current[$i].id!=nil and $current[$i].id==$after[$i].id then
        $out=concat($out,difference($current[$i],$after[$i],concat($path,[$i])))
        $current[$i]=$after[$i];$i=$i+1
      else
        push($out,{op:"splice",path:$path,index:$i,remove:0,items:[$after[$i]]})
        $current=concat(concat(slice($current,0,$i),[$after[$i]]),slice($current,$i));$i=$i+1
      end
      if len($out)>256 then return [{op:"set",path:$path,value:$after}] end
    end
    if len($current)>len($after) then push($out,{op:"splice",path:$path,index:len($after),remove:len($current)-len($after),items:[]}) end
    return $out
  end
  return [{op:"set",path:$path,value:$after}]
end
