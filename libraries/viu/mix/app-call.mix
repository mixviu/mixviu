-- SPDX-License-Identifier: MIT OR Apache-2.0
-- version: 0.1.0
-- Same native broker protocol as citizen::call_app: launch only after the
-- broker says the service was absent. Never retry a delivered refusal or an
-- uncertain effect. This module owns no application-specific fallback.
fn viu_app_raw($service,$command,$body,$call_seconds=10)
  try
    if $call_seconds==10 then send $service $command body=$body
    else send $service $command body=$body timeout=$call_seconds end
    if $rc<0 then return {rc:20,body:{error_code:"OUTCOME_UNKNOWN",message:to_string($result)},message:$result} end
    $body=if $reply!=nil then $reply else $result end
    if $rc!=0 and type($body)!="map" then $body={error_code:"REFUSED",message:to_string($result)} end
    return {rc:if $rc>0 and $rc<10 then 10 else $rc end,body:$body,message:$result}
  catch $message
    return {rc:20,body:{error_code:"OUTCOME_UNKNOWN",message:$message},message:$message}
  end
end
fn viu_app_absent($reply,$service)
  return $reply.rc>=10 and $reply.message=="Service '"..$service.."' not found"
end
fn viu_app_call($id,$command,$body,$wait_seconds,$call_seconds=10)
  $service=split($command,".")[0]
  $first=viu_app_raw($service,$command,$body,$call_seconds)
  if not viu_app_absent($first,$service) then return $first end
  $launch=viu_app_raw("apps","apps.launch",{id:$id})
  if $launch.rc>=10 and $launch.body.error_code!="OUTCOME_UNKNOWN" then $launch.stage="launch";return $launch end
  $deadline=monotonic()+$wait_seconds
  while monotonic()<$deadline
    sleep(min(0.25,$deadline-monotonic()))
    if monotonic()>=$deadline then break end
    $attempt=viu_app_raw($service,$command,$body,$call_seconds)
    if not viu_app_absent($attempt,$service) then return $attempt end
  end
  return {rc:10,stage:"wait",body:{error_code:"NOT_RUNNING",message:"Application did not register before the wait limit"}}
end
