-- Shared application frame policy. Apps supply their own actions and state.
fn apply($model,$options)
  $model.frame={icon:"icon:"..$options.icon,groups:{"gold-icon":{preferred:28,minimum:28,align:"left",shrink:nil,order:0},"gold-menu":{preferred:220,minimum:100,align:"left",shrink:1,order:1},"gold-title":{preferred:"content",minimum:0,align:"center",shrink:0,order:2},"gold-toolbar":{preferred:180,minimum:36,align:"right",shrink:1,order:3}}}
  $values=$model.values ?? {}
  $values["gold-icon"]=$options.icon
  $values["gold-title"]=$options.title
  $values["gold-menu"]=$options.menus
  $values["gold-toolbar"]=$options.toolbar
  $values["gold-status-text"]=$options.status
  $values["gold-status-right"]=$options.status_right ?? ""
  $model.values=$values
  $model.appearance=$options.appearance ?? {scheme:"studio",mode:"dark"}
  $model.window_settings=$options.window ?? {"window.decorations":"csd"}
  return $model
end
