-- Shared application frame policy. Apps supply their own actions and state.
fn apply($model,$options)
  $model.window_title=$options.title
  $model.frame={icon:"icon:"..$options.icon,menu:{id:"gold-menu",kind:"menubar",label:"",initial:$options.menus,properties:{style:"gold",header_icon:$options.icon}},groups:{"gold-captions":{preferred:"window.captions",minimum:"window.captions",align:"window.captions",shrink:nil,order:3},"gold-menu":{preferred:"content",minimum:"content",align:"window.menu",shrink:nil,order:0},"gold-toolbar":{preferred:"content",minimum:136,align:"window.actions",shrink:1,order:2},"gold-title":{preferred:"content",minimum:0,align:"window.title",shrink:0,order:1}}}
  $values=$model.values ?? {}
  $values["gold-icon"]=$options.icon
  $values["gold-title"]=$options.title
  $values["gold-menu"]=$options.menus
  $values["gold-toolbar"]=$options.toolbar
  $values["gold-status-text"]=if type($options.status)=="string" then {left:$options.status,right:[],icon:"plug"} else $options.status end
  $model.values=$values
  $model.appearance=$options.appearance ?? {scheme:"studio",mode:"dark"}
  $model.window_settings=$options.window ?? {"window.decorations":"csd"}
  return $model
end
