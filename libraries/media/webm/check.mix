fn checked($cmd)
  $r = run_argv($cmd, {timeout: 7200, max_output: 16777216})
  print($r.stdout)
  print($r.stderr)
  if not $r.ok then raise("CHECK", join($cmd, " ") .. " failed") end
end
try
  checked(["cargo", "fmt", "-p", "media-webm"])
  checked(["cargo", "clippy", "-p", "media-webm", "--all-targets", "--", "-D", "warnings"])
  checked(["cargo", "test", "-p", "media-webm", "--all-targets"])
  checked(["mix", "tools/foreign_gate.mix"])
  if env("MEDIA_WEBM_SAMPLE", "") != "" then
    checked(["cargo", "test", "--locked", "--profile", "release-fast", "-p", "media-webm", "--test", "oracle", "sample_4k", "--", "--ignored", "--exact"])
  end
finally
  print("BEGIN_WORKER_DIFF")
  print(run_argv_must(["git", "diff", "--", "libraries/media/webm", "Cargo.lock"]))
  print("END_WORKER_DIFF")
  checked(["git", "checkout", "-q", "--", "libraries/media/webm", "Cargo.lock"])
end
