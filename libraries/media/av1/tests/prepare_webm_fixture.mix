-- One-shot CBC fixture generation, preserving the worker's clean checkout.
fn checked($cmd)
  $r = run_argv($cmd, {timeout: 7200, max_output: 16777216})
  print($r.stdout)
  print($r.stderr)
  if not $r.ok then raise("CHECK", join($cmd, " ")) end
end
try
  checked(["cargo", "fmt", "-p", "media-webm", "-p", "media-av1"])
  checked(["env", "MEDIA_AV1_FIXTURE=/tmp/media-av1-webm-r2-fixture.webm", "cargo", "test", "--profile", "release-fast", "-p", "media-av1", "--features", "asm", "--test", "webm", "generate_webm_fixture", "--", "--ignored", "--exact"])
finally
  print("BEGIN_WORKER_DIFF")
  print(run_argv_must(["git", "diff", "--", "libraries/media/webm", "libraries/media/av1", "Cargo.lock"]))
  print("END_WORKER_DIFF")
  checked(["git", "checkout", "-q", "--", "libraries/media/webm", "libraries/media/av1", "Cargo.lock"])
end
