-- Opt-in focused worker correctness/first-numbers job; not the av1enc suite.
fn checked($cmd)
  $r = run_argv($cmd, {timeout: 7200, max_output: 16777216})
  print($r.stdout)
  print($r.stderr)
  if not $r.ok then exit(1) end
  return $r
end
checked(["ffmpeg", "-version"])
for $variant in ["asm", "rust"]
  $cmd = ["cargo", "build", "-j", "2", "--profile", "release-fast", "-p", "media-av1", "--example", "first_numbers"]
  if $variant == "rust" then push($cmd, "--no-default-features") end
  checked($cmd)
  for $dimensions in [[1920, 1080], [3840, 2160]]
    for $speed in [6, 8, 10]
      for $scene in ["static", "scroll", "drag"]
        $w = to_string($dimensions[0])
        $h = to_string($dimensions[1])
        $dir = "/tmp/media-av1-" .. $variant .. "-" .. $w .. "-" .. to_string($speed) .. "-" .. $scene
        checked(["target/release-fast/examples/first_numbers", $dir, $w, $h, to_string($speed), $scene])
        $probe = checked(["ffprobe", "-v", "error", "-count_frames", "-show_entries", "stream=nb_read_frames,width,height", "-of", "json", $dir .. "/encoded.ivf"])
        $stream = json_parse($probe.stdout).streams[0]
        if to_number($stream.nb_read_frames) != 8 or $stream.width != $dimensions[0] or $stream.height != $dimensions[1] then
          raise("DECODE", "wrong decoded count or dimensions")
        end
        checked(["ffmpeg", "-v", "info", "-c:v", "libdav1d", "-i", $dir .. "/encoded.ivf", "-f", "rawvideo", "-pixel_format", "yuv420p", "-video_size", $w .. "x" .. $h, "-framerate", "30", "-i", $dir .. "/source.yuv", "-lavfi", "psnr", "-f", "null", "-"])
      end
    end
  end
end
