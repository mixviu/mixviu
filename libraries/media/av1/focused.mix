$root = trim(run_argv_must(["mktemp", "-d", "/tmp/media-av1-focused-XXXXXX"]))\nfn checked($cmd)
  $r = run_argv($cmd, {timeout: 7200, max_output: 16777216})
  print($r.stdout)
  print($r.stderr)
  if not $r.ok then raise("CHECK", "command failed: " .. join($cmd, " ")) end
end
try\nchecked(["cargo", "test", "--locked", "-p", "media-av1"])\nchecked(["cargo", "test", "--locked", "-p", "media-av1", "--features", "asm"])
checked(["cargo", "test", "-p", "media-av1", "--no-default-features"])
checked(["cargo", "clippy", "--locked", "-p", "media-av1", "--all-targets", "--", "-D", "warnings"])\nchecked(["cargo", "clippy", "--locked", "-p", "media-av1", "--all-targets", "--features", "asm", "--", "-D", "warnings"])
checked(["cargo", "fmt", "-p", "media-av1"])
checked(["git", "diff"])
checked(["git", "checkout", "-q", "--", "."])
\nfinally\n  $gone = run_argv(["rm", "-rf", "--", $root])\n  if not $gone.ok then raise("CLEANUP", "could not remove " .. $root .. ": " .. $gone.stderr) end\nend\n