-- Focused worker checks only. Run via the native build service.
fn checked($cmd)
  $r = run_argv($cmd, {timeout: 7200, max_output: 16777216})
  print($r.stdout)
  print($r.stderr)
  if not $r.ok then raise("CHECK", "command failed: " .. join($cmd, " ")) end
end
if contains(args(), "--fmt") then
  try
    checked(["cargo", "fmt", "-p", "media-av1"])
    checked(["git", "diff", "--", "libraries/media/av1"])
  finally
    checked(["git", "checkout", "-q", "--", "libraries/media/av1"])
  end
else
  checked(["cargo", "fmt", "-p", "media-av1", "--", "--check"])
  for $features in [[], ["--features", "asm"]]
    $cmd = ["cargo", "clippy", "--locked", "-p", "media-av1", "--all-targets"]
    for $arg in $features do push($cmd, $arg) end
    for $arg in ["--", "-D", "warnings"] do push($cmd, $arg) end
    checked($cmd)
  end
  for $features in [["--no-default-features"], ["--features", "asm"]]
    $cmd = ["cargo", "test", "--locked", "-p", "media-av1", "--all-targets"]
    for $arg in $features do push($cmd, $arg) end
    for $arg in ["--", "--nocapture"] do push($cmd, $arg) end
    checked($cmd)
  end
  checked(["mix", "tools/foreign_gate.mix"])
end
