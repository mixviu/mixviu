-- Run on a CBC worker with a private fixture generated by episode_fixture.mix.
$a = args()
if len($a) != 1 then raise("USAGE", "episode_check.mix FIXTURE_DIR") end
$dir = $a[0]
print(run_argv_must(["cargo", "build", "--release", "-p", "mixd"], {timeout:7200}))
print(run_argv_must(["/usr/bin/time", "-v", "target/release/mixd", "av", "audio", path_join($dir,"timeline.json"), "--out", path_join($dir,"episode.webm"), "--wav", path_join($dir,"episode.wav")], {timeout:7200}))
$r = run_argv(["ffmpeg", "-hide_banner", "-nostats", "-i", path_join($dir,"episode.webm"), "-af", "ebur128=peak=true", "-f", "null", "-"], {timeout:1800})
print($r)
if not $r.ok then exit(1) end
