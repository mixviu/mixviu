-- Worker-only provenance and dependency admission evidence.
$tree = run_argv_must(["cargo", "tree", "--locked", "-p", "media-audio", "-e", "normal,build", "--prefix", "none", "-f", "{p}"])
$names = {}
for $line in split($tree, "\n")
  $names[split(trim($line), " ")[0]] = true
end
$meta = json_parse(run_argv_must(["cargo", "metadata", "--locked", "--format-version", "1"], {max_output:268435456}))
for $p in $meta.packages
  if $names[$p.name] == true then print($p.name .. " " .. $p.version .. " | " .. ($p.license ?? "UNKNOWN") .. " | " .. ($p.repository ?? "workspace")) end
end
