-- Focused worker checks, including oracle and no full CI run.
for $argv in [["cargo", "test", "-p", "media-audio", "-p", "media-webm", "-p", "mixd", "--all-targets"], ["cargo", "clippy", "-p", "media-audio", "-p", "media-webm", "-p", "mixd", "--all-targets", "--", "-D", "warnings"], ["mix", "tools/foreign_gate.mix"]]
  print(run_argv_must(concat(["env", "MIX_TEST_REQUIRE_FFMPEG=1"], $argv), {timeout: 7200}))
end
