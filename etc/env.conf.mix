    {"meaning":"Ported daylight daylight clock offset override or child-process context; see the owning script","name":"MIX_DAYLIGHT_CLOCK_OFFSET","owner":"daylight","scope":"runtime"},
    {"meaning":"Ported daylight daylight instance override or child-process context; see the owning script","name":"MIX_DAYLIGHT_INSTANCE","owner":"daylight","scope":"runtime"},
    {"meaning":"Ported daylight daylight localtime override or child-process context; see the owning script","name":"MIX_DAYLIGHT_LOCALTIME","owner":"daylight","scope":"runtime"},
    {"meaning":"Ported daylight daylight resume override or child-process context; see the owning script","name":"MIX_DAYLIGHT_RESUME","owner":"daylight","scope":"runtime"},
