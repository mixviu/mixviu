    {name: "MIX_VIUD_DISABLE_LATE_LATCH", owner: "viud", scope: "runtime", meaning: "viud disables late latching"},
    {name: "MIX_VIUD_CAPTURE_DIR", owner: "viud", scope: "runtime", meaning: "viud capture output directory"},
    {name: "MIX_VIUD_CAPTURE_ENCODER", owner: "viud", scope: "runtime", meaning: "viud capture encoder"},
    {name: "MIX_VIUD_CAPTURE_EVERY", owner: "viud", scope: "runtime", meaning: "viud periodic capture interval"},
    {name: "MIX_VIUD_CAPTURE_ON_SIGNAL", owner: "viud", scope: "runtime", meaning: "viud captures a frame on a signal"},
    {name: "MIX_TEST_VIUD_RENDER_NODE", owner: "viud", scope: "test", meaning: "GPU render node for the headless tests"},
    {name: "MIX_TEST_VIUD_EXE", owner: "viud", scope: "test", meaning: "viud executable the headless tests start"},
    {name: "MIX_TEST_VIUD_NATIVE_EXE", owner: "viu", scope: "test", meaning: "native viud executable for the furniture comparison"},
    {name: "MIX_TEST_VIUD_WLCS_EXE", owner: "viud", scope: "test", meaning: "viud executable the wlcs adapter starts"},
    {name: "MIX_TEST_VIUD_WLCS_FD", owner: "viud", scope: "test", meaning: "inherited wlcs control descriptor (wlcs feature only)"},
    {name: "MIX_TEST_VIUD_OUT", owner: "viud", scope: "test", meaning: "headless test output directory"},
    {name: "MIX_TEST_VIUD_ITEST_SERVICE", owner: "viud", scope: "test", meaning: "Bus service name for the comp-service integration test"},
    {name: "MIX_TEST_VIUD_EGL_CLIENT", owner: "viud", scope: "test", meaning: "EGL client executable for the headless test"},
    {name: "MIX_TEST_VIUD_APP_REFERENCE", owner: "viud", scope: "test", meaning: "reference app for the headless app test"},
    {name: "MIX_TEST_VIU_GALLERY_WITNESS", owner: "viu", scope: "test", meaning: "gallery parity witness output"},
    {name: "MIX_TEST_VIU_HOST_ENV", owner: "viu", scope: "test", meaning: "probe variable for the viu runtime host-env test"},
    {name: "MIX_TEST_VIU_APP_SCRIPT", owner: "viu", scope: "test", meaning: "one app Mix script selected in an isolated native test process; argv is discarded on exit"},
    {name: "MIX_TEST_INDEXD_TOKENIZER", owner: "indexd", scope: "test", meaning: "tokenizer fixture for the tokenizer parity test (build time)"},
    {name: "MIX_TEST_INDEXD_BROKER", owner: "indexd", scope: "test", meaning: "marks the indexd Bus script as run by its test"},
    {name: "MIX_TEST_MAILD_ACTIVATION", owner: "maild", scope: "test", meaning: "socket-activation test mode"},
    {name: "MIX_CLIPD_CONFIG", owner: "clipd", scope: "runtime", meaning: "clipd config file (default <etc>/clipd/clipboard.conf.mix)"},
    {name: "MIX_CLIPD_MODE", owner: "clipd", scope: "runtime", meaning: "clipd backend: store, wayland or auto"},
    {name: "MIX_CLIPD_SESSION", owner: "clipd", scope: "runtime", meaning: "clipd session name (vt<N> for a desk)"},
    {name: "MIX_CLIPD_TARGET", owner: "clipd", scope: "runtime", meaning: "Bus name the clipd watcher reports to (set by clipd)"},
    {name: "MIX_CLIPD_WATCH_TOKEN", owner: "clipd", scope: "runtime", meaning: "token pairing a watcher with its clipd (set by clipd)"},
    {name: "MIX_EXPORTD_STATE", owner: "exportd", scope: "runtime", meaning: "exportd undo and pause state directory"},
    {name: "MIX_EXPORTD_COSMIC_ROOT", owner: "exportd", scope: "runtime", meaning: "COSMIC config tree exportd writes"},
    {name: "MIX_EXPORTD_GTKQT_HOME", owner: "exportd", scope: "runtime", meaning: "allow the GTK/Qt export into the real home config"},
    {name: "MIX_EXPORTD_DRY_RUN", owner: "exportd", scope: "runtime", meaning: "plan the export only"},
    {name: "MIX_EXPORTD_KDE_STATE", owner: "exportd", scope: "runtime", meaning: "KDE export undo record"},
    {name: "MIX_EXPORTD_KDE_DRY", owner: "exportd", scope: "runtime", meaning: "plan the KDE export only"},
    {name: "MIX_EXPORTD_KDE_RECONFIGURE", owner: "exportd", scope: "runtime", meaning: "ask KDE to reconfigure after an export"},
    {name: "MIX_EXPORTD_KDE_KWRITECONFIG", owner: "exportd", scope: "runtime", meaning: "kwriteconfig6 executable"},
    {name: "MIX_EXPORTD_KDE_BUSCTL", owner: "exportd", scope: "runtime", meaning: "busctl executable"},
    {name: "MIX_NOTIFYD_STATE", owner: "notifyd", scope: "runtime", meaning: "notifyd state file (default ~/.local/state/mix/notifyd/state.json)"},
    {name: "MIX_SETTINGS_SERVICE", owner: "settings", scope: "runtime", meaning: "Bus name of the settingsd a client asks (default settingsd)"},
    {name: "MIX_TEST_BLOBD_EXE", owner: "clipd", scope: "test", meaning: "blobd executable for the clipd tests"},
    {name: "MIX_TEST_EXPORTD_REAL_KDE", owner: "exportd", scope: "test", meaning: "run the KDE export test against a real KDE"},
    {name: "MIX_EXPORTD_COSMIC_HOME", owner: "exportd", scope: "runtime", meaning: "allow the COSMIC export into the home directory own .config (otherwise a dry run)"},
    {name: "MIX_EXPORTD_KDE_HOME", owner: "exportd", scope: "runtime", meaning: "allow the KDE export into the home directory own .config (otherwise a dry run)"}
  ],
  -- Name prefixes code or docs match against (MIX_TEST_ = test-only names,
  -- MIX_<ENGINE>_ = an engine's settings). A prefix token in the tree must be listed.
  prefixes: ["MIX_TEST_", "MIX_VIUD_", "MIX_VIU_", "MIX_MACRO_"],
  -- Paths (regexes over repo-relative paths) where MIXOS_ / /opt/mixos may
  -- still appear: provenance, lab oracle and gold-comparison scripts, CBC
  -- host-mix invocations, Mix-script tests defaulting to the host's gold mix,
  -- and history (changelogs).
  mixos_allowed: [
    "^provenance/",
    -- Terminal native-session tests run the installed host Mix.
    "^libraries/viu/src/terminal/(conformance|sessions)\\.rs$",
    "^vendor/",
    "^docs/ports/",
    "^last\\.md$",
    "CHANGELOG\\.md$",
    "^docs/mix/changelog",
    "^tools/.*\\.mix$",
    "^apps/[^/]+/gate\\.mix$",
    "^apps/[^/]+/capture-build\\.mix$",
    "^apps/gallery/README\\.md$",
    "/tests/",
    "_test\\.mix$",
    "_tests\\.rs$",
    "/tests\\.rs$",
    "^services/indexd/src/bus\\.rs$"
  ]
}
