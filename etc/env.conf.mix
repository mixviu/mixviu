-- SPDX-License-Identifier: MIT OR Apache-2.0
-- Registry of every MIX_* name in the tree (strict data; read with load_data).
-- Rules (Fable ruling, 2026-11-07): a bare mix-prefixed name is system-wide;
-- an engine or personality setting names that engine as its second word
-- (viud, noded, webd, ...); interpreter settings stay bare (MIX_DEBUG,
-- MIX_LINT); test-only names carry the test word second; a name ending in
-- BIN is a directory and one ending in EXE a file. A few entries are Rust
-- constants or file names that share the spelling; their meaning says so.
{
  vars: [
    {"meaning":"Ported agentd acp agent override or child-process context; see the owning script","name":"MIX_ACP_AGENT","owner":"agentd","scope":"runtime"},
    {"meaning":"Ported agentd acp connection override or child-process context; see the owning script","name":"MIX_ACP_CONNECTION","owner":"agentd","scope":"runtime"},
    {"meaning":"Ported agentd acp service override or child-process context; see the owning script","name":"MIX_ACP_SERVICE","owner":"agentd","scope":"runtime"},
    {"meaning":"Ported agentd agentd close grace s override or child-process context; see the owning script","name":"MIX_AGENTD_CLOSE_GRACE_S","owner":"agentd","scope":"runtime"},
    {"meaning":"Ported agentd agentd conf override or child-process context; see the owning script","name":"MIX_AGENTD_CONF","owner":"agentd","scope":"runtime"},
    {"meaning":"Ported agentd agentd db override or child-process context; see the owning script","name":"MIX_AGENTD_DB","owner":"agentd","scope":"runtime"},
