-- SPDX-License-Identifier: MIT OR Apache-2.0
-- A bundled manifest must render after its repository sources are gone.
$layout = require("../share/layout/files.mix")
$tmp = env("TMPDIR", "/tmp") .. "/mix-service-bundle-" .. uuid()
$repo = dirname(dirname(script_path()))
$roots = {prefix: "/srv/fixture", lib: "/srv/fixture/lib", etc: "/srv/fixture/etc", var: "/srv/fixture/var",
  run: "/srv/fixture/run", cache: "/srv/fixture/cache", share: "/srv/fixture/share"}
try
  -- Use the archive builder's actual app placement, without fetching assets
  -- or building the engines. The registry must see every staged launcher.
  $app_files = require("../tools/apps_bundle_files.mix")
  $registry = require("../engines/viud/scripts/lib/apps.mix")
  $staged_apps = $app_files.stage_apps($tmp .. "/apps")
  $launchers = $tmp .. "/apps/share/applications"
  $expected = ["term", "dopus", "email", "ced", "deck", "gallery", "monitor", "prefs", "screenshot", "workshop"]
  $entries = glob($launchers .. "/*.desktop")
  if len($entries) != len($expected) then raise("BUNDLE", "expected exactly ten launcher entries") end
  $visible = filter($registry.scan_apps([$launchers], "", "MIXOS"), fn($e) = not $e.no_display)
  if len($visible) != len($expected) then raise("BUNDLE", "registry hid a bundled launcher") end
  for $app in $expected
    $id = "mixviu." .. $app
    $sources = $app_files.tracked("apps/" .. $app .. "/mixviu.*.desktop")
    if $sources != ["apps/" .. $app .. "/" .. $id .. ".desktop"] then
      raise("BUNDLE", "expected one tracked launcher source for " .. $app)
    end
    if len(filter($entries, fn($p) = basename($p) == $id .. ".desktop")) != 1 then
      raise("BUNDLE", "missing or duplicate launcher for " .. $app)
    end
    $entry = $registry.find_app($visible, $id)
    if $entry == nil or $registry.project_list($entry).id != $id or not $registry.match_query($entry, "") then
      raise("BUNDLE", "apps.list cannot list " .. $app)
    end
    if not contains($staged_apps, $app) or not is_file($tmp .. "/apps/share/mixviu/apps/" .. $app .. "/contract.json") then
      raise("BUNDLE", "launcher app was not placed: " .. $app)
    end
    if $app == "term" then
      if $entry.exec != "/opt/mix/bin/term" or not is_file($tmp .. "/apps/bin/term") then
        raise("BUNDLE", "Term launcher wrapper missing")
      end
      if not contains(read_file($tmp .. "/apps/bin/term"), "\"/opt/mix/bin/viu\", \"run\", \"/opt/mix/share/mixviu/apps/term\"") then
        raise("BUNDLE", "Term wrapper does not name its bundled app")
      end
    elif $registry.parse_exec($entry.exec) != ["/opt/mix/bin/viu", "run", "/opt/mix/share/mixviu/apps/" .. $app] then
      raise("BUNDLE", "Exec does not name the bundled app: " .. $app)
    end
  end
  for $app in ["backdrop", "bustap", "osd", "volume-lab", "gallery-reference"]
    if len(glob($repo .. "/apps/" .. $app .. "/mixviu.*.desktop")) != 0 or $registry.find_app($visible, "mixviu." .. $app) != nil then
      raise("BUNDLE", "non-launcher app has an entry: " .. $app)
    end
  end
  print("PASS ten bundled launcher entries target staged apps and remain visible to apps.list; five excluded apps have no entry")
  mkdir($tmp .. "/source", {parents: true})
  $entries = []
  for $svc in ["agentd", "peersd", "releasesd", "daylight"]
    for $file in sort(glob($repo .. "/services/" .. $svc .. "/units/*"))
      copy($file, $tmp .. "/source/" .. basename($file))
      push($entries, {source: basename($file), kind: "unit",
        target: "@{prefix}/share/" .. $svc .. "/units/" .. basename($file)})
    end
  end
  write_file($tmp .. "/source/templates.mx", data_encode({schema: 1, files: $entries}, true))
  $layout.bundle($tmp .. "/source", $tmp .. "/installed")
  remove_dir($tmp .. "/source")
  $rendered = $layout.plan($tmp .. "/installed", $roots)
  if len($rendered) != 5 then raise("BUNDLE", "expected five installed units") end
  for $unit in $rendered
    if not contains($unit.text, "ExecStart=/srv/fixture/bin/mix --serve /srv/fixture/lib/") or contains($unit.text, "@{") then
      raise("BUNDLE", "unresolved installed unit " .. $unit.path)
    end
  end
  print("PASS five bundled service units render without repository sources")
  -- Full closure, not just the five services above. This runs in CI's
  -- mix-services stage (also called by test/all and the PR CBC gate).
  $layout.bundle($repo .. "/share/layout", $tmp .. "/full")
  $maps = [
    {name: "desk-ct/host-install/desk-roots", roots: {prefix:"/opt/mix", share:"/opt/mix/share", lib:"/opt/mix/lib", etc:"/opt/mix/etc", var:"/opt/mix/var", run:"/opt/mix/run", cache:"/opt/mix/cache"}},
    {name: "layout-apply", roots: {}},
    {name: "relocated", roots: $roots}
  ]
  for $name in ["prefix", "share", "lib", "etc", "var", "run", "cache"]
    $maps[1].roots[$name] = mix_path($name, "", {tier:"system"})
  end
  for $installer in $maps
    $rendered = $layout.plan($tmp .. "/full", $installer.roots)
    if len($rendered) < 40 then raise("BUNDLE", "full layout closure missing") end
    for $unit in $rendered
      if contains($unit.text, "@{") then raise("BUNDLE", "unresolved " .. $installer.name .. ": " .. $unit.path) end
      if ends_with($unit.path, "/host.tmpfiles.conf") then
        for $root in ["run", "var"]
          if not contains($unit.text, "d " .. $installer.roots[$root] .. "/session 0755 root root -") then raise("BUNDLE", "session root ownership") end
        end
      end
    end
    print("PASS full layout renders installer roots: " .. $installer.name)
  end
  $forwarder = read_file($repo .. "/services/udev-forwarder/units/udev-forwarder.service")
  if $layout.desk_unit($forwarder) then raise("BUNDLE", "host-only forwarder entered desk unit catalogue") end
  if not $layout.desk_unit(read_file($repo .. "/services/noded/units/noded@.service")) then raise("BUNDLE", "desk session unit excluded") end
  -- Deliberately omit lib: the former desk installer map must fail, even
  -- though none of the five service-only fixtures above needed that root.
  $missing = {prefix:"/opt/mix", share:"/opt/mix/share", etc:"/opt/mix/etc", var:"/opt/mix/var", run:"/opt/mix/run", cache:"/opt/mix/cache"}
  $rejected = false
  try
    $layout.plan($tmp .. "/full", $missing)
  catch $err
    $rejected = true
  end
  if not $rejected then raise("BUNDLE", "missing lib installer map accepted") end
  print("PASS missing lib rejected; host-only unit excluded from desk catalogue")
finally
  remove_dir($tmp)
end
