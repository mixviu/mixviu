-- version: 0.1.1
-- apps -- the application-registry citizen: the data foundation for the
-- desktop launcher and the taskbar's app icons. It scans the freedesktop
-- desktop-entry directories, resolves icons through the icon-theme spec and
-- owns managed application children, never handing an Exec string to a shell.
--
-- Run: mix --serve apps.mix          (Bus service name "apps")
-- The parse/lookup logic lives in lib/apps.mix (pure, unit-tested); this
-- file is only the Bus surface.
--
-- Event-driven by design: the tree is scanned once here, then again on
-- apps.reload or when an inotify watch on the applications directories
-- reports a change (an entry installed, replaced or removed). There is
-- timers only schedule STOP escalation; no process polling.
$a = require("lib/apps.mix")

$apps = $a.scan_apps($a.application_dirs(), $a.locale_id(), "MIXOS")
$icon_ctx = $a.icon_ctx()
$icon_theme = $a.default_theme()
$terminal_cmd = "mix:prefix/bin/term --"

fn event_args()
  -- Structured args when the caller sent a JSON map body, else an empty map.
  return type($event.args) == "map" ? $event.args : {}
end

-- One watch per applications directory, keyed by it: {handle, on}. An
-- existing directory is watched recursively (vendor subdirectories); a
-- missing one watches its nearest existing ancestor until it appears, and
-- is re-armed on the directory itself then. A deleted directory falls back
-- the same way.
$WATCH_EVENTS = ["created", "modified", "deleted", "moved"]
fn arm($watches)
  for each $dir in $a.application_dirs()
    $t = $a.watch_target($dir)
    $on = $t == nil ? nil : $t.on
    $real = $t == nil ? nil : $t.dir
    $cur = $watches[$dir]
    if $cur != nil and $cur.on == $on and $cur.real == $real then continue end
    if $cur != nil then
      try
        fs_unwatch($cur.handle)
      catch $gone
      end
      $watches = delete($watches, $dir)
    end
    if $on != nil then
      try
        $watches[$dir] = {handle: fs_watch($on, {recursive: $on == $real, events: $WATCH_EVENTS}), on: $on, real: $real}
      catch $why
        eprint("apps: no watch for " .. $dir .. " on " .. $on .. ": " .. $why)
      end
    end
  end
  return $watches
end
$watches = arm({})

on "apps.list" desc "list visible applications sorted by name (category, query optional)"
  $args = event_args()
  $category = get_or($args, "category", "")
  $query = get_or($args, "query", "")
  if type($category) != "string" or type($query) != "string" then
    reply(10, json_encode({error: "invalid_request"}))
  else
    $out = []
    for each $e in $apps
      -- NoDisplay entries stay launchable (apps.get/apps.launch) but are
      -- hidden from the menu listing.
      if not $e.no_display and ($category == "" or contains($e.categories, $category)) and $a.match_query($e, $query) then
        $out = concat($out, [$a.project_list($e)])
      end
    end
    reply(0, json_encode($out))
  end
end

on "apps.get" desc "one application entry (all parsed fields) by id"
  $args = event_args()
  $id = get_or($args, "id", "")
  if type($id) != "string" or $id == "" then
    reply(10, json_encode({error: "invalid_request"}))
  else
    $e = $a.find_app($apps, $id)
    if $e == nil then
      reply(14, json_encode({error: "not_found"}))
    else
      reply(0, json_encode($e))
    end
  end
end

on "apps.icon" desc "resolve an icon name (or absolute path) to a themed icon file"
  $args = event_args()
  $name = get_or($args, "name", "")
  $size = get_or($args, "size", 48)
  $scale = get_or($args, "scale", 1)
  $theme_arg = get_or($args, "theme", "")
  if type($name) != "string" or $name == "" then
    reply(10, json_encode({error: "invalid_request"}))
  elif not $a.is_int($size) or $size < 1 or $size > 4096 then
    reply(10, json_encode({error: "invalid_request"}))
  elif not $a.is_int($scale) or $scale < 1 or $scale > 4 then
    reply(10, json_encode({error: "invalid_request"}))
  elif $theme_arg != "" and type($theme_arg) != "string" then
    reply(10, json_encode({error: "invalid_request"}))
  else
    $r = $a.resolve_icon($icon_ctx, $name, $size, $scale, $theme_arg == "" ? $icon_theme : $theme_arg)
    -- Whole rebind: keeps the parsed index.theme cache across calls.
    $icon_ctx = $r.ctx
    if $r.hit == nil then
      reply(14, json_encode({error: "not_found"}))
    else
      reply(0, json_encode($r.hit))
    end
  end
end

-- Managed app state belongs to this evaluator generation.
$live = {}
$generation = substr(replace(uuid(), "-", ""), 0, 4)
$serial = 0
$allow_argv = false
$history_seq = 0
$history_dir = mix_path("var", "apps/history")
mkdir($history_dir, {parents: true})

fn utc_now()
  return date_format(time(), "%Y-%m-%dT%H:%M:%SZ", {utc: true})
end

fn record_row($seq, $kind, $data)
  -- Daily append-only segments; prune old segments and cap total bytes at
  -- 8 MiB, deleting oldest whole segments. The active segment rolls at 1 MiB.
  $files = sort(glob($history_dir .. "/*.jsonl"))
  $total = 0
  for $f in $files
    if stat($f).mtime < time() - 30 * 86400 then remove($f) else $total = $total + stat($f).size end
  end
  $date = substr(utc_now(), 0, 10)
  $path = $history_dir .. "/" .. $date .. "-" .. $generation .. ".jsonl"
  if exists($path) and stat($path).size >= 1048576 then $path = $history_dir .. "/" .. $date .. "-" .. $generation .. "-" .. $seq .. ".jsonl" end
  for $f in $files
    if $total < 7340032 then break end
    if exists($f) and $f != $path then $total = $total - stat($f).size; remove($f) end
  end
  $seq = $seq + 1
  $line = exists($path) ? len(lines(trim(read_file($path)))) + 1 : 1
  append_file($path, json_encode({ts_utc: utc_now(), node: hostname(), source: "apps", seq: $generation .. "-" .. $seq, kind: $kind, class: "operator", ref: {file: basename($path), line: $line}, data: $a.history_data($data)}) .. "\n")
  return $seq
end
if not is_reload_candidate() then $history_seq = record_row($history_seq, "gap", {reason: "citizen_start"}) end
on lifecycle.commit
  $history_seq = record_row($history_seq, "gap", {reason: "reload"})
end

fn local_origin()
  return $event.headers.broker_origin == "local"
end

fn start_app($request, $live, $serial)
  $bad = $a.request_error("invalid_request")
  if not $a.start_valid($request) then return merge($bad, {live: $live, serial: $serial}) end
  if has_key($request, "argv") and (not $allow_argv or not local_origin()) then
    return {rc: 10, body: {error: "forbidden", error_code: "FORBIDDEN"}, live: $live, serial: $serial}
  end
  if len(keys($live)) >= 120 then return {rc: 10, body: {error: "limit", error_code: "RESOURCE_LIMIT"}, live: $live, serial: $serial} end
  $id = $request.id
  $opts = {exit_event: true}
  if $id != nil then
    $entry = $a.find_app($apps, $id)
    if $entry == nil then return {rc: 14, body: {error: "not_found"}, live: $live, serial: $serial} end
    $argv = $a.expand_exec($entry.exec, $entry, $request.uris)
    if $entry.terminal then $argv = concat($a.parse_exec($terminal_cmd), $argv) end
    $name = $id
    if $entry.workdir != "" and is_dir($entry.workdir) then $opts.cwd = $entry.workdir end
  else
    $argv = $request.argv
    $name = $request.name ?? basename($argv[0])
    if $request.cwd != nil then $opts.cwd = $request.cwd end
  end
  $exe = len($argv) > 0 ? $a.resolve_exec($argv[0], $opts.cwd ?? "") : nil
  if $exe == nil then return {rc: 11, body: {error: "spawn_failed", id: $id}, live: $live, serial: $serial} end
  $serial = $serial + 1
  $handle = $generation .. "-" .. $serial
  $opts.tag = $handle
  $opts.journal = $name
  $x = $a.launch_display(env("XDG_RUNTIME_DIR"), env("WAYLAND_DISPLAY"))
  if $x.display == nil then eprint("apps.launch " .. ($id ?? $name) .. ": DISPLAY unset: " .. $x.why) end
  $launch = $a.launch_spawn($argv, $exe, $x.display)
  if len(keys($launch.env)) > 0 then $opts.env = $launch.env end
  try
    $pid = spawn($launch.argv, $opts)
  catch $err
    return {rc: 11, body: {error: "spawn_failed", id: $id}, live: $live, serial: $serial}
  end
  $body = {handle: $handle, id: $id, pid: $pid, argv: $argv, started_utc: utc_now()}
  $live[$handle] = merge($body, {name: $name, since: monotonic(), state: "running", reason: "exit", timers: []})
  publish(serve_name() .. ".started", json_encode($body), {command: "apps.started"})
  return {rc: 0, body: $body, live: $live, serial: $serial}
end

fn window_snapshot()
  send comp comp.windows.list timeout=0.2 body="{}"
  return {ok: $rc == 0, windows: $rc == 0 ? $result.windows : []}
end

fn window_groups($windows)
  $groups = {}
  for $w in $windows
    if $a.is_int($w.pid) and $w.pid > 0 then
      try
        $s = read_file("/proc/" .. $w.pid .. "/stat")
        $fields = split(slice($s, last_index_of($s, ")") + 2), " ")
        $groups[to_string($w.pid)] = to_number($fields[2])
      catch $gone
      end
    end
  end
  return $groups
end

fn stop_apps($request, $live)
  if not $a.stop_valid($request) then return {rc: 10, body: {error: "invalid_request"}, live: $live} end
  $selected = $a.live_select($live, $request)
  if len($selected) == 0 then return {rc: 14, body: {error: "not_found"}, live: $live} end
  $stopping = []
  $force = ($request.mode ?? "graceful") == "force"
  $snapshot = $force ? {ok: false, windows: []} : window_snapshot()
  $groups = window_groups($snapshot.windows)
  for $r in $selected
    push($stopping, {handle: $r.handle, pid: $r.pid})
    if $r.state == "stopping" then continue end
    $r.state = "stopping"
    $r.reason = $force ? "force" : "stop"
    if $force then
      kill(-$r.pid, 9)
    else
      $owned = $a.owned_windows($r, $snapshot.windows, $groups)
      $close_ok = $snapshot.ok and len($owned) > 0
      for $w in $owned
        send comp comp.window.close timeout=0.2 body=json_encode({id: $w.id, generation: $w.generation})
        if $rc != 0 then $close_ok = false end
      end
      $timeout = ($request.timeout_ms ?? 5000) / 1000
      if $close_ok then
        $r.timers = concat($r.timers, [timer_once($timeout * 0.4, "term:" .. $r.handle)])
      else
        kill(-$r.pid, 15)
      end
      $r.timers = concat($r.timers, [timer_once($timeout, "kill:" .. $r.handle)])
    end
    $live[$r.handle] = $r
  end
  return {rc: 0, body: {stopping: $stopping}, live: $live}
end

-- Both names call this same implementation and return the identical superset.
on apps.start desc "start an app by desktop id or locally authorised argv"
  $r = start_app(event_args(), $live, $serial)
  $live = $r.live
  $serial = $r.serial
  $history_seq = record_row($history_seq, $r.rc == 0 ? "start" : "refused", $r.body)
  reply($r.rc, json_encode($r.body))
end
on apps.launch desc "alias of apps.start"
  $r = start_app(event_args(), $live, $serial)
  $live = $r.live
  $serial = $r.serial
  $history_seq = record_row($history_seq, $r.rc == 0 ? "start" : "refused", $r.body)
  reply($r.rc, json_encode($r.body))
end
on apps.stop desc "stop owned apps by handle or desktop id; never by pid"
  $request = event_args()
  $r = stop_apps($request, $live)
  $live = $r.live
  if $r.rc == 0 then
    for $s in $r.body.stopping
      $history_seq = record_row($history_seq, "stop_request", $live[$s.handle])
    end
  else
    $history_seq = record_row($history_seq, "refused", {reason: $r.body.error})
  end
  reply($r.rc, json_encode($r.body))
end
on apps.running desc "list managed app handles, optionally filtered by id"
  $request = event_args()
  if has_key($request, "id") and (type($request.id) != "string" or $request.id == "") then
    reply(10, json_encode({error: "invalid_request"}))
  else
    $snapshot = window_snapshot()
    $groups = window_groups($snapshot.windows)
    $out = []
    for $r in values($live)
      if $request.id == nil or $request.id == $r.id then push($out, $a.running_row($r, $a.owned_windows($r, $snapshot.windows, $groups))) end
    end
    reply(0, json_encode($out))
  end
end
on apps.toggle desc "start, focus or stop a desktop app"
  $request = event_args()
  $mode = $request.on_running ?? "focus_or_stop"
  if type($request.id) != "string" or $request.id == "" or not contains(["focus_or_stop", "focus", "stop"], $mode) then
    reply(10, json_encode({error: "invalid_request"}))
  else
    $selected = $a.live_select($live, {id: $request.id})
    if len($selected) == 0 then
      $r = start_app({id: $request.id}, $live, $serial)
      $serial = $r.serial
      $live = $r.live
      $history_seq = record_row($history_seq, $r.rc == 0 ? "start" : "refused", $r.body)
      reply($r.rc, json_encode(merge($r.body, {action: "started"})))
    else
      $snapshot = window_snapshot()
      $groups = window_groups($snapshot.windows)
      $windows = []
      for $r in $selected
        $windows = concat($windows, $a.owned_windows($r, $snapshot.windows, $groups))
      end
      $focused = len(filter($windows, fn($w) = $w.focused == true)) > 0
      if $mode == "stop" or ($mode == "focus_or_stop" and $focused) then
        $r = stop_apps({id: $request.id}, $live)
        $live = $r.live
        for $s in $r.body.stopping
          $history_seq = record_row($history_seq, "stop_request", $live[$s.handle])
        end
        reply($r.rc, json_encode(merge($r.body, {action: "stopping"})))
      elif len($windows) > 0 then
        $w = $windows[0]
        send comp comp.window.focus timeout=0.2 body=json_encode({id: $w.id, generation: $w.generation})
        $focus_rc = $rc
        reply($focus_rc, json_encode($focus_rc == 0 ? {action: "focused", handle: $selected[0].handle} : {error: "focus_failed"}))
      else
        reply(0, json_encode({action: "none", reason: "no_window", handle: $selected[0].handle}))
      end
    end
  end
end
on proc.exited
  if len(keys($event.headers ?? {})) != 0 then return end
  $exit = $event.args
  $r = $live[$exit.tag]
  if $r == nil or $r.pid != $exit.pid then return end
  for $timer in $r.timers
    cancel_timer($timer)
  end
  $body = {handle: $r.handle, id: $r.id, pid: $r.pid, exit_code: $exit.exit_code, signal: $exit.signal, reason: $r.reason, ran_ms: floor((monotonic() - $r.since) * 1000)}
  $live = delete($live, $r.handle)
  $history_seq = record_row($history_seq, "exit", merge($r, $body))
  publish(serve_name() .. ".exited", json_encode($body), {command: "apps.exited"})
end
on timer.tick
  if len(keys($event.headers ?? {})) != 0 then return end
  $tag = $event.args.tag
  $handle = after($tag, ":")
  $r = $live[$handle]
  if $r == nil or not contains($r.timers, $event.args.id) then return end
  kill(-$r.pid, starts_with($tag, "term:") ? 15 : 9)
end
on apps.history desc "local operator history {since?,until?,limit?}"
  $request = event_args()
  $limit = $request.limit ?? 500
  if not local_origin() then
    reply(10, json_encode({error: "forbidden", error_code: "FORBIDDEN"}))
  elif not $a.is_int($limit) or $limit < 1 or $limit > 5000 or (has_key($request, "since") and type($request.since) != "string") or (has_key($request, "until") and type($request.until) != "string") then
    reply(10, json_encode({error: "invalid_request"}))
  else
    $rows = []
    $truncated = false
    for $file in sort(glob($history_dir .. "/*.jsonl"))
      for $line in lines(read_file($file))
        if trim($line) == "" then continue end
        $row = json_parse($line)
        if $row.ts_utc >= ($request.since ?? "") and $row.ts_utc <= ($request.until ?? "9999") then
          if len($rows) < $limit then push($rows, $row) else $truncated = true end
        end
      end
    end
    reply(0, json_encode({rows: $rows, truncated: $truncated}))
  end
end

on "apps.reload" desc "rescan the desktop-entry directories now"
  $apps = $a.scan_apps($a.application_dirs(), $a.locale_id(), "MIXOS")
  -- Installed/replaced themes must clear cached misses as well as entries.
  $icon_ctx = $a.icon_ctx()
  publish(serve_name() .. ".changed", json_encode({reason: "reload", count: len($apps)}), {command: "apps.changed"})
  reply(0, json_encode({count: len($apps)}))
end

-- A local inotify batch, never a Bus message (those carry headers).
on fs.changed
  if len(keys($event.headers ?? {})) != 0 then return end
  $rescan = false
  for each $dir, $w in $watches
    if $w.handle == $event.args.watch and $a.watch_relevant($w.real, $w.on, $event.args) then $rescan = true end
  end
  if $rescan then
    $watches = arm($watches)
    $apps = $a.scan_apps($a.application_dirs(), $a.locale_id(), "MIXOS")
    $icon_ctx = $a.icon_ctx()
    publish(serve_name() .. ".changed", json_encode({reason: "watch", count: len($apps)}), {command: "apps.changed"})
  end
end

-- ── Properties ──────────────────────────────────────────────────────────
-- mix 0.89.0 reserves <svc>.props.{get,list,describe} for the runtime-owned
-- lifecycle tree, so the author properties publish through the SPEC-12 commands
-- that fall through to author handlers: watch (snapshot read) and set.

on "apps.props.watch" desc "read citizen properties: apps.count, apps.icon_theme, apps.terminal"
  $args = event_args()
  $path = get_or($args, "path", "")
  if $path == "" then
    reply(0, json_encode({"apps.count": len($apps), "apps.icon_theme": $icon_theme, "apps.terminal": $terminal_cmd, "apps.allow_argv": $allow_argv}))
  elif $path == "apps.allow_argv" then
    reply(0, json_encode({path: $path, value: $allow_argv}))
  elif $path == "apps.count" then
    reply(0, json_encode({path: $path, value: len($apps)}))
  elif $path == "apps.icon_theme" then
    reply(0, json_encode({path: $path, value: $icon_theme}))
  elif $path == "apps.terminal" then
    reply(0, json_encode({path: $path, value: $terminal_cmd}))
  else
    reply(14, json_encode({error: "not_found"}))
  end
end

on "apps.props.set" desc "set a citizen property (icon_theme, terminal; count is read-only)"
  $args = event_args()
  $path = get_or($args, "path", "")
  $value = get_or($args, "value", nil)
  if $path == "apps.allow_argv" then
    if not local_origin() then
      reply(10, json_encode({error: "forbidden", error_code: "FORBIDDEN"}))
    elif type($value) != "bool" then
      reply(10, json_encode({error: "invalid_request"}))
    else
      $allow_argv = $value
      reply(0, json_encode({path: $path, value: $allow_argv}))
    end
  elif type($path) != "string" or $path == "" or type($value) != "string" or trim($value) == "" then
    reply(10, json_encode({error: "invalid_request"}))
  elif $path == "apps.icon_theme" then
    $icon_theme = trim($value)
    publish(serve_name() .. ".changed", json_encode({reason: "icon_theme", value: $icon_theme}), {command: "apps.changed"})
    reply(0, json_encode({path: $path, value: $icon_theme}))
  elif $path == "apps.terminal" then
    $terminal_cmd = trim($value)
    reply(0, json_encode({path: $path, value: $terminal_cmd}))
  elif $path == "apps.count" then
    reply(10, json_encode({error: "read_only"}))
  else
    reply(14, json_encode({error: "not_found"}))
  end
end
