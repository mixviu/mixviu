-- The same owned, throwaway broker used by the compositor's Mix gates.
$a = args()
if $a[0] == "discover" then
  send noded noded.peers timeout=5 body="{}"
  if $rc != 0 then raise("BROKER_ADDRESS", "noded.peers failed: " .. to_string($rc)) end
  $peers = if type($result) == "string" then json_parse($result) else $result end
  print("BUS_ADDRESS " .. json_encode($peers))
elif $a[0] == "ready" then
  $service = if len($a) > 2 then $a[2] else "comp-headless" end
  $deadline = monotonic() + 15
  while monotonic() < $deadline
    send $service comp.windows.list timeout=1 body="{}"
    if $rc == 0 then exit(0) end
    sleep(0.1)
  end
  raise("VIUD_READY", "headless Bus port did not register")
else
  $command = $a[2]
  $body = $a[3]
  $service = if len($a) > 4 then $a[4] else "comp-headless" end
  send $service $command timeout=10 body=$body
  print(json_encode({rc: $rc, body: $result}))
end
