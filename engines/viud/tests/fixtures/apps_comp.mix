-- Private apps lifecycle fixture. Never connects to a host compositor.
$window = nil
$options = {}
on fake.set
  $window = {id: 1, generation: 1, pid: $event.args.pid, focused: false}
  $options = $event.args
  reply(0, "{}")
end
on fake.clear
  $window = nil
  reply(0, "{}")
end
on "comp.windows.list"
  if $options.exit_on_list == true and $window != nil then
    $options.exit_on_list = false
    $_signal = kill($window.pid, 15)
    sleep(0.03)
  end
  reply(0, json_encode({windows: $window == nil ? [] : [$window]}))
end
on "comp.window.focus"
  $window.focused = true
  reply(0, "{}")
end
on "comp.window.close"
  if $window != nil and $options.ignore_close != true then kill($window.pid, 15) end
  if $options.close_delay != nil then sleep($options.close_delay) end
  reply(0, "{}")
end
