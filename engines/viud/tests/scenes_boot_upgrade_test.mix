-- SPDX-License-Identifier: MIT OR Apache-2.0
-- Real loader + adapter on an owned private Bus. Host arrival is ordered by
-- observing the loader's failure, never by a guessed startup sleep. Deadlines
-- bound the harness only; no assertion depends on a narrow timing interval.
$here = dirname(realpath($0))
$repo = realpath($here .. "/../../..")
$pb = require("../../../tests/lib/private_bus.mix")
$mix = env("MIX_TEST_MIX_EXE", "/proc/" .. to_string(pid()) .. "/exe")
$noded = env("MIX_TEST_NODED_EXE", mix_path("prefix") .. "/bin/noded")
$tmp = trim(run_argv_must(["mktemp", "-d", "/tmp/scenes-boot-upgrade.XXXXXXXX"]))
$bus = nil
$children = {loader:nil, host:nil}
$load_children = []
$vars = {}
$started = monotonic()
$evidence = {last_call:nil}
$failure = {active:false}

fn check($ok, $message)
  if not $ok then raise("SCENES_BOOT_TEST", $message .. "; evidence: " .. $tmp) end
end

fn start($name, $script)
  return spawn([$mix, "--serve", $script, "--name", $name], {detach:true, clear_env:true, env:$vars,
    stdout:{file:$tmp .. "/" .. $name .. ".log"}, stderr:"stdout"})
end

fn stop($child)
  if $child == nil or not process_alive($child) then return end
  $_ = kill($child, 15)
  $deadline = monotonic() + 5
  while monotonic() < $deadline
    if not process_alive($child) then return end
    sleep(min(0.05, max(0, $deadline - monotonic())))
  end
  $_ = kill($child, 9)
end

fn client($target, $command, $body, $timeout)
  $r = run_argv([$mix, $tmp .. "/client.mix", $target, $command, json_encode($body)], {clear_env:true, env:$vars, timeout:$timeout})
  $evidence.last_call = {target:$target, command:$command, timeout:$timeout, result:$r}
  return $r
end

-- Assertion calls are strict. Only polling probes may discard a failed call.
fn call($target, $command, $body = {})
  $r = client($target, $command, $body, 15)
  check($r.ok, "client failed: " .. $r.stderr)
  return json_parse($r.stdout)
end

fn probe($target, $command, $deadline)
  $remaining = $deadline - monotonic()
  if $remaining < 0.25 then return nil end
  try
    $r = client($target, $command, {}, min(5, $remaining))
    if $r.ok then return json_parse($r.stdout) end
  catch $ignored
    -- Launch/parse errors are also retryable; the wait owns its failure.
  end
  return nil
end

fn wait_service($target)
  -- Local registration normally takes a fraction of a second; allow 15 s
  -- under pool load, including every client process and its Bus request.
  $began = monotonic()
  $deadline = $began + 15
  while $deadline - monotonic() >= 0.25
    $r = probe($target, "INFO", $deadline)
    if $r != nil and $r.rc == 0 then
      print("READY " .. $target .. " seconds=" .. to_string(monotonic() - $began))
      return
    end
    sleep(min(0.1, max(0, $deadline - monotonic())))
  end
  check(false, "service missing: " .. $target)
end

fn rows($deadline = nil)
  $r = if $deadline == nil then call("scenes", "scenes.list") else probe("scenes", "scenes.list", $deadline) end
  if $deadline == nil then check($r.rc == 0, "list refused") end
  if $r == nil or $r.rc != 0 then return nil end
  $out = {}
  for $row in $r.value.scenes $out[$row.name] = $row end
  return $out
end

fn wait_failure($terminal)
  -- The configured seven-rung ladder takes 7 s; 15 s includes headroom.
  $deadline = monotonic() + 15
  while $deadline - monotonic() >= 0.25
    $snapshot = rows($deadline)
    $r = if $snapshot == nil then nil else $snapshot.alpha end
    if $r != nil and $r.stale and $r.upgrade.error_code == "SCENES_UPSTREAM" then
      if not $terminal or $r.upgrade.retryable == false then return $r end
    end
    sleep(min(0.1, max(0, $deadline - monotonic())))
  end
  check(false, "missing availability flag")
end

fn fixture_source($name, $text)
  return "---\nscene: 1\nname: " .. $name .. "\ncitizen: scene-" .. $name .. "\nwindow: {\"kind\":\"edge\",\"edge\":\"right\"}\n---\n```mix\nroot: {widget: text, text: '" .. $text .. "'}\n```\n"
end

fn wait_file($path)
  $deadline = monotonic() + 5
  while monotonic() < $deadline
    if is_file($path) then return end
    sleep(min(0.01, max(0, $deadline - monotonic())))
  end
  check(false, "missing ordered task marker: " .. $path)
end

fn retry_snapshot()
  return call("scenes", "fixture.retry").value
end

fn evidence_child($name, $child)
  try
    eprint("child " .. $name .. ": " .. json_encode({pid:$child, alive:$child != nil and process_alive($child)}))
  catch $ignored
  end
end

fn failure_evidence($message, $error)
  try eprint("FAIL " .. $error.code .. ": " .. $message) catch $ignored end
  try eprint("last call: " .. json_encode($evidence.last_call)) catch $ignored end
  for $name in keys($children)
    try evidence_child($name, $children[$name]) catch $ignored end
  end
  $i = 0
  for $child in $load_children
    try evidence_child("load-" .. to_string($i), $child) catch $ignored end
    $i = $i + 1
  end
  try
    if $bus != nil then evidence_child("noded", $bus.pid) end
  catch $ignored
  end
  for $path in concat(glob($tmp .. "/*.log"), glob($tmp .. "/bus/*.log"))
    for $part in [{tool:"head", lines:"40"}, {tool:"tail", lines:"80"}]
      try
        $r = run_argv([$part.tool, "-n", $part.lines, "--", $path], {timeout:1, max_output:16384})
        eprint($path .. " (" .. $part.tool .. " " .. $part.lines .. ", capped at 16 KiB)\n" .. $r.stdout .. $r.stderr)
      catch $ignored
      end
    end
  end
end

fn cleanup()
  for $child in $load_children stop($child) end
  for $child in values($children) stop($child) end
  if $bus != nil then $pb.stop($bus) end
  if env("SCENES_BOOT_KEEP", "0") != "1" then remove_dir($tmp) else print("evidence: " .. $tmp) end
end

try
  if env("SCENES_BOOT_LOAD", "0") == "1" then
    for $i = 1 to 4
      push($load_children, spawn([$mix, "-c", '$until=monotonic()+300; $n=0; while monotonic() < $until $n=$n+1 end'], {die_with_parent:true}))
    end
  end
  write_file($tmp .. "/client.mix", '$body = json_parse($3)
send $1 $2 body=(type($body) == "string" ? $body : json_encode($body)) timeout=10
$v = $result
if type($v) == "string" then
  try $v = json_parse($v) catch $ignored end
end
print(json_encode({rc:$rc, value:$v, reply:$reply}))
')
  mkdir($tmp .. "/templates")
  mkdir($tmp .. "/scenes")
  for $name in ["alpha", "beta", "gamma", "removed"]
    mkdir($tmp .. "/templates/" .. $name)
    write_file($tmp .. "/templates/" .. $name .. "/scene.mix", fixture_source($name, "old"))
    write_file($tmp .. "/templates/" .. $name .. "/template.conf.mix", "{title:'Test'}\n")
  end
  $bus = $pb.start({dir:$tmp .. "/bus", name:"scenes-boot-test", noded:$noded})
  $vars = merge($pb.client_env($bus), {PATH:env("PATH"), HOME:$tmp .. "/home", MIX_STATS:"off",
    SCENES_DIR:$tmp .. "/scenes", SCENES_TEMPLATES:$tmp .. "/templates", SCENES_FIRST_RUN:"0",
    MIX_VIUD_SCENES_UPGRADE_DELAYS:"[1,1,1,1,1,1,1]",
    SCENES_EDITOR_APP:"0", SCENE_HOST:"fakeshell", FAKE_SHELL_OWNER:"scenes"})
  $host_script = $here .. "/fixtures/scene-editor/fake_shell.mix"
  $loader_script = env("SCENES_BOOT_REPO", $repo) .. "/engines/viud/scripts/scenes.mix"
  $bad_config = run_argv([$mix, "--serve", $loader_script, "--name", "scenes"],
    {clear_env:true, env:merge($vars, {MIX_VIUD_SCENES_UPGRADE_DELAYS:"[broken"}), timeout:5})
  -- serve renders only the message; the loader unit test checks the typed code.
  check(not $bad_config.ok and contains($bad_config.stderr, "upgrade delays must be valid JSON"), "malformed delay JSON refuses startup: " .. json_encode($bad_config))
  -- Ordinary body= callers must retain their string result and nil parsed
  -- body. The loader alone opts into a structured route error below.
  $absent = call("fakeshell", "INFO")
  check($absent.rc == 10 and $absent.value == "Service 'fakeshell' not found" and $absent.reply == nil, "default not-found result remains a string and parsed body remains nil")
  write_file($tmp .. "/compat.mix", replace('
$app = require("@repo@/libraries/viu/mix/app-call.mix")
$r = $app.viu_app_raw("absent-app", "absent-app.open", {}, 1)
if not $app.viu_app_absent($r, "absent-app") then raise("COMPAT", "absent apps must still enter the launch path") end
$runtime = require("@repo@/share/scenes/lib/runtime.mix")
$r = $runtime.call("absent-tray", "absent-tray.open", {})
if $r.absent != true then raise("COMPAT", "scene runtime must still recognise an absent tray") end
print("PASS legacy app-call and scene runtime absence on the real Bus")
', "@repo@", $repo))
  $compat = run_argv([$mix, $tmp .. "/compat.mix"], {clear_env:true, env:$vars, timeout:5})
  check($compat.ok, "legacy callers: " .. $compat.stderr)
  print($compat.stdout)
  $children.host = start("fakeshell", $host_script)
  wait_service("fakeshell")
  $children.loader = start("scenes", $loader_script)
  wait_service("scenes")
  -- Cross the real Bus boundary: read validation retains the bare-source
  -- contract, while stage_from must explicitly request write admission.
  check(call("fakeshell", "fake.validation", {refuse_writes:true}).rc == 0, "arm write admission refusal")
  $source = fixture_source("alpha", "old")
  check(call("fakeshell", "shell.scene.validate", $source).rc == 0, "bare source stays read-only during write refusal")
  check(call("fakeshell", "shell.scene.validate", {source:$source}).rc == 0, "map without write stays read-only")
  check(call("fakeshell", "shell.scene.validate", {source:$source, write:false}).rc == 0, "explicit read map stays read-only")
  check(call("fakeshell", "shell.scene.validate", {source:fixture_source("alpha", "BROKEN"), write:false}).rc == 10, "map source still gets scene validation")
  $refused = call("scenes", "scenes.install", {template:"alpha"})
  check($refused.rc == 10 and $refused.value.context.upstream.error_code == "DESIGN_VALIDATION", "stage_from carries write admission through the Bus: " .. json_encode($refused))
  check(not is_dir($tmp .. "/scenes/alpha") and len(glob($tmp .. "/scenes/.stage-*")) == 0, "write refusal leaves no installation or staged copy")
  $validation = call("fakeshell", "fake.state").value
  check($validation.write_validations == 1 and $validation.read_validations == 4, "fake observed each request shape and the staged write")
  check(call("fakeshell", "fake.validation", {refuse_writes:false}).rc == 0, "allow validated writes")
  for $name in ["alpha", "beta", "gamma", "removed"]
    $r = call("scenes", "scenes.install", {template:$name})
    check($r.rc == 0, "install " .. $name .. ": " .. json_encode($r))
  end
  check(call("fakeshell", "fake.state").value.write_validations == 5, "every install requests write admission")
  print("PASS scene validation Bus contract: bare/map reads; staged write refusal before placement; admitted installs")
  stop($children.loader)
  stop($children.host)
  $children.host = nil
  write_file($tmp .. "/scenes/beta/scene.mix", fixture_source("beta", "edited"))
  for $name in ["alpha", "beta", "gamma"]
    write_file($tmp .. "/templates/" .. $name .. "/scene.mix", fixture_source($name, $name == "gamma" ? "BROKEN" : "new"))
  end
  $children.loader = start("scenes", $loader_script)
  wait_service("scenes")
  wait_failure(false)
  check(rows().removed.upgrade.retryable == true, "boot flags the scene before removal")
  check(call("scenes", "scenes.remove", {name:"removed"}).rc == 0, "remove while host is absent")
  check(rows().removed == nil, "removed scene leaves inventory")
  $children.host = start("fakeshell", $host_script)
  wait_service("fakeshell")
  $done = false
  $deadline = monotonic() + 15
  while $deadline - monotonic() >= 0.25
    $r = rows($deadline)
    if $r != nil and not $r.alpha.stale and $r.beta.upgrade.error_code == "SCENES_EDITED" and $r.gamma.upgrade.retryable == false then $done = true; break end
    sleep(min(0.1, max(0, $deadline - monotonic())))
  end
  check($done, "late host refreshes unedited copy and retains terminal flags")
  check(contains(read_file($tmp .. "/scenes/alpha/scene.mix"), "new"), "new shipped bytes installed")
  check(contains($r.beta.upgrade.reason, "Reset or Keep") and contains(read_file($tmp .. "/scenes/beta/scene.mix"), "edited"), "edited bytes retained")
  check($r.gamma.upgrade.context.rc == 10 and not contains(read_file($tmp .. "/scenes/gamma/scene.mix"), "BROKEN"), "validation refusal is terminal")
  check(contains(read_file($tmp .. "/scenes.log"), '"rc":10'), "boot failure logged")
  -- Passive reload with disabled scenes succeeds while the host is absent;
  -- lifecycle.commit must re-arm upgrade work in the new generation.
  stop($children.host)
  $children.host = nil
  write_file($tmp .. "/templates/alpha/scene.mix", fixture_source("alpha", "reload-new"))
  check(call("scenes", "RELOAD").rc == 0, "loader reload accepted")
  wait_failure(false)
  $children.host = start("fakeshell", $host_script)
  wait_service("fakeshell")
  $done = false
  $deadline = monotonic() + 15
  while $deadline - monotonic() >= 0.25
    $r = rows($deadline)
    if $r != nil and not $r.alpha.stale and contains(read_file($tmp .. "/scenes/alpha/scene.mix"), "reload-new") then $done = true; break end
    sleep(min(0.1, max(0, $deadline - monotonic())))
  end
  check($done, "reload commit refreshes when host arrives")
  check(call("scenes", "scenes.upgrade.retry", {delay:0}).rc != 0, "wire cannot trigger local retry")
  -- Start a fresh boot with the host absent, then remove one pending scene.
  -- Other scenes run all seven rungs with configured delays, so removal cannot be
  -- hidden by a later manual upgrade/reload clearing all flags for it.
  check(call("scenes", "scenes.install", {template:"removed"}).rc == 0, "reinstall removal fixture")
  stop($children.loader)
  stop($children.host)
  $children.host = nil
  $children.loader = start("scenes", $loader_script)
  wait_service("scenes")
  wait_failure(false)
  check(rows().removed.upgrade.retryable == true, "fresh boot flags scene for removal")
  check(call("scenes", "scenes.remove", {name:"removed"}).rc == 0, "remove during final boot ladder")
  $removal_log = len(read_file($tmp .. "/scenes.log"))
  wait_failure(true)
  $log = read_file($tmp .. "/scenes.log")
  check(contains($log, "scenes upgrade exhausted:") and contains($log, '"scene":"alpha"') and contains($log, '"error_code":"SCENES_UPSTREAM"'), "exhaustion logged with scene, code and rc")
  $before = len(split($log, "scenes upgrade:"))
  sleep(2)
  check(len(split(read_file($tmp .. "/scenes.log"), "scenes upgrade:")) == $before, "no idle retry after exhaustion")
  check(not contains(slice(read_file($tmp .. "/scenes.log"), $removal_log), '"scene":"removed"'), "removed scene has no later retry failures or exhaustion log through the entire ladder")
  -- Gate the real task's async wait in a fixture. Advance to the 64-second
  -- rung by release order, then keep that waiter blocked across a manual
  -- pass. No wall-clock window decides whether the manual pass woke work.
  stop($children.loader)
  $gated = replace(read_file($loader_script), 'require("lib/', 'require("' .. dirname($loader_script) .. '/lib/')
  $gated = replace($gated, '  sleep($event.args.delay)', '
  $gate = $ROOT .. "/.task-" .. to_string($event.args.seq)
  write_file($gate .. ".waiting", "")
  $deadline = monotonic() + 15
  while not is_file($gate .. ".release") and monotonic() < $deadline sleep(0.01) end
  if not is_file($gate .. ".release") then raise("FIXTURE_TIMEOUT", $gate) end
')
  $gated = replace($gated, "on scenes.upgrade.retry\n", 'on scenes.upgrade.retry
  write_file($ROOT .. "/.task-" .. to_string($event.args.seq) .. ".done", "")
')
  $gated = $gated .. '
on fixture.retry
  if $event.args.drop == true then $state.upgrades = delete($state.upgrades, "gamma") end
  reply(0, json_encode({seq:$state.upgrade_seq, delay:$state.upgrade_delay, armed:$state.upgrade_armed}))
end
on fixture.rung
  $probe = $state
  $probe.upgrade_armed = false
  $probe.upgrade_delay = 2
  $probe.upgrade_delays = []
  try
    $probe = schedule_upgrade($probe)
    reply(0, "{}")
  catch $message, $error
    reply(10, json_encode({error_code:$error.code, message:$message}))
  end
end
'
  write_file($tmp .. "/gated.mix", $gated)
  $children.loader = start("scenes", $tmp .. "/gated.mix")
  wait_service("scenes")
  $bad_rung = call("scenes", "fixture.rung")
  check($bad_rung.rc == 10 and $bad_rung.value.error_code == "SCENES_CONFIG" and contains($bad_rung.value.message, "outside"), "rung guard refuses a short delay list")
  for $rung = 1 to 6
    $snap = retry_snapshot()
    $gate = $tmp .. "/scenes/.task-" .. to_string($snap.seq)
    wait_file($gate .. ".waiting")
    write_file($gate .. ".release", "")
    wait_file($gate .. ".done")
  end
  $old = retry_snapshot()
  check($old.delay == 128 and $old.armed, "old ladder reached its long final wait")
  $old_gate = $tmp .. "/scenes/.task-" .. to_string($old.seq)
  wait_file($old_gate .. ".waiting")
  check(call("scenes", "scenes.upgrade", []).rc == 10, "manual upgrade rejects malformed arguments")
  check(deep_eq(retry_snapshot(), $old), "refused manual upgrade retains waiter and budget")
  check(call("scenes", "fixture.retry", {drop:true}).rc == 0 and rows().gamma.upgrade == nil, "new work starts without a pending flag")
  check(call("scenes", "scenes.upgrade").rc == 0, "manual upgrade during long wait")
  check(rows().gamma.upgrade.retryable == true, "manual pass newly flags work")
  $fresh = retry_snapshot()
  check($fresh.seq != $old.seq and $fresh.delay == 2 and $fresh.armed, "manual pass arms a fresh first rung")
  $fresh_gate = $tmp .. "/scenes/.task-" .. to_string($fresh.seq)
  wait_file($fresh_gate .. ".waiting")
  $retry_log = len(read_file($tmp .. "/scenes.log"))
  write_file($fresh_gate .. ".release", "")
  wait_file($fresh_gate .. ".done")
  $after = retry_snapshot()
  check($after.delay == 4 and $after.armed, "fresh retry runs before old wait is released")
  check(contains(slice(read_file($tmp .. "/scenes.log"), $retry_log), '"scene":"gamma"'), "fresh retry takes up newly flagged work")
  $before = read_file($tmp .. "/scenes.log")
  write_file($old_gate .. ".release", "")
  wait_file($old_gate .. ".done")
  check(deep_eq(retry_snapshot(), $after), "stale completion cannot consume new budget or clear its arm")
  check(read_file($tmp .. "/scenes.log") == $before, "stale completion cannot run another upgrade")
  print("PASS scenes manual wake: new retry precedes old release; stale completion fenced")
  -- Reproduce the window before a separate fs.changed callback refreshes
  -- state_ok: run the shipped loader with only that callback renamed. All
  -- retry, command and persistence code stays unchanged. Relative modules
  -- still come from the real script directory, not this temporary fixture.
  stop($children.loader)
  $retry_fixture = replace($gated, 'on fs.changed', 'on fixture.fs.changed')
  $retry_fixture = replace($retry_fixture, '/.task-', '/.corrupt-task-')
  write_file($tmp .. "/retry-state.mix", $retry_fixture)
  $children.loader = start("scenes", $tmp .. "/retry-state.mix")
  wait_service("scenes")
  wait_failure(false)
  -- Corrupt durable state while a new retry is pending. The task must record
  -- a diagnostic and terminal flags instead of silently abandoning the work.
  check(call("scenes", "scenes.upgrade").rc == 0, "re-arm before unreadable state")
  $prior_rows = rows()
  $snap = retry_snapshot()
  $gate = $tmp .. "/scenes/.corrupt-task-" .. to_string($snap.seq)
  wait_file($gate .. ".waiting")
  $saved = read_file($tmp .. "/scenes/state.conf.mix")
  write_file($tmp .. "/scenes/state.conf.mix", "{not valid state")
  $failed_manual = call("scenes", "scenes.upgrade")
  check($failed_manual.rc == 10 and $failed_manual.value.error_code == "SCENES_STATE_UNREADABLE", "manual upgrade refuses unreadable state before budget reset")
  check(deep_eq(retry_snapshot(), $snap), "failed manual pass does not spend a rung")
  write_file($gate .. ".release", "")
  $done = false
  $deadline = monotonic() + 15
  while $deadline - monotonic() >= 0.25
    $reply = probe("scenes", "scenes.list", $deadline)
    $view = if $reply == nil then nil else $reply.value end
    $snapshot = rows($deadline)
    $r = if $snapshot == nil then nil else $snapshot.alpha end
    if $view != nil and $r != nil and ($view.diagnostic ?? {}).error_code == "SCENES_STATE_UNREADABLE" and $r.upgrade.error_code == "SCENES_UPSTREAM" and $r.upgrade.retryable == false then $done = true; break end
    sleep(min(0.1, max(0, $deadline - monotonic())))
  end
  check($done, "raised retry records diagnostic and stops retryable flags")
  for $name in keys($prior_rows)
    $prior = $prior_rows[$name].upgrade
    if $prior == nil or $prior.retryable != true then continue end
    $prior.retryable = false
    check(deep_eq(rows()[$name].upgrade, $prior), "handler failure preserves own error: " .. $name)
  end
  check($view.state_ok == false, "retry catch commits the unreadable-state guard")
  for $command in ["scenes.enable", "scenes.remove", "scenes.reset"]
    $refused = call("scenes", $command, {name:"alpha"})
    check($refused.rc == 10 and $refused.value.error_code == "SCENES_STATE_UNREADABLE", "mutation after failed retry must refuse: " .. $command)
    check(read_file($tmp .. "/scenes/state.conf.mix") == "{not valid state", "refused mutation preserves unreadable bytes: " .. $command)
  end
  check(contains(read_file($tmp .. "/scenes.log"), "scenes upgrade retry failed:"), "raised retry is logged")
  write_file($tmp .. "/scenes/state.conf.mix", $saved)
  print("PASS scenes boot/reload upgrade: late host, edited copy, validation refusal, bounded exhaustion; seconds=" .. to_string(monotonic() - $started) .. " load_workers=" .. to_string(len($load_children)) .. " load=" .. trim(read_file("/proc/loadavg")))
catch $message, $error
  $failure.active = true
  -- Snapshot the original before diagnostics. The runtime supplies a record;
  -- guard extraction too, so a malformed record cannot mask its message.
  $code = "SCENES_BOOT_TEST"
  $details = nil
  try
    if type($error) == "map" then
      $code = $error.code ?? $code
      $details = $error.details
    end
  catch $ignored
  end
  -- The outer guard also covers iteration/globbing and unexpected evidence
  -- failures; the inner guards let the remaining evidence keep printing.
  try failure_evidence($message, $error) catch $ignored end
  raise($code, $message, $details)
finally
  if $failure.active then
    try cleanup() catch $ignored end
  else
    cleanup()
  end
end
