-- Shipped panel on the existing private-Bus behaviour harness. Instrument the
-- runtime adapter so even rejected calls to an absent tray are counted.
$root = realpath(dirname(realpath($0)) .. "/../../..")
$pb = require("../../../tests/lib/private_bus.mix")
$mix = env("MIX_TEST_MIX_EXE", "/opt/mix/bin/mix")
$noded = env("MIX_TEST_NODED_EXE", "/opt/mix/bin/noded")
$tmp = trim(run_argv_must(["mktemp", "-d", "/tmp/panel-idle.XXXXXXXX"]))
$bus = nil
$pids = []
$tray_pid = nil
$vars = {}
$case = args()[0] ?? "idle"
fn check($ok, $message)
  if not $ok then
    for $file in ["calls","completed","state","registry-events"]
      if is_file($tmp .. "/" .. $file) then eprint($file .. ": " .. read_file($tmp .. "/" .. $file)) end
    end
    raise("PANEL_IDLE_TEST", $message)
  end
end
fn start($name, $path)
  $pid = spawn([$mix, "--serve", $path, "--name", $name], {detach:true, clear_env:true, env:$vars,
    stdout:{file:$tmp .. "/" .. $name .. ".log"}, stderr:"stdout"})
  push($pids, $pid)
  return $pid
end
fn stop($pid)
  if $pid == nil or not process_alive($pid) then return end
  $_ = kill($pid, 15)
  for $i = 1 to 40
    if not process_alive($pid) then return end
    sleep(0.05)
  end
  $_ = kill($pid, 9)
end
fn call($to, $command)
  return json_parse(run_argv_must([$mix, $tmp .. "/client.mix", $to, $command], {clear_env:true,env:$vars,timeout:10}))
end
fn wait_service($name)
  for $i = 1 to 100
    if call($name, "INFO").rc == 0 then return end
    sleep(0.05)
  end
  if is_file($tmp .. "/" .. $name .. ".log") then eprint(read_file($tmp .. "/" .. $name .. ".log")) end
  raise("PANEL_IDLE_TEST", "service did not start: " .. $name)
end
fn calls_for($command)
  $n = 0
  for $line in split(read_file($tmp .. "/calls"), "\n")
    if $line != "" and json_parse($line).command == $command then $n = $n + 1 end
  end
  return $n
end
fn tray_calls()
  return calls_for("tray.list")
end
fn wait_state($field, $expected)
  for $i = 1 to 400
    $s = is_file($tmp .. "/state") ? json_parse(read_file($tmp .. "/state")) : {}
    if deep_eq($s[$field], $expected) then return end
    sleep(0.05)
  end
  eprint("last panel state: " .. json_encode($s))
  eprint(read_file($tmp .. "/calls"))
  if is_file($tmp .. "/scene-panel.log") then eprint(read_file($tmp .. "/scene-panel.log")) end
  raise("PANEL_IDLE_TEST", "state did not reach " .. $field .. "=" .. json_encode($expected))
end
-- Restart the quiescence window on every call or state transition. A call
-- count alone does not mean its response/rebuild/retry has finished.
fn recorded_calls()
  return filter(split(read_file($tmp .. "/calls"),"\n"),fn($line) = $line!="" and json_parse($line).command!="scenes.model")
end
fn quiet()
  $last = nil
  $since = monotonic()
  for $i = 1 to 400
    if not is_file($tmp .. "/state") then sleep(0.05); continue end
    $s = json_parse(read_file($tmp .. "/state"))
    $now = {calls:recorded_calls(),state:$s}
    if not deep_eq($now,$last) then $since=monotonic(); $last=$now end
    $started=len(filter(split(read_file($tmp .. "/calls"),"\n"),fn($line) = $line!=""))
    $completed=len(filter(split(read_file($tmp .. "/completed"),"\n"),fn($line) = $line!=""))
    if $started==$completed and not $s.rebuilding and not $s.dirty and not $s.tray_dirty and not $s.notes_dirty and not $s.windows_dirty and monotonic()-$since>=0.3 then return end
    sleep(0.05)
  end
  raise("PANEL_IDLE_TEST","panel did not become quiescent: " .. json_encode($s))
end
fn idle($seconds)
  quiet()
  $before=recorded_calls()
  $until=monotonic()+$seconds
  while monotonic()<$until
    check(deep_eq(recorded_calls(),$before),"unexpected request during idle observation")
    sleep(0.05)
  end
  check(deep_eq(recorded_calls(),$before),"unexpected request at end of idle observation")
end
fn wait_tray($expected)
  for $i = 1 to 400
    if tray_calls() >= $expected then break end
    sleep(0.05)
  end
  quiet()
  check(tray_calls() == $expected, "expected exactly " .. to_string($expected) .. " tray reads, got " .. to_string(tray_calls()))
end
try
  mkdir($tmp .. "/home")
  write_file($tmp .. "/calls", "")
  write_file($tmp .. "/completed", "")
  $_ = run_argv_must(["cp", "-r", $root .. "/share/scenes/lib", $tmp .. "/lib"])
  $path = $tmp .. "/lib/runtime.mix"
  write_file($path, replace_must(read_file($path), "fn call($target, $command, $args)\n",
    "fn call($target, $command, $args)\n  $fixture_call=uuid()\n  append_file(env(\"FIXTURE_DIR\") .. \"/calls\", json_encode({target:$target,command:$command,at:monotonic()}) .. \"\\n\")\n  try\n  if $command == \"notify.list\" and is_file(env(\"FIXTURE_DIR\") .. \"/notify-throw\") then remove(env(\"FIXTURE_DIR\") .. \"/notify-throw\"); raise(\"FIXTURE_NOTIFY\",\"injected notify failure\") end\n  if $command == \"noded.props.get\" and is_file(env(\"FIXTURE_DIR\") .. \"/registry-fail\") then return {ok:false,value:nil} end\n"))
  write_file($path,replace_must(read_file($path),"  return {ok: true, rc: 0, value: $body}\nend","  return {ok: true, rc: 0, value: $body}\n  finally\n    append_file(env(\"FIXTURE_DIR\") .. \"/completed\",$fixture_call .. \"\\n\")\n  end\nend"))
  write_file($path,replace_must(read_file($path),"  try\n  if $command == \"notify.list\"", '  try
  if is_file(env("FIXTURE_DIR") .. "/retry-fail") and $command==read_file(env("FIXTURE_DIR") .. "/retry-fail") then return {ok:false,value:nil} end
  if is_file(env("FIXTURE_DIR") .. "/comp-fail") then
    $fault=json_parse(read_file(env("FIXTURE_DIR") .. "/comp-fail"))
    if $command==$fault.command or ($fault.command=="comp.workspaces.list" and $command=="comp.props.get") then
      if $command!="comp.workspaces.list" then remove(env("FIXTURE_DIR") .. "/comp-fail") end
      if $fault.kind=="throw" then raise("FIXTURE_COMP","injected comp failure") end
      return {ok:false,value:nil}
    end
  end
  if $command == "notify.list"'))
  write_file($tmp .. "/client.mix", 'send $1 $2 body="{}" timeout=5
print(json_encode({rc:$rc,value:$result}))
')
  write_file($tmp .. "/stub.mix", 'on shell.scene.describe
  reply(0, json_encode([{path:"flow",enum:["horizontal"]},{path:"hidden",type:"bool"}]))
end
on scenes.ready
  reply(0,"{}")
end
on scenes.model
  append_file(env("FIXTURE_DIR") .. "/models", "1\n")
  write_file(env("FIXTURE_DIR") .. "/model", json_encode($event.args.value))
  reply(0,"{}")
end
on scenes.list
  reply(0, json_encode({scenes:[]}))
end
on comp.props.watch
  reply(0,"{}")
end
on comp.windows.list
  $windows = is_file(env("FIXTURE_DIR") .. "/windows") ? json_parse(read_file(env("FIXTURE_DIR") .. "/windows")) : []
  reply(0,json_encode({windows:$windows}))
end
on comp.workspaces.list
  reply(0,is_file(env("FIXTURE_DIR") .. "/workspaces") ? read_file(env("FIXTURE_DIR") .. "/workspaces") : json_encode({count:1,current:1,list:[]}))
end
on apps.icon
  reply(0,json_encode({path:""}))
end
on windows.change
  $_=publish("panel-stub.props.changed",json_encode({path:"windows"}),{command:"props.changed"})
  reply(0,"{}")
end
')
  write_file($tmp .. "/tray.mix", 'on tray.list
  if is_file(env("FIXTURE_DIR") .. "/tray-slow") then
    remove(env("FIXTURE_DIR") .. "/tray-slow")
    sleep(0.8)
    write_file(env("FIXTURE_DIR") .. "/tray-completed","1")
  end
  if is_file(env("FIXTURE_DIR") .. "/tray-fail") then
    remove(env("FIXTURE_DIR") .. "/tray-fail")
    reply(10,"busy")
    return
  end
  reply(0,json_encode({items:[]}))
end
on change
  $_ = publish("tray-stub.item.added", "{}", {command:"tray.item.added"})
  reply(0,"{}")
end
on props
  $_ = publish("tray-stub.props.changed", "{}", {command:"props.changed"})
  reply(0,"{}")
end
