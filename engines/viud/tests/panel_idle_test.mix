  end
  $behaviour=replace_must($behaviour,"fn services_changed($live)\n","fn services_changed($live)\n  append_file(env(\"FIXTURE_DIR\") .. \"/registry-events\",json_encode($live) .. \"\\n\")\n")
  if $case == "clock" then
    $behaviour=replace_must($behaviour,"sleep($p.seconds_to_next_minute(time()))","sleep(0.05)")
    -- Isolate clock/window events from the independently capped startup
    -- registration delivery; the comp case covers that path separately.
    $behaviour=replace_must($behaviour,"services_changed($a.new)","return")
  elif $case == "registry" then
    -- Keep the initial cache stale until an item event proves the tray is
    -- live. Startup registry delivery timing must not repair it first.
    $behaviour=replace_must($behaviour,"services_changed($a.new)","if not is_file(env(\"FIXTURE_DIR\") .. \"/registry-fail\") then services_changed($a.new) end")
  else
    -- Native driver/ACP registration is asynchronous too. Isolate real
    -- fixture arrivals/departures from that noise; explicit registry hooks
    -- below exercise conservative same-name/coalesced hints exactly once.
    $behaviour=replace_must($behaviour,"services_changed($a.new)","fixture_registry($a)")
  end
  write_file($tmp .. "/panel.mix", $behaviour .. '
fn fixture_registry($change)
  for $name in [$COMP,$APPS,$TRAY,$NOTIFY]
    if contains($change.old ?? [],$name) != contains($change.new ?? [],$name) then services_changed($change.new); return end
  end
end
fn fixture_task_start($name,$body)
  $fault=env("FIXTURE_DIR") .. "/task-fail"
  if is_file($fault) and read_file($fault)==$name then
    remove($fault)
    raise("TASK_LIMIT","injected task handle limit")
  end
  return task_start($name,$body)
end
fn fixture_retry_sleep($source,$delay)
  $gate=env("FIXTURE_DIR") .. "/retry-hold"
  write_atomic(env("FIXTURE_DIR") .. "/retry-sleep",$source)
  while is_file($gate) sleep(0.02) end
  sleep($delay)
end
on panel.test.retry
  $source=$event.args.source
  if $source=="windows" then fetch_windows()
  elif $source=="tray" then fetch_tray()
  elif $source=="notes" then fetch_notes()
  elif $source=="registry" then refresh_registry()
  end
  reply(0,json_encode({retrying:$state[$source .. "_retrying"],dirty:$state[$source .. "_dirty"],delay:$state[$source .. "_delay"]}))
end
-- Local fixture observation does not register another Bus client on each
-- sample. Atomic files are already the harness model/call observation path.
on panel.test.observe async
  while true
    $retry={}
    for $source in ["windows","tray","notes","registry"]
      $retry[$source .. "_retrying"]=$state[$source .. "_retrying"]
      $retry[$source .. "_delay"]=$state[$source .. "_delay"]
    end
    write_atomic(env("FIXTURE_DIR") .. "/state",json_encode(merge($retry,{services:$state.services,tray_live:contains($state.services,$TRAY),notify_live:contains($state.services,$NOTIFY),registry_dirty:$state.registry_dirty,tray_dirty:$state.tray_dirty,notes_dirty:$state.notes_dirty ?? false,windows_dirty:$state.windows_dirty,dirty:$state.dirty,rebuilding:$state.rebuilding,windows:$state.windows,ws_count:$state.ws_count})))
    sleep(0.02)
  end
end
on panel.test.registry
  if $event.args.refresh == true then refresh_registry() else services_changed($event.args.new) end
  reply(0,"{}")
end
task_start("panel.test.observe","{}")
