-- SPDX-License-Identifier: MIT OR Apache-2.0
-- Shipped panel on the existing private-Bus behaviour harness. Instrument the
-- runtime adapter so even rejected calls to an absent tray are counted.
$root = realpath(dirname(realpath($0)) .. "/../../..")
$pb = require("../../../tests/lib/private_bus.mix")
$mix = env("MIX_TEST_MIX_EXE", "/opt/mix/bin/mix")
$noded = env("MIX_TEST_NODED_EXE", "/opt/mix/bin/noded")
$tmp = trim(run_argv_must(["mktemp", "-d", "/tmp/panel-idle.XXXXXXXX"]))
$bus = nil
$pids = []
$tray_pid = nil
$vars = {}
$case = args()[0] ?? "idle"
fn check($ok, $message)
  if not $ok then raise("PANEL_IDLE_TEST", $message) end
end
fn start($name, $path)
  $pid = spawn([$mix, "--serve", $path, "--name", $name], {detach:true, clear_env:true, env:$vars,
    stdout:{file:$tmp .. "/" .. $name .. ".log"}, stderr:"stdout"})
  push($pids, $pid)
  return $pid
end
fn stop($pid)
  if $pid == nil or not process_alive($pid) then return end
  $_ = kill($pid, 15)
  for $i = 1 to 40
    if not process_alive($pid) then return end
    sleep(0.05)
  end
  $_ = kill($pid, 9)
end
fn call($to, $command)
  return json_parse(run_argv_must([$mix, $tmp .. "/client.mix", $to, $command], {clear_env:true,env:$vars,timeout:10}))
end
fn wait_service($name)
  for $i = 1 to 100
    if call($name, "INFO").rc == 0 then return end
    sleep(0.05)
  end
  if is_file($tmp .. "/" .. $name .. ".log") then eprint(read_file($tmp .. "/" .. $name .. ".log")) end
  raise("PANEL_IDLE_TEST", "service did not start: " .. $name)
end
fn calls_for($command)
  $n = 0
  for $line in split(read_file($tmp .. "/calls"), "\n")
    if $line != "" and json_parse($line).command == $command then $n = $n + 1 end
  end
  return $n
end
fn tray_calls()
  return calls_for("tray.list")
end
fn wait_state($field, $expected)
  for $i = 1 to 100
    $s = call("scene-panel", "panel.test.state").value
    if deep_eq($s[$field], $expected) then return end
    sleep(0.05)
  end
  raise("PANEL_IDLE_TEST", "state did not reach " .. $field .. "=" .. json_encode($expected))
end
fn wait_tray($expected)
  for $i = 1 to 100
    if tray_calls() >= $expected then break end
    sleep(0.05)
  end
  sleep(0.3)
  check(tray_calls() == $expected, "expected exactly " .. to_string($expected) .. " tray reads, got " .. to_string(tray_calls()))
end
try
  mkdir($tmp .. "/home")
  write_file($tmp .. "/calls", "")
  $_ = run_argv_must(["cp", "-r", $root .. "/share/scenes/lib", $tmp .. "/lib"])
  $path = $tmp .. "/lib/runtime.mix"
  write_file($path, replace_must(read_file($path), "fn call($target, $command, $args)\n",
    "fn call($target, $command, $args)\n  append_file(env(\"FIXTURE_DIR\") .. \"/calls\", json_encode({target:$target,command:$command,at:monotonic()}) .. \"\\n\")\n  if $command == \"noded.props.get\" and is_file(env(\"FIXTURE_DIR\") .. \"/registry-fail\") then return {ok:false,value:nil} end\n"))
  write_file($tmp .. "/client.mix", 'send $1 $2 body="{}" timeout=5
print(json_encode({rc:$rc,value:$result}))
')
  write_file($tmp .. "/stub.mix", 'on shell.scene.describe
  reply(0, json_encode([{path:"flow",enum:["horizontal"]},{path:"hidden",type:"bool"}]))
end
on scenes.ready
  reply(0,"{}")
end
on scenes.model
  write_file(env("FIXTURE_DIR") .. "/model", json_encode($event.args.value))
  reply(0,"{}")
end
on scenes.list
  reply(0, json_encode({scenes:[]}))
end
on comp.props.watch
  reply(0,"{}")
end
on comp.windows.list
  reply(0,json_encode({windows:[]}))
end
on comp.workspaces.list
  reply(0,json_encode({count:1,current:1,list:[]}))
end
on apps.icon
  reply(0,json_encode({path:""}))
end
')
  write_file($tmp .. "/tray.mix", 'on tray.list
  if is_file(env("FIXTURE_DIR") .. "/tray-fail") then
    remove(env("FIXTURE_DIR") .. "/tray-fail")
    reply(10,"busy")
    return
  end
  reply(0,json_encode({items:[]}))
end
on change
  $_ = publish("tray-stub.item.added", "{}", {command:"tray.item.added"})
  reply(0,"{}")
end
on props
  $_ = publish("tray-stub.props.changed", "{}", {command:"props.changed"})
  reply(0,"{}")
end
')
  $bus = $pb.start({dir:$tmp .. "/bus",name:"panel-idle-test",noded:$noded})
  $vars = merge($pb.client_env($bus), {PATH:"/usr/bin:/bin",HOME:$tmp .. "/home",MIX_STATS:"off",
    FIXTURE_DIR:$tmp,SCENE_NAME:"panel",SCENE_GENERATION:"1",SCENE_HOST:"panel-stub",
    SCENES_SERVICE:"panel-stub",COMP_SERVICE:"panel-stub",APPS_SERVICE:"panel-stub",NOTIFY_SERVICE:"notify-stub",
    TRAY_SERVICE:"tray-stub",SCENES_LIB:$tmp .. "/lib",SCENE_DIR:$tmp .. "/home"})
  start("panel-stub", $tmp .. "/stub.mix")
  wait_service("panel-stub")
  $behaviour = read_file($root .. "/share/scenes/panel/behaviour.mix")
  write_file($tmp .. "/panel.mix", $behaviour .. '
on panel.test.state
  reply(0,json_encode({services:$state.services,tray_live:contains($state.services,$TRAY),notify_live:contains($state.services,$NOTIFY),registry_dirty:$state.registry_dirty,tray_dirty:$state.tray_dirty}))
end
on panel.test.registry
  services_changed($event.args.new)
  reply(0,"{}")
end
')
  if $case == "registry" or $case == "tray-retry" or $case == "coalesced" then
    if $case == "registry" then write_file($tmp .. "/registry-fail", "1") end
    $tray_pid = start("tray-stub", $tmp .. "/tray.mix")
    wait_service("tray-stub")
  end
  start("scene-panel", $tmp .. "/panel.mix")
  wait_service("scene-panel")
  for $i = 1 to 100
    if is_file($tmp .. "/model") then break end
    sleep(0.05)
  end
  check(is_file($tmp .. "/model"), "first panel model missing")
  if $case == "notify" then
    check(calls_for("notify.list")==0,"absent notify called")
    write_file($tmp .. "/notify.mix", 'on notify.list
  reply(0,"[]")
end
on change
  $_=publish("notify-stub.changed","{}",{command:"notification.created"})
  reply(0,"{}")
end
')
    $notify_pid=start("notify-stub",$tmp .. "/notify.mix")
    wait_service("notify-stub")
    wait_state("notify_live",true)
    check(calls_for("notify.list")==1,"notify registration must fetch once")
    call("notify-stub","change")
    for $i=1 to 100
      if calls_for("notify.list")==2 then break end
      sleep(0.05)
    end
    call("scene-panel","panel.refresh")
    sleep(1.2)
    check(calls_for("notify.list")==2,"notify event/rebuild read count")
    stop($notify_pid)
    wait_state("notify_live",false)
    call("scene-panel","panel.refresh")
    sleep(0.2)
    check(calls_for("notify.list")==2,"departed notify called")
    print("PASS absent notify, late registration, notification event and idle quiet")
    exit(0)
  elif $case == "registry" then
    check(tray_calls()==0,"failed registry must not invent a tray")
    call("tray-stub","change")
    wait_tray(1)
    wait_state("tray_live",true)
    remove($tmp .. "/registry-fail")
    wait_state("registry_dirty",false)
    check(calls_for("noded.props.get")>=2,"failed registry read never retried")
    print("PASS registry recovery and tray event repairs stale cache")
    exit(0)
  elif $case == "tray-retry" then
    wait_state("tray_live",true)
    sleep(0.3)
    $baseline=tray_calls()
    write_file($tmp .. "/tray-fail","1")
    call("tray-stub","change")
    wait_tray($baseline+2)
    wait_state("tray_dirty",false)
    $reads=[]
    for $line in split(read_file($tmp .. "/calls"),"\n")
      if $line!="" then
        $row=json_parse($line)
        if $row.command=="tray.list" then push($reads,$row.at) end
      end
    end
    check($reads[$baseline+1]-$reads[$baseline]>=0.2,"tray retry ran before its deadline")
    sleep(1.2)
    check(tray_calls()==$baseline+2,"successful tray recovery kept polling")
    print("PASS failed tray read retries once at deadline then stays quiet")
    exit(0)
  elif $case == "coalesced" then
    wait_state("tray_live",true)
    sleep(0.3)
    $baseline=tray_calls()
    write_file($tmp .. "/registry.mix", 'send scene-panel panel.test.registry body={old:["tray-stub","panel-stub"],new:["tray-stub","panel-stub","late-app"]}
')
    $_=run_argv_must([$mix,$tmp .. "/registry.mix"],{clear_env:true,env:$vars,timeout:10})
    wait_tray($baseline+1)
    print("PASS coalesced tray restart with unequal registration lists")
    exit(0)
  end
  for $i = 1 to 3 check(call("scene-panel", "panel.refresh").rc == 0, "refresh refused") end
  sleep(1.2)
  check(tray_calls() == 0, "absent tray called at startup, rebuild or idle")
  check(calls_for("notify.list")==0,"absent notify called at startup, rebuild or idle")
  $tray_pid = start("tray-stub", $tmp .. "/tray.mix")
  wait_service("tray-stub")
  wait_tray(1)
  call("tray-stub", "change")
  wait_tray(2)
  call("tray-stub", "props")
  wait_tray(3)
  for $i = 1 to 3 call("scene-panel", "panel.refresh") end
  sleep(1.2)
  check(tray_calls() == 3, "idle or unrelated rebuild re-read the tray")
  stop($tray_pid)
  wait_state("tray_live",false)
  call("scene-panel", "panel.refresh")
  sleep(0.3)
  check(tray_calls() == 3, "departed tray called")
  $tray_pid = start("tray-stub", $tmp .. "/tray.mix")
  wait_service("tray-stub")
  wait_tray(4)
  print("PASS panel idle: absent tray, late registration, item/props changes once, unrelated rebuilds and idle quiet, remove/re-register")
finally
  for $pid in reverse($pids) stop($pid) end
  if $bus != nil then $pb.stop($bus) end
  remove_dir($tmp)
end
