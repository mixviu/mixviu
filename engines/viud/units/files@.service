[Unit]
Description=MixViu files chooser for session %i
Requires=viud@%i.service
After=viud@%i.service
BindsTo=viud@%i.service
PartOf=session@%i.target
# Wayland/Bus readiness can lag a Type=simple compositor. Keep retrying
# without exhausting systemd's default five-start burst during boot.
StartLimitIntervalSec=0

[Service]
Type=simple
User=mix
EnvironmentFile=@{etc}/session/%i.env
UnsetEnvironment=DBUS_SESSION_BUS_ADDRESS DBUS_STARTER_ADDRESS DBUS_STARTER_BUS_TYPE DBUS_SYSTEM_BUS_ADDRESS
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_CURRENT_DESKTOP=MixViu
# Default profile: XDG_CONFIG_HOME (or ~/.config). DOpus keeps chooser state
# in its own subdirectory, separate from the normal file manager profile.
ExecStart=@{prefix}/bin/dopus --choose-service --service files
KillMode=control-group
TimeoutStopSec=10
Restart=on-failure
RestartSec=2
