[Unit]
RequiresMountsFor=@{run}/session/%i/desktop
Description=MixViu compositor on VT%i
# The session target chooses the broker (noded@%i or the system noded.service);
# this unit only orders after both. Never Wants= or Requires= a broker: on a desk
# with the system broker noded@%i is masked.
Requires=seatd@%i.service
After=noded@%i.service noded.service seatd@%i.service
BindsTo=seatd@%i.service
PartOf=session@%i.target

[Service]
ExecStartPre=/usr/bin/install -d -m 0700 @{run}/session/%i/desktop
ExecStartPre=/usr/bin/find @{run}/session/%i/desktop -mindepth 1 -delete
Type=simple
User=mix
SupplementaryGroups=seat
EnvironmentFile=@{etc}/session/%i.env
UnsetEnvironment=DBUS_SESSION_BUS_ADDRESS DBUS_STARTER_ADDRESS DBUS_STARTER_BUS_TYPE DBUS_SYSTEM_BUS_ADDRESS
Environment=LIBSEAT_BACKEND=seatd MIX_VIUD_CONTAIN_CHILDREN=1
Environment=MIX_VT=%i
# The session bus is found at $XDG_RUNTIME_DIR/bus by anything started without
# DBUS_SESSION_BUS_ADDRESS (apps@ unsets it). The bus socket lives in its own
# runtime directory, so link it into this one; the pre-start cleanup removes
# a stale link on restart. Dangling until the session bus starts.
# Non-fatal (-): a missing link must never keep the compositor down.
ExecStartPre=-/usr/bin/ln -sfn @{run}/session/%i/dbus/bus @{run}/session/%i/desktop/bus
ExecStart=@{prefix}/bin/viud kms-live --socket ${WAYLAND_DISPLAY} --scale ${MIX_VIUD_OUTPUT_SCALE} --config-file ${MIX_VIUD_CONFIG} --bus-service comp
TTYPath=/dev/tty%i
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYReset=yes
TTYVHangup=yes
Delegate=yes
KillMode=control-group
TimeoutStopSec=10
Restart=on-failure
RestartSec=1
