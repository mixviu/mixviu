-- SPDX-License-Identifier: MIT OR Apache-2.0
-- Identity of a Mix component (docs/docs/decisions/2026-10-10-mix-components.md).
-- Read by tools/component_index.mix; the same fields as a Cargo package's
-- [package.metadata.mixviu], plus the name, version and principal program.
{
  schema: 1,
  name: "daily",
  component: "daily",
  kind: "service",
  layer: "core",
  contract: "public",
  version: "0.1.0",
  program: "scripts/daily.mix",
  profiles: ["server"]
}
