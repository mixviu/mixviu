# SPDX-License-Identifier: MIT OR Apache-2.0
# Plain per-host maild: one mail service per host, beside the plain
# noded.service. Hosts that run per-session brokers use maild@.service.
# Data paths (database, blobs, mds, spam) come from the maild config.
# Unset ones default under @{var}/jmap, and DKIM, TLS and rule state
# under @{var}/maild. ProtectSystem=strict leaves only the state
# directories writable, so both are listed.
[Unit]
RequiresMountsFor=@{var}/maild @{run}/maild
Description=MixViu mail service
Documentation=https://mixos.dev/maild/
After=network-online.target noded.service
Wants=network-online.target noded.service

[Service]
ReadWritePaths=@{var}/maild @{run}/maild
Environment=STATE_DIRECTORY=@{var}/maild
ExecStartPre=/usr/bin/mkdir -p @{run}/maild
ExecStartPre=/usr/bin/find @{run}/maild -mindepth 1 -delete
ExecStopPost=-/usr/bin/find @{run}/maild -mindepth 1 -delete
Type=simple
User=maild
Group=maild
Environment=MIX_ETC=@{etc}
Environment=MIX_VAR=@{var}
Environment=HOME=@{var}/maild
Environment=RUST_LOG=maild=info
WorkingDirectory=@{var}/maild
ExecStart=@{prefix}/bin/maild -c @{etc}/maild/config.conf.mix serve
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=maild
LogRateLimitIntervalSec=30s
LogRateLimitBurst=10000
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
UMask=0027

[Install]
WantedBy=multi-user.target
