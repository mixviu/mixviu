# SPDX-License-Identifier: MIT OR Apache-2.0
[Unit]
RequiresMountsFor=@{var}/maild/%i @{run}/maild/%i
Description=MixViu mail service using broker instance %i
Documentation=https://mixos.dev/maild/
After=network-online.target noded@%i.service maild-prepare@%i.service
Wants=network-online.target
Requires=noded@%i.service maild-prepare@%i.service

[Service]
ReadWritePaths=@{var}/maild/%i @{run}/maild/%i
ExecStartPre=/usr/bin/install -d -m 0750 @{var}/maild/%i
Environment=STATE_DIRECTORY=@{var}/maild/%i
ExecStartPre=/usr/bin/install -d -m 0750 @{run}/maild/%i
ExecStartPre=/usr/bin/find @{run}/maild/%i -mindepth 1 -delete
Type=simple
User=maild
Group=maild
EnvironmentFile=@{etc}/session/%i.env
Environment=MIX_ETC=@{etc}
Environment=MIX_VAR=@{var}/maild/%i
Environment=HOME=@{var}/maild/%i
Environment=RUST_LOG=maild=info
WorkingDirectory=-@{var}/maild/%i
ExecStart=@{prefix}/bin/maild -c @{etc}/maild/config.conf.mix serve
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=maild
LogRateLimitIntervalSec=30s
LogRateLimitBurst=10000
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
UMask=0027

[Install]
WantedBy=multi-user.target
