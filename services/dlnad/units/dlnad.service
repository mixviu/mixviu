[Unit]
RequiresMountsFor=@{var}/dlnad
Description=MixViu DLNA media server
Documentation=https://mixos.dev/dlnad/
Wants=noded.service network-online.target
After=noded.service network-online.target

[Service]
ReadWritePaths=@{var}/dlnad
Environment=STATE_DIRECTORY=@{var}/dlnad
Type=simple
User=dlnad
Group=dlnad
# The media directory must be readable by this user: world-readable, or add
# its group with a drop-in (SupplementaryGroups=).
Environment=MIX_ETC=@{etc}
Environment=MIX_NODE_CONFIG=@{etc}/node.conf.mix
Environment=MIX_DLNAD_CONF=@{etc}/dlnad/dlnad.conf.mix
Environment=MIX_DLNAD_STATE=@{var}/dlnad
Environment=MIX_STATS=off
ExecStart=@{prefix}/bin/mix --serve @{prefix}/lib/dlnad/dlnad.mix --name dlnad
KillMode=control-group
TimeoutStopSec=10
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077

[Install]
WantedBy=multi-user.target
