# Settings authority for a KDE Plasma user session (systemctl --user).
# Create the profile once, explicitly, as the operator:
# settingsd init --instance <host> --root ~/.local/state/mix/settingsd/<host>/default
# Another desktop sharing the same home must not start this unit.
[Unit]
Description=MixViu settings authority for the KDE Plasma seat
After=graphical-session.target
PartOf=graphical-session.target
ConditionEnvironment=XDG_SESSION_DESKTOP=KDE
# A missing profile fails seed; after five tries the unit parks as failed and
# stays visible in `systemctl --user status` (restart it after `init`).
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
UMask=0077
ExecStartPre=@{prefix}/bin/settingsd seed --instance %H --root %S/mix/settingsd/%H/default
ExecStart=@{prefix}/bin/settingsd serve --instance %H --root %S/mix/settingsd/%H/default
KillMode=control-group
TimeoutStopSec=10
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
