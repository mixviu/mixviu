[Unit]
RequiresMountsFor=@{var}/indexd
Description=MixViu semantic index service
Documentation=https://mixos.dev/indexd/
After=noded.service
Wants=noded.service
StartLimitIntervalSec=10min
StartLimitBurst=3

[Service]
ReadWritePaths=@{var}/indexd
Environment=STATE_DIRECTORY=@{var}/indexd
Type=simple
User=indexd
Group=indexd
Environment=MIX_ETC=@{etc}
Environment=MIX_VAR=@{var}
Environment=MIX_NODE_CONFIG=@{etc}/node.conf.mix
Environment=MALLOC_ARENA_MAX=2
Environment=HOME=@{var}/indexd
ExecStart=@{prefix}/bin/indexd -c @{etc}/indexd/config.conf.mix serve
WorkingDirectory=@{var}/indexd
MemoryMax=2G
MemoryHigh=1536M
MemorySwapMax=0
Restart=on-failure
RestartSec=30s
TimeoutStopSec=180s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=indexd
LogRateLimitIntervalSec=30s
LogRateLimitBurst=10000

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
# The node configuration selects a TCP broker; model loading uses local files.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# Retained from the predecessor's deployed indexd unit (candle CPU/gemm).
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0027

[Install]
WantedBy=multi-user.target
