-- version: 0.1.0
-- Copied beside the lab files; cannot read or write a worker's CT configs.
$lab = dirname(script_path())
$argv = args()
if $argv[0] == "list" then
  print("VMID Status Lock Name\n102 running seat\n103 stopped old\n104 stopped unrelated")
elif $argv[0] == "config" then
  print(read_file($lab .. "/" .. $argv[1] .. ".conf"))
elif $argv[0] == "set" then
  if len($argv) != 6 or $argv[4] != "--digest" or $argv[5] != substr(hash_sha256(read_file($lab .. "/" .. $argv[1] .. ".conf")), 0, 40) then die("config digest changed") end
  if exists($lab .. "/fail-" .. $argv[1]) then die("injected CT update failure") end
  if read_file($lab .. "/hook.mix") != "test-hook\n" or not run_argv(["/usr/bin/test", "-x", $lab .. "/hook.mix"]).ok then die("pct called before executable hook published") end
  $entry = json_encode($argv) .. "\n"
  $log = $lab .. "/sets.log"
  write_file($log, (if exists($log) then read_file($log) else "" end) .. $entry)
  if $argv[2] == "--delete" then
    if $argv[3] != "hookscript" then die("wrong delete") end
    write_file($lab .. "/" .. $argv[1] .. ".conf", "cores: 2\n")
  elif $argv[2] == "--hookscript" then
    write_file($lab .. "/" .. $argv[1] .. ".conf", "cores: 2\nhookscript: " .. $argv[3] .. "\n")
  else
    die("unexpected pct set")
  end
else
  die("unexpected pct command")
end
