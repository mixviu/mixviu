[Unit]
Description=MixViu host processed-udev forwarder for desk containers
After=systemd-udevd.service pve-cluster.service
Wants=systemd-udevd.service

[Service]
Type=simple
User=root
ExecStart=@{prefix}/bin/mix @{lib}/udev-forwarder/forwarder.mix @{etc}/udev-forwarder.conf.mix
Restart=on-failure
RestartSec=2
TimeoutStopSec=10
NoNewPrivileges=yes
# CAP_SYS_PTRACE: opening a CT init's /proc/<pid>/ns/net is a ptrace-mode
# access check; without it every attach fails with EACCES.
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_NET_ADMIN CAP_SYS_PTRACE
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
# setns needs the host /proc; do not enable PrivateNetwork/RestrictNamespaces.

[Install]
WantedBy=multi-user.target
