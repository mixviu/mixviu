for $argv in [["cargo", "test", "-p", "media-av1", "-p", "media-webm", "-p", "av", "--all-targets", "--", "--nocapture"], ["cargo", "clippy", "--no-deps", "-p", "media-av1", "-p", "media-webm", "-p", "av", "--all-targets", "--", "-D", "warnings"], ["mix", "tools/foreign_gate.mix"]]
  $r = run_argv(concat(["env", "MIX_TEST_REQUIRE_FFMPEG=1"], $argv), {timeout: 7200})
  print($r.stdout)
  print($r.stderr)
  if not $r.ok then exit($r.exit_code ?? 1) end
end
