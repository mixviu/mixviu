for $argv in [["cargo", "test", "--locked", "-p", "media-audio", "-p", "media-av1", "-p", "media-webm", "-p", "av", "-p", "logging", "--all-targets", "--", "--nocapture"], ["cargo", "clippy", "--locked", "--no-deps", "-p", "media-audio", "-p", "media-av1", "-p", "media-webm", "-p", "av", "-p", "logging", "--all-targets", "--", "-D", "warnings"], ["mix", "tools/foreign_gate.mix", "--locked"], ["cargo", "deny", "check", "advisories", "bans", "licenses", "sources"]]
  $r = run_argv(concat(["env", "MIX_TEST_REQUIRE_FFMPEG=1"], $argv), {timeout: 7200})
  print($r.stdout)
  print($r.stderr)
  if not $r.ok then exit($r.exit_code ?? 1) end
end
