# MixViu blob store daemon (blobd). The same identities as the previous unit it
# replaces: uid blobd, group blob (522), the same state root
# @{var}/blobd and config @{etc}/blobd/config.conf.mix, so the
# store is read in place. Stop blobd before starting this one: both
# register as the Bus service "blobd" and both hold the lane port.

[Unit]
RequiresMountsFor=@{var}/blobd @{run}/blobd
Description=MixViu blob store daemon (blobd)
After=network-online.target noded.service
Wants=network-online.target noded.service
StartLimitIntervalSec=10min
StartLimitBurst=3

[Service]
ReadWritePaths=@{var}/blobd @{run}/blobd
Environment=STATE_DIRECTORY=@{var}/blobd
ExecStartPre=/usr/bin/mkdir -p @{run}/blobd
ExecStartPre=/usr/bin/find @{run}/blobd -mindepth 1 -delete
Type=simple
User=blobd
Group=blobd
SupplementaryGroups=blob
WorkingDirectory=@{var}/blobd
ExecStart=@{prefix}/bin/blobd -c @{etc}/blobd/config.conf.mix
Restart=on-failure
RestartSec=30s
Environment=RUST_LOG=blobd=info
Environment=HOME=@{var}/blobd
Environment=MIX_NODE_CONFIG=@{etc}/node.conf.mix
StandardOutput=journal
StandardError=journal
SyslogIdentifier=blobd
LogRateLimitIntervalSec=30s
LogRateLimitBurst=10000

# §5.1 required (Level 1)
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

# §5.2 mandatory hardening (Level 2)
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallFilter=@chown
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
UMask=0027
PrivateDevices=yes

[Install]
WantedBy=multi-user.target
