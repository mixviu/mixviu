$r = run_argv([env("MIX_TEST_MIX_EXE", realpath("/proc/self/exe")), dirname(script_path()) .. "/acp_test.mix"],
  {env: {ACP_TEST_CLIENT: "acp_failure_client.mix"}, timeout: 55, max_output: 300000})
print($r.stdout)
print($r.stderr)
if not $r.ok then exit(1) end
