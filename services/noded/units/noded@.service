[Unit]
Description=Native ABP broker for MixViu session %i
PartOf=session@%i.target

[Service]
Type=simple
User=mix
EnvironmentFile=@{etc}/session/%i.env
UnsetEnvironment=DBUS_SESSION_BUS_ADDRESS DBUS_STARTER_ADDRESS DBUS_STARTER_BUS_TYPE DBUS_SYSTEM_BUS_ADDRESS
RuntimeDirectory=mix/session/%i/noded
RuntimeDirectoryMode=0711
ExecStart=@{prefix}/bin/noded serve --no-monitor --no-log
KillMode=control-group
TimeoutStopSec=10
Restart=on-failure
RestartSec=1
