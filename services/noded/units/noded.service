# Plain per-host noded: one node per host, running as noded.
# Operators override User/Group with noded.service.d/user.conf and set
# noded.account in node.conf.mix to the same operating-system account.
# Host-local values come from EnvironmentFile (LISTEN, NODE). It is written
# per host and is never in the repo.
[Unit]
RequiresMountsFor=@{var}/noded @{run}/noded
Description=MixViu per-node Bus broker (noded)
Documentation=https://mixos.dev/noded/
After=network-online.target
Wants=network-online.target

[Service]
ReadWritePaths=@{var}/noded @{run}/noded
Environment=STATE_DIRECTORY=@{var}/noded
ExecStartPre=/usr/bin/mkdir -p @{run}/noded
ExecStartPre=/usr/bin/find @{run}/noded -mindepth 1 -delete
ExecStopPost=-/usr/bin/find @{run}/noded -mindepth 1 -delete
Type=simple
User=noded
Group=noded
EnvironmentFile=@{etc}/noded/service.env
# Pin the system trust root, state and runtime for this service account.
Environment=MIX_ETC=@{etc}
Environment=MIX_VAR=@{var}
Environment=MIX_RUN=@{run}
ExecStart=@{prefix}/bin/noded serve --listen ${LISTEN} --node ${NODE} --mesh-config @{etc}/noded/config.conf.mix --no-monitor --no-log
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
