-- SPDX-License-Identifier: MIT OR Apache-2.0
-- version: 0.1.0
-- idle_profile.mix: what a running daemon costs while it does nothing.
--
--   mix idle_profile.mix --pid PID[,PID...] [--seconds N] [--strace] [--json]
--                        [--budget WAKEUPS_PER_SECOND]
--
-- Samples /proc twice, N seconds apart (default 10), and reports for each
-- process: CPU% of one core, wake-ups a second (voluntary context switches
-- summed over its threads, the busiest thread named), involuntary switches a
-- second, resident memory and thread count. It reads /proc only, so it is
-- safe to point at a production daemon and works for any process.
--
-- --strace also attaches `strace -c -f` for the same window and reports
-- system calls a second and the top calls. Attaching needs ptrace permission
-- (the same user with kernel.yama.ptrace_scope=0, or root) and slows the
-- target while attached, so its CPU figure is taken in a separate window
-- before the trace starts.
--
-- --budget N exits 1 when any sampled process exceeds N wake-ups a second.
--
--   mix idle_profile.mix --fixture [--no-strace] [--out FILE]
--
-- Run from the repository root on a build worker. Builds noded in release
-- and runs the `profile` test of services/noded/tests/efficiency.rs: five
-- brokers in a signed fixture mesh, the first measured through idle,
-- registration churn, a local burst, a mesh burst, a flapping peer and idle
-- again. A second run under strace supplies the system-call columns (its CPU
-- figures are discarded). Prints one table; --out saves the rows as JSON so
-- two runs can be compared. NODED_PROFILE_* settings pass through.

fn fail($message)
  eprint("idle_profile: " .. $message)
  exit(2)
end

fn status_field($text, $name)
  for $line in lines($text)
    if starts_with($line, $name .. ":") then
      $parts = re_split(trim(substr($line, len($name) + 1)), "\\s+")
      return to_number($parts[0])
    end
  end
  return 0
end

-- utime + stime, in clock ticks, from a stat line. The command name may
-- hold spaces and brackets, so fields are counted from the last ")".
fn stat_ticks($text)
  $at = re_find($text, "\\) ")
  if len($at) == 0 then return 0 end
  $tail = substr($text, $at[len($at) - 1].end)
  $f = split(trim($tail), " ")
  return to_number($f[11]) + to_number($f[12])
end

fn snapshot($pid)
  $root = "/proc/" .. to_string($pid)
  if not is_file($root .. "/stat") then fail("no such process: " .. to_string($pid)) end
  $threads = {}
  for $dir in glob($root .. "/task/*")
    $tid = basename($dir)
    -- A thread may exit between the listing and the read.
    if is_file($dir .. "/status") then
      $status = read_file($dir .. "/status")
      $threads[$tid] = {
        name: trim(read_file($dir .. "/comm")),
        voluntary: status_field($status, "voluntary_ctxt_switches"),
        involuntary: status_field($status, "nonvoluntary_ctxt_switches"),
        ticks: stat_ticks(read_file($dir .. "/stat"))
      }
    end
  end
  $status = read_file($root .. "/status")
  return {
    at: monotonic(),
    ticks: stat_ticks(read_file($root .. "/stat")),
    rss_kb: status_field($status, "VmRSS"),
    threads: $threads
  }
end

fn compare($pid, $before, $after, $hz)
  $elapsed = $after.at - $before.at
  $voluntary = 0
  $involuntary = 0
  $busiest = {name: "", rate: 0}
  for $tid in keys($after.threads)
    $now = $after.threads[$tid]
    $then = $before.threads[$tid] ?? {voluntary: 0, involuntary: 0}
    $delta = $now.voluntary - $then.voluntary
    $voluntary = $voluntary + $delta
    $involuntary = $involuntary + $now.involuntary - $then.involuntary
    if $delta / $elapsed > $busiest.rate then
      $busiest = {name: $now.name, rate: $delta / $elapsed}
    end
  end
  return {
    pid: $pid,
    command: trim(replace(read_file("/proc/" .. to_string($pid) .. "/cmdline"), chr(0), " ")),
    seconds: $elapsed,
    cpu_percent: ($after.ticks - $before.ticks) / $hz / $elapsed * 100,
    wakeups_per_s: $voluntary / $elapsed,
    involuntary_per_s: $involuntary / $elapsed,
    busiest_thread: $busiest.name,
    busiest_wakeups_per_s: $busiest.rate,
    rss_kb: $after.rss_kb,
    threads: len(keys($after.threads))
  }
end

-- `strace -c` summary rows: % time, seconds, usecs/call, calls, [errors,] name.
fn strace_window($pid, $seconds)
  $out = "/tmp/idle-profile-" .. to_string(pid()) .. "-" .. to_string($pid) .. ".strace"
  $started = monotonic()
  $r = run_argv(["strace", "-c", "-f", "-p", to_string($pid), "-o", $out], {timeout: $seconds, grace: 5})
  $elapsed = monotonic() - $started
  if not is_file($out) then
    return {error: trim($r.stderr)}
  end
  $text = read_file($out)
  remove($out)
  $calls = []
  $total = 0
  for $line in lines($text)
    $f = re_split(trim($line), "\\s+")
    if len($f) >= 5 and re_match($f[0], "^[0-9.]+$") and re_match($f[3], "^[0-9]+$") and $f[len($f) - 1] != "total" then
      push($calls, {name: $f[len($f) - 1], calls: to_number($f[3])})
      $total = $total + to_number($f[3])
    end
  end
  if $total == 0 and trim($r.stderr) != "" and len($calls) == 0 and not contains($text, "total") then
    return {error: trim($r.stderr)}
  end
  $top = slice(reverse(sort_by($calls, fn($c) = $c.calls)), 0, 5)
  return {
    syscalls_per_s: $total / $elapsed,
    top: map($top, fn($c) = $c.name .. " " .. to_string($c.calls))
  }
end

-- One `profile` run; returns its PROFILE rows in phase order.
fn fixture_rows($strace)
  $env = {}
  if $strace then $env.NODED_PROFILE_STRACE = "1" end
  $r = run_argv(["cargo", "test", "--locked", "--release", "-p", "noded", "--test", "efficiency",
    "--", "--ignored", "--nocapture", "--exact", "profile"],
    {timeout: 3600, env: $env, stderr: "stdout", max_output: 64000000})
  if not $r.ok then
    print($r.stdout)
    fail("the profile run failed" .. (if $strace then " (under strace)" else "" end))
  end
  $rows = []
  for $line in lines($r.stdout)
    -- The test harness may print its own text before the marker on a line.
    $at = re_find($line, "PROFILE \\{")
    if len($at) > 0 then push($rows, json_parse(substr($line, $at[0].start + 8))) end
  end
  if len($rows) == 0 then
    print($r.stdout)
    fail("the profile run printed no rows")
  end
  return $rows
end

fn cell($value, $pattern)
  if $value == nil then return "-" end
  return fmt($pattern, $value)
end

fn fixture($g)
  $rows = fixture_rows(false)
  if not $g.opts["no-strace"] then
    $traced = fixture_rows(true)
    for $i = 0 to len($rows) - 1
      for $t in $traced
        if $t.phase == $rows[$i].phase then
          $rows[$i].syscalls_per_s = $t.syscalls_per_s
          $rows[$i].top_syscalls = $t.top_syscalls
        end
      end
    end
  end
  print(fmt("%-12s %8s %7s %9s %10s %11s %9s %7s %9s %9s", "phase", "seconds", "cpu %", "cpu ms",
    "wake-ups/s", "syscalls/s", "rss kB", "threads", "messages", "us/msg"))
  for $row in $rows
    print(fmt("%-12s %8s %7s %9s %10s %11s %9s %7s %9s %9s", $row.phase, cell($row.seconds, "%.1f"),
      cell($row.cpu_percent, "%.2f"), cell($row.cpu_ms, "%.0f"), cell($row.wakeups_per_s, "%.1f"),
      cell($row.syscalls_per_s, "%.1f"), cell($row.rss_kb, "%d"), cell($row.threads, "%d"),
      cell($row.messages, "%d"), cell($row.cpu_us_per_message, "%.1f")))
  end
  for $row in $rows
    if $row.top_syscalls != nil then
      print(fmt("%-12s top syscalls: %s", $row.phase, join($row.top_syscalls, ", ")))
    end
  end
  for $row in $rows print("ROW " .. json_encode($row)) end
  if $g.opts.out != nil then write_file($g.opts.out, json_encode($rows, true) .. chr(10)) end
end

$g = getopt(args(), {pid: {arg: true}, seconds: {arg: true}, strace: {}, json: {}, budget: {arg: true},
  fixture: {}, "no-strace": {}, out: {arg: true}})
if len($g.errors) > 0 then fail(join($g.errors, "; ")) end
if $g.opts.fixture then
  fixture($g)
  exit(0)
end
if $g.opts.pid == nil then fail("--pid PID[,PID...] or --fixture is required") end
$seconds = to_number($g.opts.seconds ?? "10")
if $seconds < 1 then fail("--seconds must be at least 1") end
$pids = map(split($g.opts.pid, ","), fn($p) = to_number(trim($p)))
$hz = to_number(trim(run_argv_must(["getconf", "CLK_TCK"])))

$before = {}
for $p in $pids $before[to_string($p)] = snapshot($p) end
sleep($seconds)
$rows = []
for $p in $pids
  push($rows, compare($p, $before[to_string($p)], snapshot($p), $hz))
end
if $g.opts.strace then
  for $i = 0 to len($rows) - 1
    $rows[$i].strace = strace_window($rows[$i].pid, $seconds)
  end
end

$over = false
for $row in $rows
  if $g.opts.json then
    print(json_encode($row))
  else
    print(fmt("pid %d  %s", $row.pid, $row.command))
    print(fmt("  cpu %.2f%%  wake-ups %.1f/s (busiest %s %.1f/s)  involuntary %.1f/s  rss %d kB  threads %d  window %.1fs",
      $row.cpu_percent, $row.wakeups_per_s, $row.busiest_thread, $row.busiest_wakeups_per_s,
      $row.involuntary_per_s, $row.rss_kb, $row.threads, $row.seconds))
    if $row.strace != nil then
      if $row.strace.error != nil then
        print("  strace unavailable: " .. $row.strace.error)
      else
        print(fmt("  syscalls %.1f/s  top: %s", $row.strace.syscalls_per_s, join($row.strace.top, ", ")))
      end
    end
  end
  if $g.opts.budget != nil and $row.wakeups_per_s > to_number($g.opts.budget) then
    $over = true
    eprint(fmt("idle_profile: pid %d makes %.1f wake-ups/s, over the budget of %s", $row.pid, $row.wakeups_per_s, $g.opts.budget))
  end
end
if $over then exit(1) end
