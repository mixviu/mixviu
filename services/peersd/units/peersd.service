# SPDX-License-Identifier: MIT OR Apache-2.0
# peersd in a user's own session (a user unit, `systemctl --user`): the
# `peers` Bus service for that user's agent sessions, always running.
# State lives in the user's XDG state dir, one per host, because a desk
# container may share its home with the host:
# ~/.local/state/mixos/peers/<host>/peers.db.
[Unit]
Description=MixViu peer agent sessions (peersd)
Documentation=https://mixos.dev/peersd/
# The broker is the system noded.service, which a user unit cannot order
# after or want; `mix --serve` is supervised and keeps retrying until the
# broker answers. The After= covers a user-manager noded where there is one.
After=noded.service

[Service]
Type=simple
Environment=PEERS_STATE=%S/mixos/peers/%H
# What StateDirectory=mixos/peers/%H with StateDirectoryMode=0700 gave: the
# parents are created as the manager's umask allows, the leaf is the user's
# and 0700. A leaf that is a symlink or belongs to another uid is refused,
# not chmod'ed. No UMask=: files the service writes keep the manager's
# umask, as before.
ExecStartPre=/usr/bin/mkdir -p %S/mixos/peers/%H
ExecStartPre=/usr/bin/test ! -L %S/mixos/peers/%H
ExecStartPre=/usr/bin/test -O %S/mixos/peers/%H
ExecStartPre=/usr/bin/chmod 0700 %S/mixos/peers/%H
ExecStart=@{prefix}/bin/mix --serve @{prefix}/lib/peersd/peersd.mix --name peers
TimeoutStopSec=10
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
