-- SPDX-License-Identifier: MIT OR Apache-2.0
-- Run from the repository root: mix services/webd/vhosts/subscriptions_test.mix
-- Execute real app source with the host DB seam mapped to in-memory SQLite,
-- strict HTTP fixtures, an injected session and a body-only page shell.
-- No server, gateway, mail account, or on-disk database is used.
$root = "services/webd/vhosts/"
$mix = args()[0] ?? "/usr/local/bin/mix"
$source = '$DB = sqlopen(":memory:", "rwc")
sqlexec($DB, "PRAGMA foreign_keys=OFF")
function test_query($sql, $params = [])
  return sqlexec($DB, $sql, $params)
end
function test_exec($sql, $params = [])
  return sqlexec($DB, $sql, $params)
end
function check($ok, $message)
  if not $ok then raise("SUB_TEST", $message) end
end
function test_page($title, $user, $body)
  return $body
end
function test_http_request($method, $url, $body, $headers, $options)
  global $HTTP_CALLS
  push($HTTP_CALLS, {method: $method, url: $url, body: $body, headers: $headers})
  if $method == "POST" and ends_with($url, "/v1/customers") then
    return {status: 200, body: json_encode({id: "cus_example"})}
  end
  if $TEST_HTTP_FAIL then return {status: 503, body: "{}"} end
  if $method != "GET" or not contains($url, "/payment_intents/pi_") then
    raise("SUB_TEST", "unexpected network request")
  end
  return {status: 200, body: json_encode({id: "pi_example", status: "succeeded", customer: $TEST_PI_CUSTOMER,
          payment_method: $TEST_PI_METHOD, setup_future_usage: "off_session"})}
end
$HTTP_CALLS = []
$TEST_HTTP_FAIL = false
$TEST_PI_CUSTOMER = "cus_example"
$TEST_PI_METHOD = "pm_example"
$SESSION = {authenticated: true, email: "admin@example.net", kind: "staff"}
$SITE = {title: "Example", domain: "example.com", fqdn: "example.com", tagline: "", footer: "", features: {}}
$HEADERS = {}
$METHOD = "GET"
$QUERY = ""
$BODY = ""
$PATH = "/subscribe/example-plus"
$CSRF = "test"
'
for each $file in ["lib/lib.mix", "widgets/forms.mix", "widgets/modals.mix", "widgets/datatable.mix", "widgets/detail.mix", "widgets/treeview.mix", "apps/biz.mix", "apps/stripe.mix", "apps/paypal.mix", "apps/h_biz_pay.mix", "apps/h_sub.mix", "apps/shop.mix", "apps/h_biz_tick.mix", "apps/h_biz_services.mix", "apps/h_biz_subscriptions.mix", "subscriptions_test_cases.mix"]
  $part = read_file($root .. $file)
  $part = re_replace($part, "(?m)^include .*\n", "")
  $part = replace($part, "db_query(", "test_query(")
  $part = replace($part, "db_exec(", "test_exec(")
  $part = replace($part, "http_request(", "test_http_request(")
  $part = replace($part, "body: page($title, $user, $body)", "body: test_page($title, $user, $body)")
  $part = replace($part, 'mix_path("prefix") .. "/vhosts/shared/lib/shell.html"', '"services/webd/vhosts/lib/shell.html"')
  $source = $source .. "\n" .. $part
end
$path = "/var/tmp/subscriptions-test-" .. pid() .. ".mix"
try
  write_file($path, $source)
  $result = run_argv([$mix, $path], {timeout: 120, max_output: 20000})
  print($result.stdout)
  print($result.stderr)
  if $result.exit_code != 0 then raise("SUB_TEST", "harness failed") end
finally
  remove($path)
end
