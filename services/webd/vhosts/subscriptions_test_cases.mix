test_exec("INSERT INTO users (username,pass_hash,salt,role) VALUES ('admin@example.net','','','admin')")
biz_init()
$old = test_query("SELECT * FROM services WHERE id=42")[0]
check($old.fqdn == "example.net" and $old.period_months == 12 and $old.price_cents == 5000, "migration preserves old columns")
check(length(test_query("SELECT * FROM services")) == 2001, "migration row count")
check(length(test_query("SELECT name FROM sqlite_master WHERE name='idx_example_preserved'")) == 1, "migration index preserved")
$schema = test_query("SELECT sql FROM sqlite_master WHERE name='services'")[0].sql
biz_init()
check(test_query("SELECT sql FROM sqlite_master WHERE name='services'")[0].sql == $schema, "migration rerun no-op")
test_exec("INSERT INTO plans (code,name,units,price_cents,kind,product,period_months) VALUES ('example-month','Example Plus',0,500,'subscription','example-plus',1)")
$plan_id = test_query("SELECT id FROM plans WHERE code='example-month'")[0].id
$page = sub_main()
check($page.status == 200 and contains($page.body, "per month"), "public plans")
$METHOD = "POST"
$BODY = "email=reader%40example.com&plan_id=" .. $plan_id
check(sub_main().status == 200, "signup accepted with mail off")
check(length(test_query("SELECT * FROM sub_signups")) == 1, "signup persisted")
-- Raw tokens are deliberately unavailable in the database; seed a known proof.
$token = biz_token()
test_exec("UPDATE sub_signups SET token_sha256=?1", [hash_sha256($token)])
$confirmed = sub_confirm($token)
check($confirmed.status == 303 and starts_with($confirmed.headers["Location"], "/pay/"), "confirm issues invoice")
$invoice_id = test_query("SELECT invoice_id FROM sub_signups")[0].invoice_id
$invoice = test_query("SELECT * FROM invoices WHERE id=?1", [$invoice_id])[0]
check($invoice.status == "open" and $invoice.total_cents == 500 and $invoice.tax_cents == 0, "plan price is final total")
check(sub_confirm($token).headers["Location"] == $confirmed.headers["Location"], "reuse open invoice")
check(length(test_query("SELECT * FROM services WHERE kind='subscription'")) == 1, "no duplicate service")
$item = test_query("SELECT * FROM invoice_items WHERE invoice_id=?1", [$invoice_id])[0]
check($item.period_end == biz_period_end($item.period_start, 1, to_number(substr($item.period_start,8,2))), "monthly item period")
$paid = biz_apply_payment($invoice_id, "bank", "example-payment", 500, 0, "test", "test")
check($paid.ok and $paid.flipped, "payment applied")
$service = test_query("SELECT * FROM services WHERE id=?1", [$item.service_id])[0]
check($service.status == "active" and $service.next_due == $item.period_end, "activation and paid through")
check(not biz_apply_payment($invoice_id, "bank", "example-payment", 500, 0, "test", "test").flipped, "replay does not advance dates")
check(contains(sub_confirm($token).body, "used"), "paid token reuse")
$existing_token = biz_token()
test_exec("INSERT INTO sub_signups (email,plan_id,token_sha256,expires_at) VALUES ('reader@example.com',?1,?2,'2999-01-01')", [$plan_id,hash_sha256($existing_token)])
check(contains(sub_confirm($existing_token).body, "paid up until"), "existing subscription status after proof")
check(length(test_query("SELECT * FROM services WHERE kind='subscription'")) == 1, "existing email does not create duplicate")
check(sub_export("example-plus").status == 404, "export disabled")
biz_setting_set("sub_export_secret", "example-secret")
check(sub_export("example-plus").status == 401, "export unauthenticated")
$HEADERS = {"x-sub-secret": "wrong"}
check(sub_export("example-plus").status == 401, "export wrong secret")
$HEADERS = {"x-sub-secret": "example-secret"}
$export = json_parse(sub_export("example-plus").body)
check(length($export.subscribers) == 1 and $export.subscribers[0].email == "reader@example.com", "paid entitlement exported")
$METHOD = "GET"
$PATH = "/subscribe/unknown"
check(sub_main().status == 404, "unknown product")
$expired = biz_token()
$METHOD = "POST"
test_exec("INSERT INTO sub_signups (email,plan_id,token_sha256,expires_at) VALUES ('other@example.net',?1,?2,'2000-01-01')", [$plan_id,hash_sha256($expired)])
check(sub_confirm($expired).status == 410, "expired token")
check(sub_confirm("bad").status == 404, "malformed token")
-- Exact pre-existing annual description and period, including leap-day policy.
$annual = test_query("SELECT * FROM services WHERE id=42")[0]
$annual_invoice = bt_generate_one("service", $annual, "2026-02-01")
$annual_item = test_query("SELECT * FROM invoice_items WHERE invoice_id=?1", [$annual_invoice])[0]
check($annual_item.description == "Annual hosting renewal — Example hosting (2026-02-28 to 2027-02-28)", "annual description unchanged")
check($annual_item.period_end == biz_date_add($annual.next_due, "+1 year"), "annual period unchanged")
check(deep_eq(st_subscription_params($annual_invoice, ["existing=1"]), ["existing=1"]), "hosting Stripe params unchanged")
biz_setting_set("stripe_secret_key", "example-key")
$params = join(st_subscription_params($invoice_id, []), "&")
check(contains($params, "off_session") and contains($params, "customer=cus_example") and not contains($params, "customer_creation"), "subscription card setup only")
biz_setting_set("stripe_secret_key", "example-key")
biz_setting_set("stripe_webhook_secret", "example-signing-secret")
test_exec("INSERT INTO payment_attempts (invoice_id,gateway,kind,idempotency_key,external_id,amount_cents,currency,mode,status)
           VALUES (?1,'stripe','checkout','example-attempt','cs_example',500,'aud','test','succeeded')", [$invoice_id])
$event = {type: "checkout.session.completed", data: {object: {id: "cs_example", payment_status: "paid", payment_intent: "pi_example",
          customer: "cus_example", amount_total: 500, currency: "aud"}}}
$BODY = json_encode($event)
$timestamp = "" .. floor(time())
$HEADERS = {"stripe-signature": "t=" .. $timestamp .. ",v1=" .. hmac_sha256("example-signing-secret", $timestamp .. "." .. $BODY)}
check(bp_stripe_webhook().status == 200, "verified Checkout replay repairs card setup")
$card = test_query("SELECT * FROM customers WHERE id=?1", [$service.customer_id])[0]
check($card.stripe_pm_status == "verified" and $card.stripe_pm_id == "pm_example" and $card.stripe_customer_id == "cus_example", "verified card saved")
check(test_query("SELECT auto_charge FROM services WHERE id=?1", [$service.id])[0].auto_charge == 1, "auto charge enabled")
check(contains(join(st_subscription_params($invoice_id, []), "&"), "cus_example"), "saved customer reused")
check(biz_date_add("2024-02-29", "+12 months") == biz_date_add("2024-02-29", "+1 year"), "annual leap policy unchanged")
test_exec("UPDATE services SET next_due='2000-01-01' WHERE id=?1", [$service.id])
$lapsed = test_query("SELECT * FROM services WHERE id=?1", [$service.id])[0]
$renewal = bt_generate_one("service", $lapsed, biz_today())
check($renewal != nil, "monthly renewal generated")
check(bt_generate_one("service", $lapsed, biz_today()) == nil, "renewal idempotent")
biz_subscription_tick(biz_today())
check(test_query("SELECT status FROM services WHERE id=?1", [$service.id])[0].status == "suspended", "unpaid renewal suspends")
$HEADERS = {"x-sub-secret": "example-secret"}
check(length(json_parse(sub_export("example-plus").body).subscribers) == 0, "outside grace excluded")
test_exec("UPDATE services SET next_due=?2 WHERE id=?1", [$service.id, biz_today()])
check(length(json_parse(sub_export("example-plus").body).subscribers) == 1, "suspended inside grace included")
$renewal_invoice = test_query("SELECT * FROM invoices WHERE id=?1", [$renewal])[0]
check(biz_apply_payment($renewal, "bank", "example-renewal", $renewal_invoice.total_cents, 0, "test", "test").flipped, "renewal payment applied")
check(test_query("SELECT status FROM services WHERE id=?1", [$service.id])[0].status == "active", "suspended service reactivates")
$pending_token = biz_token()
test_exec("INSERT INTO sub_signups (email,plan_id,token_sha256,expires_at) VALUES ('pending@example.net',?1,?2,'2999-01-01')", [$plan_id,hash_sha256($pending_token)])
check(sub_confirm($pending_token).status == 303, "pending fixture")
test_exec("UPDATE invoices SET issued='2000-01-01' WHERE status='open' AND customer_id=(SELECT id FROM customers WHERE email='pending@example.net')")
biz_subscription_tick(biz_today())
check(test_query("SELECT status FROM services WHERE customer_id=(SELECT id FROM customers WHERE email='pending@example.net')")[0].status == "cancelled", "stale pending cancelled")
check(length(test_query("SELECT i.id FROM invoices i JOIN customers c ON c.id=i.customer_id WHERE c.email='pending@example.net' AND i.status='cancelled'")) == 1, "pending invoice cancelled")
biz_subscription_tick(biz_today())
check(test_query("SELECT sent_at FROM notification_events WHERE template='sub_receipt'")[0].sent_at != nil, "receipt off stamped")
-- r2.1: money is applied before a failing card fetch; signed replay repairs it.
$METHOD = "POST"
$HEADERS = {}
$failure_proof = test_signup("card-failure@example.net", $plan_id)
check(sub_confirm($failure_proof).status == 303, "r2.1 payment fixture")
$failure_invoice = test_invoice_for($failure_proof)
$TEST_HTTP_FAIL = true
check(test_checkout_event($failure_invoice,"failure").status == 200, "r2.1 card failure still acknowledges payment")
$failure_service = test_query("SELECT s.* FROM services s JOIN invoice_items ii ON ii.service_id=s.id WHERE ii.invoice_id=?1", [$failure_invoice])[0]
check($failure_service.status == "active" and $failure_service.auto_charge == 0, "r2.1 paid and active without saved card")
check(test_query("SELECT status FROM invoices WHERE id=?1", [$failure_invoice])[0].status == "paid", "r2.1 invoice paid")
check(length(test_query("SELECT id FROM audit WHERE action='subscription_card_save_failed' AND row_id=?1", [$failure_invoice])) == 1, "r2.1 failure audited")
$TEST_HTTP_FAIL = false
check(test_checkout_event($failure_invoice,"failure").status == 200, "r2.1 replay repairs card")
$repaired = test_query("SELECT * FROM services WHERE id=?1", [$failure_service.id])[0]
check($repaired.auto_charge == 1 and $repaired.next_due == $failure_service.next_due, "r2.1 repair never advances twice")
$validation_proof = test_signup("validation@example.net", $plan_id)
sub_confirm($validation_proof)
$validation_invoice = test_invoice_for($validation_proof)
check(test_checkout_event($validation_invoice,"validation",501).status == 400, "r2.1 normal amount validation precedes card")
check(test_checkout_event($validation_invoice,"validation",500,"usd").status == 400, "r2.1 normal currency validation")
test_exec("UPDATE payment_attempts SET mode='live' WHERE external_id='cs_validation'")
check(test_checkout_event($validation_invoice,"validation").status == 400, "r2.1 normal mode validation")
test_exec("UPDATE payment_attempts SET status='expired' WHERE external_id='cs_validation'")
$write_failure = test_signup("card-write-failure@example.net",$plan_id)
sub_confirm($write_failure)
$write_invoice = test_invoice_for($write_failure)
test_exec("CREATE TRIGGER example_card_write_failure BEFORE UPDATE OF stripe_pm_id ON customers BEGIN SELECT RAISE(ABORT,'example write failure'); END")
check(test_checkout_event($write_invoice,"write_failure").status == 200,"r2.1 card database failure still acknowledges payment")
test_exec("DROP TRIGGER example_card_write_failure")
check(test_query("SELECT status FROM invoices WHERE id=?1",[$write_invoice])[0].status == "paid", "r2.1 card database failure leaves invoice paid")
check(length(test_query("SELECT id FROM audit WHERE action='subscription_card_save_failed' AND row_id=?1",[$write_invoice])) == 1,"r2.1 card write failure audited")

-- r2.2: age starts at issue; any created attempt or net payment blocks expiry.
check(biz_setting("sub_pending_days") == "14", "r2.2 new default is fourteen days")
$age_proof = test_signup("issue-age@example.net", $plan_id)
sub_confirm($age_proof)
$age_invoice = test_invoice_for($age_proof)
test_exec("UPDATE services SET created='2000-01-01' WHERE id IN (SELECT service_id FROM invoice_items WHERE invoice_id=?1)", [$age_invoice])
biz_subscription_tick(biz_today())
check(test_query("SELECT status FROM invoices WHERE id=?1", [$age_invoice])[0].status == "open", "r2.2 old service newly issued invoice stays open")
test_exec("UPDATE invoices SET issued='2000-01-01' WHERE id=?1", [$age_invoice])
test_exec("INSERT INTO payment_attempts (invoice_id,gateway,kind,idempotency_key,amount_cents,currency,mode,status,updated)
           VALUES (?1,'stripe','checkout','example-old-flight',500,'aud','test','created','2000-01-01')", [$age_invoice])
biz_subscription_tick(biz_today())
check(test_query("SELECT status FROM invoices WHERE id=?1", [$age_invoice])[0].status == "open", "r2.2 stale created attempt still blocks cancellation")
test_exec("UPDATE payment_attempts SET status='expired' WHERE idempotency_key='example-old-flight'")
check(biz_apply_payment($age_invoice,"bank","example-partial",100,0,"test","test").ok, "r2.2 partial transfer recorded")
biz_subscription_tick(biz_today())
check(test_query("SELECT status FROM invoices WHERE id=?1", [$age_invoice])[0].status == "open", "r2.2 partial payment blocks cancellation")
$late_proof = test_signup("late-transfer@example.net",$plan_id)
sub_confirm($late_proof)
$late_invoice = test_invoice_for($late_proof)
test_exec("UPDATE invoices SET issued='2000-01-01' WHERE id=?1", [$late_invoice])
biz_subscription_tick(biz_today())
check(test_query("SELECT status FROM invoices WHERE id=?1", [$late_invoice])[0].status == "cancelled", "r2.2 truly unpaid invoice expires")
check(not biz_apply_payment($late_invoice,"bank","example-late",500,0,"test","test").ok, "r2.2 cancelled invoice refuses ordinary apply until recovery")
$BODY = "csrf=test&action=reopen&invoice_id=" .. $late_invoice
check(biz_subscriptions_main().status == 303, "r2.2 admin reopen action")
check(biz_apply_payment($late_invoice,"bank","example-late",500,0,"late transfer","test").flipped, "r2.2 admin can record late bank payment after reopen")
check(test_query("SELECT s.status FROM services s JOIN invoice_items ii ON ii.service_id=s.id WHERE ii.invoice_id=?1", [$late_invoice])[0].status == "active", "r2.2 recovered subscription active")

-- r2.3: fixed civil-date expectations, thirteen real invoice/payment cycles.
$calendars = [
 ["2026-01-31","2026-02-28","2026-03-31","2026-04-30","2026-05-31","2026-06-30","2026-07-31","2026-08-31","2026-09-30","2026-10-31","2026-11-30","2026-12-31","2027-01-31","2027-02-28"],
 ["2024-02-29","2024-03-29","2024-04-29","2024-05-29","2024-06-29","2024-07-29","2024-08-29","2024-09-29","2024-10-29","2024-11-29","2024-12-29","2025-01-29","2025-02-28","2025-03-29"],
 ["2026-04-30","2026-05-30","2026-06-30","2026-07-30","2026-08-30","2026-09-30","2026-10-30","2026-11-30","2026-12-30","2027-01-30","2027-02-28","2027-03-30","2027-04-30","2027-05-30"],
 ["2026-12-31","2027-01-31","2027-02-28","2027-03-31","2027-04-30","2027-05-31","2027-06-30","2027-07-31","2027-08-31","2027-09-30","2027-10-31","2027-11-30","2027-12-31","2028-01-31"]]
for each $dates in $calendars
  $anchor = to_number(substr($dates[0],8,2))
  test_exec("INSERT INTO services (customer_id,kind,label,plan_id,price_cents,period_months,next_due,anchor_day,status)
             VALUES (?1,'subscription','Example calendar',?2,500,1,?3,?4,'active')", [$service.customer_id,$plan_id,$dates[0],$anchor])
  $calendar_id = test_query("SELECT last_insert_rowid() AS id")[0].id
  $round = 0
  while $round < 13
    $calendar = test_query("SELECT * FROM services WHERE id=?1",[$calendar_id])[0]
    $calendar_invoice = bt_generate_one("service",$calendar,$dates[$round])
    $calendar_item = test_query("SELECT * FROM invoice_items WHERE invoice_id=?1",[$calendar_invoice])[0]
    check($calendar_item.period_start == $dates[$round] and $calendar_item.period_end == $dates[$round+1], "r2.3 anchored item " .. $dates[$round])
    check(biz_apply_payment($calendar_invoice,"bank","example-calendar-" .. $calendar_id .. "-" .. $round,500,0,"test","test").flipped, "r2.3 calendar payment")
    check(test_query("SELECT next_due FROM services WHERE id=?1",[$calendar_id])[0].next_due == $dates[$round+1], "r2.3 paid-through matches item")
    $round = $round + 1
  end
end
check(biz_period_end("2024-01-31",1,31) == "2024-02-29" and biz_period_end("2024-02-29",1,31) == "2024-03-31", "r2.3 leap February retains anchor")
check(biz_period_end("2024-02-29",12,29) == biz_date_add("2024-02-29","+1 year"), "r2.3 annual leap behaviour preserved")
check($old.anchor_day == 28, "r2.3 legacy anchor backfilled before rebuild")

-- r2.4: a pending plan switch cancels through the common cancellation path.
test_exec("INSERT INTO plans (code,name,units,price_cents,kind,product,period_months) VALUES ('example-year','Example Year',0,5000,'subscription','example-plus',12)")
$year_plan = test_query("SELECT id FROM plans WHERE code='example-year'")[0].id
$switch_month = test_signup("switch@example.net", $plan_id)
sub_confirm($switch_month)
$switch_old_invoice = test_invoice_for($switch_month)
$switch_year = test_signup("switch@example.net", $year_plan)
check(sub_confirm($switch_year).status == 303, "r2.4 pending different plan honoured")
$switch_new_invoice = test_invoice_for($switch_year)
check($switch_new_invoice != $switch_old_invoice, "r2.4 replacement invoice")
check(test_query("SELECT status FROM invoices WHERE id=?1",[$switch_old_invoice])[0].status == "cancelled", "r2.4 old invoice cancelled")
$switch_service = test_query("SELECT s.* FROM services s JOIN invoice_items ii ON ii.service_id=s.id WHERE ii.invoice_id=?1",[$switch_new_invoice])[0]
check($switch_service.plan_id == $year_plan and $switch_service.period_months == 12 and $switch_service.price_cents == 5000, "r2.4 chosen plan snapshot")
$same_plan = test_signup("switch@example.net", $year_plan)
check(sub_confirm($same_plan).headers["Location"] == sub_pay($switch_new_invoice).headers["Location"], "r2.4 same pending plan reuses invoice")
check(biz_apply_payment($switch_new_invoice,"bank","example-switch",5000,0,"test","test").flipped, "r2.4 activate yearly fixture")
$switch_service = test_query("SELECT * FROM services WHERE id=?1",[$switch_service.id])[0]
$switch_renewal = bt_generate_one("service", $switch_service, biz_today())
$active_choice = test_signup("switch@example.net", $plan_id)
check(contains(sub_confirm($active_choice).body, "paid up until"), "r2.4 active service shows status even with open renewal")
test_exec("UPDATE services SET status='suspended' WHERE id=?1",[$switch_service.id])
$suspended_choice = test_signup("switch@example.net",$plan_id)
check(sub_confirm($suspended_choice).headers["Location"] == sub_pay($switch_renewal).headers["Location"], "r2.4 suspended service routes to existing renewal")
check(length(test_query("SELECT id FROM services WHERE customer_id=?1 AND status!='cancelled'",[$switch_service.customer_id])) == 1, "r2.4 no duplicate suspended service")
check(not biz_reopen_subscription_invoice($switch_old_invoice,"test").ok, "r2.4 replaced invoice cannot be revived")
$blocked_month = test_signup("switch-flight@example.net",$plan_id)
sub_confirm($blocked_month)
$blocked_invoice = test_invoice_for($blocked_month)
test_exec("INSERT INTO payment_attempts (invoice_id,gateway,kind,idempotency_key,status,updated,amount_cents,currency,mode) VALUES (?1,'stripe','checkout','example-switch-flight','created','2000-01-01',500,'aud','test')",[$blocked_invoice])
$blocked_year = test_signup("switch-flight@example.net",$year_plan)
check(sub_confirm($blocked_year).status == 409, "r2.4 plan switch respects payment fence")
check(test_query("SELECT used_at FROM sub_signups WHERE token_sha256=?1",[hash_sha256($blocked_year)])[0].used_at == nil, "r2.4 failed switch keeps proof usable")

-- r2.5: exercise the actual admin save handler, not a stand-in INSERT.
$PATH = "/biz/services"
$BODY = "customer_id=" .. $service.customer_id .. "&kind=subscription&label=ExampleAdminMonthly&plan_id=" .. $plan_id .. "&price=&status=pending&payment_pref=bank&next_due=2026-01-31"
check(biz_services_main().status == 303, "r2.5 admin save succeeds with blank subscription price")
$admin_service = test_query("SELECT * FROM services WHERE label='ExampleAdminMonthly'")[0]
check($admin_service.period_months == 1 and $admin_service.price_cents == 500 and $admin_service.anchor_day == 31, "r2.5 admin copies period price and anchor")
$BODY = "id=" .. $admin_service.id .. "&customer_id=" .. $service.customer_id .. "&kind=subscription&label=ExampleAdminMonthly&plan_id=" .. $year_plan .. "&price=42&status=pending&payment_pref=bank&next_due=2026-01-31"
check(biz_services_main().status == 303, "r2.5 admin edits plan with explicit price")
$admin_service = test_query("SELECT * FROM services WHERE id=?1",[$admin_service.id])[0]
check($admin_service.period_months == 12 and $admin_service.price_cents == 4200, "r2.5 explicit price retained and period updated")
$BODY = "customer_id=" .. $service.customer_id .. "&kind=subscription&label=ExampleInvalidPlan&plan_id=&price=5&status=pending"
$invalid_admin = biz_services_main()
check(contains($invalid_admin.body,"requires a subscription plan"), "r2.5 no plan clear error")
check(length(test_query("SELECT id FROM services WHERE label='ExampleInvalidPlan'")) == 0, "r2.5 invalid service not saved")
$hosting_plan = test_query("SELECT id FROM plans WHERE kind='hosting' LIMIT 1")[0].id
check(not biz_subscription_plan("subscription",$hosting_plan).ok, "r2.5 hosting plan rejected for subscriptions")

-- r2.6: preserve an existing customer and its verified hosting card.
$TEST_PI_CUSTOMER = "cus_different"
check(test_checkout_event($failure_invoice,"failure").status == 200, "r2.6 mismatch still acknowledges money")
$kept_card = test_query("SELECT * FROM customers WHERE id=?1",[$failure_service.customer_id])[0]
check($kept_card.stripe_customer_id == "cus_example" and $kept_card.stripe_pm_id == "pm_example", "r2.6 mismatched customer never replaces ids")
check(test_query("SELECT auto_charge FROM services WHERE id=?1",[$failure_service.id])[0].auto_charge == 0, "r2.6 mismatched service auto charge off")
check(length(test_query("SELECT id FROM audit WHERE action='subscription_customer_mismatch' AND row_id=?1",[$failure_invoice])) == 1, "r2.6 mismatch audited")
$TEST_PI_CUSTOMER = "cus_example"
$TEST_PI_METHOD = "pm_new_subscription"
test_exec("UPDATE customers SET stripe_pm_id='pm_hosting',stripe_pm_status='verified' WHERE id=?1",[$failure_service.customer_id])
check(test_checkout_event($failure_invoice,"failure").status == 200, "r2.6 matching customer uses existing verified card")
check(test_query("SELECT stripe_pm_id FROM customers WHERE id=?1",[$failure_service.customer_id])[0].stripe_pm_id == "pm_hosting", "r2.6 hosting card preserved")
check(test_query("SELECT auto_charge FROM services WHERE id=?1",[$failure_service.id])[0].auto_charge == 1, "r2.6 matching stored customer enables auto charge")
$customer_proof = test_signup("customer-create@example.net",$plan_id)
sub_confirm($customer_proof)
$customer_invoice = test_invoice_for($customer_proof)
$calls_before = length($HTTP_CALLS)
$first_params = st_subscription_params($customer_invoice,[])
$second_params = st_subscription_params($customer_invoice,[])
check(length($HTTP_CALLS) == $calls_before + 1 and deep_eq($first_params,$second_params), "r2.6 stored customer avoids second create")
$first_create = $HTTP_CALLS[$calls_before]
test_exec("UPDATE customers SET stripe_customer_id='' WHERE id=(SELECT customer_id FROM invoices WHERE id=?1)",[$customer_invoice])
st_subscription_params($customer_invoice,[])
check($first_create.headers["Idempotency-Key"] == $HTTP_CALLS[$calls_before+1].headers["Idempotency-Key"], "r2.6 crash/concurrent empty reads share customer creation idempotency key")
check(not contains(join($first_params,"&"),"customer_creation"), "r2.6 always explicit customer")

-- r2.7: scanner GET never consumes proof or creates business records.
$scanner_proof = test_signup("scanner@example.net",$plan_id)
$before_invoices = length(test_query("SELECT id FROM invoices"))
$before_services = length(test_query("SELECT id FROM services"))
$before_customers = length(test_query("SELECT id FROM customers"))
$PATH = "/subscribe/confirm/" .. $scanner_proof
$METHOD = "GET"
$HEADERS = {}
$scanner_page = sub_main()
check($scanner_page.status == 200 and contains($scanner_page.body,"Confirm and continue to payment"), "r2.7 GET confirmation button")
check(sub_main().status == 200, "r2.7 repeated scanner GET harmless")
check(test_query("SELECT used_at FROM sub_signups WHERE token_sha256=?1",[hash_sha256($scanner_proof)])[0].used_at == nil, "r2.7 GET leaves proof unused")
check(length(test_query("SELECT id FROM invoices")) == $before_invoices and length(test_query("SELECT id FROM services")) == $before_services and length(test_query("SELECT id FROM customers")) == $before_customers, "r2.7 GET creates no invoice service or customer")
$METHOD = "POST"
$HEADERS = {origin: "https://example.net"}
check(sub_main().status == 403, "r2.7 foreign origin rejected")
$HEADERS = {origin: "https://example.com"}
check(sub_main().status == 303, "r2.7 same origin POST consumes proof")
$expiry_proof = test_signup("scanner-expired@example.net",$plan_id)
test_exec("UPDATE sub_signups SET expires_at='2000-01-01' WHERE token_sha256=?1",[hash_sha256($expiry_proof)])
$PATH = "/subscribe/confirm/" .. $expiry_proof
$METHOD = "GET"
check(sub_main().status == 410,"r2.7 GET expiry checked")
$METHOD = "POST"
check(sub_main().status == 410,"r2.7 POST expiry checked")

-- r2.8: unauthenticated pulls cannot spend the authenticated export budget.
test_exec("DELETE FROM rate_limits")
$HEADERS = {"x-sub-secret": "wrong"}
$attempt = 0
while $attempt < 125
  check(sub_export("example-plus").status == 401,"r2.8 bad secret rejected before rate bucket")
  $attempt = $attempt + 1
end
$HEADERS = {"x-sub-secret": "example-secret"}
check(sub_export("example-plus").status == 200,"r2.8 authentic export survives wrong secret flood")
$HEADERS = {}
$PATH = "/subscribe/example-plus"
$signup_count = length(test_query("SELECT id FROM sub_signups"))
$attempt = 0
while $attempt < 21
  $BODY = "email=domain" .. $attempt .. "%40example.com&plan_id=" .. $plan_id
  check(sub_main().status == 200,"r2.8 signup response uniform")
  $attempt = $attempt + 1
end
check(length(test_query("SELECT id FROM sub_signups")) == $signup_count + 20,"r2.8 domain capped at twenty")
test_exec("DELETE FROM rate_limits")
$signup_count = length(test_query("SELECT id FROM sub_signups"))
$attempt = 0
while $attempt < 4
  $BODY = "email=limited%40example.net&plan_id=" .. $plan_id
  sub_main()
  $attempt = $attempt + 1
end
check(length(test_query("SELECT id FROM sub_signups")) == $signup_count + 3,"r2.8 per email cap retained")
test_exec("DELETE FROM rate_limits")
$signup_count = length(test_query("SELECT id FROM sub_signups"))
$attempt = 0
while $attempt < 101
  $BODY = "email=global%40d" .. $attempt .. ".example.net&plan_id=" .. $plan_id
  sub_main()
  $attempt = $attempt + 1
end
check(length(test_query("SELECT id FROM sub_signups")) == $signup_count + 100,"r2.8 aggregate signup cap retained")

-- r2.9: guard the gate wiring; the gate also executes this entire harness.
check(contains(read_file("tools/ci.mix"),'run_step([$mix, "services/webd/vhosts/subscriptions_test.mix", $mix])'),"r2.9 lint gate runs subscription tests with selected Mix")

-- r2.10: default adds nothing; setting applies to ordinary and subscription invoices.
check(biz_setting("stripe_descriptor_suffix") == "","r2.10 descriptor default empty")
biz_setting_set("stripe_descriptor_suffix","EXAMPLE")
check(contains(join(st_subscription_params($annual_invoice,[]),"&"),"statement_descriptor_suffix%5D=EXAMPLE"),"r2.10 ordinary invoice descriptor")
check(contains(join(st_subscription_params($customer_invoice,[]),"&"),"statement_descriptor_suffix%5D=EXAMPLE"),"r2.10 subscription descriptor")
biz_setting_set("stripe_descriptor_suffix","")
check(not contains(join(st_subscription_params($annual_invoice,[]),"&"),"statement_descriptor_suffix"),"r2.10 empty descriptor omitted")
-- The recovery and settings surface retains admin/CSRF checks.
$PATH = "/biz/subscriptions"
$BODY = "action=reopen&invoice_id=" .. $late_invoice .. "&csrf=wrong"
check(biz_subscriptions_main().status == 403,"r2.2 reopen rejects invalid CSRF")
$SESSION = {authenticated: false}
check(biz_subscriptions_main().headers["Location"] == "/auth/login","r2.2 anonymous reopen denied")
$SESSION = {authenticated: true,email: "admin@example.net",kind: "staff"}
$BODY = "action=settings&csrf=test&sub_mail_mode=off&sub_grace_days=3&sub_pending_days=14&stripe_descriptor_suffix=EXAMPLE"
check(biz_subscriptions_main().status == 303 and biz_setting("stripe_descriptor_suffix") == "EXAMPLE", "r2.10 descriptor can be configured by admin")
print("subscription tests passed: original flow and all ten review regressions")
