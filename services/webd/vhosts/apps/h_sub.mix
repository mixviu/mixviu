-- Anonymous email proof, invoice checkout and secret-scoped entitlement export.
-- lint: ignore MIX-W2401
include (mix_path("prefix") .. "/vhosts/shared/apps/h_biz_pay.mix")

function sub_response($status, $body)
  return { status: $status, headers: { "Cache-Control": "no-store", "Referrer-Policy": "no-referrer",
           "Content-Type": "text/html; charset=utf-8" }, body: bp_page("Subscriptions", $body) }
end

function sub_pay($invoice_id)
  $rows = db_query("SELECT status, token FROM invoices WHERE id = ?1", [$invoice_id])
  if length($rows) == 0 then return sub_response(200, "<p>This link has been used.</p>") end
  if $rows[0].status == "draft" then
    $issued = biz_issue_invoice($invoice_id, biz_today(), "subscription")
    if not $issued.ok then return sub_response(503, "<p>Please retry this link.</p>") end
    $rows = db_query("SELECT status, token FROM invoices WHERE id = ?1", [$invoice_id])
  end
  if $rows[0].status == "open" then
    return { status: 303, headers: { "Location": "/pay/" .. $rows[0].token,
             "Cache-Control": "no-store", "Referrer-Policy": "no-referrer" }, body: "" }
  end
  return sub_response(200, "<p>This link has been used.</p>")
end

function sub_confirm($token)
  if length($token) != 64 or not bp_is_hex_token($token) then return sub_response(404, "<p>Invalid link.</p>") end
  $proof = db_query("SELECT expires_at FROM sub_signups WHERE token_sha256 = ?1", [hash_sha256($token)])
  if length($proof) == 0 then return sub_response(404, "<p>Invalid link.</p>") end
  if $proof[0].expires_at <= biz_now() then return sub_response(410, "<p>This link has expired.</p>") end
  if $METHOD == "GET" then
    return sub_response(200, '<form method="post"><button type="submit">Confirm and continue to payment</button></form>')
  end
  if $METHOD != "POST" then return sub_response(405, "POST only") end
  if $HEADERS["origin"] != nil and $HEADERS["origin"] != biz_base_url() then
    return sub_response(403, "Origin mismatch")
  end
  db_exec("BEGIN IMMEDIATE")
  try
    $rows = db_query("SELECT * FROM sub_signups WHERE token_sha256 = ?1", [hash_sha256($token)])
    if length($rows) == 0 then
      db_exec("ROLLBACK")
      return sub_response(404, "<p>Invalid link.</p>")
    end
    $signup = $rows[0]
    if $signup.expires_at <= biz_now() then
      db_exec("ROLLBACK")
      return sub_response(410, "<p>This link has expired.</p>")
    end
    if $signup.used_at != nil then
      db_exec("COMMIT")
      return sub_pay($signup.invoice_id)
    end
    $plans = db_query("SELECT * FROM plans WHERE id = ?1 AND active = 1 AND kind = 'subscription'
                       AND product != '' AND period_months IN (1,12) AND price_cents > 0", [$signup.plan_id])
    if length($plans) == 0 then
      db_exec("ROLLBACK")
      return sub_response(404, "<p>Plan unavailable.</p>")
    end
    $plan = $plans[0]
    db_exec("UPDATE sub_signups SET used_at = ?2 WHERE id = ?1", [$signup.id, biz_now()])
    $customers = db_query("SELECT id FROM customers WHERE email = ?1 COLLATE NOCASE AND status = 'active'
                           ORDER BY id LIMIT 1", [$signup.email])
    if length($customers) == 0 then
      db_exec("INSERT INTO customers (name,email,created,updated) VALUES (?1,?1,?2,?2)", [$signup.email, biz_now()])
      $customers = db_query("SELECT last_insert_rowid() AS id")
    end
    $customer_id = $customers[0].id
    $existing = db_query("SELECT s.id, s.status, s.next_due, s.plan_id FROM services s JOIN plans p ON p.id = s.plan_id
                          WHERE s.customer_id = ?1 AND s.kind = 'subscription' AND p.product = ?2
                          AND s.status IN ('active','pending','suspended') ORDER BY s.id LIMIT 1", [$customer_id, $plan.product])
    if length($existing) > 0 then
      if $existing[0].status == "active" then
        db_exec("COMMIT")
        return sub_response(200, "<p>paid up until " .. html_escape("" .. $existing[0].next_due) .. "</p>")
      end
      $open = db_query("SELECT i.id FROM invoices i JOIN invoice_items ii ON ii.invoice_id = i.id
                        WHERE ii.service_id = ?1 AND i.status IN ('open','draft') ORDER BY i.id LIMIT 1", [$existing[0].id])
      $replace_pending = $existing[0].status == "pending" and $existing[0].plan_id != $plan.id
      if $replace_pending then
        for each $invoice in $open
          $cancel = biz_cancel_invoice_locked($invoice.id, "subscription", "different plan selected", true)
          if not $cancel.ok then
            db_exec("ROLLBACK")
            return sub_response(409, "<p>Payment in progress. Please finish or retry later.</p>")
          end
        end
        db_exec("UPDATE services SET status = 'cancelled', updated = ?2 WHERE id = ?1", [$existing[0].id, biz_now()])
      else
        if length($open) > 0 then
          db_exec("UPDATE sub_signups SET invoice_id = ?2 WHERE id = ?1", [$signup.id, $open[0].id])
          db_exec("COMMIT")
          return sub_pay($open[0].id)
        end
        db_exec("COMMIT")
        return sub_response(200, "<p>" .. html_escape($existing[0].status) .. " — paid up until " .. html_escape("" .. $existing[0].next_due) .. "</p>")
      end
    end
    $today = biz_today()
    $anchor = to_number(substr($today, 8, 2))
    $period_end = biz_period_end($today, $plan.period_months, $anchor)
    db_exec("INSERT INTO services (customer_id,kind,label,plan_id,price_cents,period_months,status,next_due,created,updated,anchor_day)
             VALUES (?1,'subscription',?2,?3,?4,?5,'pending',?6,?7,?7,?8)",
            [$customer_id, $plan.name, $plan.id, $plan.price_cents, $plan.period_months, $today, biz_now(), $anchor])
    $service = db_query("SELECT last_insert_rowid() AS id")
    db_exec("INSERT INTO invoices (customer_id,status,created,updated) VALUES (?1,'draft',?2,?2)", [$customer_id, biz_now()])
    $invoice = db_query("SELECT last_insert_rowid() AS id")
    $invoice_id = $invoice[0].id
    db_exec("INSERT INTO invoice_items (invoice_id,service_id,description,amount_cents,period_start,period_end)
             VALUES (?1,?2,?3,?4,?5,?6)", [$invoice_id, $service[0].id, $plan.name, $plan.price_cents, $today, $period_end])
    db_exec("INSERT INTO renewal_keys (kind,ref_id,period_start,invoice_id) VALUES ('service',?1,?2,?3)",
            [$service[0].id, $today, $invoice_id])
    biz_recompute_draft($invoice_id)
    db_exec("UPDATE sub_signups SET invoice_id = ?2 WHERE id = ?1", [$signup.id, $invoice_id])
    db_exec("COMMIT")
  catch $e
    try db_exec("ROLLBACK") catch $rollback_error end
    return sub_response(503, "<p>Please retry this link.</p>")
  end
  return sub_pay($invoice_id)
end

function sub_export($product)
  $secret = biz_setting("sub_export_secret")
  if $secret == "" then return sub_response(404, "not found") end
  $header = ""
  if $HEADERS["x-sub-secret"] != nil then $header = "" .. $HEADERS["x-sub-secret"] end
  if not constant_time_eq($secret, $header) then return sub_response(401, "unauthorised") end
  if not bp_rate_ok("sub:export:authenticated", 120, 60) then return sub_response(429, "rate limited") end
  $rows = db_query("SELECT c.email, p.code AS plan_code, s.period_months, s.next_due AS paid_through, s.status
                    FROM services s JOIN plans p ON p.id = s.plan_id JOIN customers c ON c.id = s.customer_id
                    WHERE s.kind = 'subscription' AND p.product = ?1
                    AND (s.status = 'active' OR (s.status = 'suspended'
                         AND date(s.next_due, '+' || ?2 || ' days') >= ?3)) ORDER BY c.email, s.id",
                   [$product, biz_setting("sub_grace_days"), biz_today()])
  return { status: 200, headers: { "Content-Type": "application/json", "Cache-Control": "no-store" },
           body: json_encode({ product: $product, generated_at: biz_now(), subscribers: $rows }) }
end

function sub_main()
  cms_init()
  biz_init()
  $parts = split($PATH, "/")
  if length($parts) < 3 then return sub_response(404, "not found") end
  $product = $parts[2]
  if $METHOD == "GET" and $product == "entitlements" and length($parts) == 3 then
    $query = parse_form($QUERY)
    return sub_export("" .. ($query["product"] ?? ""))
  end
  if $product == "confirm" and length($parts) == 4 then
    if $METHOD == "POST" and not bp_rate_ok("sub:confirm", 120, 60) then return sub_response(429, "rate limited") end
    return sub_confirm($parts[3])
  end
  if length($parts) != 3 then return sub_response(404, "not found") end
  $plans = db_query("SELECT * FROM plans WHERE product = ?1 AND kind = 'subscription' AND active = 1
                     AND period_months IN (1,12) AND price_cents > 0 ORDER BY period_months, id", [$product])
  if length($plans) == 0 then return sub_response(404, "<p>Product not found.</p>") end
  if $METHOD == "POST" then
    $form = parse_form($BODY)
    $email = lower(trim("" .. ($form["email"] ?? "")))
    -- webd currently provides no trusted client IP: bound aggregate traffic as
    -- well as each email; never trust a visitor-supplied forwarding header.
    $global_ok = bp_rate_ok("sub:signup", 100, 3600)
    $email_ok = bp_rate_ok("sub:email:" .. hash_sha256($email), 3, 3600)
    $domain = split($email, "@")
    $domain_ok = false
    if length($domain) == 2 then
      $domain_ok = bp_rate_ok("sub:domain:" .. hash_sha256($domain[1]), 20, 3600)
    end
    $selected = nil
    for each $plan in $plans
      if to_number($form["plan_id"]) == $plan.id then $selected = $plan end
    end
    if $global_ok and $email_ok and $domain_ok and biz_is_plain_email($email) and $selected != nil then
      $token = biz_token()
      db_exec("INSERT INTO sub_signups (token_sha256,email,plan_id,expires_at,created)
               VALUES (?1,?2,?3,?4,?5)", [hash_sha256($token), $email, $selected.id, date_format(time() + 86400, "%Y-%m-%dT%H:%M:%S"), biz_now()])
      $url = replace(biz_invoice_url($token), "/invoice/", "/subscribe/confirm/")
      biz_mail_mode($email, biz_brand() .. " — confirm " .. $selected.name,
                    "Confirm your subscription to " .. $selected.name .. ":\n" .. $url .. "\nThis link expires in 24 hours.\n",
                    biz_setting("sub_mail_mode"))
    end
    return sub_response(200, "<p>Check your inbox for a confirmation link.</p>")
  end
  if $METHOD != "GET" then return sub_response(405, "GET or POST only") end
  $html = '<h1>' .. html_escape($product) .. '</h1><form method="post"><label>Email <input type="email" name="email" required></label><label>Plan <select name="plan_id">'
  for each $plan in $plans
    $period = "per year"
    if $plan.period_months == 1 then $period = "per month" end
    $html = $html .. '<option value="' .. $plan.id .. '">' .. html_escape($plan.name) .. ' — ' .. fmt_aud($plan.price_cents) .. ' ' .. $period .. '</option>'
  end
  return sub_response(200, $html .. '</select></label><button type="submit">Subscribe</button></form>')
end
