[Unit]
RequiresMountsFor=@{var}/webd @{run}/webd
Description=MixViu web service
Documentation=https://mixos.dev/webd/
After=network-online.target noded.service
Wants=network-online.target noded.service

[Service]
ReadWritePaths=@{var}/webd @{run}/webd
Environment=STATE_DIRECTORY=@{var}/webd
ExecStartPre=/usr/bin/mkdir -p @{run}/webd
ExecStartPre=/usr/bin/find @{run}/webd -mindepth 1 -delete
ExecStopPost=-/usr/bin/find @{run}/webd -mindepth 1 -delete
Type=simple
User=webd
Group=webd
WorkingDirectory=@{var}/webd
# Per-vhost content and mutable state live under /srv/<domain>/ (docroot,
# cms.db, uploads). ProtectSystem=strict makes everything outside the state
# directory read-only, so webd must be granted write access to /srv or every
# per-vhost cms.db write fails with "readonly database".
ReadWritePaths=/srv
# The database is pinned under the state directory. The default resolves to a
# root-owned parent that webd cannot write.
ExecStart=@{prefix}/bin/webd serve --db-path @{var}/webd/web.db
Restart=on-failure
RestartSec=5s
Environment=RUST_LOG=webd=info
Environment=HOME=@{var}/webd
# Node config is pinned so that listen address, TLS paths, the JMAP upstream
# and the noded URL come from the per-host config, not from fallbacks.
Environment=MIX_ETC=@{etc}
# Optional root:root 0600 source; systemd supplies webd a private copy.
# Probed webd.vhost-secrets with real systemd-run units on systemd 262:
# missing LoadCredential
# alone exits 243/CREDENTIALS; same-ID SetCredential succeeds when absent,
# and a present LoadCredential source overrides the fallback (cmp equal).
LoadCredential=webd.vhost-secrets:@{etc}/credstore/webd.vhost-secrets
SetCredential=webd.vhost-secrets:{vhost:[]}
# Journald is the sink. Stray stdout and stderr also go there, and the rate
# limit stops a crash loop from flooding the journal.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=webd
LogRateLimitIntervalSec=30s
LogRateLimitBurst=10000

# Webd binds the privileged HTTPS port (443). CAP_NET_BIND_SERVICE keeps the
# unit non-root. TLS keys are shared through the mixos-tls group, so the
# private key must be root:mixos-tls 0640 and both tls_cert and tls_key must
# be set in the node config. Without both, webd falls back to cleartext HTTP.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes

RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
UMask=0027

[Install]
WantedBy=multi-user.target
