$cli=require("startup-policy.mix")
fn check($ok,$why) if not $ok then raise("TEST",$why) end end
check($cli.decide([],"own-version","help\n").mode=="window","no flags select window")
check($cli.decide(["--headless"],"own-version","help\n").mode=="headless","headless selects no-window mode")
check($cli.decide(["--headless","--print-config"],"own-version","help\n").print_config,"print-config wins after valid flags")
for $args in [["--unknown"],["--print-config","--unknown"],["--headless","--unknown"],["--unknown","--version"],["--print-config","--version"]]
  $v=$cli.decide($args,"own-version","help\n")
  $bad=if $args[0]=="--unknown" then "--unknown" else $args[1] end
  check($v.mode=="exit" and $v.code==2 and $v.stdout=="" and $v.stderr=="term: unknown option "..$bad.." (see --help)\n","Gold unknown flag and ordering contract")
end
for $args in [["--unknown","--help"],["--help","--unknown"],["--unknown","-h"]]
  check(deep_eq($cli.decide($args,"own-version","help\n"),{mode:"exit",code:0,stdout:"help\n",stderr:""}),"help anywhere precedes invalid option refusal")
end
check(deep_eq($cli.decide(["--version","--unknown"],"own-version","help\n"),{mode:"exit",code:0,stdout:"own-version\n",stderr:""}),"leading version wins and reports own data")
$settings={font_px:18.5,scrollback:1000,cursor:"underline",TERM:"xterm-256color"}
check($cli.print_config($settings)=="{\n  \"font_px\": 18.5,\n  \"scrollback\": 1000,\n  \"cursor\": \"underline\",\n  \"TERM\": \"xterm-256color\"\n}\n","Gold print-config field order and formatting")
$settings.font_px=6
check(contains($cli.print_config($settings),'"font_px": 6.0,'),"integral native font sizes retain Gold's float formatting")
print("term startup policy: flag precedence, unknown refusals, own version and config formatting passed")
