-- version: 0.2.0
-- lint: globals app_args
$ctx=viu_context();$core=require("core.mix");$wire=require("wire.mix");$model=require("model.mix");$bus=require("bus.mix")
$native=fn($op,$handle,$args)=viu_terminal($op,$handle,$args)
$state={look:{appearance:{scheme:"studio",mode:"dark"},values:{}},closed:false,replies:[],watching:false,event_revision:0,zoom:0}
$state.layout=$model.open_tab($model.initial(),$native("create","",{}),nil)
$state.identity=$native("identity","",{})
$actions=require("actions.mix");$controls=require("controls.mix")
$state.version=$ctx.version;$state.build_line=$ctx.build_line;$state.choice={};$state.bindings={};$state.effective={};$state.pastes={}
$state.publishing=false;$state.event_job=0
fn pump_events($s)
  if $s.closed and not ($s.drain_expired ?? false) and ($s.publishing or len($s.layout.events)>0) then
    if not ($s.drain_close ?? false) then viu_timer("terminal-events-close",2000,{kind:"terminal-events-close"}) end
    $s.drain_close=true
  elif not $s.publishing and len($s.layout.events)==0 then $s.drain_close=false end
  if $s.publishing or len($s.layout.events)==0 then return $s end
  $s.event_job=$s.event_job+1
  $path=path_join(dirname(script_path()),"event-job.mix")
  send "viu-local" "jobs.start" id="terminal-events-"..to_string($s.event_job) owner={kind:"terminal-events"} path=$path source=read_file($path) command="events.publish" args={events:$s.layout.events}
  if $rc==0 then $s.publishing=true;$s.layout.events=[]
  else viu_timer("terminal-events-retry",500,{kind:"terminal-events"}) end
  return $s
end
fn publish_term($s)
  send "viu-local" "scenes.model" body={generation:$ctx.generation,value:$core.framed($s)}
end
fn command($s,$name,$args)
  $out=$bus.dispatch($s,$name,$args,$native)
  $out.state=pump_events($out.state);publish_term($out.state);reply($out.rc,$out.body)
  return $out.state
end
fn act($s,$id,$args,$origin)
  $out=$actions.invoke($bus.refresh($s,$native),$id,$args,$native);$s=$out.state
  for $effect in $out.effects
    if $effect.kind=="theme" then
      send "viu-local" "native.theme" body=$effect.choice
      if $rc==0 then $s.effective=$result end
    elif $effect.kind=="copy" and $effect.text!=nil then viu_platform("copy","terminal-copy",{text:$effect.text})
    elif $effect.kind=="paste" then
      if $effect.supplied then $done=$native("paste",$effect.handle,{text:$effect.text})
      else $token=uuid();$s.pastes[$token]=$effect.handle;viu_platform("paste",$token,{}) end
    elif $effect.kind=="font" then $s.font_unsaved=true end
  end
  if $out.rc==0 then
    $note={topic:"term.action.executed",body:viu_action_event($id,$origin,nil,nil)}
    if len($s.layout.events)>=256 then $s.layout.events=slice($s.layout.events,1) end
    $s.layout.events=push($s.layout.events,$note)
  end
  $s=pump_events($s);publish_term($s)
  return {state:$s,rc:$out.rc,body:$out.body}
end
publish_term($state)
on term.ping
  reply(0,json_encode({schema:"term.v1",version:$ctx.version}))
end
on viu.session
  $state.look.appearance=$event.args.appearance
  $state.settings_connected=not $event.args.state.lost and $event.args.state.incarnation!=nil and $event.args.state.error==nil
  if not $event.args.state.lost then $state.look.values=$event.args.state.values end
  publish_term($state)
end
on viu.keymap.changed
  send "viu-local" "native.bindings" body={defaults:$actions.binding_defaults(),overrides:$event.args}
  if $rc==0 then $state.bindings=$reply.bindings;publish_term($state) end
end
on viu.theme.changed
  $state.effective=$event.args;publish_term($state)
end
on viu.terminal.changed
  $old=$state.layout
  $state=$bus.refresh($state,$native)
  $exited=[]
  for $p in values($state.layout.panes) if $p.exited then push($exited,$p.id) end end
  for $id in $exited $state=$bus.close_removed($state,$model.close_pane($state.layout,$id),$native) end
  if not deep_eq($old,$state.layout) then $state=pump_events($state);publish_term($state) end
end
on viu.job.completed
  if $event.args.tag.owner.kind=="terminal-events" then $state.publishing=false;$state=pump_events($state);if $state.closed then publish_term($state) end end
end
on viu.timer
  if $event.args.value.kind=="terminal-events" then $state=pump_events($state) end
  if $event.args.value.kind=="terminal-events-close" then $state.drain_expired=true;$state.drain_close=false;publish_term($state) end
end
on viu.frame.close
  $state=pump_events($bus.shut($state,$native));publish_term($state)
end
on app.quit
  $state=pump_events($bus.shut($state,$native));publish_term($state);reply(0,"{}")
end
on viu.frame.intent
  $id=if $event.args.value.command=="close" then "app.quit" else $event.args.value.command end
  $out=act($state,$id,{},if $event.args.id=="gold-menu" then "menu" else "ui" end);$state=$out.state;reply($out.rc,json_encode($out.body))
end
on term.intent
  $a=$event.args
  if $a.id=="tabs" then
    $name=if $a.action=="close" then "term.tab.close" else "term.tab.select" end
    $state=command($state,$name,{id:to_number($a.value)})
  elif $a.id=="terminal" and $a.action=="focus" then
    for $p in values($state.layout.panes)
      if $p.handle==$a.value and $state.layout.tabs[$state.layout.active].active_pane!=$p.id then $state.layout=$model.select_pane($state.layout,$p.id);$state=pump_events($state);publish_term($state) end
    end
  elif $a.id=="terminal" and $a.action=="command" then $out=act($state,$a.value,{},"shortcut");$state=$out.state
  elif $a.id=="terminal" and $a.action=="clipboard" then
    $target=filter(values($state.layout.panes),fn($p)=$p.handle==$a.value.handle)
    if len($target)==1 then
      $kind=$a.value.kind
      if $kind!="cut" or $bus.target_handle($state,$bus.active($state))==$a.value.handle then
        $params={clipboard_handle:$a.value.handle}
        if $kind=="paste" then $params.paste_text=$a.value.text end
        $out=act($state,if $kind=="copy" then "edit.copy" elif $kind=="paste" then "edit.paste" else "pane.close" end,$params,"shortcut");$state=$out.state
      end
    end
  end
end
on term.execute
  if type($event.args)!="map" or type($event.args.id)!="string" then reply(10,json_encode({error_code:"INVALID_ARGUMENT",message:"term.execute needs {\"id\": <command id>}"}));return end
  $params={}
  for $key in ["tab","pane"] if $wire.whole_id($event.args[$key]) then $params[$key]=$event.args[$key] end end
  $out=act($state,$event.args.id,$params,"bus");$state=$out.state;reply($out.rc,json_encode($out.body))
end
on term.actions
  $state=$bus.refresh($state,$native)
  reply(0,json_encode({actions:$actions.registry($state),state:$actions.observed_state($state)}))
end
on term.dialog
  $out=$controls.dialog($state,$event.args);$state=$out.state;publish_term($state);reply($out.rc,json_encode($out.body))
end
on term.overlay
  $a=$event.args
  if $a.id=="term-macros" then $state.macros_open=false
  elif $a.id=="term-dialog" then $state.dialog=nil;$state.layout.focus_serial=$state.layout.focus_serial+1
  elif $a.id=="term-search" then
    $state.search_open=false
    if $a.action=="command" then $out=act($state,$a.value.command,{},"palette");$state=$out.state end
  end
  publish_term($state)
end
on viu.platform.completed
  $handle=$state.pastes[$event.args.id]
  if $handle!=nil then
    $state.pastes=delete($state.pastes,$event.args.id)
    if any(values($state.layout.panes),fn($p)=$p.handle==$handle) then
      try $result=viu_terminal("paste",$handle,{text:$event.args.text}) catch $message $state.notice=$message end
    end
  end
end
on term.tabs
  $state=command($state,"term.tabs",$event.args)
end
on term.panes
  $state=command($state,"term.panes",$event.args)
end
on term.tab.new
  $state=command($state,"term.tab.new",$event.args)
end
on term.tab.select
  $state=command($state,"term.tab.select",$event.args)
end
on term.tab.close
  $state=command($state,"term.tab.close",$event.args)
end
on term.tab.title
  $state=command($state,"term.tab.title",$event.args)
end
on term.tab.move
  $state=command($state,"term.tab.move",$event.args)
end
on term.pane.split
  $state=command($state,"term.pane.split",$event.args)
end
on term.pane.select
  $state=command($state,"term.pane.select",$event.args)
end
on term.pane.close
  $state=command($state,"term.pane.close",$event.args)
end
on term.snapshot
  $state=command($state,"term.snapshot",$event.args)
end
on term.type
  $state=command($state,"term.type",$event.args)
end
on term.scroll
  $state=command($state,"term.scroll",$event.args)
end
on term.props.watch
  $state=command($state,"term.props.watch",$event.args)
end
