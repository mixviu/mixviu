-- SPDX-License-Identifier: MIT OR Apache-2.0
$m=require("model.mix")
fn check($ok,$message)
  if not $ok then raise("TEST",$message) end
end
fn session($n) return {handle:"vt-"..to_string($n),pid:1000+$n} end
$s=$m.open_tab($m.initial(),session(1),nil)
check($s.tabs[0].id==1 and $s.tabs[0].active_pane==1,"first tab and pane")
$s=$m.split_pane($s,"v",session(2));$s=$m.split_pane($s,"h",session(3))
check(deep_eq($m.leaves($s.tabs[0].tree),[1,2,3]),"split traversal")
$out=$m.close_pane($s,3);$s=$out.state
check($s.tabs[0].active_pane==2 and deep_eq($out.removed,["vt-3"]),"closest sibling receives focus")
$s=$m.open_tab($s,session(4),"Pinned");$active=$s.tabs[$s.active].id;$revision=$s.revision
$r=$m.resolve($s,2,nil)
check($r.tab==1 and $r.pane==2 and $s.tabs[$s.active].id==$active,"explicit pane does not change focus")
$refused=false
try $r=$m.resolve($s,2,$active) catch $message $refused=$message=="invalid-argument: pane does not belong to tab" end
check($refused,"pane and tab must agree")
check($m.surface_tree($s,$s.tabs[0].tree).second=="vt-2","Mix supplies native composition without policy in Rust")
$s=$m.move_tab($s,1,100)
check($s.tabs[$s.active].id==$active and $s.revision==$revision+1,"reorder preserves focus and advances gold layout revision")
$s=$m.select_tab($s,1);$s=$m.select_pane($s,1)
check($s.tabs[$s.active].active_pane==1,"focus an existing pane")
$out=$m.close_pane($s,1);$s=$out.state
check($s.tabs[$s.active].active_pane==2,"focus sibling when first leaf closes")
$out=$m.close_pane($s,2);$s=$out.state
check(len($s.tabs)==1 and not $s.closing,"last pane closes its tab")
$out=$m.close_tab($s,$s.tabs[0].id);$s=$out.state
check($s.closing and len($s.tabs)==0 and len(keys($s.panes))==0,"last tab closes application")
check($m.sanitise_title("a\n\r\t\e\u{85}\u{2028}\u{2029}b")=="ab","gold strips controls and line separators")
check($m.sanitise_title(repeat("𝐀",100))==repeat("𝐀",64),"title bound is UTF-8 bytes")
$s=$m.open_tab($m.initial(),session(1),nil);$s=$m.open_tab($s,session(2),nil);$s=$m.open_tab($s,session(3),nil)
$s=$m.select_tab($s,2);$s=$m.close_tab($s,2).state
check($s.tabs[$s.active].id==3,"closing middle active tab selects its following neighbour")
$s=$m.open_tab($m.initial(),session(1),nil)
for $i=2 to 32 $s=$m.split_pane($s,"v",session($i)) end
$refused=false
try $s=$m.open_tab($s,session(33),nil) catch $message $refused=$message=="tab limit (32) reached" end
check($refused and len(keys($s.panes))==32,"gold 32-slot cap spans panes and tabs")
print("term model: tab/pane lifecycle and cap checks passed")

-- Event order is independent of layout revisions and never blocks a mutation.
$s=$m.open_tab($m.initial(),session(1),nil)
check($s.event_revision==4 and len($s.events)==0,"unwatched changes advance sequence without accumulating")
$s.watching=true
$s=$m.split_pane($s,"v",session(2))
check(deep_eq(map($s.events,fn($e)=$e.body.kind),["added","selected"]),"split event order")
check(deep_eq(map($s.events,fn($e)=$e.body.revision),[5,6]),"separate monotonic event revision")
$s.events=[];$revision=$s.revision
$s=$m.set_title($s,1,"pin")
check($s.revision==$revision and deep_eq(map($s.events,fn($e)=$e.topic),["term.tabs.changed","term.title.changed"]),"retitle events preserve layout revision")
$s.events=[];$s=$m.select_pane($s,1);$s.events=[]
$s=$m.close_pane($s,2).state
check(len($s.events)==1 and $s.events[0].body.kind=="removed","closing unfocused pane does not emit selection")
$s.events=[];$s=$m.open_tab($s,session(3),nil);$s.events=[]
$s=$m.close_tab($s,2).state
check(deep_eq(map($s.events,fn($e)=$e.topic..":"..$e.body.kind),["term.pane.changed:removed","term.tabs.changed:removed","term.tabs.changed:selected","term.pane.changed:selected"]),"active tab close selects survivor after removal")
$s.events=[];$first=$s.event_revision
for $i=1 to 300 $s=$m.changed($s,"pane.changed",1,1,"resized") end
check(len($s.events)==256 and $s.event_revision==$first+300,"bounded best effort publication leaves detectable gaps")
print("term model: ordered change topics and bounded queue checks passed")
