#!/opt/mix/bin/mix
-- SPDX-License-Identifier: MIT OR Apache-2.0
-- version: 0.1.0
-- Install as /opt/mix/bin/term; use the apps.tar shared bundle layout.
$r = run_argv(concat(["/opt/mix/bin/viu", "run", "/opt/mix/share/mixviu/apps/term",
  "--service", "term", "--app-id", "mixviu.term", "--title", "Term"], args()),
  {timeout: 0, stdout: "inherit", stderr: "inherit"})
exit($r.exit_code ?? 1)
