#!/opt/mix/bin/mix
-- SPDX-License-Identifier: MIT OR Apache-2.0
-- version: 0.2.0
-- Install as /opt/mix/bin/term; use the apps.tar shared bundle layout.
exec_argv(concat(["/opt/mix/bin/viu", "run", "/opt/mix/share/mixviu/apps/term",
  "--service", "term", "--app-id", "mixviu.term", "--title", "Term"], args()))
