$a=require("actions.mix");$m=require("model.mix")
$controls=require("controls.mix")
fn check($ok,$message) if not $ok then raise("TEST",$message) end end
fn native($op,$handle,$args)
  if $op=="font-size" then return $args.base+$args.steps*2/3 end
  if $op=="create" then return {handle:"vt-2",pid:12} end
  if $op=="state" then return {title:"",pid:11,cols:80,rows:24,geometry:{x:0,y:0,w:0,h:0}} end
  return nil
end
$n=fn($op,$handle,$args)=native($op,$handle,$args)
$s={layout:$m.open_tab($m.initial(),{handle:"vt-1",pid:11},nil),closed:false,look:{values:{},appearance:{mode:"dark"}},choice:{},bindings:{},effective:{},zoom:0,replies:[]}
check(len($a.registry($s))==61,"complete pinned registry")
check(not any($a.terminal_shortcuts($s),fn($key)=$key.key=="Tab" and not $key.ctrl and not $key.alt),"single-pane Tab stays with the shell")
check(any($a.terminal_shortcuts($s),fn($key)=$key.command=="tab.new" and $key.ctrl and $key.shift and $key.key=="T"),"terminal widget receives default command chords")
check(deep_eq(map($a.menus($s),fn($v)=$v.label),["File","Edit","View","Pane","Tabs","Help"]),"gold menu order")
check($a.invoke($s,"pane.next",{},$n).body.error_code=="DISABLED","pane cycling requires a split")
$out=$a.invoke($s,"pane.split_right",{},$n);$s=$out.state
check(len($m.leaves($s.layout.tabs[0].tree))==2,"action follows real pane split path")
$out=$a.invoke($s,"pane.focus_left",{},$n);$s=$out.state
check($s.layout.tabs[0].active_pane==1,"directional focus before first layout uses tree geometry")
$out=$a.invoke($s,"view.zoom_in",{},$n);$s=$out.state
check(abs($s.zoom-2/3)<0.000001,"gold half-point zoom step")
$out=$a.invoke($s,"view.zoom_out",{},$n)
check($out.state.zoom==0,"zoom roundtrip exact")
$out=$a.invoke($s,"view.theme.ocean",{},$n)
check($out.state.choice.scheme=="ocean" and $out.effects[0].kind=="theme","local theme effect")
check($a.invoke($s,"absent",{},$n).body.error_code=="UNKNOWN_ACTION","unknown action refuses")
check($a.toolbar($s)[0].id=="help.macros" and len($a.toolbar($s))==4,"gold standard action tail")
$paste=$a.invoke($s,"edit.paste",{clipboard_handle:"vt-1",paste_text:"wide: 中\n"},$n)
check($paste.effects[0].handle=="vt-1" and $paste.effects[0].supplied and $paste.effects[0].text=="wide: 中\n","platform paste carries already-read text and captured native owner")
$paste=$a.invoke($s,"edit.paste",{},$n)
check(not $paste.effects[0].supplied,"menu paste still requests native clipboard read")
$rebound=$s;$rebound.bindings={"tab.new":{shortcut:"F2",keys:["F2","Ctrl+N"]},"edit.copy":{shortcut:nil,keys:[]}}
check(deep_eq(filter($a.terminal_shortcuts($rebound),fn($key)=$key.command=="tab.new"),[{command:"tab.new",key:"F2",ctrl:false,shift:false,alt:false,enabled:true,repeat:false,normal_screen_only:false},{command:"tab.new",key:"N",ctrl:true,shift:false,alt:false,enabled:true,repeat:false,normal_screen_only:false}]),"all resolved live key bindings reach terminal input")
check(any($a.terminal_shortcuts($s),fn($key)=$key.command=="view.zoom_reset" and $key.repeat),"gold font actions repeat")
check(any($a.terminal_shortcuts($s),fn($key)=starts_with($key.command,"scroll.") and $key.repeat and $key.normal_screen_only),"scrollback chords belong to normal screen")
check(any($a.terminal_shortcuts($s),fn($key)=$key.command=="pane.next" and $key.key=="Tab" and not $key.ctrl and not $key.repeat),"plain Tab cycles a split without autorepeat")
check(len(filter($a.terminal_shortcuts($rebound),fn($key)=$key.command=="edit.copy"))==0,"unbound command has no stale terminal chord")
$s.layout.panes["1"]=merge($s.layout.panes["1"],{cols:49,rows:23,geometry:{x:0,y:70,w:450,h:490},cell:[9,20],font_px:14.667,scale:1.25})
$s.layout.panes["2"]=merge($s.layout.panes["2"],{cols:49,rows:23,geometry:{x:450,y:70,w:450,h:490},cell:[9,20],font_px:14.667,scale:1.25})
$observed=$a.observed_state($s)
check(deep_eq($observed.cell,[9,20]) and $observed.scale==1.25 and $observed.font_px==14.667,"action readback carries measured raster metrics")
check(deep_eq($observed.panes,[{id:1,focused:true,grid:[49,23],rect:[0,70,450,490]},{id:2,focused:false,grid:[49,23],rect:[450,70,450,490]}]),"action pane readback preserves native geometry and tree order")
$out=$controls.dialog($s,{open:"keys"});check($out.rc==0 and $out.body.dialog.kind=="keys","Bus opens keyboard dialog")
$overlays=$controls.overlays($out.state,"test")
check(len($overlays[len($overlays)-1].definition.initial.grid)>0,"keyboard dialog includes the bound command rows")
check($controls.dialog($out.state,{open:"about"}).body.error_code=="DIALOG_OPEN","second dialog refuses")
$out=$controls.dialog($out.state,{answer:"done"});check($out.state.dialog==nil,"dialog answer closes")
check($controls.dialog($out.state,{answer:"done"}).body.error_code=="NO_DIALOG","closed dialog refuses late answer")
$about=$s;$about.build_line="viu 0.1.2 (example-sha, built example-time)";$about.settings_connected=true
check($controls.about_text($about,"fallback")=="Terminal\nviu 0.1.2 (example-sha, built example-time)\nThe MixOS terminal.\nMIT OR Apache-2.0\nSettings source: settingsd connected","About preserves own build provenance and gold line order")
$about.settings_connected=false
check(ends_with($controls.about_text($about,"fallback"),"settingsd not connected"),"About follows settings source loss")
print("term actions: catalogue, menus, targets, directional focus, theme and zoom checked")
