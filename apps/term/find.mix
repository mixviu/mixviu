-- Terminal history search policy. Native storage owns cells and matching.
fn initial()
  return {open:false,pattern:"",replacement:"",replace:false,regex:false,case:true,request:0,instance:0,handle:nil,origin:nil,backwards:false,result:nil}
end
fn active_handle($s)
  $tab=$s.layout.tabs[$s.layout.active]
  return if $tab==nil then nil else $s.layout.panes[to_string($tab.active_pane)].handle end
end
fn sync($s)
  if $s.find==nil then $s.find=initial() end
  if $s.closed or $s.find.handle!=active_handle($s) then $s.find.open=false;$s.find.result=nil;$s.find.handle=nil end
  return $s
end
fn start($s,$native)
  $s=sync($s);$handle=active_handle($s)
  if $s.closed or $handle==nil then return $s end
  $s.find.open=true;$s.find.handle=$handle;$s.find.instance=$s.find.instance+1
  return restart($s,$native)
end
fn restart($s,$native)
  $s.find.request=$s.find.request+1;$s.find.result=nil;$s.find.backwards=false;$s.find.boundary_wrapped=false;$s.find.recovered=nil
  $g=$native("state",$s.find.handle,{})
  $s.find.origin={row:-$g.display_offset,col:0}
  return $s
end
fn request($s)
  if $s.find==nil or not $s.find.open or $s.find.pattern=="" then return nil end
  return {handle:$s.find.handle,query:$s.find.pattern,regex:$s.find.regex,case_sensitive:$s.find.case,origin:$s.find.origin,backwards:$s.find.backwards,max_lines:10000,request:$s.find.request}
end
fn intent($s,$a,$native)
  $s=sync($s)
  if $a.action=="submit" then $a.action=if $a.value.shift then "prev" else "next" end end
  if not $s.find.open then return $s end
  if $a.action=="close" then
    $s.find.open=false;$s.find.result=nil;$s.layout.focus_serial=$s.layout.focus_serial+1
  elif $a.action=="edit" then
    if type($a.value.pattern)!="string" or type($a.value.regex)!="bool" or type($a.value.case)!="bool" then return $s end
    $s.find.pattern=$a.value.pattern;$s.find.regex=$a.value.regex;$s.find.case=$a.value.case
    $s=restart($s,$native)
  elif contains(["next","prev"],$a.action) and $s.find.pattern!="" then
    $s.find.boundary_wrapped=false
    $back=$a.action=="prev";$result=$s.find.result ?? {};$match=$result.matched ?? {}
    $g=$native("state",$s.find.handle,{});$scroll=$native("scroll",$s.find.handle,{lines:0})
    $point=if $back then $match.start else $match.end end
    if $point==nil then $s.find.origin={row:-$g.display_offset,col:if $back then $g.cols-1 else 0 end}
    else
      $row=$point.row;$col=$point.col+if $back then -1 else 1 end
      if $col<0 then $row=$row-1;$col=$g.cols-1
      elif $col>=$g.cols then $row=$row+1;$col=0 end
      if $row<-$scroll.history_size then $row=$g.rows-1;$col=$g.cols-1;$s.find.boundary_wrapped=true
      elif $row>=$g.rows then $row=-$scroll.history_size;$col=0;$s.find.boundary_wrapped=true end
      $s.find.origin={row:$row,col:$col}
    end
    $s.find.request=$s.find.request+1;$s.find.result=nil;$s.find.backwards=$back
  end
  return $s
end
fn observed($s,$v,$native)
  $s=sync($s)
  if not $s.find.open or $v.handle!=$s.find.handle or $v.request!=$s.find.request then return $s end
  $s.find.result=$v
  if $v.error=="search origin is outside the retained grid" and $s.find.recovered!=$s.find.request then
    $s=restart($s,$native);$s.find.recovered=$s.find.request
    return $s
  end
  if $v.error!=nil then return $s end
  $s.find.result.wrapped=$v.wrapped or ($s.find.boundary_wrapped ?? false)
  -- Reveal once for this user request. Output changes and manual scrolling
  -- continue to update matches without repeatedly taking over the viewport.
  if $v.matched!=nil and $s.find.revealed!=$s.find.request then
    $s.find.revealed=$s.find.request
    $g=$native("state",$s.find.handle,{})
    $row=$v.matched.start.row;$top=-$g.display_offset;$bottom=$top+$g.rows-1
    if $row<$top or $row>$bottom then
      $target=max(0,-$row)
      $moved=$native("scroll",$s.find.handle,{lines:$target-$g.display_offset})
    end
  end
  return $s
end
fn message($s)
  $v=$s.find.result
  if $s.find.pattern=="" then return "Search terminal output · Ctrl+Shift+F · Enter next · Shift+Enter previous" end
  if $v==nil then return "Searching…" end
  if $v.error!=nil then return $v.error end
  if $v.matched==nil then return if $v.limited then "No match in the search window (10,000 lines)" else "No matches" end end
  return (if $v.wrapped then "Wrapped · " else "" end).."Match at row "..to_string($v.matched.start.row)..", column "..to_string($v.matched.start.col+1)..(if $v.limited then " · Search limited to 10,000 lines" else "" end)
end
