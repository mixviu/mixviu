-- Gold maild CalendarEvent and JSContact policy; no independent transport.
$p=require("protocol.mix");$arg=require("arguments.mix");$identity=require("identity.mix")
fn calendars($rows)
  return jq($rows,'map({id,name,color:(.color // null),description:(.description // null),isVisible:(if has("isVisible") then .isVisible else null end),sortOrder:(.sortOrder // 0)})')
end
fn books($rows)
  return jq($rows,'map({id,name,description:(.description // null),sortOrder:(.sortOrder // 0)})')
end
fn events($rows)
  return jq($rows,'map({id,calendarId,uid:(.uid // null),data:(.data // null),title:(.title // null),start:(.start // null),end:(.end // null),updated:(.updated // null)})')
end
fn starts_at($event)
  try return date_parse($event.start) catch $invalid return -62135596800 end
end
fn contacts($rows)
  return jq($rows,'map({id,addressBookId,uid:(.uid // null),data:(.data // null),full_name:(.full_name // null),email:(.email // null),company:(.company // null),phone:(.phone // null),updated:(.updated // null)})')
end
fn numbered($values,$prefix,$field)
  $map={};$i=0
  for $v in $values
    if trim($v)!="" then
      $i=$i+1;$entry={};$entry[$field]=trim($v);$map[$prefix..to_string($i)]=$entry
    end
  end
  return $map
end
fn contact_patch($a,$create)
  $out={}
  if $create or contains(keys($a),"name") then $out.name={full:if $create then $arg.required($a,"name") else $arg.text($a,"name") end} end
  for $spec in [{key:"emails",prefix:"e",field:"address"},{key:"phones",prefix:"p",field:"number"}]
    $values=$arg.list($a,$spec.key)
    if $values!=nil then
      $v=numbered($values,$spec.prefix,$spec.field)
      if len(keys($v))>0 then $out[$spec.key]=$v elif not $create then $out[$spec.key]=nil end
    end
  end
  $org=$arg.text($a,"org")
  if $org!=nil then
    if trim($org)!="" then $out.organizations={o1:{name:trim($org)}} elif not $create then $out.organizations=nil end
  end
  $notes=$arg.text($a,"notes")
  if $notes!=nil then
    if trim($notes)!="" then $out.notes=trim($notes) elif not $create then $out.notes=nil end
  end
  return $out
end
fn event_patch($a,$create)
  $out={};$start=$arg.text($a,"start");$end=$arg.text($a,"end");$duration=$arg.text($a,"duration")
  if $create then $out.title=$arg.required($a,"title");$start=$arg.required($a,"start")
  elif $arg.text($a,"title")!=nil then $out.title=$a.title end
  if $end==nil and $duration!=nil then
    if $start==nil then raise("INVALID_ARGUMENT","duration needs start") end
    $end=$arg.end_after($start,$duration)
  end
  if $create and $end==nil then raise("INVALID_ARGUMENT","end or duration is required") end
  if $start!=nil then $out.start=$arg.instant($start) end
  if $end!=nil then $out.end=$arg.instant($end) end
  if $create then
    $seconds=floor(date_parse($out.end)-date_parse($out.start))
    if $seconds<0 then raise("SERVER","The end is before the start") end
    $days=floor($seconds/86400);$hours=floor(($seconds%86400)/3600);$minutes=floor(($seconds%3600)/60);$rest=$seconds%60
    $out.duration="P"..(if $days>0 then to_string($days).."D" else "" end)
    if $hours>0 or $minutes>0 or $rest>0 then $out.duration=$out.duration.."T"..(if $hours>0 then to_string($hours).."H" else "" end)..(if $minutes>0 then to_string($minutes).."M" else "" end)..(if $rest>0 then to_string($rest).."S" else "" end) end
    if $out.duration=="P" then $out.duration="PT0S" end
  end
  for $field in [{from:"time_zone",to:"timeZone"},{from:"description",to:"description"},{from:"location",to:"locations"}]
    $v=$arg.text($a,$field.from)
    if $v!=nil then
      $v=trim($v)
      if $v!="" then $out[$field.to]=if $field.from=="location" then {l1:{"@type":"Location",name:$v}} else $v end
      elif not $create then $out[$field.to]=nil end
    end
  end
  $all_day=$arg.flag($a,"all_day")
  if $create or $all_day!=nil then $out.showWithoutTime=$all_day ?? false end
  return $out
end
fn dispatch($e,$s,$command,$a)
  if $command=="email.calendars" then return {calendars:calendars($p.call($e,$s,"Calendar/get",{}).list)} end
  if $command=="email.books" then return {books:books($p.call($e,$s,"AddressBook/get",{}).list)} end
  $event=starts_with($command,"email.event") or $command=="email.events";$kind=if $event then "CalendarEvent" else "Contact" end
  if $command=="email.events" or $command=="email.contacts" then
    $filter={};$query={filter:$filter,limit:500}
    if $event then
      $query.filter.calendarId=$arg.required($a,"calendar")
      if $arg.text($a,"from")!=nil then $query.filter.after=$arg.instant($a.from) end
      if $arg.text($a,"to")!=nil then $query.filter.before=$arg.instant($a.to) end
    else
      $query.filter.addressBookId=$arg.required($a,"book");$text=trim($arg.text($a,"filter") ?? "")
      if $text!="" then $query.filter.text=$text end
      $query.sort=[{property:"fullName",isAscending:true}]
    end
    $list=$p.chained($e,$s,$kind,$query).get.list
    if $event then return {events:reverse(sort_by(events($list),fn($e)=starts_at($e)))} end
    return {contacts:contacts($list)}
  end
  if ends_with($command,".get") then
    $id=$arg.required($a,"id");$list=$p.call($e,$s,$kind.."/get",{ids:[$id]}).list
    if len($list)==0 then raise("NOT_FOUND",(if $event then "event " else "contact " end)..json_encode($id).." is gone") end
    return if $event then events($list)[0] else contacts($list)[0] end
  end
  $create=ends_with($command,".create");$destroy=ends_with($command,".delete");$id=if $create then "c0" else $arg.required($a,"id") end
  if $create then
    $parent=$arg.required($a,if $event then "calendar" else "book" end)
    if not re_match($parent,"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$") then raise("SERVER","The parent must be a UUID") end
  end
  $request={}
  if $destroy then $request.destroy=[$id]
  else
    $patch=if $event then event_patch($a,$create) else contact_patch($a,$create) end
    if not $create and len(keys($patch))==0 then raise("INVALID_ARGUMENT","nothing to change") end
    if $create then
      $patch["@type"]=if $event then "Event" else "Card" end;$patch.uid=$identity.mint();$patch[if $event then "calendarId" else "addressBookId" end]=$parent;$request.create={c0:$patch}
    else $request.update={};$request.update[$id]=$patch end
  end
  $r=$p.call($e,$s,$kind.."/set",$request)
  $error=if $create then ($r.notCreated ?? {})[$id] elif $destroy then ($r.notDestroyed ?? {})[$id] else ($r.notUpdated ?? {})[$id] end
  if $error!=nil then raise(if $error.type=="notFound" then "NOT_FOUND" else "SERVER" end,to_string($error.type)..": "..to_string($error.description ?? "")) end
  if $create then
    if $r.created.c0.id==nil then raise("SERVER","Create was not confirmed") end
    return {id:$r.created.c0.id}
  end
  if $destroy and not contains($r.destroyed ?? [],$id) then raise("SERVER","Delete was not confirmed") end
  if not $destroy and not contains(keys($r.updated ?? {}),$id) then raise("SERVER","Update was not confirmed") end
  return {id:$id}
end
