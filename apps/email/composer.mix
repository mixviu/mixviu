-- SPDX-License-Identifier: MIT OR Apache-2.0
-- All composers belong to this interpreter. Native viewports only draw them.
$composers={};$compose_serial=0;$compose_focused=nil
$compose_addresses=require("addresses.mix");$compose_sending=require("sending.mix");$compose_ids=require("identity.mix")
$compose_frame=require("../../libraries/viu/mix/gold-frame.mix")
$compose_scene=read_file(path_join(dirname(script_path()),"composer-scene.mix"))
fn composer_info($c)
  return {account:$c.account,from:$c.from,to:$c.to,cc:$c.cc,bcc:$c.bcc,reply_to:$c.reply_to,subject:$c.subject,body:$c.body,attachments:$c.attachments,busy:$c.busy,error:$c.error}
end
fn composer_snapshot($info,$window=nil)
  $info.compose_windows=map(keys($composers),fn($key)={window:$key,root:false,compose:composer_info($composers[$key])})
  $key=$window ?? $compose_focused;$c=$composers[$key]
  if $c!=nil then $info.window=$key;$info.compose=composer_info($c);$info.confirm=if $c.confirm then "close_compose" else nil end end
  return $info
end
fn composer_open($a)
  global $composers,$compose_serial,$compose_focused
  try
    $id=$a.account ?? $mail_settings.default_account ?? $active;$e=wire_entry($id)
    if $e==nil then return wire_refuse("UNKNOWN_ACCOUNT","No account is selected") end
    $sender=$compose_sending.identity($e,$a.from)
    $compose_serial=$compose_serial+1;$key="compose-"..to_string($compose_serial)
    $c={account:$id,identity:$sender.id,from:$sender.address,from_name:$sender.name,to:join(map($compose_addresses.field($a,"to"),fn($v)=$compose_addresses.format($v)),", "),cc:join(map($compose_addresses.field($a,"cc"),fn($v)=$compose_addresses.format($v)),", "),bcc:join(map($compose_addresses.field($a,"bcc"),fn($v)=$compose_addresses.format($v)),", "),reply_to:$a.reply_to ?? $sender.reply_to,subject:$a.subject ?? "",body:$a.body ?? (if $sender.signature!="" then "\n\n-- \n"..$sender.signature else "" end),attachments:$a.attachments ?? [],in_reply_to:$a.in_reply_to,references:$a.references ?? [],busy:false,error:nil,attempt:{},confirm:false,show_cc:$a.cc!=nil,show_bcc:$a.bcc!=nil,show_reply_to:$a.reply_to!=nil,chooser:false,revision:0,draft_id:replace($compose_ids.mint(),"-","")}
    $composers[$key]=$c;$compose_focused=$key
    return {rc:0,body:{window:$key,compose:composer_info($c)}}
  catch $message,$error return wire_refuse($error.code,$message) end
end
fn composer_save($key)
  $c=$composers[$key];$dir=path_join(viu_app_dirs("email").state,"drafts");viu_private_directory($dir)
  $path=path_join($dir,$c.draft_id..".json");$old=viu_read_optional($path)
  if $old.found then
    try $old=json_parse($old.text) catch $bad raise("DRAFT","Unreadable draft was left untouched") end
    if $old.schema_version!=1 or $old.id!=$c.draft_id then raise("DRAFT","Unsupported draft was left untouched") end
  end
  $saved={schema_version:1,id:$c.draft_id,account:$c.account,from:$c.from,from_name:$c.from_name,identity:$c.identity,to:$c.to,cc:$c.cc,bcc:$c.bcc,reply_to:$c.reply_to,subject:$c.subject,body:$c.body,attachments:$c.attachments,in_reply_to:$c.in_reply_to,references:$c.references,saved_at:date_format(time(),"%Y-%m-%dT%H:%M:%SZ",{utc:true}),attempt:$c.attempt}
  viu_atomic_replace($path,json_encode($saved))
end
fn composer_close($key,$answer=nil)
  global $composers
  $c=$composers[$key]
  if $c==nil then return wire_refuse("NOT_FOUND","No compose is open") end
  if $c.busy then return wire_refuse("BUSY","Sending…") end
  if $answer==nil then $composers[$key].confirm=true;return {rc:0,body:{}} end
  if $answer=="cancel" then $composers[$key].confirm=false;return {rc:0,body:{}} end
  if $answer=="keep" then composer_save($key)
  elif $answer=="discard" then
    $path=path_join(viu_app_dirs("email").state,"drafts/"..$c.draft_id..".json")
    if exists($path) then viu_files("remove",{path:$path}) end
  else return wire_refuse("INVALID_ARGUMENT","Unknown draft answer") end
  $composers=delete($composers,$key);return {rc:0,body:{}}
end
fn composer_intent($a)
  global $composers
  $key=$a.window ?? $compose_focused;$c=$composers[$key]
  if $c==nil then return wire_refuse("NOT_FOUND","No compose is open") end
  if $c.busy then return wire_refuse("BUSY","Sending…") end
  if $a.id=="compose-confirm" then return composer_close($key,$a.value) end
  if $a.id=="compose-body" then $composers[$key].body=$a.value
  elif $a.id=="compose-headers" then
    if $a.action=="edit" then for $field in keys($a.value) if contains(["to","cc","bcc","reply_to","subject"],$field) then $composers[$key][$field]=$a.value[$field] end end
    elif $a.action=="command" then
      if $a.value=="attach" then $composers[$key].chooser=true
      elif contains(["show_cc","show_bcc","show_reply_to"],$a.value) then $composers[$key][$a.value]=not $c[$a.value] end
    elif $a.action=="picked" then $composers[$key].attachments=unique(concat($c.attachments,$a.value));$composers[$key].chooser=false
    elif $a.action=="cancel" then $composers[$key].chooser=false
    elif $a.action=="remove" then $composers[$key].attachments=filter($c.attachments,fn($p)=$p!=$c.attachments[$a.value]) end
  end
  $composers[$key].revision=$c.revision+1
  composer_save($key)
  return {rc:0,body:{}}
end
fn composer_command($key,$id)
  global $composers
  if $id=="file.close" or $id=="compose.close" then return composer_close($key) end
  if $id=="mail.send" then
    $c=$composers[$key]
    if $c==nil then return wire_refuse("NOT_FOUND","No compose is open") end
    if $c.busy then return wire_refuse("BUSY","Sending…") end
    $args=merge($c,{window:$key})
    $r=wire_start("email.send",$args,nil,"compose-send")
    if $r.rc==0 then $composers[$key].busy=true;$composers[$key].error=nil end
    return $r
  end
  return wire_refuse("UNKNOWN_ACTION","No such command")
end
fn composer_models($m)
  $m.native_windows=[]
  for $key in keys($composers)
    $c=$composers[$key];$fields=[]
    for $f in [{id:"from",label:"From",value:$c.from_name.." <"..$c.from..">",read_only:true,visible:true},{id:"to",label:"To",value:$c.to,visible:true},{id:"cc",label:"Cc",value:$c.cc,visible:$c.show_cc},{id:"bcc",label:"Bcc",value:$c.bcc,visible:$c.show_bcc},{id:"reply_to",label:"Reply-To",value:$c.reply_to ?? "",visible:$c.show_reply_to},{id:"subject",label:"Subject",value:$c.subject,visible:true}]
      $f.actions=[]
      if $f.id=="to" then $f.actions=[{id:"show_cc",label:"Show Cc",icon:"copy",selected:$c.show_cc},{id:"show_bcc",label:"Show Bcc",icon:"eye-off",selected:$c.show_bcc},{id:"show_reply_to",label:"Show Reply-To",icon:"reply",selected:$c.show_reply_to}] end
      push($fields,$f)
    end
    $headers={id:"compose-headers",kind:"header-form",label:"",initial:{enabled:not $c.busy,identity:$c.draft_id,fields:$fields,attachments:$c.attachments,attachment_label:"Attachments",attach_label:"Attach…",remove_label:"Remove attachment",chooser:{open:$c.chooser,title:"Attach files",directory:env("HOME")}},properties:{}}
    $body={id:"compose-body",kind:"editor",label:"Body",initial:$c.body,properties:{native_document:true,prose:true,document:$c.draft_id,language:"text",soft_wrap:true,line_numbers:false,remote_carets:false,read_only:$c.busy}}
    $child={values:{},headers:$headers,body_editor:$body,reader_content:$mail_settings.composer ?? {},native_overlays:[],shortcuts:[],window_close:false}
    if $c.confirm then $child.native_overlays=[{command:"email.compose.intent",definition:{id:"compose-confirm",kind:"dialog-form",label:"",initial:{open:true,instance:$c.draft_id,title:"Close draft?",body:"Keep this draft to finish later?",choices:[{id:"keep",label:"Keep Draft",enabled:true,default:true},{id:"discard",label:"Discard",enabled:true},{id:"cancel",label:"Keep Editing",enabled:true,cancel:true}]},properties:{style:"gold"}}}] end
    $menus=[{id:"File",label:"File",enabled:true,children:[{id:"mail.send",label:"Send",enabled:not $c.busy},{id:"file.close",label:"Close",enabled:not $c.busy}]}]
    $child=$compose_frame.apply($child,{icon:"square-pen",title:"Compose",menus:$menus,toolbar:[{id:"mail.send",label:"Send",icon:"send",enabled:not $c.busy}],status:$c.error ?? "",window:{"window.decorations":"csd"}})
    $m.native_windows=push($m.native_windows,{key:$key,title:"Compose — "..$key,size:[900,700],persist:true,scene:$compose_scene,model:$child})
  end
  return $m
end
fn composer_sent($key,$answer)
  global $composers
  if $composers[$key]==nil then return end
  $composers[$key].busy=false;$composers[$key].attempt=$answer.attempt ?? $composers[$key].attempt
  if $answer.rc==0 then composer_close($key,"discard")
  else $composers[$key].error=$answer.body.message;composer_save($key) end
end
