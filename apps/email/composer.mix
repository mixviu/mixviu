-- All composers belong to this interpreter. Native viewports only draw them.
$composers={};$compose_serial=0;$compose_focused=nil;$compose_quitting=false;$compose_restore=[]
$compose_addresses=require("addresses.mix");$compose_sending=require("sending.mix");$compose_ids=require("identity.mix")
$compose_quoting=require("quoting.mix")
$compose_suggest=require("suggest.mix")
$compose_frame=require("../../libraries/viu/mix/gold-frame.mix")
$compose_scene=read_file(path_join(dirname(script_path()),"composer-scene.mix"))
fn composer_info($c)
  return {account:$c.account,from:$c.from,to:$c.to,cc:$c.cc,bcc:$c.bcc,subject:$c.subject,body:$c.body,attachments:$c.files,attachment_size:$c.attachment_size,attachment_error:$c.attachment_error,attachments_over_limit:$c.attachments_over_limit,sendable:composer_sendable($c),send_origin:$c.send_origin,in_reply_to:$c.in_reply_to,stale:$c.stale,busy:$c.busy,error:$c.error}
end
fn composer_sendable($c)
  return not $c.busy and $c.stale==nil and $c.attachment_error==nil and wire_entry($c.account)!=nil and trim($c.to)!="" and trim($c.subject)!=""
end
fn composer_size($bytes)
  if $bytes==nil then return "unknown size" end
  if $bytes<1024 then return to_string($bytes).." B" end
  if $bytes<1048576 then return to_string(round($bytes/1024)).." KB" end
  return to_string(round($bytes/1048576*10)/10).." MB"
end
fn composer_theme()
  $view=filter($actions.menus(action_context()),fn($m)=$m.id=="View")[0]
  return filter($view.children,fn($c)=$c.id=="theme-menu")
end
fn composer_files($c,$strict=false)
  $files=[];$total=0
  for $path in unique($c.attachments)
    $file={path:$path,name:basename($path),label:basename($path),size:nil,state:"ready"}
    if not starts_with($path,"/") then $file.state="relative"
    else
      try
        $stat=viu_files("stat",{path:$path})
        if not $stat.is_file then $file.state="not_file"
        else
          $file.size=$stat.size;$total=$total+$stat.size
          try viu_files("inspect",{path:$path}) catch $bad $file.state="unreadable" end
        end
      catch $missing $file.state="missing" end
    end
    if $strict and $file.state!="ready" then raise(if $file.state=="relative" then "ATTACHMENT_RELATIVE" elif $file.state=="not_file" or $file.state=="missing" then "ATTACHMENT_NOT_FILE" else "ATTACHMENT_UNREADABLE" end,"Attachment is not readable: "..$path) end
    push($files,$file)
  end
  $limit=((($wire_views[$c.account] ?? {}).session ?? {}).max_size_upload) ?? 26214400
  $estimate=byte_length($c.body)+byte_length($c.subject)+2048
  for $f in $files
    if $f.size!=nil then $encoded=4*ceil($f.size/3);$estimate=$estimate+$encoded+2*ceil($encoded/76)+512 end
  end
  $c.attachments=map($files,fn($f)=$f.path);$c.files=$files;$c.attachment_size=$total;$c.attachments_over_limit=$estimate>$limit
  $c.attachment_error=if any($files,fn($f)=$f.state!="ready") then "Fix or remove the unavailable attachments." elif $c.attachments_over_limit then "The message is larger than the server's upload limit." else nil end
  if $strict and $c.attachments_over_limit then raise("MESSAGE_TOO_LARGE",$c.attachment_error) end
  return $c
end
fn composer_snapshot($info,$window=nil)
  $info.compose_windows=map(keys($composers),fn($key)={window:$key,root:false,compose:composer_info($composers[$key])})
  $key=$window ?? $compose_focused;$c=$composers[$key]
  if $c!=nil then $info.window=$key;$info.compose=composer_info($c);$info.confirm=if $c.confirm then (if $compose_quitting then "quit" else "close_compose" end) else nil end end
  return $info
end
fn composer_target($args)
  if contains(keys($args),"window") then
    if type($args.window)!="string" then return wire_refuse("INVALID_ARGUMENT","window must be a string") end
    if $composers[$args.window]==nil then return wire_refuse("NOT_FOUND","No compose is open") end
  end
  return {rc:0,body:{window:$args.window ?? $compose_focused}}
end
fn composer_open($a,$raw_to=nil)
  global $composers,$compose_serial,$compose_focused
  try
    if type($a)!="map" then raise("INVALID_ARGUMENT","arguments must be an object") end
    if contains(keys($a),"window") then raise("INVALID_ARGUMENT","compose always creates a new window; window is not accepted") end
    if $a.document!=nil then
      for $field in ["to","cc","bcc","from","reply_to","subject","body","attachments","in_reply_to","references"]
        if contains(keys($a),$field) then raise("INVALID_ARGUMENT","document excludes inline message fields") end
      end
      $path=$argument_policy.required($a,"document")
      if not starts_with($path,"/") then raise("INVALID_ARGUMENT","document must be an absolute path") end
      $a=merge(viu_maildoc("parse",viu_files("read-text",{path:$path,limit:8388608})),{account:$a.account})
    end
    for $field in ["account","subject","body","from","reply_to","in_reply_to"] $argument_policy.text($a,$field) end
    $argument_policy.list($a,"references")
    if $a.attachments!=nil and (type($a.attachments)!="list" or not all($a.attachments,fn($p)=type($p)=="string")) then raise("INVALID_ARGUMENT","attachments must hold absolute file paths") end
    $id=$a.account ?? $mail_settings.default_account ?? $active;$e=wire_entry($id)
    if $e==nil then return wire_refuse("UNKNOWN_ACCOUNT","No account is selected") end
    $sender=$compose_sending.identity($e,$a.from)
    $compose_serial=$compose_serial+1;$key="compose-"..to_string($compose_serial)
    $c={account:$id,identity:$sender.id,from:$sender.address,from_name:$sender.name,to:join(map($compose_addresses.field($a,"to"),fn($v)=$compose_addresses.format($v)),", "),cc:join(map($compose_addresses.field($a,"cc"),fn($v)=$compose_addresses.format($v)),", "),bcc:join(map($compose_addresses.field($a,"bcc"),fn($v)=$compose_addresses.format($v)),", "),reply_to:$a.reply_to ?? $sender.reply_to,subject:$a.subject ?? "",body:$a.body ?? (if $sender.signature!="" then "\n\n-- \n"..$sender.signature else "" end),attachments:$a.attachments ?? [],in_reply_to:$a.in_reply_to,references:$a.references ?? [],busy:false,error:nil,attempt:{},confirm:false,show_cc:$a.cc!=nil,show_bcc:$a.bcc!=nil,show_reply_to:$a.reply_to!=nil,chooser:false,revision:0,draft_id:replace($compose_ids.mint(),"-","")}
    if len($e.identities ?? [])==0 then $c.from_name="" end
    if $a.body==nil or $a.body=="" then $c.body=$compose_quoting.signature($sender.signature ?? "") end
    if $raw_to!=nil then $c.to=$raw_to end
    $c.show_cc=$c.cc!="";$c.show_bcc=$c.bcc!="";$c.show_reply_to=($c.reply_to ?? "")!=""
    $c.stale=nil;$c.send_origin=nil;$c.reply_quote=$a.reply_quote;$c.reply_signature=$a.reply_signature;$c.reply_position=$a.reply_position
    $c.connection={url:$e.url,user:$e.user,ca_file:$e.ca_file,enabled:$e.enabled}
    $c=composer_files($c,true)
    $composers[$key]=$c;$compose_focused=$key
    return {rc:0,body:{composing:$id,window:$key,compose:composer_info($c)}}
  catch $message,$error return wire_refuse($error.code,$message) end
end
fn composer_save($key)
  $c=$composers[$key];$dir=path_join(viu_app_dirs("email").state,"drafts");viu_private_directory($dir)
  $path=path_join($dir,$c.draft_id..".json");$old=viu_read_optional($path)
  if $old.found then
    try $old=json_parse($old.text) catch $bad raise("DRAFT","Unreadable draft was left untouched") end
    if $old.schema_version!=1 or $old.id!=$c.draft_id then raise("DRAFT","Unsupported draft was left untouched") end
  end
  $saved={schema_version:1,id:$c.draft_id,account:$c.account,from:$c.from,from_name:$c.from_name,identity:$c.identity,to:$c.to,cc:$c.cc,bcc:$c.bcc,reply_to:$c.reply_to,subject:$c.subject,body:$c.body,attachments:$c.attachments,in_reply_to:$c.in_reply_to,references:$c.references,saved_at:date_format(time(),"%Y-%m-%dT%H:%M:%SZ",{utc:true}),attempt:$c.attempt}
  viu_atomic_replace($path,json_encode($saved))
end
fn composer_close($key,$answer=nil)
  global $composers,$compose_quitting,$chrome
  $c=$composers[$key]
  if $c==nil then return wire_refuse("NOT_FOUND","No compose is open") end
  if $c.busy then return wire_refuse("BUSY","Sending…") end
  if $answer==nil and ($c.revision>0 or $c.restored==true or len($c.attachments)>0 or len(keys($c.attempt))>0) then composer_save($key);$composers[$key].confirm=true;return {rc:0,body:{}} end
  if $answer==nil then $answer="discard" end
  if $answer=="cancel" then $composers[$key].confirm=false;$compose_quitting=false;return {rc:0,body:{}} end
  if $answer=="keep" then composer_save($key)
  elif $answer=="discard" then
    $path=path_join(viu_app_dirs("email").state,"drafts/"..$c.draft_id..".json")
    if exists($path) then viu_files("remove",{path:$path}) end
  else return wire_refuse("INVALID_ARGUMENT","Unknown draft answer") end
  viu_timer("draft:"..$key,nil,{})
  $composers=delete($composers,$key)
  if $compose_quitting then composer_quit() end
  return {rc:0,body:{}}
end
fn composer_quit()
  global $compose_quitting,$chrome,$status
  $waiting=filter(keys($composers),fn($key)=$composers[$key].revision>0 or $composers[$key].restored==true or len($composers[$key].attachments)>0 or len(keys($composers[$key].attempt))>0)
  $answer={rc:0,body:{quitting:len($waiting)==0,confirming:len($waiting)>0,windows:$waiting}}
  $compose_quitting=true
  for $key in keys($composers)
    if $composers[$key].busy then return $answer end
    composer_close($key)
    if $composers[$key]!=nil then return $answer end
  end
  if not $fixture then try config_save() catch $unsaved $status="Window settings not saved" end end
  $chrome.window_close=true;return $answer
end
fn composer_attachments($command,$a)
  global $composers
  try
    $target=composer_target($a)
    if $target.rc!=0 then return $target end
    $key=$a.window ?? $compose_focused;$c=$composers[$key]
    if $command=="email.compose.attachment.add" then
      if type($a.paths)!="list" or not all($a.paths,fn($p)=type($p)=="string") then raise("INVALID_ARGUMENT","paths must be a list of absolute file paths") end
    else $argument_policy.required($a,"path") end
    if $c==nil then return wire_refuse("NOT_FOUND","No compose is open") end
    if $c.busy then return wire_refuse("BUSY","Sending…") end
    if $command=="email.compose.attachment.add" then $c.attachments=unique(concat($c.attachments,$a.paths))
    elif not contains($c.attachments,$a.path) then return wire_refuse("NOT_FOUND","No such attachment")
    else $c.attachments=filter($c.attachments,fn($p)=$p!=$a.path) end
    $c=composer_files($c,true);$c.revision=$c.revision+1;$composers[$key]=$c;composer_save($key)
    return {rc:0,body:{compose:composer_info($c)}}
  catch $message,$error return wire_refuse($error.code,$message) end
end
fn composer_intent($a)
  global $composers
  $key=$a.window ?? $compose_focused;$c=$composers[$key]
  if $c==nil then return wire_refuse("NOT_FOUND","No compose is open") end
  if $c.busy then return wire_refuse("BUSY","Sending…") end
  if $a.id=="compose-identities" then return composer_identity_intent($key,$a) end
  if $a.id=="compose-position" then
    $position=if $a.value then "below" else "above" end
    $body=$compose_quoting.moved($c.body,$c.reply_quote,$c.reply_signature,$position)
    if $body!=nil then $composers[$key].body=$body;$composers[$key].reply_position=$position;$composers[$key].revision=$c.revision+1;viu_timer("draft:"..$key,500,{kind:"draft",window:$key}) end
    return {rc:0,body:{}}
  end
  if $a.id=="compose-new-from" then
    composer_use_new_from($key);return {rc:0,body:{}}
  end
  if $a.id=="compose-confirm" then return composer_close($key,$a.value.choice ?? $a.value) end
  if $a.id=="compose-replace" then
    $doc=$c.pending_document;$composers[$key].pending_document=nil
    if $a.value.choice=="replace" then return composer_document_apply($key,$doc) end
    return {rc:0,body:{}}
  end
  if $a.id=="compose-headers" and $c.document_mode!=nil then
    if $a.action=="picked" then
      $composers[$key].chooser=false;$composers[$key].document_mode=nil
      return composer_document_start($key,"read",{path:$a.value[0]})
    elif $a.action=="saved" then
      $composers[$key].chooser=false;$composers[$key].document_mode=nil
      return composer_document_start($key,"save",$a.value)
    elif $a.action=="cancel" then $composers[$key].chooser=false;$composers[$key].document_mode=nil;return {rc:0,body:{}} end
  end
  if $a.action=="completion_close" then $composers[$key].suggest=nil;return {rc:0,body:{}} end
  if $a.action=="completion_move" then
    $s=$c.suggest
    if $s!=nil and len($s.items)>0 then $composers[$key].suggest.cursor=($s.cursor+len($s.items)+$a.value.delta)%len($s.items) end
    return {rc:0,body:{}}
  end
  if $a.action=="complete" then
    $s=$c.suggest;$item=$s.items[$a.value.index]
    if $s==nil or $s.field!=$a.value.field or $item==nil then return wire_refuse("STALE","Suggestion changed") end
    $token=$compose_suggest.token($c[$s.field]);$prefix=$token.prefix
    $composers[$key][$s.field]=(if $prefix=="" then "" else $prefix.." " end)..$compose_addresses.format($item)..", "
    $composers[$key].suggest=nil;$composers[$key].revision=$c.revision+1;viu_timer("draft:"..$key,500,{kind:"draft",window:$key});return {rc:0,body:{}}
  end
  if $a.id=="compose-body" then $composers[$key].body=$a.value
  elif $a.id=="compose-headers" then
    if $a.action=="edit" then
      for $field in keys($a.value)
        if contains(["to","cc","bcc","reply_to","subject"],$field) then
          $composers[$key][$field]=$a.value[$field]
          if contains(["to","cc","bcc","reply_to"],$field) then composer_suggest_typed($key,$field) end
        elif $field=="from" then
          for $e in $entries
            for $sender in $compose_sending.senders($e)
              if $sender.name.." <"..$sender.address..">"==$a.value.from then
                composer_choose_sender($key,$e,$sender)
              end
            end
          end
        end
      end
    elif $a.action=="command" then
      if $a.value=="attach" then return composer_run($key,"compose.attach","ui")
      elif $a.value=="identities" then composer_identity_open($key)
      elif contains(["show_cc","show_bcc","show_reply_to"],$a.value) then $composers[$key][$a.value]=not $c[$a.value] end
    elif $a.action=="picked" then $composers[$key].attachments=unique(concat($c.attachments,$a.value));$composers[$key].chooser=false
    elif $a.action=="cancel" then $composers[$key].chooser=false
    elif $a.action=="remove" then $composers[$key].attachments=filter($c.attachments,fn($p)=$p!=$c.attachments[$a.value]) end
  end
  if $a.action=="picked" or $a.action=="remove" then $composers[$key]=composer_files($composers[$key]) end
  $composers[$key].revision=$c.revision+1
  viu_timer("draft:"..$key,500,{kind:"draft",window:$key})
  return {rc:0,body:{}}
end
fn composer_command($key,$id)
  global $composers
  if $id=="compose.new" then return composer_open({}) end
  if $id=="file.quit" then return composer_quit() end
  if $id=="file.close" or $id=="compose.close" then return composer_close($key) end
  if $id=="compose.attach" then $composers[$key].chooser=true;return {rc:0,body:{executed:$id}} end
  if contains(["compose.open","compose.save_as"],$id) then
    if $composers[$key].busy then return wire_refuse("BUSY","Sending…") end
    $composers[$key].document_mode=if $id=="compose.open" then "open" else "save" end
    $composers[$key].chooser=true;$composers[$key].chooser_instance=($composers[$key].chooser_instance ?? 0)+1
    return {rc:0,body:{executed:$id}}
  end
  if $id=="compose.attachments.clear" then $composers[$key].attachments=[];$composers[$key]=composer_files($composers[$key]);$composers[$key].revision=$composers[$key].revision+1;composer_save($key);return {rc:0,body:{executed:$id}} end
  if contains(["compose.undo","compose.redo","compose.cut","compose.copy","compose.paste"],$id) then
    $composers[$key].edit_serial=($composers[$key].edit_serial ?? 0)+1;$composers[$key].edit_command=split($id,".")[1];return {rc:0,body:{executed:$id}}
  end
  if starts_with($id,"view.") then return apply_email($id,"menu") end
  if $id=="mail.send" then
    $c=$composers[$key]
    if $c==nil then return wire_refuse("NOT_FOUND","No compose is open") end
    if $c.busy then return wire_refuse("BUSY","Sending…") end
    if $c.stale!=nil then return wire_refuse("STALE_CONNECTION","The account changed under this draft") end
    if not composer_sendable($c) then return wire_refuse("DISABLED",$c.attachment_error ?? "That command cannot run now") end
    $args=merge($c,{window:$key})
    $r=wire_start("email.send",$args,nil,"compose-send")
    if $r.rc==0 then $composers[$key].busy=true;$composers[$key].error=nil end
    return $r
  end
  return wire_refuse("UNKNOWN_ACTION","No such command")
end
fn composer_models($m)
  $m.native_windows=[]
  for $key in keys($composers)
    $c=$composers[$key];$fields=[]
    $senders=[]
    for $e in $entries
      if $e.enabled!=false then for $sender in $compose_sending.senders($e) push($senders,{account:$e.id,sender:$sender,label:$sender.name.." <"..$sender.address..">"}) end end
    end
    for $f in [{id:"from",label:"From",kind:"label",value:if $c.identity=="default" then $c.from else $c.from_name.." <"..$c.from..">" end,read_only:true,visible:true},{id:"to",label:"To",value:$c.to,visible:true},{id:"cc",label:"Cc",value:$c.cc,visible:$c.show_cc},{id:"bcc",label:"Bcc",value:$c.bcc,visible:$c.show_bcc},{id:"reply_to",label:"Reply-To",value:$c.reply_to ?? "",visible:$c.show_reply_to},{id:"subject",label:"Subject",value:$c.subject,visible:true}]
      if $c.suggest!=nil and $c.suggest.field==$f.id then $f.suggestions=$c.suggest.items;$f.query=$c.suggest.query;$f.cursor=$c.suggest.cursor end
      $f.actions=[]
      if $f.id=="from" then
        $f.actions=[{id:"identities",label:"Identities…",icon:nil}]
        if len($senders)>1 then $f.kind="choice";$f.read_only=false;$f.choices=map($senders,fn($s)=$s.label);$f.value=(filter($senders,fn($s)=$s.account==$c.account and $s.sender.id==$c.identity)[0] ?? $senders[0]).label end
      end
      if $f.id=="to" then $f.actions=[{id:"show_cc",label:"Show Cc",icon:"copy",selected:$c.show_cc},{id:"show_bcc",label:"Show Bcc",icon:"eye-off",selected:$c.show_bcc},{id:"show_reply_to",label:"Show Reply-To",icon:"reply",selected:$c.show_reply_to}] end
      push($fields,$f)
    end
    $headers={id:"compose-headers",kind:"header-form",label:"",initial:{native_spacing:true,enabled:not $c.busy,identity:$c.draft_id,fields:$fields,attachments:map($c.files,fn($f)={path:$f.path,text:$f.label.." · "..composer_size($f.size)..(if $f.state!="ready" then " — "..$f.state else "" end),bad:$f.state!="ready"}),attachment_label:"Files",attach_icon:"paperclip",attach_label:"Attach…",remove_label:"Remove attachment",chooser:{open:$c.chooser,title:"Attach files",directory:env("HOME")}},properties:{}}
    if $c.document_mode!=nil then $headers.initial.chooser=merge($headers.initial.chooser,{mode:$c.document_mode,instance:$c.chooser_instance,title:if $c.document_mode=="open" then "Open mail document" else "Save mail document as" end,confirm:if $c.document_mode=="open" then "Open" else "Save" end}) end
    $body={id:"compose-body",kind:"editor",label:"Body",initial:$c.body,properties:{native_document:true,prose:true,document:$c.draft_id,language:"text",soft_wrap:true,line_numbers:false,remote_carets:false,read_only:$c.busy,command:{serial:$c.edit_serial ?? 0,name:$c.edit_command ?? ""}}}
    $child={values:{},headers:$headers,body_editor:$body,reader_content:$mail_settings.composer ?? {},native_overlays:[],shortcuts:[],window_close:false}
    $child.reply_visible=$c.reply_quote!=nil;$child.stale_visible=$c.stale!=nil;$child.error_visible=$c.error!=nil;$child.busy=$c.busy
    $child.footer_visible=$child.reply_visible or $child.stale_visible or $child.error_visible or $c.busy
    $child.reply_toggle={id:"compose-position",kind:"toggle",label:"",initial:$c.reply_position=="below",properties:{text:"Reply below the quote",style:"gold",enabled:not $c.busy and $compose_quoting.moved($c.body,$c.reply_quote,$c.reply_signature,$c.reply_position)!=nil}}
    $child.values["compose-error"]="Not sent: "..($c.error ?? "")
    $child.values["compose-stale-text"]="From was "..$c.from.."; the account now signs in as "..(($c.stale ?? {}).address ?? "")
    if $c.confirm then $child.native_overlays=[{command:"email.compose.intent",definition:{id:"compose-confirm",kind:"dialog-form",label:"",initial:{open:true,instance:$c.draft_id,title:if $compose_quitting then "Quit with an unsent message?" else "Close this message?" end,body:"Your draft is kept on this computer and offered again when Email starts. Discard deletes it.",choices:[{id:"keep",label:"Keep Draft",enabled:true,default:true},{id:"discard",label:"Discard",enabled:true},{id:"cancel",label:"Keep Editing",enabled:true,cancel:true}]},properties:{style:"gold"}}}] end
    if $c.pending_document!=nil then $child.native_overlays=push($child.native_overlays,{command:"email.compose.intent",definition:{id:"compose-replace",kind:"dialog-form",label:"",initial:{open:true,instance:$c.draft_id,title:"Replace message?",body:"Replace the message in this composer with the mail document?",choices:[{id:"replace",label:"Replace",enabled:true,default:true},{id:"cancel",label:"Cancel",enabled:true,cancel:true}]},properties:{style:"gold"}}}) end
    $identity_model=composer_identity_model($key,$c)
    if $identity_model!=nil then $child.native_overlays=push($child.native_overlays,$identity_model) end
    $menus=[{id:"File",label:"File",enabled:true,children:[{id:"compose.new",label:"New",enabled:true,shortcut:"Ctrl+N"},{id:"compose.open",label:"Open…",enabled:not $c.busy,shortcut:"Ctrl+O"},{id:"compose.save_as",label:"Save As…",enabled:not $c.busy,shortcut:"Ctrl+Shift+S"},{id:"mail.send",label:"Send",enabled:composer_sendable($c),shortcut:"Ctrl+Enter"},{separator:true},{id:"compose.close",label:"Close",enabled:true,shortcut:"Ctrl+W"},{id:"file.quit",label:"Quit",enabled:true,shortcut:"Ctrl+Q"}]},{id:"Edit",label:"Edit",enabled:true,children:map([["undo","Undo"],["redo","Redo"],["cut","Cut"],["copy","Copy"],["paste","Paste"]],fn($v)={id:"compose."..$v[0],label:$v[1],enabled:not $c.busy})},{id:"Attachments",label:"Attachments",enabled:true,children:[{id:"compose.attach",label:"Attach files…",enabled:not $c.busy,shortcut:"Ctrl+Shift+A"},{separator:true},{id:"compose.attachments.clear",label:"Remove all attachments",enabled:not $c.busy and len($c.attachments)>0}]},{id:"View",label:"View",enabled:true,children:composer_theme()}]
    $child=$compose_frame.apply($child,{icon:"square-pen",title:"Compose",menus:$menus,toolbar:[{id:"mail.send",label:"Send",icon:"send",enabled:composer_sendable($c)},{id:"view.mode",label:"Toggle light/dark",icon:if $chrome.theme_effective.mode=="dark" then "sun" else "moon" end,enabled:true}],status:$c.error ?? "",window:{"window.decorations":"csd"}})
    $child.frame.status_visible=false
    if $c.dialog!=nil then
      $help=$frame.apply({values:{}},merge(action_context(),{dialog:$c.dialog}))
      for $overlay in $help.native_overlays ?? [] $child.native_overlays=push($child.native_overlays,$overlay) end
    end
    $m.native_windows=push($m.native_windows,{key:$key,title:"Compose",size:[900,700],persist:true,scene:$compose_scene,model:$child})
  end
  return $m
end
fn composer_suggest_typed($key,$field)
  global $composers
  $c=$composers[$key];$token=$compose_suggest.token($c[$field]);$present=[]
  try $present=map($compose_addresses.decode($token.head),fn($a)=$a.email) catch $bad nil end
  if len($token.query)<2 then $composers[$key].suggest=nil;viu_timer("suggest:"..$key,nil,{});return end
  $s={field:$field,query:$token.query,text:$c[$field],present:$present,items:$compose_suggest.ranked([],($wire_data[$c.account] ?? {}).recent ?? [],$token.query,8,$present),cursor:0}
  $composers[$key].suggest=$s;viu_timer("suggest:"..$key,200,{kind:"suggest",window:$key,field:$field,text:$c[$field],query:$token.query,account:$c.account})
end
fn composer_suggest_completed($args,$answer)
  global $composers
  $c=$composers[$args.window];$s=$c.suggest
  if $c==nil or $s==nil or $c.account!=$args.account or $s.field!=$args.field or $s.text!=$args.typed or $answer.rc!=0 then return end
  $composers[$args.window].suggest.items=$compose_suggest.ranked($answer.body.suggestions,($wire_data[$c.account] ?? {}).recent ?? [],$s.query,8,$s.present)
  $composers[$args.window].suggest.cursor=min($s.cursor,max(0,len($composers[$args.window].suggest.items)-1))
end
fn composer_sent($key,$answer)
  global $composers
  if $composers[$key]==nil then return end
  $composers[$key].busy=false;$composers[$key].attempt=$answer.attempt ?? $composers[$key].attempt
  if $answer.rc==0 then composer_close($key,"discard")
  else $composers[$key].error=$answer.body.message;composer_save($key);if $compose_quitting then composer_quit() end end
end
fn composer_run($key,$id,$origin)
  $r=composer_command($key,$id)
  if $r.rc==0 then
    send "viu-local" "native.executed" body={id:$id,origin:$origin,params:nil,result:nil}
    publish_email();$r.body={executed:$id}
  end
  return $r
end
fn composer_document_start($key,$operation,$a)
  $c=$composers[$key]
  try
    if $c==nil then return wire_refuse("NOT_FOUND","No compose is open") end
    $args=merge($a,{operation:$operation})
    if $operation=="save" then
      $args.document={from:$c.from,reply_to:$c.reply_to,subject:$c.subject,body:rtrim($c.body),in_reply_to:$c.in_reply_to,references:$c.references,attachments:$c.attachments,to:map($compose_addresses.decode($c.to),fn($v)=$compose_addresses.format($v)),cc:map($compose_addresses.decode($c.cc),fn($v)=$compose_addresses.format($v)),bcc:map($compose_addresses.decode($c.bcc),fn($v)=$compose_addresses.format($v))}
    end
    $path=path_join(dirname(script_path()),"document-job.mix")
    send "viu-local" "jobs.start" id="document-"..$compose_ids.mint() owner={composer_document:{key:$key,revision:$c.revision,generation:$wire_generations[$c.account] ?? 0,operation:$operation}} path=$path source=read_file($path) command="job.run" args=$args
    if $rc!=0 then return wire_refuse("BUSY","Document worker unavailable") end
    return {rc:0,body:{}}
  catch $message return wire_refuse("DOCUMENT_INVALID_VALUE",$message) end
end
fn composer_document_completed($tag,$rc,$body)
  global $composers
  $c=$composers[$tag.key]
  if $c==nil then return end
  if $tag.revision!=$c.revision or $tag.generation!=($wire_generations[$c.account] ?? 0) then $composers[$tag.key].error="The composer changed while the document was loading; open it again";return end
  if $rc!=0 then $composers[$tag.key].error=$body.message;return end
  if $tag.operation=="save" then $composers[$tag.key].notice="Saved "..$body.path;return end
  if $c.revision>0 or $c.restored==true or len($c.attachments)>0 then $composers[$tag.key].pending_document=$body.document
  else composer_document_apply($tag.key,$body.document) end
end
fn composer_document_apply($key,$doc)
  global $composers,$compose_focused
  $old=$composers[$key];$opened=composer_open(merge($doc,{account:$old.account}))
  if $opened.rc!=0 then $composers[$key].error=$opened.body.message;return $opened end
  $next=$composers[$opened.body.window];$next.body=$doc.body
  $path=path_join(viu_app_dirs("email").state,"drafts/"..$old.draft_id..".json")
  if exists($path) then viu_files("remove",{path:$path}) end
  $composers=delete($composers,$opened.body.window);$composers[$key]=$next;$compose_focused=$key
  return {rc:0,body:{}}
end
fn composer_load_drafts()
  global $compose_restore
  $dir=path_join(viu_app_dirs("email").state,"drafts")
  for $path in glob(path_join($dir,"*.json"))
    try
      $read=viu_read_optional($path);$d=json_parse($read.text)
      if $d.schema_version!=1 or not re_match($d.id ?? "","^[0-9a-f]{1,64}$") or basename($path)!=$d.id..".json" then continue end
      if not all(["account","from","to","cc","bcc","subject","body","saved_at"],fn($f)=type($d[$f])=="string") then continue end
      if type($d.attachments)!="list" or not all($d.attachments,fn($p)=type($p)=="string") then continue end
      push($compose_restore,$d)
    catch $unreadable nil end
  end
  $ordered=[]
  for $stamp in reverse(sort_by(unique(map($compose_restore,fn($d)=$d.saved_at)),fn($v)=$v))
    for $draft in sort_by(filter($compose_restore,fn($d)=$d.saved_at==$stamp),fn($d)=$d.id) push($ordered,$draft) end
  end
  $compose_restore=$ordered
end
fn composer_restore_answer($choice)
  global $compose_restore,$composers,$compose_serial,$compose_focused
  $d=$compose_restore[0]
  if $d==nil then return wire_refuse("NOT_FOUND","No draft is offered") end
  if $choice=="later" then $compose_restore=[];return {rc:0,body:{}} end
  if $choice=="discard" then
    viu_files("remove",{path:path_join(viu_app_dirs("email").state,"drafts/"..$d.id..".json")})
    $compose_restore=slice($compose_restore,1);return {rc:0,body:{}}
  end
  if $choice!="restore" then return wire_refuse("INVALID_ARGUMENT","Unknown draft answer") end
  $e=wire_entry($d.account)
  if $e==nil then
    $fallback=wire_entry($mail_settings.default_account ?? $active)
    if $fallback!=nil then $d.account=$fallback.id;$d.from=$fallback.user;$d.from_name="";$d.reply_to=nil;$d.identity="" end
  end
  $compose_serial=$compose_serial+1;$key="compose-"..to_string($compose_serial)
  $c=merge($d,{draft_id:$d.id,revision:0,restored:true,busy:false,error:nil,attempt:$d.attempt ?? {},confirm:false,show_cc:$d.cc!="",show_bcc:$d.bcc!="",show_reply_to:($d.reply_to ?? "")!="",chooser:false,stale:nil,send_origin:nil})
  $composers[$key]=composer_files($c);$compose_focused=$key;$compose_restore=slice($compose_restore,1)
  return {rc:0,body:{window:$key,compose:composer_info($composers[$key])}}
end
fn composer_restore_model($m)
  if len($compose_restore)==0 or len(keys($composers))>0 or $mail_form!=nil then return $m end
  $d=$compose_restore[0];$subject=if trim($d.subject)=="" then "(no subject)" else $d.subject end
  $to=if trim($d.to)=="" then "(no recipients)" else rtrim(trim($d.to),",;") end
  $saved="";try $saved=date_format(date_parse($d.saved_at),"%-d %b %Y, %H:%M") catch $bad nil end
  $v={open:true,instance:$d.id,title:"Restore a draft?",body:"A message you were writing was kept:",details:[{text:$subject,strong:true},{text:"To: "..$to},{text:"Saved "..$saved,weak:true}],choices:[{id:"restore",label:"Restore",enabled:true,default:true},{id:"discard",label:"Discard",enabled:true},{id:"later",label:"Later",enabled:true,cancel:true}]}
  if len($compose_restore)>1 then $v.details=push($v.details,{text:to_string(len($compose_restore)-1).." more kept after this one",weak:true}) end
  $m.native_overlays=push($m.native_overlays,{command:"email.restore.intent",definition:{id:"email-restore",kind:"dialog-form",label:"",initial:$v,properties:{style:"gold"}}})
  return $m
end
fn composer_begin($command,$args,$event)
  try
    $argument_policy.required($args,"id")
    if contains(keys($args),"window") then raise("INVALID_ARGUMENT","compose always creates a new window; window is not accepted") end
    if $command=="email.reply" then $argument_policy.flag($args,"all");$argument_policy.flag($args,"quote")
    else $argument_policy.list($args,"to") end
  catch $message,$error return wire_refuse("INVALID_ARGUMENT",$message) end
  return wire_start($command,$args,$event,"compose-open")
end
