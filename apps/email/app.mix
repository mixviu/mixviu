-- version: 0.1.0
-- lint: globals app_args
$c=require("core.mix");$mail=require("mail.mix");$ctx=viu_context()
$fixture=len($app_args)>0 and $app_args[0]=="--fixture"
$rows=[];$selected=nil;$revision=0;$account="No account connected";$mailbox="No mailbox";$reader="No message open";$draft={to:"",subject:"",text:""}
$entries=[];$active="";$session=nil;$boxes=[];$box="";$offset=0;$total=0;$message=nil;$connected=false;$busy=false;$serial=0;$pending=nil;$status="Choose an account and Connect"
$submission=nil;$receipt=nil;$last_receipt=nil
$view="Mail"
if not $fixture then $status="" end
$frame=require("frame.mix");$actions=require("actions.mix")
$chrome={bindings:{},theme_choice:{scheme:nil,mode:nil,style:nil,decorations:nil,caption_side:nil},theme_effective:{scheme:"studio",mode:"dark"},dialog:nil,macros_open:false,window_close:false}
if not $fixture and len($app_args)>0 then
  $entries=$mail.accounts($app_args[0])
  if len($entries)>0 then $active=$entries[0].id end
end
fn entry()
  for $e in $entries if $e.id==$active then return $e end end
  raise("ACCOUNT","No configured account selected")
end
fn publish_email()
  $m=$c.model(if $fixture then $rows else [] end,if $fixture then $selected else nil end,$revision,$account,$mailbox,$reader,$draft)
  $m.fixture=$fixture
  $m.status=if $fixture then $m.status else $status.." · "..to_string(len($rows)).." / "..to_string($total).." messages · offset "..to_string($offset) end
  $m.accounts={id:"accounts",kind:"combo",label:"Account",initial:if $active!="" then $active else "No account" end,properties:{choices:if len($entries)>0 then map($entries,fn($e)=$e.id) else ["No account"] end}}
  $chosen=filter($boxes,fn($b)=$b.id==$box)
  $m.mailboxes={id:"mailboxes",kind:"combo",label:"Mailbox",initial:if len($chosen)>0 then $chosen[0].choice ?? $chosen[0].name else "Select mailbox" end,properties:{choices:concat(["Select mailbox"],map($boxes,fn($b)=$b.choice ?? $b.name))}}
  $m.values.view=$view;$m.mail_hidden=$view!="Mail";$m.compose_hidden=$view!="Compose"
  $m.values["reader-body"]=if $message!=nil then $message.text ?? $message.html ?? "" else "" end
  if not $fixture then $m=surface_model($m) end
  $look=merge(action_context(),{fixture:$fixture,accounts:len($entries),connected:$connected,status:$status})
  if not $fixture then
    $current=wire_entry($active);$state=$wire_views[$active] ?? {}
    $look.status=if $current==nil then "" else $current.name.." — "..(if $state.state=="ready" then "Connected" elif $state.state=="connecting" then "Connecting…" else "Not connected" end) end
    if $status!="" then $look.status=$look.status.." — "..$status end
    if $mail_settings.source=="missing" then $look.status=$look.status.." — Settings service not running: showing the saved accounts, read-only" end
  end
  $m=$frame.apply($m,$look)
  if not $fixture then $m=composer_models($m) end
  send "viu-local" "scenes.model" body={generation:$ctx.generation,value:$m}
end
fn begin_mail($op,$data)
  if $fixture then raise("FIXTURE","Fixture mode cannot contact a mail service") end
  if $busy then raise("BUSY","Wait for the pending mail operation") end
  $path=path_join(dirname(script_path()),"job.mix")
  $owner=$serial+1;$a=merge($data,{op:$op,entry:entry(),account:if $session!=nil then $session.account else nil end})
  send "viu-local" "jobs.start" id="email-work" owner=$owner path=$path source=read_file($path) command="job.run" args=$a
  if $rc!=0 then raise("JOB","Mail worker unavailable") end
end
fn reader_text($m)
  return "Subject: "..substr($m.subject ?? "",0,120).."\nFrom: "..substr(json_encode($m.from),0,120)
end
fn send_request()
  if $fixture or not $connected then raise("CONNECT","Connect a real configured account first") end
  if $busy then raise("BUSY","Wait for the pending operation") end
  if any($session.accounts,fn($a)=$a.id==$session.account and $a.isReadOnly) then raise("READ_ONLY","This JMAP account is read-only") end
  if $submission!=nil then
    if $receipt!=nil then raise("ACCEPTED","This operation was accepted; edit a new draft first") end
    return $submission
  end
  $e=entry()
  if $e.submit_service==nil then raise("ROUTE","No submission Bus route configured for this account") end
  $recipients=map(split($draft.to,","),fn($r)=trim($r))
  if len($recipients)<1 or len($recipients)>32 or not all($recipients,fn($r)=re_match($r,"^[A-Za-z0-9._+%-]+@[A-Za-z0-9.-]+$")) then raise("RECIPIENTS","Use 1..32 comma-separated bare email addresses") end
  if len(unique(map($recipients,fn($r)=lower($r))))!=len($recipients) then raise("RECIPIENTS","Duplicate recipients refused") end
  if re_match($draft.subject,"[\\r\\n\\x00]") or re_match($draft.text,"\\x00") then raise("HEADER","Newlines in subject and NUL in mail are refused") end
  return {operation_id:"email-"..fmt("%.0f",random(0,1000000000000)).."-"..fmt("%.0f",random(0,1000000000000)),account:$e.user,to:$recipients,subject:$draft.subject,text:$draft.text}
end
include "wire.mix"
include "surface.mix"
include "composer.mix"
publish_email()
on email.ping
  reply(0,json_encode({pong:true,schema:"email.v1",version:$ctx.version,pid:$ctx.pid}))
end
on email.info
  if not $fixture then reply(0,json_encode(composer_snapshot(surface_info(),$event.args.window)));return end
  reply(0,json_encode({fixture:$fixture,connected:$connected,busy:$busy,status:$status,accounts:map($entries,fn($e)={id:$e.id,label:$e.label,user:$e.user}),active:$active,server_accounts:if $session!=nil then $session.accounts else [] end,mailboxes:$boxes,mailbox:$box,rows:len($rows),total:$total,offset:$offset,selected:$selected,revision:$revision,draft:$draft,operation_id:if $submission!=nil then $submission.operation_id else nil end,receipt:$last_receipt}))
end
on email.message
  reply(0,json_encode($message))
end
on email.connect
  begin_mail("connect",{});$serial=$serial+1;$busy=true;$pending={op:"connect"};$status="Connecting";publish_email();reply(0,"{}")
end
on email.account
  if $busy then raise("BUSY","Wait for the pending operation") end
  if not any($entries,fn($e)=$e.id==$event.args.id) then raise("ACCOUNT","Unknown configured account") end
  if $draft.to!="" or $draft.subject!="" or $draft.text!="" then raise("DRAFT","Clear the draft before changing account") end
  $active=$event.args.id;$connected=false;$session=nil;$boxes=[];$box="";$rows=[];$message=nil;$reader="No message open";$account="Not connected";$mailbox="No mailbox";$selected=nil
  begin_mail("connect",{});$serial=$serial+1;$busy=true;$pending={op:"connect"};$status="Connecting";publish_email();reply(0,"{}")
end
on email.mailbox
  if not $connected then raise("CONNECT","Connect first") end
  if not any($boxes,fn($b)=$b.id==$event.args.id) then raise("MAILBOX","Unknown mailbox") end
  begin_mail("page",{mailbox:$event.args.id,offset:0});$serial=$serial+1;$busy=true;$pending={op:"page",mailbox:$event.args.id};$status="Loading mailbox";publish_email();reply(0,"{}")
end
on email.read
  if not $connected or not any($rows,fn($r)=$r.key==$event.args.id) then raise("MESSAGE","Choose a listed message on a connected account") end
  begin_mail("read",{id:$event.args.id});$serial=$serial+1;$busy=true;$pending={op:"read"};$status="Reading message";publish_email();reply(0,"{}")
end
on email.send
  if not $fixture then $r=wire_start("email.send",$event.args,$event);reply($r.rc,json_encode($r.body));return end
  $request=send_request();begin_mail("send",{request:$request});$submission=$request;$serial=$serial+1;$busy=true;$pending={op:"send"};$status="Submitting · awaiting receipt";publish_email();reply(0,json_encode({accepted:true,operation_id:$submission.operation_id}))
end
on email.fixture
  if not $fixture then raise("FIXTURE","Explicit --fixture launch required; this is not maild data") end
  if $event.args.modern==true then
    $began=monotonic();$projected=gold_rows($event.args.messages)
    reply(0,json_encode({rows:len($projected),first:$projected[0],milliseconds:(monotonic()-$began)*1000}));return
  end
  $candidate=$c.rows($event.args.messages,$event.args.bulk ?? true)
  $rows=$candidate;$selected=nil;$revision=$revision+1
  $account="Synthetic account · user@example.test";$mailbox="Synthetic Inbox"
  publish_email();reply(0,json_encode({rows:len($rows),revision:$revision}))
end
on email.intent
  $a=$event.args
  if not $fixture then
    $r=surface_intent($a);publish_email();reply($r.rc,json_encode($r.body));return
  end
  if $a.id=="open-settings" then
    $out=execute_email("file.accounts","ui");reply($out.rc,json_encode($out.body));return
  elif $a.id=="view" then
    if not contains(["Mail","Compose"],$a.value) then raise("VIEW","Unknown view") end
    $view=$a.value
  elif $a.id=="send" then
    $request=send_request();begin_mail("send",{request:$request});$submission=$request;$serial=$serial+1;$busy=true;$pending={op:"send"};$status="Submitting · awaiting receipt"
  elif $a.id=="connect" then
    begin_mail("connect",{});$serial=$serial+1;$busy=true;$pending={op:"connect"};$status="Connecting"
  elif $a.id=="accounts" then
    if $busy then raise("BUSY","Wait for the pending operation") end
    if not any($entries,fn($e)=$e.id==$a.value) then raise("ACCOUNT","Unknown configured account") end
    if $draft.to!="" or $draft.subject!="" or $draft.text!="" then raise("DRAFT","Clear the draft before changing account") end
    $active=$a.value;$connected=false;$session=nil;$boxes=[];$box="";$rows=[];$selected=nil;$message=nil;$reader="No message open"
    begin_mail("connect",{});$serial=$serial+1;$busy=true;$pending={op:"connect"};$status="Connecting"
  elif $a.id=="mailboxes" then
    $choice=filter($boxes,fn($b)=$b.choice==$a.value)
    if not $connected or len($choice)!=1 then raise("MAILBOX","Choose a connected mailbox") end
    begin_mail("page",{mailbox:$choice[0].id,offset:0});$serial=$serial+1;$busy=true;$pending={op:"page",mailbox:$choice[0].id};$status="Loading mailbox"
  elif contains(["next","previous","refresh"],$a.id) then
    if not $connected or $box=="" then raise("MAILBOX","Choose a mailbox first") end
    $position=if $a.id=="next" then $offset+200 elif $a.id=="previous" then max(0,$offset-200) else $offset end
    if $a.id=="next" and $position>=$total then raise("PAGE","No next page") end
    begin_mail("page",{mailbox:$box,offset:$position});$serial=$serial+1;$busy=true;$pending={op:"page",mailbox:$box};$status="Loading page"
  elif $a.id=="messages" then
    if not contains(["select","activate"],$a.action) then raise("DEFERRED","Message sorting/navigation needs authoritative list wiring") end
    if not any($rows,fn($r)=$r.key==$a.value.key) then raise("ID","Unknown message") end
    if $fixture then $selected=$a.value.key;$reader="Selected fixture "..$selected.." · full message read not wired"
    else
      if not $connected then raise("CONNECT","Reconnect before reading") end
      begin_mail("read",{id:$a.value.key});$serial=$serial+1;$busy=true;$pending={op:"read"};$status="Reading message"
    end
  elif contains(["to","subject","compose"],$a.id) then
    if $busy and $pending.op=="send" then raise("BUSY","Submission holds its draft") end
    if $submission!=nil and $receipt==nil then raise("SUBMISSION","Resolve the existing operation before editing its draft") end
    if type($a.value)!="string" or byte_length($a.value)>if $a.id=="compose" then 65536 else 4096 end then raise("TEXT","Draft text exceeds budget") end
    $submission=nil;$receipt=nil
    if $a.id=="compose" then $draft.text=$a.value else $draft[$a.id]=$a.value end
  else raise("DEFERRED","Unknown or deferred mail action") end
  publish_email();reply(0,"{}")
end

fn execute_email($id,$origin)
  global $chrome,$view,$serial,$busy,$pending,$status,$reader_markdown,$reader_auto,$attachments_inline
  $s=action_context()
  $found=filter($actions.registry($s),fn($a)=$a.id==$id)
  if len($found)==0 then return {rc:10,body:{error_code:"UNKNOWN_ACTION",message:"No such command"}} end
  if not $found[0].enabled then return {rc:10,body:{error_code:"DISABLED",message:"That command cannot run now"}} end
  if $id=="file.quit" or $id=="compose.close" then $chrome.window_close=true
  elif $id=="file.accounts" then
    send "prefs" "prefs.section" body={name:"apps_email"}
    if $rc!=0 then
      send "apps" "apps.launch" body={id:"dev.mixos.prefs"}
      if $rc!=0 then return {rc:10,body:{error_code:"LAUNCH",message:"Can't open Prefs: no launcher"}} end
      send "prefs" "prefs.section" body={name:"apps_email"}
      if $rc!=0 then return {rc:10,body:{error_code:"LAUNCH",message:"Prefs did not open its Email settings"}} end
    end
  elif $id=="help.about" then $chrome.dialog="about"
  elif $id=="help.shortcuts" then $chrome.dialog="shortcuts"
  elif $id=="help.macros" then $chrome.macros_open=not $chrome.macros_open
  elif $id=="view.search" then
    return {rc:10,body:{error_code:"DISABLED",message:"Command search is awaiting the shared palette port"}}
  elif $id=="mail.compose" then
    if not $fixture then $opened=composer_open({});publish_email();return $opened else $view="Compose" end
  elif $id=="file.refresh" then
    if not $fixture then
      wire_start("email.mailboxes",{},nil,"boxes")
      if $box!="" then wire_start("email.list",{mailbox:$box,offset:$offset},nil,"refresh-list") end
      wire_start("email.calendars",{},nil,"parents");wire_start("email.books",{},nil,"parents")
    elif len($entries)>0 then begin_mail("connect",{});$serial=$serial+1;$busy=true;$pending={op:"connect"};$status="Connecting" end
  elif contains(["view.mail","view.calendar","view.contacts"],$id) then surface_mode(split($id,".")[1])
  elif contains(["mail.flag","mail.mark_unread"],$id) then surface_toggle_target($id=="mail.flag")
  elif starts_with($id,"mail.reply") or $id=="mail.forward" then
    $args={id:$message.id,all:contains($id,"reply_all")}
    if ends_with($id,"_unquoted") then $args.quote=false elif ends_with($id,"_quoted") then $args.quote=true end
    wire_start(if $id=="mail.forward" then "email.forward" else "email.reply" end,$args,nil,"compose-open")
  elif $id=="view.reader.markdown" then $reader_markdown=not $reader_markdown;$reader_auto=false
  elif $id=="view.attachments_inline" then $attachments_inline=not $attachments_inline
  elif contains(["view.next_account","view.previous_account"],$id) then
    $at=index_of(map($entries,fn($e)=$e.id),$active);$at=($at+len($entries)+(if $id=="view.next_account" then 1 else -1 end))%len($entries);surface_account($entries[$at].id)
  elif starts_with($id,"view.theme.") or starts_with($id,"view.mode") or starts_with($id,"view.style.") or starts_with($id,"view.decorations.") or starts_with($id,"view.captions.") then
    $axis=if starts_with($id,"view.theme.") then "scheme" elif starts_with($id,"view.style.") then "style" elif starts_with($id,"view.decorations.") then "decorations" elif starts_with($id,"view.captions.") then "caption_side" else "mode" end
    $parts=split($id,".");$value=$parts[len($parts)-1]
    if $id=="view.mode" then
      send "viu-local" "native.theme" body=$chrome.theme_choice
      if $rc!=0 then return {rc:$rc,body:$reply} end
      $value=if $reply.mode=="dark" then "light" else "dark" end
    end
    $edit={};$edit[$axis]=if $value=="session" then nil else $value end
    $out=theme_email($edit)
    if $out.rc!=0 then return $out end
  else return {rc:10,body:{error_code:"DISABLED",message:"That command cannot run now"}} end
  send "viu-local" "native.executed" body={id:$id,origin:$origin,params:nil,result:nil}
  publish_email()
  return {rc:0,body:{executed:$id}}
end
fn theme_email($args)
  global $chrome
  $edit=$actions.theme_edit($chrome.theme_choice,$args)
  if not $edit.ok then return {rc:10,body:{error_code:"ARGUMENT",message:$edit.message}} end
  send "viu-local" "native.theme" body=$edit.choice
  if $rc!=0 then return {rc:$rc,body:$reply} end
  $chrome.theme_choice=$edit.choice;$chrome.theme_effective=$reply
  $body=$edit.choice;$body.effective=$reply
  return {rc:0,body:$body}
end
on email.actions
  reply(0,json_encode({actions:$actions.registry(action_context())}))
end
on email.execute
  $out=execute_email($event.args.id,"bus");reply($out.rc,json_encode($out.body))
end
on email.theme
  $out=theme_email($event.args);publish_email();reply($out.rc,json_encode($out.body))
end
on viu.theme.changed
  $chrome.theme_effective=$event.args;publish_email()
end
on viu.macros.changed
  $chrome.macros_open=$event.args.open;publish_email()
end
on viu.keymap.changed
  send "viu-local" "native.bindings" body={defaults:$actions.binding_defaults(),overrides:$event.args}
  if $rc==0 then $chrome.bindings=$reply.bindings;publish_email() end
end
on viu.frame.intent
  if $event.args.window!=nil then $out=composer_command($event.args.window,$event.args.value.command);publish_email();reply($out.rc,json_encode($out.body));return end
  $out=execute_email($event.args.value.command,$event.args.value.origin ?? "menu")
  reply($out.rc,json_encode($out.body))
end
on email.compose
  $out=composer_open($event.args);publish_email();reply($out.rc,json_encode($out.body))
end
on email.reply
  $out=composer_begin("email.reply",$event.args,$event);publish_email();reply($out.rc,json_encode($out.body))
end
on email.forward
  $out=composer_begin("email.forward",$event.args,$event);publish_email();reply($out.rc,json_encode($out.body))
end
on email.compose.intent
  $out=composer_intent($event.args);publish_email();reply($out.rc,json_encode($out.body))
end
on viu.window.focused
  $compose_focused=$event.args.window
end
on viu.window.close
  composer_close($event.args.window);publish_email()
end
on viu.frame.close
  $chrome.window_close=true;publish_email()
end
on email.quit
  $chrome.window_close=true;publish_email();reply(0,json_encode({quitting:true}))
end
on email.dialog
  $window=$event.args.window ?? $compose_focused
  if $composers[$window]!=nil and $composers[$window].confirm then
    if $event.args.answer!=nil then $out=composer_close($window,$event.args.answer);publish_email();reply($out.rc,json_encode($out.body))
    else reply(0,json_encode({dialog:"close_compose"})) end
    return
  end
  if contains(keys($event.args),"open") then
    if $event.args.open!=nil and not contains(["about","shortcuts"],$event.args.open) then reply(10,json_encode({error_code:"ARGUMENT",message:"Unknown dialog"}));return end
    $chrome.dialog=$event.args.open
  elif $event.args.answer!=nil then $chrome.dialog=nil end
  publish_email();reply(0,json_encode({dialog:$chrome.dialog}))
end
on email.dialog.intent
  $chrome.dialog=nil;publish_email();reply(0,"{}")
end
on viu.job.completed
  $d=$event.args
  if $d.tag.owner.id!=nil then wire_completed($d);publish_email();return end
  wire_pump()
  if $busy and $d.tag.owner==$serial then
    $busy=false
    if $d.rc==0 then
      if $pending.op=="connect" then
        $session=$d.body.session;$boxes=$d.body.mailboxes;$connected=true;$box="";$rows=[];$selected=nil;$message=nil;$reader="Choose a mailbox, then a message";$total=0;$offset=0
        $e=entry();$account=$e.label.." · "..$e.user;$mailbox="Select mailbox";$status="Connected · choose mailbox"
      elif $pending.op=="page" then
        $candidate=$c.rows($d.body.messages,false)
        $rows=$candidate;$box=$pending.mailbox;$offset=$d.body.offset;$total=$d.body.total;$selected=nil;$message=nil;$reader="Select a message to read"
        for $b in $boxes if $b.id==$box then $mailbox=$b.name end end
        $revision=$revision+1;$status="Mailbox loaded"
      elif $pending.op=="read" then
        $message=$d.body;$selected=$message.id;$reader=reader_text($message);$status="Message loaded"
      else
        $receipt=$d.body;$last_receipt=$receipt;$draft={to:"",subject:"",text:""};$status="Accepted by maild · delivery not confirmed · "..$receipt.submission_id
      end
    else
      if $pending.op=="send" then $status="Submission unconfirmed · draft and operation ID retained · Send retries the same ID; no automatic retry"
      else $connected=false;$status="Mail request failed · choose Connect to recover; no automatic retry" end
    end
    publish_email()
  end
end

on viu.session
  wire_session($event.args);publish_email()
end
on email.accounts
  reply(0,json_encode({accounts:wire_accounts()}))
end
on email.account.set
  $r=wire_start("email.account.set",$event.args,$event);reply($r.rc,json_encode($r.body))
end
on email.account.remove
  $r=wire_start("email.account.remove",$event.args,$event);reply($r.rc,json_encode($r.body))
end
on email.account.default
  $r=wire_start("email.account.default",$event.args,$event);reply($r.rc,json_encode($r.body))
end
on email.account.password.set
  $r=wire_start("email.account.password.set",$event.args,$event);reply($r.rc,json_encode($r.body))
end
on email.account.connect
  $r=wire_start("email.account.connect",$event.args,nil,"connect");reply($r.rc,json_encode(if $r.rc==0 then {id:$event.args.id} else $r.body end))
end
on email.account.select
  $r=surface_account($event.args.id);publish_email();reply($r.rc,json_encode($r.body))
end
on email.mailbox.select
  $r=surface_mailbox($event.args.account ?? $active,$event.args.id);publish_email();reply($r.rc,json_encode($r.body))
end
on email.panel.action
  $r=execute_email($event.args.id,"panel");reply($r.rc,json_encode($r.body))
end
on email.mailboxes
  $r=wire_start("email.mailboxes",$event.args,$event);reply($r.rc,json_encode($r.body))
end
on email.list
  $r=wire_start("email.list",$event.args,$event);reply($r.rc,json_encode($r.body))
end
on email.search
  $r=wire_start("email.search",$event.args,$event);reply($r.rc,json_encode($r.body))
end
on email.get
  $r=wire_start("email.get",$event.args,$event);reply($r.rc,json_encode($r.body))
end
on email.attachments
  $r=wire_start("email.attachments",$event.args,$event);reply($r.rc,json_encode($r.body))
end
on email.mode
  $r=surface_mode($event.args.name);publish_email();reply($r.rc,json_encode($r.body))
end
on email.calendar.select
  $r=surface_parent($event.args.account ?? $active,$event.args.id,true);publish_email();reply($r.rc,json_encode($r.body))
end
on email.book.select
  $r=surface_parent($event.args.account ?? $active,$event.args.id,false);publish_email();reply($r.rc,json_encode($r.body))
end
on email.attachment.save
  $r=wire_start("email.attachment.save",$event.args,$event);reply($r.rc,json_encode($r.body))
end
on email.open
  $r=wire_start("email.open",$event.args,$event,"open");reply($r.rc,json_encode($r.body))
end
on email.mark
  $r=wire_start("email.mark",$event.args,$event);reply($r.rc,json_encode($r.body))
end
on email.move
  $r=wire_start("email.move",$event.args,$event);reply($r.rc,json_encode($r.body))
