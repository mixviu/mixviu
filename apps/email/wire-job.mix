-- SPDX-License-Identifier: MIT OR Apache-2.0
$protocol=require("protocol.mix");$accounts=require("accounts.mix")
on job.run
  $a=$event.args
  try
    if contains(["email.account.set","email.account.remove","email.account.default","email.account.password.set"],$a.command) then
      $answer=$accounts.update($a.command,$a.args,$a.binding)
      $snapshot=$accounts.settings_call("settings.get",{binding:$a.binding,view:"values"})
      reply(0,json_encode({rc:0,body:$answer,settings:$snapshot}));return
    end
    $e=$a.entry
    if $e.password_file==nil and $accounts.password($e.id)=="" then raise("NO_PASSWORD","No password is saved for "..$e.user) end
    $s=$a.session ?? $protocol.connect($e)
    $command=$a.command;$p=$a.args
    if $command=="email.mailboxes" or $command=="email.account.connect" then
      $answer={mailboxes:$protocol.boxes($protocol.call($e,$s,"Mailbox/get",{}).list)}
    elif $command=="email.list" or $command=="email.search" then
      if $command=="email.search" then $p.query=$p.text end
      $answer=$protocol.list($e,$s,$p)
    elif $command=="email.get" or $command=="email.open" then $answer=$protocol.get($e,$s,$p.id)
    elif contains(["email.mark","email.move","email.junk","email.delete"],$command) then $answer=$protocol.batch($e,$s,$command,$p)
    elif contains(["email.mailbox.create","email.mailbox.rename","email.mailbox.delete"],$command) then $answer=$protocol.mailbox_write($e,$s,$command,$p)
    else raise("UNKNOWN_COMMAND","Unknown Email command") end
    reply(0,json_encode({rc:0,body:$answer,session:$s}))
  catch $message,$error
    $code=if contains(["UNKNOWN_ACCOUNT","NO_PASSWORD","NOT_FOUND","INVALID_ARGUMENT","SETTINGS","SECRETS"],$error.code) then $error.code else "SERVER" end
    reply(0,json_encode({rc:10,body:{error_code:$code,message:$message}}))
  end
end
