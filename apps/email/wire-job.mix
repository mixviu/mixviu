-- version: 0.1.0
$arg=require("arguments.mix");$protocol=require("protocol.mix");$accounts=require("accounts.mix");$pim=require("pim.mix");$attachments=require("attachments.mix");$sending=require("sending.mix");$suggest=require("suggest.mix")
on job.run
  $a=$event.args
  try
    if contains(["email.account.set","email.account.remove","email.account.default","email.account.password.set"],$a.command) then
      $answer=$accounts.update($a.command,$a.args,$a.binding)
      $snapshot=$accounts.settings_call("settings.get",{binding:$a.binding,view:"values"})
      reply(0,json_encode({rc:0,body:$answer,settings:$snapshot}));return
    end
    $e=$a.entry
    if $e.password_file==nil and $accounts.password($e.id)=="" then raise("NO_PASSWORD","No password is saved for "..$e.user) end
    $s=$a.session ?? $protocol.connect($e)
    $command=$a.command;$p=$a.args
    if $command=="email.send" then
      $sent=$sending.execute($e,$s,$p);reply(0,json_encode(merge($sent,{session:$s})));return
    end
    if $command=="email.mailboxes" or $command=="email.account.connect" then
      $answer={mailboxes:$protocol.boxes($protocol.call($e,$s,"Mailbox/get",{}).list)}
    elif $command=="email.list" or $command=="email.search" then
      if $command=="email.search" then $p.query=$arg.required($p,"text")
      else $p.mailbox=$arg.required($p,"mailbox") end
      $answer=$protocol.list($e,$s,$p)
    elif contains(["email.get","email.open","email.reply","email.forward"],$command) then $answer=$protocol.get($e,$s,$p.id)
    elif $command=="email.contacts.suggest" then $answer=$suggest.contacts($e,$s,$p)
    elif $command=="email.attachments" then
      $email=$protocol.get($e,$s,$p.id);$answer={id:$email.id,attachments:$attachments.metadata($email)}
    elif $command=="email.attachment.save" then $answer=$attachments.save($e,$s,$p)
    elif contains(["email.mark","email.move","email.junk","email.delete"],$command) then $answer=$protocol.batch($e,$s,$command,$p)
    elif contains(["email.mailbox.create","email.mailbox.rename","email.mailbox.delete"],$command) then $answer=$protocol.mailbox_write($e,$s,$command,$p)
    elif contains(["email.calendars","email.events","email.event.get","email.event.create","email.event.update","email.event.delete","email.books","email.contacts","email.contact.get","email.contact.create","email.contact.update","email.contact.delete"],$command) then $answer=$pim.dispatch($e,$s,$command,$p)
    else raise("UNKNOWN_COMMAND","Unknown Email command") end
    reply(0,json_encode({rc:0,body:$answer,session:$s}))
  catch $message,$error
    $code=if contains(["UNKNOWN_ACCOUNT","NO_PASSWORD","NOT_FOUND","INVALID_ARGUMENT","SETTINGS","SECRETS","REFUSED","UNAVAILABLE","CONFLICT","OUTCOME_UNKNOWN"],$error.code) then $error.code else "SERVER" end
    reply(0,json_encode({rc:10,body:{error_code:$code,message:$message}}))
  end
end
