$m=require("model.mix");$t=require("transcript.mix");$s=$m.initial();$a=$s.agents
fn check($v,$why) if not $v then raise("TRANSCRIPT_TEST",$why) end end
for $e in [{seq:1,kind:"prompt",content:[{text:"Hi "},{text:"there"}]},{seq:2,kind:"agent_message_chunk",update:{content:{text:"one"}}},{seq:3,kind:"agent_message_chunk",update:{content:" two"}},{seq:4,kind:"tool_call",update:{toolCallId:"a",title:"Read file",kind:"read"}},{seq:5,kind:"tool_call_update",update:{toolCallId:"a",status:"completed"}}]
  $a=$t.take_event($a,$e)
end
check(len($a.transcript.items)==3,"chunk and tool folding")
check($a.transcript.items[0].text=="Hi there" and $a.transcript.items[1].text=="one two","content blocks")
check($a.transcript.items[2].title=="Read file" and $a.transcript.items[2].status=="completed","latest tool status")
$a=$t.take_event($a,{seq:5,kind:"prompt",content:"duplicate"});check(len($a.transcript.items)==3,"duplicates ignored")
$a=$t.take_event($a,{seq:7,kind:"stop",stop:"done"});check($a.transcript.gap,"gap recorded")
for $i=8 to 2010 $a=$t.take_event($a,{seq:$i,kind:"ready"}) end
check(len($a.transcript.events)<2000 and $a.transcript.evicted,"bounded transcript")
print("Workshop transcript contracts PASS")
