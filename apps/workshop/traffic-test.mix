$t=require("traffic.mix");$m=require("model.mix");$s=$m.initial()
fn check($v,$message) if not $v then raise("TRAFFIC_TEST",$message) end end
for $from in ["a","b"]
  $s=$t.observed($s,{message_type:"request",correlation_id:"1",from:$from,to:"ced",command:"ced.execute",ts:"2026-10-24T23:59:59.997Z",payload:{headers:{"macro-origin":"macro:ced:proof"}}})
end
$s=$t.observed($s,{message_type:"response",correlation_id:"1",from:"ced",to:"a",rc:10,ts:"2026-10-25T00:00:00.005Z",payload:{body:{token:"hidden"}}})
check(len($s.traffic)==2,"correlate by caller")
check($s.traffic[0].from=="b" and $s.traffic[0].pending,"other caller retained")
check($s.traffic[1].ms==8 and $s.traffic[1].rc==10,"midnight latency and refusal")
check($s.traffic[1].response.payload.body.token=="[redacted]","redaction before retention")
for $i=1 to 1030 $s=$t.retain($s,{seq:$i}) end
check(len($s.traffic)==1024 and $s.dropped==8,"bounded ring with drop count")
$s.traffic_paused=true;$s=$t.retain($s,{seq:9999});check($s.traffic[1023].seq==1030,"pause")
$flow=require("mesh-flow.mix");$s=$m.initial();$s.subscription="test-sub";$s.mesh.observer="workshop"
fn observe_frame($s,$frame)
  return $flow.observed($s,{headers:{type:"event",subscription_id:"test-sub"},args:{args:$frame},body:json_encode({args:$frame})})
end
$frame={message_type:"request",correlation_id:"discovery-1",from:"workshop",to:"peer",command:"HELP",payload:{headers:{workshop_job_owner:"discovery",workshop_discovery_generation:"1"}}}
$s=observe_frame($s,$frame)
$s=observe_frame($s,{message_type:"response",correlation_id:"discovery-1",from:"peer",to:"workshop",command:"HELP"})
check(len($s.traffic)==0,"tagged discovery request and correlated reply are noise")
for $frame in [{message_type:"request",correlation_id:"user-1",from:"workshop",to:"peer",command:"HELP",direction:"local"},{message_type:"request",correlation_id:"user-2",from:"peer",to:"workshop",command:"workshop.ping",direction:"local"}]
  $s=observe_frame($s,$frame)
end
check(len($s.traffic)==2 and $s.mesh.local.msgs==2,"deliberate outbound and inbound calls remain visible")
print("Workshop traffic contracts PASS")
