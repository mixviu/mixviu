-- version: 0.2.0
-- lint: globals app_launch app_args
$controller=require("controller.mix");$model=require("model.mix");$frame=require("frame.mix");$presentation=require("presentation.mix");$discovery=require("discovery.mix");$work=require("work.mix");$counter=require("counter.mix")
$saved=require("saved.mix")
$actions=require("actions.mix");$macros=require("macro.mix")
$agent_ui=require("agent-ui.mix")
$state=$model.initial();$ctx=viu_context();$state.mesh.observer=$ctx.citizen
try $launch=$app_launch catch $why $launcher=require("launch.mix");$launch=$launcher.plan($app_args) end
$state.comp=$launch.comp ?? env("MIX_COMP_SERVICE","comp");$state.startup_macro=$launch.initial_macro
fn publish_workshop($s)
  $s=$saved.reconcile($s)
  $s.busy=$model.busy($s)
  if $s.quitting and not $s.busy then $s.window_close=true end
  $projection=$frame.project($s,$presentation.project($s));$persist=$saved.project($s)
  for $key in keys($persist) $projection[$key]=$persist[$key] end
  send "viu-local" "scenes.model" body={generation:$ctx.generation,value:$projection}
  return $s
end
fn handle($s,$event)
  try return $controller.request($s,$event)
  catch $message, $error return $controller.refused($s,if contains(["BUSY","DISCONNECTED","ARGUMENT"],$error.code) then $error.code else "ARGUMENT" end,$message) end
end
$state=publish_workshop($state)
on workshop.ping
  $out=handle($state,$event);$state=$out.state
  if not $out.deferred then reply($out.rc,$counter.wire($out.body)) end
end
on workshop.info
  $out=handle($state,$event);$state=$out.state;$state=publish_workshop($state)
  if not $out.deferred then reply($out.rc,$counter.wire($out.body)) end
end
on workshop.actions
  $out=handle($state,$event);$state=$out.state;$state=publish_workshop($state)
  if not $out.deferred then reply($out.rc,$counter.wire($out.body)) end
end
on workshop.execute
