-- version: 0.2.0
-- lint: globals app_launch app_args
$controller=require("controller.mix");$model=require("model.mix");$frame=require("frame.mix");$presentation=require("presentation.mix");$discovery=require("discovery.mix");$work=require("work.mix")
$state=$model.initial();$ctx=viu_context()
try $launch=$app_launch catch $why $launcher=require("launch.mix");$launch=$launcher.plan($app_args) end
$state.comp=$launch.comp ?? env("MIXOS_COMP_SERVICE","comp");$state.startup_macro=$launch.initial_macro
fn publish_workshop($s)
  $s.busy=$model.busy($s)
  if $s.quitting and not $s.busy then $s.window_close=true end
  send "viu-local" "scenes.model" body={generation:$ctx.generation,value:$frame.project($s,$presentation.project($s))}
end
fn handle($s,$event)
  try return $controller.request($s,$event)
  catch $message, $error return $controller.refused($s,if contains(["BUSY","DISCONNECTED","ARGUMENT"],$error.code) then $error.code else "ARGUMENT" end,$message) end
end
publish_workshop($state)
on workshop.ping
  $out=handle($state,$event);$state=$out.state;publish_workshop($state)
  if not $out.deferred then reply($out.rc,json_encode($out.body)) end
end
on workshop.info
  $out=handle($state,$event);$state=$out.state;publish_workshop($state)
  if not $out.deferred then reply($out.rc,json_encode($out.body)) end
end
on workshop.actions
  $out=handle($state,$event);$state=$out.state;publish_workshop($state)
  if not $out.deferred then reply($out.rc,json_encode($out.body)) end
end
on workshop.execute
  $out=handle($state,$event);$state=$out.state;publish_workshop($state)
  if not $out.deferred then reply($out.rc,json_encode($out.body)) end
end
on workshop.theme
  $out=handle($state,$event);$state=$out.state;publish_workshop($state)
  if not $out.deferred then reply($out.rc,json_encode($out.body)) end
end
on workshop.dialog
  $out=handle($state,$event);$state=$out.state;publish_workshop($state)
  if not $out.deferred then reply($out.rc,json_encode($out.body)) end
end
on workshop.call
  $out=handle($state,$event);$state=$out.state;publish_workshop($state)
  if not $out.deferred then reply($out.rc,json_encode($out.body)) end
end
on workshop.refresh
  $out=handle($state,$event);$state=$out.state;publish_workshop($state)
  if not $out.deferred then reply($out.rc,json_encode($out.body)) end
end
on workshop.quit
  $out=handle($state,$event);$state=$out.state;publish_workshop($state)
  if not $out.deferred then reply($out.rc,json_encode($out.body)) end
end
on workshop.select
  $out=handle($state,$event);$state=$out.state;publish_workshop($state)
  if not $out.deferred then reply($out.rc,json_encode($out.body)) end
end
on workshop.body
  $out=handle($state,$event);$state=$out.state;publish_workshop($state)
  if not $out.deferred then reply($out.rc,json_encode($out.body)) end
end
on workshop.filter
  $out=handle($state,$event);$state=$out.state;publish_workshop($state)
  if not $out.deferred then reply($out.rc,json_encode($out.body)) end
end
on workshop.tree
  $out=handle($state,$event);$state=$out.state;publish_workshop($state)
  if not $out.deferred then reply($out.rc,json_encode($out.body)) end
end
on workshop.reply
  $out=handle($state,$event);$state=$out.state;publish_workshop($state)
  if not $out.deferred then reply($out.rc,json_encode($out.body)) end
end
on workshop.split
  $out=handle($state,$event);$state=$out.state;publish_workshop($state)
  if not $out.deferred then reply($out.rc,json_encode($out.body)) end
end
on workshop.dock
  $out=handle($state,$event);$state=$out.state;publish_workshop($state)
  if not $out.deferred then reply($out.rc,json_encode($out.body)) end
end
on workshop.expand
  $out=handle($state,$event);$state=$out.state;publish_workshop($state)
  if not $out.deferred then reply($out.rc,json_encode($out.body)) end
end
on workshop.select_row
  $out=handle($state,$event);$state=$out.state;publish_workshop($state)
  if not $out.deferred then reply($out.rc,json_encode($out.body)) end
end
on viu.frame.intent
  $out=$controller.execute($state,$event.args.value.command,$event.args.value.origin ?? "ui");$state=$out.state
  publish_workshop($state);reply($out.rc,json_encode($out.body))
end
on viu.frame.close
  $state.quitting=true;publish_workshop($state)
end
on workshop.dialog.intent
  if $event.args.value.instance==$state.dialog then $state.dialog=nil;publish_workshop($state) end
end
on viu.viewport.changed
  $state.window_width=$event.args.width;publish_workshop($state)
end
on workshop.layout
  $a=$event.args
  if $a.node=="inspector" then $state.split=clamp($a.value,0.1,0.8)
  elif $a.value.child=="traffic" then
    if $model.effective_dock($state)=="right" then $state.dock_width=clamp($a.value.fraction,0.2,0.5)
    else $state.dock_height=clamp($a.value.fraction,0.12,0.5) end
  end
  publish_workshop($state);reply(0,"{}")
end
on workshop.intent
  $a=$event.args
  if $state.dialog!=nil then reply(10,json_encode({error_code:"BUSY",message:"An operation is already running"}));return end
  if $a.id=="filter" then $state.filter=$a.value
  elif $a.id=="body" then
    if $state.call==nil and byte_length($a.value)<=65536 then $state.body=$a.value end
  elif $a.id=="services-tree" then
    $event.command=if $a.action=="expand" then "workshop.expand" else "workshop.select_row" end;$event.args=$a.value
    $out=handle($state,$event);$state=$out.state
  elif $a.id=="traffic-toggle" then $state.dock_open=not $state.dock_open
  elif $a.id=="traffic-side" then $state.dock_side=if $model.effective_dock($state)=="right" then "bottom" else "right" end
  elif $a.id=="traffic-pause" then $state.traffic_paused=$a.value
  elif $a.id=="traffic-filter" then $state.traffic_filter=$a.value
  else
    $id=if $a.id=="clear" then "edit.clear" elif $a.id=="call" then "bus.call" else $a.id end
    $out=$controller.execute($state,$id,"ui");$state=$out.state
  end
  publish_workshop($state);reply(0,"{}")
end
on viu.theme.changed
  $state.theme_effective=$event.args;publish_workshop($state)
end
on viu.macros.changed
  $state.macros_open=$event.args.open;publish_workshop($state)
end
on viu.keymap.changed
  $actions=require("actions.mix")
  send "viu-local" "native.bindings" body={defaults:$actions.defaults(),overrides:$event.args}
  if $rc==0 then $state.bindings=$reply.bindings;publish_workshop($state) end
end
on bus.connected
  $state.connected=true;$state.status="Connected";$state=$discovery.begin($state,nil);publish_workshop($state)
end
on bus.disconnected
  $state.connected=false;$state.status="Disconnected — requests are never replayed";publish_workshop($state)
end
on viu.job.completed
  $state=$controller.received($state,$event.args);publish_workshop($state)
end
on viu.tick
  $state=$work.launch($state)
end
on workshop.agents
  $out=handle($state,$event);$state=$out.state;publish_workshop($state)
  if not $out.deferred then reply($out.rc,json_encode($out.body)) end
end
on workshop.agents.select
  $out=handle($state,$event);$state=$out.state;publish_workshop($state)
  if not $out.deferred then reply($out.rc,json_encode($out.body)) end
end
on workshop.agents.refresh
  $out=handle($state,$event);$state=$out.state;publish_workshop($state)
  if not $out.deferred then reply($out.rc,json_encode($out.body)) end
end
on workshop.agents.filter
  $out=handle($state,$event);$state=$out.state;publish_workshop($state)
  if not $out.deferred then reply($out.rc,json_encode($out.body)) end
end
on workshop.agents.new
  $out=handle($state,$event);$state=$out.state;publish_workshop($state)
  if not $out.deferred then reply($out.rc,json_encode($out.body)) end
end
on workshop.agents.prompt
  $out=handle($state,$event);$state=$out.state;publish_workshop($state)
  if not $out.deferred then reply($out.rc,json_encode($out.body)) end
end
on workshop.agents.cancel
  $out=handle($state,$event);$state=$out.state;publish_workshop($state)
  if not $out.deferred then reply($out.rc,json_encode($out.body)) end
end
on workshop.agents.close
  $out=handle($state,$event);$state=$out.state;publish_workshop($state)
  if not $out.deferred then reply($out.rc,json_encode($out.body)) end
end
on workshop.agents.resume
  $out=handle($state,$event);$state=$out.state;publish_workshop($state)
  if not $out.deferred then reply($out.rc,json_encode($out.body)) end
end
on workshop.agents.set
  $out=handle($state,$event);$state=$out.state;publish_workshop($state)
  if not $out.deferred then reply($out.rc,json_encode($out.body)) end
end
on workshop.agents.answer
  $out=handle($state,$event);$state=$out.state;publish_workshop($state)
  if not $out.deferred then reply($out.rc,json_encode($out.body)) end
end
on workshop.macros.open
  $out=handle($state,$event);$state=$out.state;publish_workshop($state)
  if not $out.deferred then reply($out.rc,json_encode($out.body)) end
end
on workshop.macros.list
  $out=handle($state,$event);$state=$out.state;publish_workshop($state)
  if not $out.deferred then reply($out.rc,json_encode($out.body)) end
end
on workshop.macros.reload
  $out=handle($state,$event);$state=$out.state;publish_workshop($state)
  if not $out.deferred then reply($out.rc,json_encode($out.body)) end
end
on workshop.macros.run
  $out=handle($state,$event);$state=$out.state;publish_workshop($state)
  if not $out.deferred then reply($out.rc,json_encode($out.body)) end
end
on workshop.macros.status
  $out=handle($state,$event);$state=$out.state;publish_workshop($state)
  if not $out.deferred then reply($out.rc,json_encode($out.body)) end
end
on workshop.macros.output
  $out=handle($state,$event);$state=$out.state;publish_workshop($state)
  if not $out.deferred then reply($out.rc,json_encode($out.body)) end
end
on workshop.macros.stop
  $out=handle($state,$event);$state=$out.state;publish_workshop($state)
  if not $out.deferred then reply($out.rc,json_encode($out.body)) end
end
on workshop.macros.new
  $out=handle($state,$event);$state=$out.state;publish_workshop($state)
  if not $out.deferred then reply($out.rc,json_encode($out.body)) end
end
on workshop.macros.get
  $out=handle($state,$event);$state=$out.state;publish_workshop($state)
  if not $out.deferred then reply($out.rc,json_encode($out.body)) end
