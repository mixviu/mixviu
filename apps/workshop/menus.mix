$actions=require("actions.mix")
fn registry($s) return $actions.registry($s) end
fn menus($s)
  $actions=registry($s);$out=[]
  for $menu in ["File","Edit","View","Bus","Macros","Help"]
    $children=[];$last=nil;$theme=[];$theme_group=nil
    for $a in filter($actions,fn($a)=$a.menu==$menu)
      $group=if $a.id=="file.quit" or $a.id=="view.tree" or $a.id=="view.pause" or $a.id=="process.copy" or $a.id=="help.about" then 1 else 0 end
      -- Prefix checks stay explicit: identifiers are public command data.
      $is_theme=starts_with($a.id,"view.theme.") or starts_with($a.id,"view.mode.") or starts_with($a.id,"view.style.") or starts_with($a.id,"view.decorations.") or starts_with($a.id,"view.captions.")
      $row={id:$a.id,label:$a.label,enabled:$a.enabled,checked:$a.checked,shortcut:$a.shortcut}
      if $is_theme then
        $tg=if starts_with($a.id,"view.theme.") then (if contains(["pro","studio","classic","breeze","adwaita","mixos"],slice($a.id,11)) then 1 elif $a.id=="view.theme.session" then 2 else 0 end) elif starts_with($a.id,"view.mode.") then 3 elif starts_with($a.id,"view.style.") then 4 else 5 end
        if $theme_group!=nil and $theme_group!=$tg then push($theme,{separator:true}) end
        push($theme,$row);$theme_group=$tg
      else
        if $last!=nil and $last!=$group then push($children,{separator:true}) end
        push($children,$row);$last=$group
      end
    end
    if len($theme)>0 then push($children,{separator:true});push($children,{id:"theme-menu",label:"Theme",enabled:true,children:$theme}) end
    push($out,{id:$menu,label:$menu,enabled:true,children:$children})
  end
  return $out
end
