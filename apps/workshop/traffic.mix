-- SPDX-License-Identifier: MIT OR Apache-2.0
-- Bounded observation ring and redaction, adapted from gold inspector/workshop.rs.
$counter=require("counter.mix")
$work=require("work.mix")
-- Raw inputs stay in this private, bounded queue until an isolated native Job
-- returns the complete redacted value. Neither rows() nor presentation exports
-- this queue. Notice callbacks perform no recursive redaction work.
fn defer_row($s,$row,$observed)
  if $observed then $s.dropped=$counter.add($s.dropped,$row.dropped_count ?? 0) end
  if $s.traffic_paused or $s.quitting then return $s end
  $q=$s.traffic_redaction ?? {waiting:[],bytes:0,active:nil}
  $bytes=byte_length(json_encode($row))
  $active_bytes=if $q.active==nil then 0 else $q.active.bytes end
  -- Active work cannot be evicted. Reject impossible admission before touching
  -- valid waiting rows, even when the incoming row alone exceeds the cap.
  if $active_bytes+$bytes>8388608 then $s.dropped=$counter.add($s.dropped,1);return $s end
  while len($q.waiting)>0 and (len($q.waiting)+(if $q.active!=nil then $q.active.count else 0 end)>=1024 or $q.bytes+$bytes>8388608)
    $q.bytes=$q.bytes-$q.waiting[0].bytes;$q.waiting=slice($q.waiting,1);$s.dropped=$s.dropped+1
  end
  if $q.bytes+$bytes>8388608 then $s.dropped=$s.dropped+1
  else $q.waiting=push($q.waiting,{row:$row,observed:$observed,bytes:$bytes});$q.bytes=$q.bytes+$bytes end
  $s.traffic_redaction=$q;return $s
end
fn launch($s)
  $q=$s.traffic_redaction
  if $s.quitting or $s.traffic_paused or $q==nil or $q.active!=nil or len($q.waiting)==0 then return $s end
  -- Keep changes below the publisher's wire budget: at most 64 rows / 256 KiB.
  -- One larger admissible row runs alone so it can always make progress.
  $rows=[];$entries=[];$bytes=0
  for $entry in $q.waiting
    if len($rows)>=64 or (len($rows)>0 and $bytes+$entry.bytes>262144) then break end
    push($rows,$entry.row);push($entries,{observed:$entry.observed});$bytes=$bytes+$entry.bytes
  end
  $q.waiting=slice($q.waiting,len($rows));$q.active={bytes:$bytes,count:len($rows),entries:$entries}
  $s.traffic_redaction=$q
  return $work.enqueue($s,{owner:"traffic",op:"redact",job:"traffic-redact-job.mix",lane:"traffic",rows:$rows,redaction_generation:$s.traffic_generation})
end
fn completed($s,$d,$generation)
  if $s.traffic_redaction==nil or $generation!=$s.traffic_generation then return $s end
  $active=$s.traffic_redaction.active
  if $active==nil then return $s end
  $s.traffic_redaction.active=nil;$s.traffic_redaction.bytes=$s.traffic_redaction.bytes-$active.bytes
  if $d.rc!=0 or type($d.body)!="map" or type($d.body.rows)!="list" or len($d.body.rows)!=$active.count or any($d.body.rows,fn($row)=type($row)!="map") then
    $s.dropped=$counter.add($s.dropped,$active.count);return $s
  end
  for $i=0 to $active.count-1
    if $active.entries[$i].observed then $s=observed($s,$d.body.rows[$i],true)
    else $s=retain($s,$d.body.rows[$i],true) end
  end
  return $s
end
fn redact($v)
  if type($v)=="map" then
    for $key in keys($v)
      if any(["password","token","secret","credential","authorization","cookie"],fn($word)=contains(lower($key),$word)) then $v[$key]="[redacted]"
      else $v[$key]=redact($v[$key]) end
    end
  elif type($v)=="list" then $v=map($v,fn($item)=redact($item)) end
  return $v
end
fn retain($s,$row,$redacted=false)
  if $s.traffic_paused then return $s end
  if not $redacted then $row=redact($row) end
  if not has_key($row,"service") then $row.service=$row.to end
  $bytes=byte_length(json_encode($row))
  if $bytes>8388608 then $s.dropped=$s.dropped+1;return $s end
  while len($s.traffic)>=1024 or $s.traffic_bytes+$bytes>8388608
    $s.traffic_bytes=$s.traffic_bytes-byte_length(json_encode($s.traffic[0]));$s.traffic=slice($s.traffic,1);$s.dropped=$s.dropped+1
  end
  $s.traffic=push($s.traffic,$row);$s.traffic_bytes=$s.traffic_bytes+$bytes
  return $s
end
fn clock_ms($v)
  if type($v)!="string" then return nil end
  try
    $clock=if len($v)>=23 then substr($v,11,12) else $v end
    $parts=split($clock,":");if len($parts)!=3 then return nil end
    $sec=split($parts[2],".");if len($sec)!=2 then return nil end
    $h=to_number($parts[0]);$m=to_number($parts[1]);$s=to_number($sec[0]);$ms=to_number($sec[1])
    if $h<0 or $h>=24 or $m<0 or $m>=60 or $s<0 or $s>=60 or $ms<0 or $ms>=1000 then return nil end
    return (($h*60+$m)*60+$s)*1000+$ms
  catch $why return nil end
end
fn observed($s,$frame,$redacted=false)
  if not $redacted then $s.dropped=$counter.add($s.dropped,$frame.dropped_count ?? 0) end
  if $s.traffic_paused then return $s end
  if $frame.message_type=="response" and type($frame.correlation_id)=="string" then
    $index=nil
    for $i=0 to len($s.traffic)-1
      $r=$s.traffic[$i]
      if $r.pending==true and $r.correlation_id==$frame.correlation_id and $r.from==$frame.to and $r.to==$frame.from then $index=$i end
    end
    if $index!=nil then
      $row=$s.traffic[$index];$s.traffic_bytes=$s.traffic_bytes-byte_length(json_encode($row))
      $s.traffic=concat(slice($s.traffic,0,$index),slice($s.traffic,$index+1));$row.pending=false;$row.rc=$frame.rc
      $mesh=contains(["mesh_out","mesh_in"],$row.direction) or contains(["mesh_out","mesh_in"],$frame.direction)
      $start=clock_ms($row.ts);$end=clock_ms($frame.ts)
      if not $mesh and $start!=nil and $end!=nil then $row.ms=($end+86400000-$start)%86400000 end
      $row.response=$frame;return retain($s,$row,$redacted)
    end
    $frame.service=$frame.from
  elif $frame.message_type=="request" then $frame.pending=true end
  return retain($s,$frame,$redacted)
end
fn rows($s,$limit,$filter)
  if $filter=="" then return slice($s.traffic,max(0,len($s.traffic)-min($limit,1024))) end
  return reverse(take(filter(reverse($s.traffic),fn($row)=contains(json_encode($row),$filter)),min($limit,1024)))
end
