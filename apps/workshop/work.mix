$path=path_join(dirname(script_path()),"rpc-job.mix");$source=read_file($path);$counter=require("counter.mix")
fn enqueue($s,$task)
  $task.generation=$s.generation;$task.queued=monotonic();$s.queue=push($s.queue,$task)
  return $s
end
fn launch($s)
  $waiting=[];$admitted=0;$now=monotonic()
  for $task in $s.queue
    $lane=$task.lane ?? "local"
    $used=len(filter(values($s.jobs),fn($j)=($j.lane ?? "local")==$lane))
    if $used>=6 or len($s.jobs)>=15 or $admitted>=2 or $now<($task.retry_at ?? 0) then push($waiting,$task);continue end
    $s.serial=$s.serial+1;$id="workshop-"..to_string($s.serial)
    $job_path=if $task.job!=nil then path_join(dirname($path),$task.job) else $path end
    send "viu-local" "jobs.start" id=$id owner=$task.generation path=$job_path source=read_file($job_path) command="job.run" args=$task timeout_seconds=(if contains(["discovery","subscription"],$task.owner) then 4 else 180 end)
    $admitted=$admitted+1
    if $rc!=0 then $task.retry_at=$now+1;push($waiting,$task);continue end
    $s.jobs[$id]=$task
  end
  $s.queue=$waiting
  return $s
end
fn defer($event)
  $id=to_number($event.headers.id)
  send "viu-local" "native.defer" body={id:$id}
  if $rc!=0 then raise("DEFER",to_string($result)) end
  return $id
end
fn answer($id,$rc,$value)
  if $id!=nil then send "viu-local" "native.reply" body={id:$id,rc:$rc,value_json:$counter.wire($value)} end
end
fn answer_json($id,$rc,$json)
  if $id!=nil then send "viu-local" "native.reply" body={id:$id,rc:$rc,value_json:$json} end
end
