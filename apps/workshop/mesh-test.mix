$t=require("mesh.mix");$now=$t.ts_ms("2026-10-25T13:10:00.000Z");$s=$t.initial("alpha","observer",$now-60000)
fn check($ok,$why) if not $ok then raise("MESH_TEST",$why) end end
check($t.ts_ms("2026-10-25T13:09:40.040Z")==$now-19960,"fractional UTC timestamp")
check($t.ts_ms("bad")==nil,"invalid timestamp")
$s=$t.set_nodes($s,{name:"alpha",wg_ip:"192.0.2.1"},{authority:{routing_view:[{name:"gamma",wg_ip:"192.0.2.3"},{name:"beta",wg_ip:"192.0.2.2"},{name:"gone",class:"tombstone"},{name:"alpha"}]}})
check(deep_eq(map($s.nodes,fn($n)=$n.name),["alpha","beta","gamma"]),"active Bus peers sorted, local excluded")
$s=$t.add_event($s,{ts:"2026-10-25T13:09:40.000Z",direction:"mesh_out",to:"noded.beta.bus",command:"noded.info",message_type:"request",correlation_id:"c1",outcome:"delivered",size:69},$now)
$s=$t.add_event($s,{ts:"2026-10-25T13:09:40.040Z",direction:"mesh_in",from:"noded",command:"noded.info",message_type:"response",correlation_id:"c1",outcome:"delivered",size:385},$now)
check(len($s.pending)==0 and $s.links.beta.out_msgs==1 and $s.links.beta.in_msgs==1,"response correlation places inbound peer")
$s=$t.add_event($s,{ts:"2026-10-25T13:09:55.000Z",direction:"local",to:"webd",command:"webd.info",message_type:"request",outcome:"delivered",size:100},$now)
$snap=$t.snapshot($s,$now)
check($snap.local.msgs_1m==1 and $snap.links[0].out_bytes==69 and $snap.links[0].in_bytes==385,"bounded time windows")
check($snap.nodes[0].self and not $snap.nodes[1].self,"gold node serialization")
check($snap.local.top_services[0].name=="webd","local services")
$s=$t.set_probe($s,{beta:{ok:false,rc:nil,ms:2000,at:$now}},$now)
check($t.ping_failed($s,"beta"),"failed ping survives prior inbound")
$s=$t.add_event($s,{direction:"mesh_out",peer:"beta",from:"webd",to:"webd.beta.bus",size:1},$now+1)
check($t.ping_failed($s,"beta"),"outbound does not clear failure")
$s=$t.add_event($s,{direction:"mesh_in",peer:"beta",from:"webd.beta.bus",to:"webd",size:1},$now+2)
check(not $t.ping_failed($s,"beta"),"newer inbound clears failure")
$s=$t.prune($s,$now+400000);check(len($s.recent)==0 and len($s.buckets)==0,"expiry")
print("Workshop mesh contracts PASS")
