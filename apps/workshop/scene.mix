---
scene: 1
name: workshop
citizen: workshop
---
```mix
{
root:{widget:"dock",children:["traffic","inspector"],placements:"= $model.placements",on_change:"workshop.layout"},
inspector:{widget:"split",children:["services","details"],axis:"= $model.axis",ratio:"= $model.split",minimum:0.1,maximum:0.8,divider:6,on_change:"workshop.layout"},
services:{widget:"column",group_title:"Nodes and services",background:"design.dock",padding:8,children:["filter","services-tree"],gap:6},
filter:{widget:"control",definition:{id:"filter",kind:"field",label:"Search services and commands",initial:"",properties:{placeholder:"Search services and commands",search:true}},on_intent:"workshop.intent"},
"services-tree":{widget:"control",definition:"= $model.tree",on_intent:"workshop.intent"},
details:{widget:"column",group_title:"Details",scroll:true,background:"design.dock",padding:8,children:["description","details-divider","body-actions","body","reply-title","reply"],gap:6},
description:{widget:"control",definition:{id:"description",kind:"label",label:"",initial:"",properties:{scroll_lines:6,max_bytes:8388608}}},
"details-divider":{widget:"control",definition:{id:"details-divider",kind:"divider",label:"",initial:nil,properties:{}}},
"body-actions":{widget:"row",children:["body-title","clear","call"],gap:6},
"body-title":{widget:"control",grow:1,definition:{id:"body-title",kind:"label",label:"",initial:"JSON body (optional)",properties:{role:"section"}}},
clear:{widget:"control",definition:"= $model.clear_button",on_intent:"workshop.intent"},
call:{widget:"control",definition:"= $model.call_button",on_intent:"workshop.intent"},
body:{widget:"control",definition:"= $model.body_editor",on_intent:"workshop.intent"},
"reply-title":{widget:"control",definition:{id:"reply-title",kind:"label",label:"",initial:"Reply",properties:{role:"section"}}},
reply:{widget:"control",definition:{id:"reply",kind:"editor",label:"Reply",initial:"",properties:{rows:4,read_only:true,max_bytes:1000100}}},
traffic:{widget:"column",background:"design.dock",padding:8,children:["traffic-controls","traffic-content"],gap:6},
"traffic-controls":{widget:"row",children:["traffic-toggle","traffic-side","traffic-pause","traffic-filter","traffic-state"],gap:6},
"traffic-toggle":{widget:"control",definition:{id:"traffic-toggle",kind:"button",label:"Traffic",initial:"",properties:{text:"Traffic"}},on_intent:"workshop.intent"},
"traffic-side":{widget:"control",definition:{id:"traffic-side",kind:"button",label:"Move Traffic",initial:"",properties:{icon:"panel-right",text:""}},on_intent:"workshop.intent"},
"traffic-pause":{widget:"control",hidden:"= $model.traffic_hidden",definition:{id:"traffic-pause",kind:"toggle",label:"Pause",initial:false,properties:{text:"Pause"}},on_intent:"workshop.intent"},
"traffic-filter":{widget:"control",hidden:"= $model.traffic_hidden",definition:{id:"traffic-filter",kind:"field",label:"Filter traffic",initial:"",properties:{placeholder:"Filter traffic",width:160}},on_intent:"workshop.intent"},
"traffic-state":{widget:"control",hidden:"= $model.traffic_hidden",definition:{id:"traffic-state",kind:"label",label:"",initial:"",properties:{weak:true}}},
"traffic-content":{widget:"control",hidden:"= $model.traffic_hidden",definition:{id:"traffic-content",kind:"label",label:"",initial:"",properties:{}}}
}
```
