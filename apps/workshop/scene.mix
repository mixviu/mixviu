---
scene: 1
name: workshop
citizen: workshop
---
```mix
{
root:{widget:"dock",children:["traffic","inspector"],placements:"= $model.placements",on_change:"workshop.layout"},
inspector:{widget:"dock",children:["services","details"],placements:"= $model.inspector_placements",on_change:"workshop.layout"},
services:{widget:"column",group_title:"Nodes and services",group_frame:false,background:"design.dock",padding:8,children:["filter","services-tree"],gap:6},
filter:{widget:"control",definition:{id:"filter",kind:"field",label:"Search services and commands",initial:"",properties:{placeholder:"Search services and commands",search:true}},on_intent:"workshop.intent"},
"services-tree":{widget:"control",definition:"= $model.tree",on_intent:"workshop.intent"},
details:{widget:"column",scroll:true,scroll_key:"= $model.details_key",reserve_panel_after:"= !$model.show_macro",background:"design.dock",children:["macro-new","command-panel","macro-panel","mesh-panel","agent-panel"],gap:6},
"macro-new":{widget:"control",hidden:"= !$model.macro_new_visible",definition:"= $model.macro_new",on_intent:"workshop.intent"},
"command-panel":{widget:"column",group_title:"Details",group_key:"details",group_frame:false,hidden:"= !$model.show_command",background:"design.dock",padding:8,children:["description","details-divider","body-actions","body","reply-title","reply"],gap:6},
description:{widget:"control",definition:{id:"description",kind:"label",label:"",initial:"",properties:{scroll_lines:6,max_bytes:8388608}}},
"details-divider":{widget:"control",definition:{id:"details-divider",kind:"divider",label:"",initial:nil,properties:{axis:"horizontal"}}},
"body-actions":{widget:"row",justify:"between",native_spacing:true,children:["body-title","clear","call"]},
"body-title":{widget:"control",grow:1,definition:{id:"body-title",kind:"label",label:"",initial:"JSON body (optional)",properties:{role:"section"}}},
clear:{widget:"control",definition:"= $model.clear_button",on_intent:"workshop.intent"},
call:{widget:"control",definition:"= $model.call_button",on_intent:"workshop.intent"},
body:{widget:"control",definition:"= $model.body_editor",on_intent:"workshop.intent"},
"reply-title":{widget:"control",definition:{id:"reply-title",kind:"label",label:"",initial:"Reply",properties:{role:"section"}}},
reply:{widget:"control",definition:{id:"reply",kind:"editor",label:"Reply",initial:"",properties:{rows:4,read_only:true,fill_height:true,max_bytes:1000100}}},
"macro-panel":{widget:"column",hidden:"= !$model.show_macro",children:["macro-title","macro-meta","macro-editor-area","macro-dirty","macro-buttons","macro-confirmation","macro-message"],gap:6},
"macro-title":{widget:"control",definition:{id:"macro-title",kind:"label",label:"",initial:"",properties:{role:"heading"}}},
"macro-meta":{widget:"control",definition:{id:"macro-meta",kind:"label",label:"",initial:"",properties:{small:true}}},
"macro-editor-area":{widget:"column",children:["macro-source"],min_height:"= $model.macro_editor_height",max_height:"= $model.macro_editor_height"},
"macro-source":{widget:"control",definition:"= $model.macro_editor",on_intent:"workshop.intent"},
"macro-dirty":{widget:"control",hidden:"= !$model.macro_dirty",definition:{id:"macro-dirty",kind:"label",label:"",initial:"Unsaved changes",properties:{small:true}}},
"macro-buttons":{widget:"row",native_spacing:true,wrap:true,gap:6,children:["macro-put","macro-target","macro-run","macro-stop","macro-destination","macro-copy","macro-move","macro-ced","macro-dopus","macro-remove"]},
"macro-put":{widget:"control",definition:{id:"macro-put",kind:"button",label:"Save",initial:"",properties:{text:"Save"}},on_intent:"workshop.intent"},
"macro-target":{widget:"control",hidden:"= !$model.macro_target_visible",definition:"= $model.macro_target",on_intent:"workshop.intent"},
"macro-run":{widget:"control",definition:{id:"macro-run",kind:"button",label:"Run",initial:"",properties:{text:"Run"}},on_intent:"workshop.intent"},
"macro-stop":{widget:"control",definition:{id:"macro-stop",kind:"button",label:"Stop",initial:"",properties:{text:"Stop"}},on_intent:"workshop.intent"},
"macro-destination":{widget:"control",hidden:"= !$model.macro_destination_visible",definition:"= $model.macro_destination",on_intent:"workshop.intent"},
"macro-copy":{widget:"control",definition:{id:"macro-copy",kind:"button",label:"Copy to user",initial:"",properties:{text:"Copy to user"}},on_intent:"workshop.intent"},
"macro-move":{widget:"control",definition:{id:"macro-move",kind:"button",label:"Move",initial:"",properties:{text:"Move"}},on_intent:"workshop.intent"},
"macro-ced":{widget:"control",definition:{id:"macro-ced",kind:"button",label:"Open in Ced",initial:"",properties:{text:"Open in Ced"}},on_intent:"workshop.intent"},
"macro-dopus":{widget:"control",definition:{id:"macro-dopus",kind:"button",label:"Show in Dopus",initial:"",properties:{text:"Show in Dopus"}},on_intent:"workshop.intent"},
"macro-remove":{widget:"control",definition:{id:"macro-remove",kind:"button",label:"Delete",initial:"",properties:{text:"Delete"}},on_intent:"workshop.intent"},
"macro-confirmation":{widget:"row",hidden:"= !$model.macro_confirm",children:["macro-delete-label","macro-delete-confirm","macro-delete-cancel"],gap:6},
"macro-delete-label":{widget:"control",definition:{id:"macro-delete-label",kind:"label",label:"",initial:"Delete this user macro?"}},
"macro-delete-confirm":{widget:"control",definition:{id:"macro-delete-confirm",kind:"button",label:"Delete",initial:"",properties:{text:"Delete"}},on_intent:"workshop.intent"},
"macro-delete-cancel":{widget:"control",definition:{id:"macro-delete-cancel",kind:"button",label:"Cancel",initial:"",properties:{text:"Cancel"}},on_intent:"workshop.intent"},
"macro-message":{widget:"control",definition:{id:"macro-message",kind:"label",label:"",initial:"",properties:{mono:true}}},
"mesh-panel":{widget:"column",hidden:"= !$model.show_mesh",children:["mesh-header","mesh-observation","mesh-loss","mesh-observe-error","mesh-start","mesh-nodes-error","mesh-scope","mesh-legend","mesh-loading","mesh-main"],gap:6},
"mesh-header":{widget:"row",native_spacing:true,children:["mesh-title","mesh-ping"],gap:6},
"mesh-title":{widget:"control",definition:{id:"mesh-title",kind:"label",label:"",initial:"Mesh",properties:{role:"section"}}},
"mesh-ping":{widget:"control",definition:"= $model.mesh_ping",on_intent:"workshop.intent"},
"mesh-observation":{widget:"control",definition:"= $model.mesh_observation"},
"mesh-loss":{widget:"control",hidden:"= $model.mesh_loss == \"\"",definition:{id:"mesh-loss",kind:"label",label:"",initial:"",properties:{tone:"warning"}}},
"mesh-observe-error":{widget:"control",hidden:"= $model.mesh_observe_error == \"\"",definition:{id:"mesh-observe-error",kind:"label",label:"",initial:"",properties:{error:true}}},
"mesh-start":{widget:"control",hidden:"= !$model.mesh_start_visible",definition:"= $model.mesh_start",on_intent:"workshop.intent"},
"mesh-nodes-error":{widget:"control",hidden:"= $model.mesh_nodes_error == \"\"",definition:{id:"mesh-nodes-error",kind:"label",label:"",initial:""}},
"mesh-scope":{widget:"control",definition:{id:"mesh-scope",kind:"label",label:"",initial:"Only this node's broker is observed. Dashed peer links carry traffic this node cannot see.",properties:{small:true}}},
"mesh-legend":{widget:"control",definition:"= $model.mesh_legend"},
"mesh-loading":{widget:"control",hidden:"= !$model.mesh_empty",definition:{id:"mesh-loading",kind:"label",label:"",initial:"Reading this node and its mesh peers…"}},
"mesh-main":{widget:"column",native_spacing:true,hidden:"= $model.mesh_empty",children:["mesh-canvas","mesh-node-divider","mesh-inspector-title","mesh-counts","mesh-history-label","mesh-history","mesh-local-text","mesh-top-lists","mesh-ping-text","mesh-unplaced"],gap:6},
"mesh-canvas":{widget:"control",definition:"= $model.mesh_canvas",on_intent:"workshop.intent"},
"mesh-node-divider":{widget:"control",definition:{id:"mesh-node-divider",kind:"divider",label:"",initial:nil,properties:{axis:"horizontal"}}},
"mesh-inspector-title":{widget:"control",definition:{id:"mesh-inspector-title",kind:"label",label:"",initial:"",properties:{bold:true}}},
"mesh-counts":{widget:"control",definition:"= $model.mesh_counts"},
"mesh-history-label":{widget:"control",hidden:"= $model.mesh_local",definition:{id:"mesh-history-label",kind:"label",label:"",initial:"Messages/s · last 5 minutes · out solid, in dashed",properties:{small:true}}},
"mesh-history":{widget:"control",hidden:"= $model.mesh_local",definition:"= $model.mesh_history"},
"mesh-local-text":{widget:"control",hidden:"= !$model.mesh_local",definition:{id:"mesh-local-text",kind:"label",label:"",initial:""}},
"mesh-top-lists":{widget:"grid",columns:2,column_gap:12,row_gap:0,min_column_width:0,hidden:"= !$model.mesh_has_stats",children:["mesh-services","mesh-commands"]},
"mesh-services":{widget:"control",definition:"= $model.mesh_services"},
"mesh-commands":{widget:"control",definition:"= $model.mesh_commands"},
"mesh-ping-text":{widget:"control",hidden:"= $model.mesh_local",definition:{id:"mesh-ping-text",kind:"label",label:"",initial:""}},
"mesh-unplaced":{widget:"control",definition:"= $model.mesh_unplaced"},
"agent-panel":{native_spacing:true,widget:"column",hidden:"= !$model.show_agents",children:["agent-intro","agent-new-panel","agent-session-panel","agent-error"],gap:6},
"agent-intro":{widget:"control",hidden:"= !$model.agent_intro",definition:{id:"agent-intro",kind:"label",label:"",initial:"Coding agents run by agentd on this node and its peers. Select a session to read its transcript."}},
"agent-new-panel":{native_spacing:true,widget:"column",hidden:"= !$model.agent_new",children:["agent-new-label","agent-newform","agent-cap","agent-start","agent-new-error"],gap:6},
"agent-new-label":{widget:"control",definition:{id:"agent-new-label",kind:"label",label:"",initial:"New session…",properties:{role:"section"}}},
"agent-newform":{widget:"control",definition:"= $model.agent_newform",on_intent:"workshop.intent"},
"agent-cap":{widget:"control",definition:{id:"agent-cap",kind:"label",label:"",initial:"",properties:{weak:true}}},
"agent-start":{widget:"control",definition:"= $model.agent_start",on_intent:"workshop.intent"},
"agent-error":{widget:"control",hidden:"= $model.agent_error == \"\" or $model.agent_new or $model.agent_session",definition:{id:"agent-error",kind:"label",label:"",initial:"",properties:{error:true}}},
"agent-new-error":{widget:"control",hidden:"= $model.agent_error == \"\"",definition:{id:"agent-new-error",kind:"label",label:"",initial:"",properties:{error:true}}},
"agent-session-error":{widget:"control",hidden:"= $model.agent_error == \"\"",definition:{id:"agent-session-error",kind:"label",label:"",initial:"",properties:{error:true}}},
"agent-session-panel":{native_spacing:true,widget:"column",hidden:"= !$model.agent_session",children:["agent-title","agent-header","agent-actions","agent-session-error","agent-divider","agent-transcript-label","agent-evicted","agent-gap","agent-transcript","agent-permissions","agent-composer-panel"],gap:6},
"agent-title":{widget:"control",definition:{id:"agent-title",kind:"label",label:"",initial:"",properties:{role:"section"}}},
"agent-header":{widget:"control",definition:"= $model.agent_header",on_intent:"workshop.intent"},
"agent-actions":{native_spacing:true,widget:"row",children:["agent-cancel","agent-close","agent-resume"],gap:6},
"agent-cancel":{widget:"control",hidden:"= !$model.agent_running",definition:{id:"agent-cancel",kind:"button",label:"Cancel turn",initial:"",properties:{text:"Cancel turn",style:"secondary"}},on_intent:"workshop.intent"},
"agent-close":{widget:"control",hidden:"= !$model.agent_live",definition:{id:"agent-close",kind:"button",label:"Close",initial:"",properties:{text:"Close",style:"secondary"}},on_intent:"workshop.intent"},
"agent-resume":{widget:"control",hidden:"= !$model.agent_ended",definition:{id:"agent-resume",kind:"button",label:"Resume",initial:"",properties:{text:"Resume",style:"primary"}},on_intent:"workshop.intent"},
"agent-divider":{widget:"control",definition:{id:"agent-divider",kind:"divider",label:"",initial:nil,properties:{axis:"horizontal",style:"native"}}},
"agent-transcript-label":{widget:"control",definition:{id:"agent-transcript-label",kind:"label",label:"",initial:"Transcript",properties:{role:"section"}}},
"agent-evicted":{widget:"control",hidden:"= !$model.agent_evicted",definition:{id:"agent-evicted",kind:"label",label:"",initial:"Older events are not shown.",properties:{weak:true}}},
"agent-gap":{widget:"control",hidden:"= !$model.agent_gap",definition:{id:"agent-gap",kind:"label",label:"",initial:"Some events are missing from the session log.",properties:{weak:true}}},
"agent-transcript":{widget:"control",definition:"= $model.agent_transcript",on_intent:"workshop.intent"},
"agent-permissions":{widget:"control",definition:"= $model.agent_permissions",on_intent:"workshop.intent"},
"agent-composer-panel":{native_spacing:true,widget:"column",hidden:"= !$model.agent_live",children:["agent-composer-divider","agent-composer","agent-send-row"],gap:6},
"agent-composer-divider":{widget:"control",definition:{id:"agent-composer-divider",kind:"divider",label:"",initial:nil,properties:{axis:"horizontal",style:"native"}}},
"agent-composer":{widget:"control",definition:"= $model.agent_composer",on_intent:"workshop.intent"},
"agent-send-row":{native_spacing:true,widget:"row",align:"end",children:["agent-send"]},
"agent-send":{widget:"control",definition:"= $model.agent_send",on_intent:"workshop.intent"},
traffic:{widget:"column",native_spacing:true,children:["traffic-controls","traffic-content"],gap:6},
"traffic-controls":{widget:"row",native_spacing:true,wrap:true,children:["traffic-toggle","traffic-side","traffic-pause","traffic-filter","traffic-state"],gap:6},
"traffic-toggle":{widget:"control",definition:"= $model.traffic_toggle",on_intent:"workshop.intent"},
"traffic-side":{widget:"control",definition:"= $model.traffic_side",on_intent:"workshop.intent"},
"traffic-pause":{widget:"control",hidden:"= $model.traffic_hidden",definition:{id:"traffic-pause",kind:"checkbox",label:"Pause",initial:false,properties:{text:"Pause"}},on_intent:"workshop.intent"},
"traffic-filter":{widget:"control",hidden:"= $model.traffic_hidden",definition:{id:"traffic-filter",kind:"field",label:"Filter traffic",initial:"",properties:{placeholder:"Filter traffic",width:160}},on_intent:"workshop.intent"},
"traffic-state":{widget:"control",hidden:"= $model.traffic_hidden",definition:{id:"traffic-state",kind:"label",label:"",initial:"",properties:{small:true}}},
"traffic-content":{widget:"control",hidden:"= $model.traffic_hidden",definition:"= $model.traffic_view"}
}
```
