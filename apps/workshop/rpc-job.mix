-- SPDX-License-Identifier: MIT OR Apache-2.0
$model=require("model.mix")
on job.run
  $a=$event.args
  try
    if $a.op=="describe" then
      $started=monotonic();$ok=false;$why=""
      try
        send $a.service "HELP" body="" timeout=3
        if $rc>=10 then raise("HELP",to_string($result)) end
        $commands=$model.catalogue($reply);$ok=true
      catch $message $why=$message end
      if not $ok then
        $left=3-(monotonic()-$started)
        if $left<0.1 then raise("HELP",$why) end
        send $a.service "app.describe" body="" timeout=$left
        if $rc>=10 then raise("DESCRIBE","HELP: "..$why.."\napp.describe: "..to_string($result)) end
        $commands=$model.catalogue($reply)
      end
      reply(0,json_encode({Ok:$commands}))
    else
      send $a.service $a.command body=($a.body ?? "") timeout=($a.timeout ?? 3) reply_mode="raw"
      reply(if $reply.transport_error!=nil then 20 else 0 end,json_encode($reply))
    end
  catch $message
    reply(20,json_encode({transport_error:$message}))
  end
end
