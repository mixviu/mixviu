-- SPDX-License-Identifier: MIT OR Apache-2.0
$core=require("core.mix")
$view=require("view.mix")
$actions=require("actions.mix")
fn check($on,$message) if not $on then raise("TEST",$message) end end
fn frame($kind,$caller="client",$id="1",$ts="2026-11-15T01:02:03.000Z")
  $request=$kind=="request"
  return {seq:1,ts:$ts,message_type:$kind,from:if $request then $caller else "example" end,to:if $request then "example" else $caller end,command:"example.ping",correlation_id:$id,rc:if $request then nil else 0 end,size:42,direction:"local",outcome:"delivered",dropped_count:0,payload:{secret:"must not survive"}}
end
$s=$core.initial()
check(deep_eq($s.limits,{history:2000,pending:4096,tombstones:4096,services:256}),"production limits unchanged")
$s=$core.observed($s,frame("request"),1)
$s=$core.observed($s,frame("response","client","1","2026-11-15T01:02:03.012Z"),1.012)
check($s.rows[1].latency_ms==12,"named request/reply")
check(not contains(json_encode($s),"must not survive"),"metadata only")
$s=$core.initial()
$s=$core.observed($s,frame("request",nil),1)
$s=$core.observed($s,frame("request",nil),1.1)
$s=$core.observed($s,frame("response",nil),1.2)
check($s.rows[2].latency_ms==nil and $s.rows[0].from=="(anon)","anonymous collision stays unpaired")
$s=$core.initial()
$s=$core.observed($s,frame("request"),1)
$s=$core.observed($s,frame("request"),1.1)
$s=$core.observed($s,frame("response"),1.2)
check($s.rows[2].latency_ms==nil,"duplicate named key ambiguous")
$s=$core.initial()
$r=frame("response");$r.command=nil;$r.outcome="rejected";$r.rc=10
$s=$core.observed($s,$r,1)
$s=$core.observed($s,frame("request"),1)
check($s.rows[0].latency_ms==nil and $s.rows[0].error,"reject-first does not pair backwards")
$s=$core.observed($s,frame("response"),32)
check($s.rows[2].latency_ms==nil,"expiry uses arrival age")
$s=$core.initial()
$s=$core.observed($s,frame("request","client","1","2026-11-15T23:59:59.999Z"),1)
$s=$core.observed($s,frame("response","client","1","2026-11-16T00:00:00.001Z"),1.002)
check($s.rows[1].latency_ms==2,"midnight")
$f=$core.filter_edit($s.filter,{text:"EXAMPLE.PING"})
check($core.visible($s.rows[0],$f),"case insensitive text")
$f.hide=["example"];check(not $core.visible($s.rows[0],$f),"hide service")
$f.hide=[];$f.services=["elsewhere"];check(not $core.visible($s.rows[0],$f),"services")
$f.services=[];$f.commands=["other"];check(not $core.visible($s.rows[0],$f),"commands")
$f.commands=[];$f.directions=["mesh_in"];check(not $core.visible($s.rows[0],$f),"directions")
$f=$core.initial().filter;$r=$s.rows[0];$r.from="bustap"
check(not $core.visible($r,$f),"own hidden by default")
$f.own=true;check($core.visible($r,$f),"own toggle")
for $bad in [{own:1},{text:[]},{hide:"example"},{services:[1]},{directions:["invalid"]},{body:"redacted"}]
  $failed=false
  try $unused=$core.filter_edit($f,$bad) catch $why $failed=true end
  check($failed,"invalid filter refused")
end
$s=$core.initial();$s.paused=true
$r=frame("request");$r.dropped_count=7
$s=$core.observed($s,$r,1);$s=$core.observed($s,$r,2)
check($s.dropped==7 and len($s.rows)==0 and $s.seen==2,"pause preserves cumulative loss and totals")
$s.drop_cursor=0;$r.dropped_count=2;$s=$core.observed($s,$r,3)
check($s.dropped==9,"new subscription retains lifetime loss")
$s=$core.clear_rows($s);check($s.dropped==9,"clear preserves loss")
$s.paused=false;$s.limits.history=8
for $i=1 to 11
  $r=frame("request",nil);$r.seq=$i;$s=$core.observed($s,$r,4)
end
check(len($s.rows)==8 and $s.evicted==3 and $s.rows[0].seq==4,"bounded oldest first eviction")
check($core.rows($s,2)[1].seq==11 and len($core.rows($s,0))==0,"rows newest last and limit zero")
$s.selected=to_string($s.rows[len($s.rows)-1].id);$s=$actions.execute($s,"view.hide")
check(contains($s.filter.hide,"example"),"one action hides selected service")
$s=$actions.execute($s,"view.unhide")
$model=$view.project($s)
check(len($model.table.initial.columns)==10 and $model.table.initial.columns[1].id=="direction" and $model.table.properties.stick_to_bottom,"table projection and direction")
$s.paused=true;check(not $view.project($s).table.properties.stick_to_bottom,"pause stops following")
print("bustap core: pairing, collision, reject-first, expiry, midnight, loss, filtering, bounds and actions passed")

-- Reject-first, error replies with pending, completion and duplicate tombstones.
for $error in [true,false]
  $s=$core.initial();$r=frame("response")
  if $error then $r.rc=10;$r.outcome="rejected" end
  $s=$core.observed($s,$r,1)
  $s=$core.observed($s,frame("request"),1.1)
  $s=$core.observed($s,frame("response"),1.2)
  check($s.rows[2].latency_ms==nil,"unmatched reply poisons later pairing")
end
$s=$core.initial();$s=$core.observed($s,frame("request"),1)
$r=frame("response");$r.rc=10
$s=$core.observed($s,$r,1.1);$s=$core.observed($s,frame("response"),1.2)
check($s.rows[2].latency_ms==nil,"error reply cannot leave a usable pending pair")
$s=$core.initial();$s=$core.observed($s,frame("request"),1)
$s=$core.observed($s,frame("response"),1.1)
$s=$core.observed($s,frame("response"),1.2)
$s=$core.observed($s,frame("request"),1.3)
$s=$core.observed($s,frame("response"),1.4)
check($s.rows[4].latency_ms==nil,"completed and duplicate reply guard later ID reuse")
$s=$core.initial({pending:8,tombstones:8})
for $i=1 to 8
  $key=json_encode([to_string($i),"example","client"])
  $s.pending[$key]={arrival:1,stamp:3723000,ambiguous:false}
end
$s=$core.observed($s,frame("request"),2)
check($s.pending[json_encode(["1","example","client"])].ambiguous,"full pending map still marks duplicates")
check(len($s.pending)==8,"pending bounded")
$s=$core.observed($s,frame("request","client","overflow"),2)
check(len($s.pending)==8 and $s.pending[json_encode(["overflow","example","client"])]==nil,"unseen pending key refused at cap")
$s=$core.tick_rate($s,33);check(len($s.pending)==0,"tick expires pending")
for $i=1 to 9 $s=$core.remember_reply($s,to_string($i),1) end
check(len($s.unmatched_replies)==8,"tombstones bounded")
check($s.unmatched_replies["1"]==nil and $s.unmatched_replies["9"]!=nil,"oldest tombstone evicted at cap")
$s=$core.tick_rate($s,32);check(len($s.unmatched_replies)==0,"tick expires tombstones")
$s=$core.initial();$r=frame("request","bustap");$r.dropped_count=5
$s=$core.observed($s,$r,1);$s=$core.tick_rate($s,1);$s=$core.tick_rate($s,2)
check($s.seen==0 and len($s.rows)==0 and len($s.counts)==0 and $s.rate==0 and $s.dropped==5,"own frames account loss only")
$s.filter.own=true;$s=$core.observed($s,$r,3)
check($s.seen==1 and len($s.rows)==1 and $s.counts.example==1,"show own counts frames")
$s=$core.initial();$s.subscription_id="a";$r=frame("request")
$s=$core.received($s,$r,1,nil);check($s.seen==0,"headerless notification refused")
$s=$core.received($s,$r,1,"a");$s=$core.received($s,$r,2,"a")
$r.seq=0;$s=$core.received($s,$r,3,"a")
check($s.seen==1 and len($s.rows)==1,"duplicate and out of order sequence ignored")
$s.retired.a={cursor:0,seq:1,live:true};$s.subscription_id="b";$s.last_seq=0;$r.seq=1
$s=$core.received($s,$r,4,"b");check($s.seen==2,"new subscription resets sequence")
$s.retired.b={cursor:0,seq:1,live:true};$s.subscription_id="c"
$r.seq=2;$r.dropped_count=3;$s=$core.received($s,$r,5,"a")
$r.dropped_count=7;$s=$core.received($s,$r,5,"b")
$s=$core.received($s,$r,5,"b")
check($s.dropped==10 and $s.seen==2,"all retired IDs retain independent loss cursors and dedupe")
for $i=1 to 62 $s.retired[to_string($i)]={cursor:0,seq:0,live:true} end
$failed=false;try $unused=$core.retire_slot($s) catch $why $failed=true end
check($failed and len($s.retired)==64,"retired live map refuses overflow")
$s.retired.a.live=false;$s=$core.retire_slot($s)
check(len($s.retired)==63 and $s.retired.a==nil,"cap prunes only stopped entries")
$first=$core.stop_batch($s);$second=$core.stop_batch($first.state)
check(len($first.ids)==2 and len($second.ids)==2 and not contains($first.ids,$second.ids[0]),"stop retries rotate so persistent failures cannot starve later IDs")
$s=$core.initial();$s.connected=true;$s.retry_at=10
check(not $core.retry_due($s,9) and $core.retry_due($s,10),"subscribe retry deadline")
$s.connected=false;check(not $core.retry_due($s,20),"disconnected never retries")
$s=$core.initial()
for $bad in [{id:"traffic",action:"select"},{id:"traffic",action:"select",value:{key:1}},{id:"filter",value:123},{id:"pause",value:"yes"},{id:"own",value:1},{id:"clear",value:[]},{id:"hide",value:{}},{id:"missing"},{id:"hide"}]
  $failed=false
  try $unused=$actions.intent($s,$bad) catch $why $failed=true end
  check($failed and deep_eq($s,$core.initial()),"invalid intent refused without mutation")
end
$s.rows=[{id:1,kind:"request",to:"(anon)"}];$s.selected="1"
$failed=false;try $unused=$actions.execute($s,"view.hide") catch $why $failed=true end
check($failed and len($s.filter.hide)==0,"anonymous service cannot be hidden")
$s=$core.initial();$s=$core.observed($s,frame("request"),1)
$s=$actions.intent($s,{id:"traffic",action:"select",value:{key:"1"}})
$s=$actions.intent($s,{id:"filter",value:"ping"})
$s=$actions.intent($s,{id:"pause",value:true})
$s=$actions.intent($s,{id:"own",value:true})
$s=$actions.intent($s,{id:"hide",value:nil})
check($s.selected=="1" and $s.filter.text=="ping" and $s.paused and $s.filter.own and contains($s.filter.hide,"example"),"valid intent values")
$s=$actions.intent($s,{id:"clear",value:"Clear"});check(len($s.rows)==0,"valid clear button")
print("bustap round 2: validation, self exclusion, dedupe, retired loss, retries and pairing regressions passed")

-- Clear and replacement discard pairings, but retain conservative ambiguity.
for $mode in ["clear","replacement"]
  $s=$core.initial();$s=$core.observed($s,frame("request"),1)
  $s=$core.observed($s,frame("request"),1.1)
  if $mode=="clear" then $s=$core.clear_rows($s) else $s=$core.reset_pairings($s) end
  check(len($s.pending)==0 and len($s.unmatched_replies)==1,"pending keys seed tombstones before reset")
  $s=$core.observed($s,frame("request"),2);$s=$core.observed($s,frame("response"),2.1)
  check($s.rows[len($s.rows)-1].latency_ms==nil,"reset does not erase ambiguity")
  $s=$core.clear_rows($s);check(len($s.unmatched_replies)==1,"clear preserves existing tombstones")
end
for $pending in [true,false]
  $s=$core.initial();$s.subscription_id="new";$s.retired.old={cursor:0,seq:0,live:false}
  if $pending then $s=$core.observed($s,frame("request"),1) end
  $s=$core.received($s,frame("response"),1.1,"old")
  check($s.seen==(if $pending then 1 else 0 end) and len($s.counts)==(if $pending then 1 else 0 end),"retired reply only affects ambiguity/loss")
  if not $pending then $s=$core.observed($s,frame("request"),2) end
  $s=$core.observed($s,frame("response"),2.1)
  check($s.rows[len($s.rows)-1].latency_ms==nil,"retired reply poisons existing or later pending")
end
$s=$core.initial({history:2,services:4})
$s=$core.observed($s,frame("request"),1);$s.selected=to_string($s.rows[0].id)
$s=$core.observed($s,frame("request",nil),2);$s=$core.observed($s,frame("request",nil),3)
check($s.selected==nil and not filter($actions.registry($s),fn($a)=$a.id=="view.hide")[0].enabled,"eviction clears selection and disables hide")
for $name in ["one","two","three","four","five"]
  $r=frame("request",nil);$r.to=$name;$s=$core.observed($s,$r,4)
end
check(len($s.counts)==4 and $s.counts["(other)"]==3,"counts include overflow within cap")
$counts={z:9,a:9,b:10,c:1,d:2,e:3,f:4,g:5,h:6,i:7}
$summary=$view.service_summary($counts)
check(len($summary)==8 and $summary[0]=="b: 10" and $summary[1]=="a: 9" and $summary[2]=="z: 9","services summary uses top eight counts and alphabetical ties")
print("bustap round 3: retained ambiguity, eviction selection, strict counts cap and ranked summary passed")
