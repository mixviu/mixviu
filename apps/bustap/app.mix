-- host: viu
-- version: 0.1.0
-- SPDX-License-Identifier: MIT OR Apache-2.0
$core=require("core.mix")
$view=require("view.mix")
$actions=require("actions.mix")
$state=$core.initial();$ctx=viu_context()
fn publish_bustap($s)
  $model=$view.project($s)
  if not deep_eq($model,$s.last_model) then
    send "viu-local" "scenes.model" body={generation:$ctx.generation,value:$model}
    $s.last_model=$model
  end
  return $s
end
fn stop_observer($id)
  try
    send "noded" "noded.observe.stop" body={subscription_id:$id} timeout=2
    return $rc==0
  catch $why return false end
end
fn start_observer($s,$filter)
  $s.retry_at=time()+2
  try $s=$core.retire_slot($s) catch $why $s.error="Retired subscriptions could not be stopped; "..$why;return {state:$s,ok:false} end
  $started=nil
  try
    send "noded" "noded.observe.start" body={filter:$core.broker_filter($filter),body:"none",capacity:1024} timeout=5
    if $rc==0 then $started=$reply end
  catch $why $started=nil end
  if type($started)!="map" or type($started.subscription_id)!="string" then
    $s.error=if $core.stop_warning($s) then "Retired subscriptions could not be stopped; observation subscription refused" else "Observation subscription refused" end;$s.status="Unavailable"
    return {state:$s,ok:false}
  end
  $old=$s.subscription_id
  if $old!=nil then $s.retired[$old]={cursor:$s.drop_cursor,seq:$s.last_seq,live:true} end
  $s.subscription_id=$started.subscription_id
  $s.filter=$filter;$s.drop_cursor=0;$s.last_seq=0;$s.pending={};$s.unmatched_replies={};$s.status="Live"
  if $old!=nil then
    if stop_observer($old) then $s.retired[$old].live=false end
  end
  $s.error=if $core.stop_warning($s) then "Retired subscriptions could not be stopped" else nil end
  return {state:$s,ok:true}
end
$state=publish_bustap($state)
on bus.connected
  $state.connected=true
  $out=start_observer($state,$state.filter);$state=$out.state;$state=publish_bustap($state)
end
on bus.disconnected
  $state.connected=false;$state.subscription_id=nil;$state.retired={};$state.pending={};$state.unmatched_replies={};$state.status="Disconnected";$state.error="Bus connection lost"
  $state=publish_bustap($state)
end
on noded.observe.event
  $state=$core.received($state,$event.args,time(),$event.headers.subscription_id)
  -- Tick batches model updates: rendering must not amplify every observation.
end
on viu.tick
  $now=time();$state=$core.tick_rate($state,$now)
  if $core.retry_due($state,$now) then $out=start_observer($state,$state.filter);$state=$out.state end
  if $state.connected and $now>=$state.stop_retry_at then
    $state.stop_retry_at=$now+2
    for $id in take(filter(keys($state.retired),fn($id)=$state.retired[$id].live),4)
      if stop_observer($id) then $state.retired[$id].live=false end
    end
    if $core.stop_warning($state) then $state.error="Retired subscriptions could not be stopped"
    elif $state.subscription_id!=nil then $state.error=nil end
  end
  $state=publish_bustap($state)
end
on bustap.pause
  if type($event.args.on)!="bool" then reply(10,json_encode({error_code:"ARGUMENT",message:"on must be bool"}));return end
  $state.paused=$event.args.on;$state=publish_bustap($state);reply(0,json_encode({paused:$state.paused}))
end
on bustap.clear
  $state=$core.clear_rows($state);$state=publish_bustap($state);reply(0,"{}")
end
on bustap.filter
  try
    $next=$core.filter_edit($state.filter,$event.args)
    -- Display keys always apply, even if a connected broker rejects its edit.
    $state.filter.text=$next.text;$state.filter.hide=$next.hide;$state.filter.own=$next.own
    if $state.connected and not deep_eq($core.broker_filter($next),$core.broker_filter($state.filter)) then
      $out=start_observer($state,$next);$state=$out.state
      if not $out.ok then $state=publish_bustap($state);reply(10,json_encode({error_code:"UNAVAILABLE",message:$state.error}));return end
    else $state.filter=$next end
    $state=publish_bustap($state);reply(0,json_encode({filter:$state.filter,subscription_id:$state.subscription_id}))
  catch $why reply(10,json_encode({error_code:"ARGUMENT",message:$why})) end
end
on bustap.rows
  $limit=$event.args.limit ?? 2000
  if type($limit)!="number" or $limit<0 or $limit>2000 or floor($limit)!=$limit then reply(10,json_encode({error_code:"ARGUMENT",message:"limit must be an integer from 0 to 2000"}));return end
  reply(0,json_encode({rows:$core.rows($state,$limit)}))
end
on bustap.stats
  reply(0,json_encode({seen:$state.seen,retained:len($state.rows),visible:len($core.rows($state)),history_evicted:$state.evicted,dropped:$state.dropped,rate:$state.rate,services:$state.counts,paused:$state.paused,connected:$state.connected,subscription_id:$state.subscription_id,retired:$state.retired,status:$state.status,error:$state.error,filter:$state.filter}))
end
on bustap.actions
  reply(0,json_encode({actions:$actions.registry($state)}))
end
on bustap.execute
  try
    $state=$actions.execute($state,$event.args.id);$state=publish_bustap($state);reply(0,json_encode({executed:$event.args.id}))
  catch $why reply(10,json_encode({error_code:"ARGUMENT",message:$why})) end
end
on bustap.intent
  try
    $next=$actions.intent($state,$event.args);$state=$next
    $state=publish_bustap($state);reply(0,"{}")
  catch $why reply(10,json_encode({error_code:"ARGUMENT",message:$why})) end
end
on viu.frame.intent
  try
    $state=$actions.execute($state,$event.args.value.command);$state=publish_bustap($state);reply(0,"{}")
  catch $why reply(10,json_encode({error_code:"ARGUMENT",message:$why})) end
end
on viu.frame.close
  $state.window_close=true;$state=publish_bustap($state)
end
