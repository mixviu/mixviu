-- version: 0.1.0
-- Own CBC checkout only. Print the formatting/lock diff before restoring it.
print(run_argv_must(["cargo", "fmt", "-p", "headless"]))
print(run_argv_must(["git", "diff", "--", "engines/viud/crates/headless/src/wire.rs"]))
print(run_argv_must(["git", "checkout", "-q", "--", "engines/viud/crates/headless/src/wire.rs"]))
print(run_argv_must(["cargo", "build", "-p", "viu", "-p", "viud", "--features", "viud/backend-headless"], {timeout:7200, stdout:"inherit", stderr:"inherit"}))
print(run_argv_must(["git", "diff", "--", "Cargo.lock"]))
print(run_argv_must(["git", "checkout", "-q", "--", "Cargo.lock"]))
$sha = trim(run_argv_must(["git", "rev-parse", "HEAD"]))
$out = "/build/quoin-p3/" .. $sha
mkdir($out, {parents:true})
for $name in ["viu", "viud"] copy("target/debug/" .. $name, $out .. "/" .. $name) end
print("P3_ARTIFACTS=" .. $out)
