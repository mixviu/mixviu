-- Lab opt-in loader, one accepted panel document per output.
-- version: 0.1.0
$p3 = require("instances.mix")
$io = require("../../engines/viud/scripts/lib/scenes_io.mix")
$meta = load_data(dirname(script_path()) .. "/template.conf.mix")
$source = read_file(dirname(script_path()) .. "/panel.mix")
$state = {}; $model = {outputs:{}}; $settings = {}
$settings_path = env("P3_SETTINGS")
if $settings_path == "" then raise("P3_SETTINGS", "set a private settings path") end
if is_file($settings_path) then $settings = load_data($settings_path) end
$host = env("SCENE_HOST", "shell")
$comp = env("VIU_COMP_SERVICE", "comp-headless")
$shape = env("P3_SHAPE", "shared")
if not contains(["shared", "instance"], $shape) then raise("P3_SHAPE", "shared or instance") end
$children = {}
$feed = nil; $watching = false

fn sample($name, $snapshot, $key)
  global $children
  if not has_key($children, $name) then
    $file = if $shape == "shared" then "behaviour-shared.mix" else "behaviour-instance.mix" end
    $children[$name] = spawn(["/opt/mixos/bin/mix", "--serve", dirname(script_path()) .. "/" .. $file, "--name", $name], {die_with_parent:true})
    sleep(0.3)
  end
  if $key != nil then
    $one = {}; $one[$key] = $snapshot[$key]; $snapshot = $one
  end
  return $io.rpc($name, "sample", {outputs:$snapshot, settings:$settings, key:$key})
end

fn update()
  global $state, $model, $settings, $children, $feed
  if $feed == nil then $feed = $p3.outputs($io, $comp) end
  $snapshot = $feed
  $keys = $p3.select_outputs($meta, $snapshot)
  if $shape == "shared" then
    $model = sample("p3-panel", $snapshot, nil)
  else
    $model = {outputs:{}}
    for $key in $keys
      $name = "p3-" .. substr(hash_sha256($key), 0, 16)
      $part = sample($name, $snapshot, $key)
      $model.outputs[$key] = $part.outputs[$key]
      $model.clock = $part.clock
    end
    for $name in keys($children)
      if not any($keys, fn($k) = $name == "p3-" .. substr(hash_sha256($k), 0, 16)) then
        if not kill($children[$name], 9) then raise("P3_STOP", "failed to stop instance behaviour") end
        $children = delete($children, $name)
      end
    end
  end
  $workspaces = $io.rpc($comp, "comp.props.get", {path:"workspaces"})
  $model.current = {}
  for $key in $keys $model.current[$key] = ($workspaces[$key] ?? {}).current ?? $workspaces.current end
  $src = {comp:{workspaces:[]}}
  -- P2 exposes a map with .list rows (numeric index, optional name), not
  -- the keyed list consumed by repeat. Keep that projection in Mix.
  for $ws in $workspaces.list
    $src.comp.workspaces = push($src.comp.workspaces, {id:to_string($ws.index), index:$ws.index, label:$ws.name ?? to_string($ws.index)})
  end
  $model.clock = date_format(time(), "%H:%M:%S")
  $state = $p3.reconcile($state, $meta, $snapshot, $source, $model, $src, $io, $host, serve_name())
end

on mode
  global $settings
  $key = $event.args.output
  if not has_key($state, $key) then reply(10, "output removed"); return end
  $settings[$model.outputs[$key].name] = $event.args.mode
  write_atomic($settings_path, data_encode($settings))
  update()
  reply(0, "ok")
end

on workspace
  $matches = filter(keys($state), fn($key) = $state[$key].id == $event.args.scene)
  if len($matches) != 1 or type(($event.args.item ?? {}).index) != "number" then
    reply(10, "stale workspace instance")
    return
  end
  $r = $io.rpc($comp, "comp.workspace.switch", {output:$matches[0], index:$event.args.item.index})
  reply(0, json_encode($r))
end

on snapshot
  reply(0, json_encode({instances:$state, model:$model, shape:$shape}))
end

on timer.tick
  global $feed
  if len(keys($event.headers)) != 0 then return end
  if $event.args.tag != "tick" then return end
  if not $watching then $feed = nil end
  update()
end

on props.changed
  global $feed
  if $event.headers.topic != $comp .. ".props.changed" then return end
  $feed = nil
  update()
end

on bus.connected
  global $feed, $watching
  if len(keys($event.headers)) != 0 then return end
  $feed = nil
  $watching = $p3.watch_outputs($io, $comp)
  update()
end

$watching = $p3.watch_outputs($io, $comp)
update()
interval(1, "tick")
