-- version: 0.1.0
-- Usage: mix live.mix HARNESS CBC-BIN-DIR PRIVATE-RUN-DIR
$h = require(args()[0])
$bin = args()[1]; $dir = args()[2]
$root = dirname(script_path())
$probe = $bin .. "/testkit-panel-pixels"
if not is_file($probe) then raise("P3_LIVE", "supply the CBC snapshot including testkit-panel-pixels") end
mkdir($dir, {parents:true})
$bus = $h.private_bus({dir:$dir .. "/broker", name:"p3-live"})
export MIXOS_NODE_CONFIG = $bus.conf
export MIXOS_NODED_URL = $bus.url
export MIXOS_RUN = $bus.dir .. "/run"
export MIXOS_BROKER_ACCOUNT = $bus.account
$io = require("../../engines/viud/scripts/lib/scenes_io.mix")
$runtime = $dir .. "/wayland"
mkdir($runtime); chmod($runtime, 0o700)
copy(dirname(args()[0]) .. "/smoke-settings.json", $dir .. "/settings.json")
write_file($dir .. "/preferences.json", json_encode({scene_host:false}))
$env = {HOME:$dir .. "/home", XDG_RUNTIME_DIR:$runtime, XDG_CONFIG_HOME:$dir .. "/config", XDG_DATA_HOME:$dir .. "/data", XDG_STATE_HOME:$dir .. "/state", XDG_CACHE_HOME:$dir .. "/cache", MIXOS_ETC:$dir .. "/etc", MIXOS_VAR:$dir .. "/var", MIXOS_RUN:$bus.dir .. "/run", MIXOS_NODE_CONFIG:$bus.conf, MIXOS_NODED_URL:$bus.url, VIU_COMP_SERVICE:"comp-p3", WAYLAND_DISPLAY:"p3", DISPLAY:nil, DBUS_SESSION_BUS_ADDRESS:nil, MIXOS_VT:nil, NOTIFY_SOCKET:nil, MESA_VK_WSI_PRESENT_MODE:"mailbox", P3_SETTINGS:$dir .. "/panel-settings.conf.mix"}
mkdir($env.HOME, {parents:true})
-- The frozen operational harness uses MIXOS_; the P0 engines use MIX_.
-- Pin both generations to the same private broker and private state.
for $suffix in ["ETC", "VAR", "RUN", "NODE_CONFIG", "NODED_URL"]
  $env["MIX_" .. $suffix] = $env["MIXOS_" .. $suffix]
end
$env.MIX_BROKER_ACCOUNT = $bus.account
$env.MIX_BUS_SOCKET = $bus.endpoint
$env.MIX_SESSION_FD = nil
$env.MIX_VIU_COMP_SERVICE = "comp-p3"
$env.MIX_VIUD_LAB_CAPTURE_PATTERN = env("P3_CAPTURE_PATTERN", "")
$children = []; $records = []
fn launch($argv, $name, $extra)
  return spawn($argv, {env:merge($env, $extra), die_with_parent:true, stdout:{file:$dir .. "/" .. $name .. ".log"}, stderr:"stdout"})
end
fn wait_call($svc, $command, $body)
  $until = monotonic() + 20
  while monotonic() < $until
    try
      return $io.rpc($svc, $command, $body)
    catch $message
      sleep(0.1)
    end
  end
  raise("P3_LIVE", "service timeout: " .. $svc .. " " .. $command)
end
try
  $comp = launch([$bin .. "/viud", "--headless", "--size", "1280x720", "--socket", "p3", "--bus-service", "comp-p3", "--config-file", $dir .. "/settings.json"], "viud", {MIX_VIUD_LAB_OUTPUTS:"2", MIX_VIUD_LAB_UNPLUG_SECS:"25"})
  push($children, $comp)
  wait_call("comp-p3", "comp.ping", {})
  $outputs = $io.rpc("comp-p3", "comp.props.get", {path:"outputs"})
  if len(keys($outputs)) != 2 then raise("P3_LIVE", "headless did not advertise two outputs") end
  $host = launch([$bin .. "/viu", "--host"], "viu", {})
  push($children, $host)
  wait_call("shell", "shell.ping", {})
  $loader = launch(["/opt/mixos/bin/mix", "--serve", $root .. "/loader.mix", "--name", "p3-loader"], "loader", {})
  push($children, $loader)
  $mounted = wait_call("p3-loader", "snapshot", {})
  if len(keys($mounted.instances)) != 2 then raise("P3_LIVE", "two panels not loaded") end
  $kept_key = sort(keys($mounted.instances))[0]
  $io.rpc("p3-loader", "mode", {output:$kept_key, mode:"pinned"})
  -- Native policy currently switches only the default output. Its peer must
  -- keep workspace 1, and each panel must project that output's own row.
  $io.rpc("comp-p3","comp.workspace.switch",{output:$kept_key,index:2})
  sleep(2)
  $mounted = $io.rpc("p3-loader","snapshot",{})
  for $key in keys($mounted.instances)
    $scene = $mounted.instances[$key]
    $deadline = monotonic() + 12
    while monotonic() < $deadline
      $watch = $io.rpc("shell","shell.scene.watch",{scene:$scene.id,output:$key})
      if ($watch.applied_revision ?? 0) > 0 then break end
      sleep(0.1)
    end
    if ($watch.applied_revision ?? 0) == 0 then raise("P3_LIVE","scene never presented") end
    push($records, $io.rpc("shell", "shell.scene.get", {scene:$scene.id, output:$key}))
    push($records, $io.rpc("comp-p3", "comp.capture.frame", {output:$outputs[$key].name, path:$dir .. "/" .. $key .. ".png", cursor:false}))
    $colour = if env("P3_CAPTURE_PATTERN") == "1" then (if ends_with($key,"0") then "990000" else "009900" end) else (if ends_with($key,"0") then "243640" else "403024" end) end
    push($records, json_parse(run_argv_must([$probe,$dir .. "/" .. $key .. ".png",$colour,"10000"])))
  end
  for $sample = 1 to 4
    for $key in keys($mounted.instances)
      $path = $dir .. "/sample-" .. to_string($sample) .. "-" .. $key .. ".png"
      $io.rpc("comp-p3", "comp.capture.frame", {output:$outputs[$key].name,path:$path,cursor:false})
      $colour = if env("P3_CAPTURE_PATTERN") == "1" then (if ends_with($key,"0") then "990000" else "009900" end) else (if ends_with($key,"0") then "243640" else "403024" end) end
      push($records, json_parse(run_argv_must([$probe,$path,$colour,"10000"])))
    end
    sleep(0.1)
  end
  push($records, {surfaces:$io.rpc("comp-p3", "comp.props.get", {path:"surfaces"}), panels:$io.rpc("shell", "shell.props.get", {})})
  $io.rpc("p3-loader", "workspace", {scene:$mounted.instances[$kept_key].id, item:{index:4}})
  $ws = $io.rpc("comp-p3", "comp.props.get", {path:"workspaces"})
  if $ws[$kept_key].current != 4 then raise("P3_LIVE", "workspace action did not target its output") end
  $other = filter(keys($mounted.instances),fn($key) = $key != $kept_key)[0]
  if $ws[$other].current != 1 then raise("P3_LIVE","workspace action changed another output") end
  push($records,{workspace_action:$ws})
  $until = monotonic() + 35
  $after = $mounted
  while monotonic() < $until
    $after = $io.rpc("p3-loader", "snapshot", {})
    if len(keys($after.instances)) == 1 then break end
    sleep(0.2)
  end
  if len(keys($after.instances)) != 1 then raise("P3_LIVE", "unplug did not remove one instance") end
  $survivor = keys($after.instances)[0]
  if $after.instances[$survivor].id != $mounted.instances[$survivor].id then raise("P3_LIVE", "surviving identity changed") end
  if $after.model.outputs[$survivor].mode != "pinned" then raise("P3_LIVE", "survivor mode changed") end
  if load_data($env.P3_SETTINGS)[$after.model.outputs[$survivor].name] != "pinned" then raise("P3_LIVE", "mode not persisted by name") end
  $removed = filter(keys($mounted.instances), fn($k) = $k != $survivor)[0]
  $gone = false
  try
    $io.rpc("shell", "shell.scene.watch", {scene:$mounted.instances[$removed].id, output:$survivor})
  catch $message, $error
    $gone = (($error.details ?? {}).upstream ?? {}).error == "unknown scene"
  end
  if not $gone then raise("P3_LIVE", "removed instance remains in host") end
  push($records, $io.rpc("shell", "shell.scene.get", {scene:$after.instances[$survivor].id, output:$survivor}))
  write_file($dir .. "/result.json", json_encode({result:"pass",visual:true,before:$mounted,after:$after,records:$records}))
  print("P3_LIVE=pass visual=true")
catch $message, $error
  eprint(json_encode({message:$message, error:$error}))
  raise($error.code, $message, $error.details)
finally
  write_file($dir .. "/progress.json", json_encode($records))
  for $child in reverse($children) $stopped = kill($child, 9) end
  $h.stop_bus($bus)
end
