$performance=require("performance.mix")
fn info($s,$ctx)
  $snapshot=nil
  if $s.snapshot!=nil then $v=$s.snapshot;$snapshot={host:$v.host,ts:$v.ts,cpu:$v.cpu.busy,memory:{used:$v.memory.used,total:$v.memory.total},uptime_s:$v.uptime_s} end
  return {theme:{mode:$s.theme_choice.mode,effective:$s.theme_effective},schema:"monitor.v1",app_id:"dev.mixos.monitor",version:$ctx.version,pid:$ctx.pid,connected:$s.connected,target:if $s.node=="" then "monitord" else "monitord."..$s.node..".bus" end,host:if $s.snapshot!=nil and ($s.snapshot.host ?? "")!="" then $s.snapshot.host elif $s.node!="" then $s.node else "This node" end,status:$s.status,error:$s.error,peers:$s.peers,snapshot:$snapshot,processes:if $s.processes_loaded then {total:$s.total,count:len($s.processes)} else nil end,sections:$performance.keys_for($s.snapshot),ui:{macros_open:$s.macros_open,node:if $s.node=="" then nil else $s.node end,tab:lower($s.tab),section:$s.section,sort:$s.sort,reverse:$s.reverse,filter:$s.filter,tree:$s.tree,selected:$s.selected,paused:$s.paused,dialog:$s.dialog,theme_scheme:$s.theme_choice.scheme,theme_effective:$s.theme_effective,theme_mode:$s.theme_choice.mode,theme_style:$s.theme_choice.style,theme_decorations:$s.theme_choice.decorations,theme_captions:$s.theme_choice.caption_side}}
end
fn rows($s)
  return map($s.processes,fn($p)={pid:$p.pid,name:$p.name,user:$p.user,cpu:$p.cpu,memory:$p.memory,io:if $p.read_bps==nil and $p.write_bps==nil then nil else ($p.read_bps ?? 0)+($p.write_bps ?? 0) end,depth:$p.depth ?? 0,selected:$p.pid==$s.selected})
end
fn peers($v)
  $names=[];$rows=$v.authority.routing_view ?? $v.peers ?? []
  if type($rows)!="list" then return [] end
  for $p in $rows
    if ($p.class==nil or $p.class=="active-bus") and type($p.name)=="string" and $p.name!=$v.node and re_match($p.name,"^[a-zA-Z0-9_-]{1,63}$") and not contains($names,$p.name) then push($names,$p.name) end
  end
  return sort_by($names,fn($n)=$n)
end
