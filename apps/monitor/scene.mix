---
scene: 1
name: monitor
citizen: monitor
---
```mix
{
root:{widget:"column",children:["title","status","toolbar","searches","summary","history","processes"],gap:8},
title:{widget:"text",text:"System Monitor · Mix on Viu"},
status:{widget:"text",text:"= $model.status"},
toolbar:{widget:"row",children:["refresh","pause"],gap:8},
searches:{widget:"grid",columns:2,children:["filter-cell","node-cell"],column_gap:12},
filter-cell:{widget:"column",children:["filter-label","filter"]},
node-cell:{widget:"column",children:["node-label","node"]},
filter-label:{widget:"text",text:"Filter processes"},
node-label:{widget:"text",text:"Node (Enter to apply; empty = local)"},
refresh:{widget:"control",definition:{id:"refresh",kind:"button",label:"",initial:"Refresh",properties:{text:"Refresh"}},on_intent:"monitor.intent"},
pause:{widget:"control",definition:{id:"pause",kind:"toggle",label:"Pause",initial:false,properties:{text:"Pause"}},on_intent:"monitor.intent"},
filter:{widget:"control",definition:{id:"filter",kind:"field",label:"Filter processes",initial:"",properties:{placeholder:"Name or command line"}},on_intent:"monitor.intent"},
node:{widget:"control",definition:{id:"node",kind:"field",label:"Node",initial:"",properties:{placeholder:"Local node"}},on_intent:"monitor.intent"},
summary:{widget:"text",text:"= $model.summary"},
history:{widget:"control",definition:"= $model.chart"},
processes:{widget:"control",definition:"= $model.table",on_intent:"monitor.intent"}
}
```
