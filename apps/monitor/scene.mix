---
scene: 1
name: monitor
citizen: monitor
---
```mix
{
root:{widget:"dock",children:["options","content"],placements:{options:{edge:"top",size:"design.options_height"},content:{edge:"fill"}}},
options:{widget:"control",definition:"= $model.options_row",on_intent:"monitor.intent"},
content:{widget:"column",padding:0,children:["processes","performance"]},
performance:{widget:"control",hidden:"= $model.performance_hidden",definition:"= $model.performance_view",on_intent:"monitor.intent"},
processes:{widget:"control",hidden:"= $model.processes_hidden",definition:"= $model.table",on_intent:"monitor.intent"}
}
```
