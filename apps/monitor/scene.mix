---
scene: 1
name: monitor
citizen: monitor
---
```mix
{
root:{widget:"dock",children:["options","content"],placements:{options:{edge:"top",size:"design.options_height"},content:{edge:"fill"}}},
options:{widget:"column",background:"design.chrome",padding:8,children:["options-band"]},
"options-band":{widget:"band",children:["tabs","node","filter","tree","end-task"],groups:"= $model.options"},
tabs:{widget:"control",definition:{id:"tabs",kind:"tabs",label:"",initial:"Processes",properties:{choices:["Processes","Performance"]}},on_intent:"monitor.intent"},
node:{widget:"control",definition:{id:"node",kind:"field",label:"Node",initial:"This node",properties:{placeholder:"This node"}},on_intent:"monitor.intent"},
filter:{widget:"control",definition:{id:"filter",kind:"field",label:"Filter processes",initial:"",properties:{placeholder:"Search processes"}},on_intent:"monitor.intent"},
tree:{widget:"control",definition:{id:"tree",kind:"toggle",label:"Tree",initial:false,properties:{text:"Tree"}},on_intent:"monitor.intent"},
"end-task":{widget:"control",definition:"= $model.end_button",on_intent:"monitor.intent"},
content:{widget:"column",padding:8,children:["processes"]},
processes:{widget:"control",definition:"= $model.table",on_intent:"monitor.intent"}
}
```
