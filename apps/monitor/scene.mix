---
scene: 1
name: monitor
citizen: monitor
---
```mix
{
root:{widget:"dock",children:["options","content"],placements:{options:{edge:"top",size:"design.options_height"},content:{edge:"fill"}}},
options:{widget:"column",background:"design.chrome",padding:8,children:["options-band"]},
"options-band":{widget:"band",children:["tabs","server","node","paused","filter","tree","end-task"],groups:"= $model.options"},
tabs:{widget:"control",definition:{id:"tabs",kind:"tabs",label:"",initial:"Processes",properties:{choices:["Processes","Performance"]}},on_intent:"monitor.intent"},
server:{widget:"control",definition:{id:"server",kind:"mark",label:"",initial:"server"}},
paused:{widget:"control",definition:{id:"paused",kind:"label",label:"",initial:""}},
node:{widget:"control",definition:"= $model.node_choice",on_intent:"monitor.intent"},
filter:{widget:"control",definition:{id:"filter",kind:"field",label:"Filter processes",initial:"",properties:{placeholder:"Filter processes"}},on_intent:"monitor.intent"},
tree:{widget:"control",definition:{id:"tree",kind:"toggle",label:"Tree",initial:false,properties:{text:"Show as tree"}},on_intent:"monitor.intent"},
"end-task":{widget:"control",definition:"= $model.end_button",on_intent:"monitor.intent"},
content:{widget:"column",padding:2,children:["processes"]},
processes:{widget:"control",definition:"= $model.table",on_intent:"monitor.intent"}
}
```
