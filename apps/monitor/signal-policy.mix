-- SPDX-License-Identifier: MIT OR Apache-2.0
-- Fixed procfs root; test copies replace it, never Bus arguments.
$proc_root="/proc"
fn session_id($run,$vt)
  $match=re_find($run,"^/.*/session/([0-9]+)/?$")
  if len($match)==1 then return $match[0].groups[0] end
  if re_match($vt,"^[0-9]+$") then return $vt end
  return nil
end
$session=session_id(env("MIX_RUN",""),env("MIX_VT",""))
fn parent_pid($pid)
  $stat=read_file($proc_root.."/"..to_string($pid).."/stat")
  $tail=re_replace($stat,"(?s)^.*\\) ","")
  return to_number(split($tail," ")[1])
end
fn effective_uid($pid)
  $uids=re_find(read_file($proc_root.."/"..to_string($pid).."/status"),"(?m)^Uid:\\s+([0-9]+)\\s+([0-9]+)")
  if len($uids)!=1 then raise("PROCFS","Cannot read process credentials") end
  return to_number($uids[0].groups[1])
end
fn local_context()
  $uid=effective_uid("self")
  $ancestors=[];$at=to_number(split(read_file($proc_root.."/self/stat")," ")[0])
  while $at>0
    if contains($ancestors,$at) then raise("PROCFS","Ancestry changed; retry") end
    push($ancestors,$at)
    $at=parent_pid($at)
  end
  return {uid:$uid,ancestors:$ancestors}
end
fn protected($pid)
  if parent_pid($pid)!=1 then return false end
  for $line in split(trim(read_file($proc_root.."/"..to_string($pid).."/cgroup")),"\n")
    $unit=re_find(trim($line),"(?:^|/)([^/@:]+)@([0-9]+)\\.service$")
    if len($unit)==1 and $unit[0].groups[0]!="apps" and ($session==nil or $unit[0].groups[1]==$session) then return true end
  end
  return false
end
fn disabled($message) return {error_code:"DISABLED",message:$message} end
fn admission($s,$pid)
  if $pid==nil then return disabled("Select a process in the table") end
  if type($pid)!="number" or $pid<=1 or floor($pid)!=$pid then return disabled("Select a process other than PID 1") end
  if $s.node!="" then return disabled("End task and Kill act only on this node") end
  try
    if protected($pid) then
      return {error_code:"PROTECTED",message:if $session==nil then "Session number is unknown; all session-unit main processes are protected" else "Session infrastructure is protected" end,recovery:"Use the host's hostd desk.restart {desk: <desk name>}; for a non-container session, restart the unit from another VT with sudo systemctl restart <unit>@N.service. See docs/ports/monitor.md#protected-session-processes"}
    end
    if $s.dialog!=nil or $s.quitting then return disabled("Close the dialog before ending a task") end
    if $pid!=$s.selected or not any($s.processes,fn($p)=$p.pid==$pid) then return disabled("Select a process in the table") end
    $ctx=local_context()
    if contains($ctx.ancestors,$pid) then return disabled("Monitor and its ancestors cannot be ended") end
    $owner=effective_uid($pid)
    if $ctx.uid!=0 and $ctx.uid!=$owner then return disabled("This process belongs to another user") end
  catch $message
    return disabled("Cannot verify process credentials/ancestry/cgroup; retry: "..$message)
  end
  return nil
end
fn allowed($s,$pid)
  return admission($s,$pid)==nil
end
