$wire=require("wire.mix")
$commands=require("actions.mix")
-- SPDX-License-Identifier: MIT OR Apache-2.0
-- version: 0.1.0
-- lint: globals app_args
$history=require("history.mix")
$performance=require("performance.mix")
$core=require("core.mix");$state=$core.initial();$ctx=viu_context()
if len($app_args)>0 then $state.node=$app_args[0];$state.node_draft=$state.node;$checked=$core.target($state.node) end
fn publish_monitor($s)
  send "viu-local" "scenes.model" body={generation:$ctx.generation,value:$core.framed($s)}
end
fn refresh_monitor($s)
  try
    $target=$core.target($s.node)
    send $target "monitord.snapshot" body={}
    if $rc!=0 then raise("SNAPSHOT",to_string($result)) end
    $snapshot=$reply
    send $target "monitord.processes" body=$core.query($s)
    if $rc!=0 then raise("PROCESSES",to_string($result)) end
    if type($reply.rows)!="list" or len($reply.rows)>2000 or ($reply.total ?? 0)>2000 then raise("PROCESS_BUDGET","Process limit 2000 exceeded; no partial state") end
    $s.processes_loaded=true;$s.snapshot=$snapshot;$s.processes=$reply.rows;$s.total=$reply.total ?? len($reply.rows)
    $s.start_times=if $s.node=="" then viu_process("snapshot",{pids:map($s.processes,fn($p)=$p.pid)}) else {} end
        $s.rings=$history.record($s.rings,$snapshot)
    if not $s.history_seeded then
      $s.history_seeded=true
      send $target "monitord.history" body={series:["cpu.busy","cpu.core.*","mem.used","disk.*","net.*","tcp.*"],since:60,max_points:60}
      if $rc==0 then $s.rings=$history.seed($s.rings,$reply) end
    end
    if $s.tab=="Performance" and $s.section=="tcp" then
      send $target "monitord.connections" body={limit:20,sort:"throughput"}
      if $rc==0 then $s.connections=$reply;$s.connections_error=nil
      else $s.connections=nil;$s.connections_error=to_string($result) end
    else $s.connections=nil;$s.connections_error=nil end
    $s.history=push($s.history,$snapshot.cpu.busy)
    if len($s.history)>60 then $s.history=slice($s.history,len($s.history)-60) end
    $s.error=nil;$s.status=if $s.paused then "Paused" else "Live" end;$s.serial=$s.serial+1
  catch $message
    $s.error=$message
  end
  return $s
end
publish_monitor($state)
on viu.tick
  if not $state.paused then $state=refresh_monitor($state);publish_monitor($state) end
end
on monitor.ping
  reply(0,json_encode({schema:"monitor.v1",version:$ctx.version}))
end
on monitor.info
  reply(0,json_encode($wire.info($state,$ctx)))
end
on monitor.debug.state
  reply(0,json_encode($state))
end
on monitor.rows
  reply(0,json_encode({rows:$wire.rows($state)}))
end
on monitor.refresh
  $state=refresh_monitor($state);publish_monitor($state)
  reply(if $state.error==nil then 0 else 10 end,json_encode($state))
end
on monitor.node
  $node=$event.args.node ?? "";$checked=$core.target($node)
  $state.node=$node;$state.node_draft=$node;$state.snapshot=nil;$state.processes=[];$state.history=[];$state.rings={};$state.history_seeded=false;$state.connections=nil;$state.connections_error=nil;$state.selected=nil
  $state=refresh_monitor($state);publish_monitor($state)
  reply(0,json_encode({node:$state.node}))
end
on monitor.sort
  if not contains(["name","pid","user","cpu","memory","io"],$event.args.column) then raise("SORT","Unknown column") end
  $state.sort=$event.args.column;$state.reverse=$event.args.reverse ?? false
  $state=refresh_monitor($state);publish_monitor($state)
  reply(0,"{}")
end
on monitor.filter
  if type($event.args.text)!="string" or len($event.args.text)>256 then raise("FILTER","At most 256 characters") end
  $state.filter=$event.args.text;$state=refresh_monitor($state);publish_monitor($state)
  reply(0,"{}")
end
on monitor.tree
  if type($event.args.on)!="bool" then raise("TREE","Boolean required") end
  $state.tree=$event.args.on;$state=refresh_monitor($state);publish_monitor($state)
  reply(0,"{}")
end
on monitor.pause
  if type($event.args.on)!="bool" then raise("PAUSE","Boolean required") end
  $state.paused=$event.args.on;publish_monitor($state);reply(0,"{}")
end
on monitor.select
  $pid=$event.args.pid
  if $pid!=nil and not any($state.processes,fn($p)=$p.pid==$pid) then raise("PID","Process is not in the current table") end
  $state.selected=$pid;publish_monitor($state);reply(0,"{}")
end
on monitor.intent
  $a=$event.args
  if $a.id=="end-task" then
    $out=signal_monitor($state,{pid:$state.selected,signal:"SIGTERM"});$state=$out.state
  elif $a.id=="tabs" then $state.tab=$a.value;$state=refresh_monitor($state)
  elif $a.id=="performance" and $a.action=="choose" then $state.section=$a.value;$state=refresh_monitor($state)
  elif $a.id=="tree" then $state.tree=$a.value;$state=refresh_monitor($state)
  elif $a.id=="refresh" then $state=refresh_monitor($state)
  elif $a.id=="pause" then $state.paused=$a.value
  elif $a.id=="filter" then $state.filter=$a.value;$state=refresh_monitor($state)
  elif $a.id=="node" then
    $state.node_draft=$a.value
    if $a.action=="submit" or $a.action=="set" then
      $node=if $a.value=="This node" then "" else $a.value end
      $checked=$core.target($node);$state.node=$node;$state.snapshot=nil;$state.processes=[];$state.history=[];$state.rings={};$state.history_seeded=false;$state.connections=nil;$state.connections_error=nil;$state.selected=nil;$state=refresh_monitor($state)
    end
  elif $a.id=="processes" then
    if $a.action=="sort" then
      $state.reverse=if $state.sort==$a.value.column then not $state.reverse else false end
      $state.sort=$a.value.column;$state=refresh_monitor($state)
    elif $a.action=="select" then $state.selected=to_number($a.value.key) end
  end
  publish_monitor($state);reply(0,"{}")
end

on viu.frame.close
  $model=$core.framed($state)
  $model.window_close=true
  send "viu-local" "scenes.model" body={generation:$ctx.generation,value:$model}
end
on viu.frame.intent
  $origin=$event.args.value.origin ?? (if $event.args.id=="gold-menu" then "menu" else "ui" end)
  $out=execute_monitor($state,$event.args.value.command,$origin);$state=$out.state
  publish_monitor($state);reply($out.rc,json_encode($out.body))
end

fn signal_monitor($s,$a)
  $pid=$a.pid
  if $s.node!="" or $s.dialog!=nil or $s.selected==nil or $pid!=$s.selected then
    return {state:$s,rc:10,body:{error_code:"DISABLED",message:"Command is disabled"}}
  end
  $expected=$a.start_time ?? $s.start_times[to_string($pid)]
  $answer=viu_process("signal",{pid:$pid,signal:$a.signal,start_time:$expected})
  if $answer.pid_reused==true then $s=refresh_monitor($s) end
  if not $answer.ok then
    $s.error=$answer.error
    return {state:$s,rc:10,body:{error_code:"SIGNAL",message:$answer.error}}
  end
  $s=refresh_monitor($s)
  return {state:$s,rc:0,body:{pid:$pid,signal:$a.signal}}
end
on monitor.signal
  $out=signal_monitor($state,$event.args);$state=$out.state;publish_monitor($state)
  reply($out.rc,json_encode($out.body))
end

on monitor.tab
  if not contains(["processes","performance"],$event.args.tab) then raise("ARGUMENT","tab must be processes or performance") end
  $state.tab=if $event.args.tab=="processes" then "Processes" else "Performance" end
  $state=refresh_monitor($state);publish_monitor($state)
  reply(0,json_encode({tab:$event.args.tab}))
end
on monitor.section
  if not contains($performance.keys_for($state.snapshot),$event.args.section) then raise("ARGUMENT","No such section") end
  $state.section=$event.args.section;$state=refresh_monitor($state);publish_monitor($state)
  reply(0,json_encode({section:$state.section}))
end

fn execute_monitor($s,$id,$origin)
  $matches=filter($commands.registry($s),fn($a)=$a.id==$id)
  if len($matches)==0 then return {state:$s,rc:10,body:{error_code:"UNKNOWN_ACTION",message:"Unknown Monitor command"}} end
  if not $matches[0].enabled then return {state:$s,rc:10,body:{error_code:"DISABLED",message:"That command is not available right now"}} end
  if contains(["process.end","process.kill"],$id) then
    $out=signal_monitor($s,{pid:$s.selected,signal:if $id=="process.end" then "SIGTERM" else "SIGKILL" end});$s=$out.state
  elif $id=="file.refresh" then $s=refresh_monitor($s)
  elif $id=="file.quit" then $s.quitting=true;$s.window_close=$origin!="bus"
  elif $id=="view.pause" then $s.paused=not $s.paused;$s.status=if $s.paused then "Paused" else "Live" end
  elif $id=="view.processes" then $s.tab="Processes"
  elif $id=="view.performance" then $s.tab="Performance"
  elif $id=="view.tree" then $s.tree=not $s.tree;$s=refresh_monitor($s)
  elif $id=="help.macros" then $s.macros_open=not $s.macros_open
  elif $id=="help.about" then $s.dialog="about"
  elif $id=="help.shortcuts" then $s.dialog="shortcuts"
  elif $id=="view.search" then $s.tab="Processes";$s.focus_serial=$s.focus_serial+1
  elif $id=="process.copy" then
    $p=filter($s.processes,fn($p)=$p.pid==$s.selected)[0]
    send "viu-local" "native.copy" body={text:$p.cmdline ?? $p.name}
    if $rc!=0 then return {state:$s,rc:$rc,body:$reply} end
  else
    $axis=if starts_with($id,"view.theme.") then "scheme" elif starts_with($id,"view.style.") then "style" elif starts_with($id,"view.decorations.") then "decorations" elif starts_with($id,"view.captions.") then "caption_side" else "mode" end
    $parts=split($id,".");$value=$parts[len($parts)-1]
    if $id=="view.mode" then
      send "viu-local" "native.theme" body=$s.theme_choice
      if $rc!=0 then return {state:$s,rc:$rc,body:$reply} end
      $value=if $reply.mode=="dark" then "light" else "dark" end
    end
    $edit={};$edit[$axis]=if $value=="session" then nil else $value end
    $answer=theme_monitor($s,$edit);$s=$answer.state
    if $answer.rc!=0 then return $answer end
  end
  return {state:$s,rc:0,body:{executed:$id}}
end
fn theme_monitor($s,$args)
  $edit=$commands.theme_edit($s.theme_choice,$args)
  if not $edit.ok then return {state:$s,rc:10,body:{error_code:"ARGUMENT",message:$edit.message}} end
  send "viu-local" "native.theme" body=$edit.choice
  if $rc!=0 then return {state:$s,rc:$rc,body:$reply} end
  $s.theme_choice=$edit.choice;$s.theme_effective=$reply
  $body=$edit.choice;$body.effective=$reply
  return {state:$s,rc:0,body:$body}
end
on monitor.actions
  reply(0,json_encode({actions:$commands.registry($state)}))
end
on monitor.execute
  if type($event.args.id)!="string" then reply(10,json_encode({error_code:"ARGUMENT",message:"id must be a command id string"}));return end
  $out=execute_monitor($state,$event.args.id,"bus");$state=$out.state;publish_monitor($state);reply($out.rc,json_encode($out.body))
end
on monitor.theme
  $out=theme_monitor($state,$event.args);$state=$out.state;publish_monitor($state);reply($out.rc,json_encode($out.body))
end
on monitor.dialog
  if not contains(keys($event.args),"open") or ($event.args.open!=nil and not contains(["about","shortcuts"],$event.args.open)) then reply(10,json_encode({error_code:"ARGUMENT",message:"open must be \"about\", \"shortcuts\" or null"}));return end
  if $event.args.open!=nil and ($state.dialog!=nil or $state.quitting) then reply(10,json_encode({error_code:"BUSY",message:"Not now: a dialog is open"}));return end
  $state.dialog=$event.args.open;publish_monitor($state);reply(0,json_encode({dialog:$state.dialog}))
end
on monitor.quit
  $state.quitting=true;reply(0,json_encode({quitting:true}))
end
on viu.macros.changed
  $state.macros_open=$event.args.open;publish_monitor($state)
end
on monitor.dialog.intent
  if $event.args.value.instance==$state.dialog then $state.dialog=nil;publish_monitor($state) end
end
