-- version: 0.1.0
$c=require("core.mix")
if $c.target("")!="monitord" or $c.target("example-node")!="monitord.example-node.bus" then raise("TARGET","Routing") end
$refused=false
try $c.target("bad.node") catch $message $refused=true end
if not $refused then raise("TARGET","Invalid node accepted") end
$s=$c.initial()
if $c.query($s).reverse!=false or not $s.reverse or $c.query($s).sort!="cpu" then raise("SORT","Match monitord's default descending CPU contract") end
if len($c.project($s).table.initial.rows)!=0 then raise("EMPTY","No synthetic process rows") end
$s.processes=[]
for $i=1 to 2000
  $s.processes=push($s.processes,{pid:$i,name:"process-"..to_string($i),user:"user",cpu:1,memory:1024,depth:0})
end
$start=monotonic();$model=$c.project($s);$elapsed=monotonic()-$start
if len($model.table.initial.rows)!=2000 then raise("ROWS","Row count") end
if $model.table.initial.rows[1999].cells[5]!="—" then raise("IO","Missing rates must use gold's unavailable marker") end
if len($model.table.initial.columns)!=7 or $model.table.initial.rows[0].cells[4]!="1.0 KiB" then raise("TABLE","Gold columns and binary units") end
$s.processes=push($s.processes,{pid:2001});$refused=false
try $c.project($s) catch $message $refused=true end
if not $refused then raise("INVALID_ROW","Malformed process row accepted") end
print(json_encode({result:"pass",rows:2000,project_seconds:$elapsed,boundary:"Installed Mix interpreter, pure projection only; not embedded Viu latency"}))

$s.processes=[]
for $i=1 to 3000 $s.processes=push($s.processes,{pid:$i,name:"process",user:"user",cpu:0,memory:1,depth:0}) end
if len($c.project($s).table.initial.rows)!=3000 or $c.query($s).limit!=0 then raise("UNBOUNDED","Gold unlimited query/list was capped") end
