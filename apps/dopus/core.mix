-- Application-owned file-manager state. No Rust Dopus controller is called.
fn dp_display($text)
  return re_replace(to_string($text), "\\p{Cc}", "�")
end
fn dp_extension($path)
  $parts=split(basename($path),".")
  return if len($parts)>1 then lower($parts[len($parts)-1]) else "" end
end
fn dp_size($bytes)
  if $bytes==nil then return "—" end
  if $bytes<1024 then return fmt("%d B",$bytes)
  elif $bytes<1048576 then return fmt("%.1f KiB",$bytes/1024)
  elif $bytes<1073741824 then return fmt("%.1f MiB",$bytes/1048576)
  else return fmt("%.1f GiB",$bytes/1073741824) end
end
fn dp_date($timestamp)
  if $timestamp==nil then return "—" end
  try return date_format($timestamp,"%d/%m/%y %H:%M") catch $error return "—" end
end
fn dp_count($count)
  if $count==nil then return "" end
  return to_string($count)..if $count==1 then " item" else " items" end
end
fn dp_filename($name)
  if type($name)!="string" then raise("INVALID_ARGUMENT","Name must be text") end
  $name=trim($name)
  if $name=="" or contains([".",".."],$name) or contains($name,"/") or contains($name,"\u0000") then raise("INVALID_ARGUMENT","Enter a valid file name") end
  return $name
end
fn dp_path($path)
  if type($path)!="string" or $path=="" then raise("INVALID_ARGUMENT","Path must be non-empty text") end
  if $path=='~' then $path=env("HOME","/")
  elif starts_with($path,'~/') then $path=path_join(env("HOME","/"),slice($path,2)) end
  if not starts_with($path,"/") then $path=path_join(cwd(),$path) end
  return $path
end
fn dp_lstat($path)
  try return stat($path,{follow_symlinks:false}) catch $message return nil end
end
fn dp_present($path)
  return dp_lstat($path)!=nil
end
fn dp_summary($entries)
  $folders=len(filter($entries,fn($e)=$e.dir))
  $files=len($entries)-$folders
  $bytes=0
  for $entry in $entries if not $entry.dir then $bytes=$bytes+($entry.size ?? 0) end end
  return fmt("%d %s, %d %s (%s)",$folders,if $folders==1 then "folder" else "folders" end,$files,if $files==1 then "file" else "files" end,dp_size($bytes))
end
fn dp_sort($rows,$key,$ascending)
  -- Stable passes preserve the original's ascending raw-name tie break.
  $rows=sort_by($rows,fn($r)=$r.name)
  if $key=="name" then
    if $ascending then $rows=sort_by($rows,fn($r)=lower($r.name))
    else $rows=reverse(sort_by(reverse($rows),fn($r)=lower($r.name))) end
  else
    $known=[]
    $unknown=[]
    for $row in $rows
      $metric=if $key=="size" then (if $row.dir then $row.child_count else $row.size end) else $row.modified end
      if $metric==nil then push($unknown,$row)
      else $row.sort_metric=$metric;push($known,$row) end
    end
    $known=sort_by($known,fn($r)=if $ascending then $r.sort_metric else -$r.sort_metric end)
    $rows=concat($known,$unknown)
  end
  return concat(filter($rows,fn($r)=$r.dir),filter($rows,fn($r)=not $r.dir))
end
fn dp_scan($path,$hidden,$expanded,$key,$ascending,$depth)
  $rows=[]
  for $name in ls($path)
    if $hidden or not starts_with($name,".") then
      $full=path_join($path,$name)
      $st=dp_lstat($full)
      if $st!=nil then
        $count=nil
        if $st.is_dir then
          try $count=len(filter(ls($full),fn($n)=$hidden or not starts_with($n,"."))) catch $message $count=nil end
        end
        push($rows,{path:$full,name:dp_display($name),dir:$st.is_dir,file:$st.is_file,symlink:$st.is_symlink,size:if $st.is_dir then nil else $st.size end,modified:$st.mtime,child_count:$count,depth:$depth})
      end
    end
  end
  $out=[]
  for $row in dp_sort($rows,$key,$ascending)
    push($out,$row)
    if $row.dir and ($expanded[$row.path] ?? false) then
      $out=concat($out,dp_scan($row.path,$hidden,$expanded,$key,$ascending,$depth+1))
    end
  end
  return $out
end
fn dp_refresh($pane)
  try
    $pane.entries=dp_scan($pane.path,$pane.show_hidden,$pane.expanded,$pane.sort,$pane.ascending,0)
    $pane.root_entries=filter($pane.entries,fn($r)=$r.depth==0)
    $pane.summary=dp_summary($pane.root_entries)
    $pane.error=nil
  catch $message
    $pane.entries=[];$pane.root_entries=[];$pane.summary="Cannot read folder";$pane.error=dp_display($message)
  end
  $paths=map($pane.entries,fn($r)=$r.path)
  $pane.selected_paths=filter($pane.selected_paths,fn($p)=contains($paths,$p))
  if not contains($paths,$pane.selected) then $pane.selected=nil end
  $pane.revision=$pane.revision+1
  return $pane
end
fn dp_pane($config)
  return dp_refresh({path:dp_path($config.path),show_hidden:$config.show_hidden ?? false,previews:$config.previews ?? true,sort:$config.sort ?? "name",ascending:$config.ascending ?? true,selected:nil,selected_paths:[],anchor:nil,expanded:{},back:[],forward:[],entries:[],root_entries:[],revision:0,generation:1,summary:"",error:nil})
end
-- A root relisting starts a new generation and clears selection/expansion,
-- matching the original controller. Sorting/expansion use dp_refresh instead.
fn dp_relist($pane)
  $pane.selected=nil;$pane.selected_paths=[];$pane.anchor=nil;$pane.expanded={}
  $pane.generation=$pane.generation+1
  return dp_refresh($pane)
end
fn dp_navigate($pane,$path)
  $path=dp_path($path)
  if is_file($path) then $path=dirname($path) end
  if $path!=$pane.path then $pane.back=push($pane.back,$pane.path);$pane.forward=[] end
  $pane.path=$path;$pane.selected=nil;$pane.selected_paths=[];$pane.anchor=nil;$pane.expanded={};$pane.generation=$pane.generation+1
  return dp_refresh($pane)
end
fn dp_history($pane,$back)
  $from=if $back then $pane.back else $pane.forward end
  if len($from)==0 then return $pane end
  $path=$from[len($from)-1]
  $from=slice($from,0,len($from)-1)
  if $back then $pane.back=$from;$pane.forward=push($pane.forward,$pane.path)
  else $pane.forward=$from;$pane.back=push($pane.back,$pane.path) end
  $pane.path=$path;$pane.selected=nil;$pane.selected_paths=[];$pane.anchor=nil;$pane.expanded={};$pane.generation=$pane.generation+1
  return dp_refresh($pane)
end
fn dp_pick($pane,$path,$ctrl,$shift)
  $paths=map($pane.entries,fn($r)=$r.path)
  $index=index_of($paths,$path)
  if $index<0 then raise("NOT_FOUND","Row is not in the current tree") end
  if $shift then
    $anchor=index_of($paths,$pane.anchor)
    if $anchor<0 then $anchor=$index end
    $range=slice($paths,min($anchor,$index),max($anchor,$index)+1)
    $pane.selected_paths=if $ctrl then unique(concat($pane.selected_paths,$range)) else $range end
    if $pane.anchor==nil then $pane.anchor=$path end
  elif $ctrl then
    if contains($pane.selected_paths,$path) then $pane.selected_paths=filter($pane.selected_paths,fn($p)=$p!=$path)
    else $pane.selected_paths=push($pane.selected_paths,$path) end
    $pane.anchor=$path
    $pane.selected=if contains($pane.selected_paths,$path) then $path else (filter($paths,fn($p)=contains($pane.selected_paths,$p))[0] ?? nil) end
    return $pane
  else $pane.selected_paths=[$path];$pane.anchor=$path end
  $pane.selected=$path
  return $pane
end
fn dp_select_key($pane,$key,$ctrl,$shift)
  if len($pane.entries)==0 then return $pane end
  $paths=map($pane.entries,fn($r)=$r.path)
  $index=index_of($paths,$pane.selected)
  if $key=="ArrowDown" then $index=min(len($paths)-1,$index+1)
  elif $key=="ArrowUp" then $index=max(0,$index-1)
  elif $key=="Home" then $index=0
  elif $key=="End" then $index=len($paths)-1
  else raise("INVALID_ARGUMENT","Not a selection key") end
  return dp_pick($pane,$paths[$index],$ctrl,$shift)
end
fn dp_expand($pane,$path)
  $row=filter($pane.entries,fn($r)=$r.path==$path and $r.dir)
  if len($row)!=1 then raise("NOT_FOUND","Folder row is not in the current tree") end
  $pane.expanded[$path]=not ($pane.expanded[$path] ?? false)
  return dp_refresh($pane)
end
fn dp_sources($pane)
  $ordered=filter(map($pane.entries,fn($r)=$r.path),fn($p)=contains($pane.selected_paths,$p))
  return filter($ordered,fn($p)=not any($ordered,fn($parent)=$parent!=$p and starts_with($p,$parent.."/")))
end
fn dp_permissions($mode)
  $chars=[]
  $bits=[256,128,64,32,16,8,4,2,1]
  $letters=["r","w","x","r","w","x","r","w","x"]
  for $i=0 to 8 push($chars,if floor($mode/$bits[$i])%2==1 then $letters[$i] else "-" end) end
  for $s in [{bit:2048,index:2,lower:"s",upper:"S"},{bit:1024,index:5,lower:"s",upper:"S"},{bit:512,index:8,lower:"t",upper:"T"}]
    if floor($mode/$s.bit)%2==1 then $chars[$s.index]=if $chars[$s.index]=="x" then $s.lower else $s.upper end end
  end
  return join($chars,"").." ("..sprintf("%04o",$mode%4096)..")"
end
fn dp_identity($file,$id,$column)
  try
    for $line in split(read_file($file),"\n")
      $fields=split($line,":")
      if len($fields)>$column and $fields[$column]==to_string($id) then return dp_display($fields[0]) end
    end
  catch $message
    return to_string($id)
  end
  return to_string($id)
end
