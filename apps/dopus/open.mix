-- The session service owns the controller; the launcher only reopens its scene.
send dopus-mix dopus-mix.open body="{}" timeout=10
if $rc != 0 then raise("DOPUS_UNAVAILABLE", "Dopus Mix session service is unavailable: " .. json_encode($result)) end
