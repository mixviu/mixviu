-- version: 0.1.0
-- File chooser composition/behaviour; the retained native files engine owns
-- request validation, exactly-once outcomes and acceptance checks.
$s=nil
$config=require("config.mix")
$files=require("core.mix")
fn ch_item($id,$label)
  return {id:$id,label:$label,enabled:true}
end
fn ch_rows($s,$folder,$depth)
  $rows=viu_files("scan",{folder:$folder,hidden:$s.hidden,filter:$s.request.current_filter})
  for $i=0 to len($rows)-1
    $rows[$i].depth=$depth;$rows[$i].child_count=nil
    if $rows[$i].dir then
      try $rows[$i].child_count=viu_files("count",{folder:$rows[$i].key,hidden:$s.hidden,filter:$s.request.current_filter}) catch $message $rows[$i].child_count=nil end
    end
  end
  $out=[]
  for $row in $files.dp_sort($rows,$s.sort,$s.ascending)
    push($out,$row)
    if $row.dir and ($s.expanded[$row.key] ?? false) then
      if $depth>=256 then raise("TREE_DEPTH","Expanded directory depth exceeds 256") end
      $out=concat($out,ch_rows($s,$row.key,$depth+1))
    end
    if len($out)>100000 then raise("TREE_ROWS","Expanded directory tree exceeds 100000 rows") end
  end
  return $out
end
fn ch_scan($s)
  $s.rows=ch_rows($s,$s.folder,0);$s.revision=($s.revision ?? 0)+1
  $s.selected=filter($s.selected,fn($p)=any($s.rows,fn($r)=$r.key==$p))
  if not any($s.rows,fn($r)=$r.key==$s.anchor) then $s.anchor=nil end
  if not any($s.rows,fn($r)=$r.key==$s.cursor) then $s.cursor=nil end
  return $s
end
fn ch_go($s,$folder)
  $s.folder=viu_files("uri",{path:$folder});$s.location=viu_files("display-path",{path:$s.folder});$s.selected=[];$s.anchor=nil;$s.cursor=nil;return ch_scan($s)
end
fn ch_key($s,$a)
  if $a.ctrl and $a.key=="L" then $s.focus={id:"location",selection:[0,len($s.location)]};return $s end
  if $a.ctrl and $a.key=="H" then $s.hidden=not $s.hidden;return ch_scan($s) end
  if $a.key=="Escape" then return ch_effect($s,"cancel",{request:$s.id}) end
  if $a.key=="Backspace" or ($a.alt and $a.key=="ArrowUp") then return ch_go($s,viu_files("parent",{path:$s.folder})) end
  if $a.key=="Enter" then
    $row=filter($s.rows,fn($r)=contains($s.selected,$r.key))[0]
    if $row!=nil and $row.dir then return ch_go($s,$row.key) end
    return ch_accept($s,false)
  end
  if contains(["ArrowUp","ArrowDown","Home","End"],$a.key) and len($s.rows)>0 then
    $keys=map($s.rows,fn($r)=$r.key);$i=index_of($keys,$s.cursor ?? $s.anchor)
    $i=if $a.key=="Home" then 0 elif $a.key=="End" then len($keys)-1 elif $i<0 then if $a.key=="ArrowUp" then len($keys)-1 else 0 end elif $a.key=="ArrowUp" then max(0,$i-1) else min(len($keys)-1,$i+1) end
    if $a.shift and $s.anchor!=nil then
      $first=index_of($keys,$s.anchor);$s.selected=slice($keys,min($first,$i),max($first,$i)+1)
    else $s.selected=[$keys[$i]];$s.anchor=$keys[$i] end
    $s.cursor=$keys[$i]
  end
  return $s
end
fn ch_effect($s,$command,$body)
  $s.serial=$s.serial+1;$s.effect={serial:$s.serial,command:$command,body:$body};return $s
end
fn ch_accept($s,$replace)
  $paths=$s.selected
  if $s.request.mode=="save" then $paths=[viu_files("join",{folder:$s.folder,name:$s.raw_name ?? $s.name})]
  elif $s.request.mode=="save_files" then $paths=map($s.request.files,fn($n)=viu_files("join",{folder:$s.folder,name:$n}))
  elif $s.request.directory and len($paths)==0 then $paths=[$s.folder] end
  $s.pending={request:$s.id,paths:$paths,folder:$s.folder,choices:$s.choices,replace:$replace}
  if $s.request.current_filter!=nil then $s.pending.current_filter=$s.request.current_filter end
  return ch_effect($s,"accept",$s.pending)
end
fn ch_project($s)
  $rows=[]
  for $row in $s.rows
    push($rows,{key:$row.key,path:$row.key,cells:[$row.name,if $row.dir then $files.dp_count($row.child_count) else $files.dp_size($row.size) end,$files.dp_date($row.modified)],depth:$row.depth,branch:$row.dir,expanded:$s.expanded[$row.key] ?? false,selected:contains($s.selected,$row.key),focused:$s.cursor==$row.key,icon:if $row.dir then "folder" else "file" end})
  end
  $options=[]
  if len($s.request.filters ?? [])>0 then
    $filters=[]
    for $i=0 to len($s.request.filters)-1
      $f=$s.request.filters[$i];$item=ch_item("filter:"..to_string($i),$f.name);$item.checked=deep_eq($f,$s.request.current_filter);push($filters,$item)
    end
    push($options,{id:"filter",label:"Filter: "..if $s.request.current_filter==nil then "All" else $s.request.current_filter.name end,enabled:true,children:$filters})
  end
  for $i=0 to len($s.request.choices)-1
    $c=$s.request.choices[$i];$items=[]
    if len($c.options)==0 then
      for $v in ["true","false"] $item=ch_item("choice:"..to_string($i)..":"..$v,$v);$item.checked=$s.choices[$c.id]==$v;push($items,$item) end
    else
      for $j=0 to len($c.options)-1
        $o=$c.options[$j];$item=ch_item("option:"..to_string($i)..":"..to_string($j),$o.label);$item.checked=$s.choices[$c.id]==$o.id;push($items,$item)
      end
    end
    push($options,{id:"choice-menu:"..to_string($i),label:$c.label,enabled:true,children:$items})
  end
  $hidden=ch_item("hidden","Hidden files");$hidden.checked=$s.hidden
  $places=[]
  for $i=0 to len($s.places)-1
    $p=$s.places[$i];$selected=false
    try $selected=$s.folder==viu_files("uri",{path:$p.path}) catch $message $selected=false end
    push($places,{key:to_string($i),path:$p.path,cells:[$p.name],depth:0,branch:false,expanded:false,selected:$selected,focused:false,icon:"folder"})
  end
  $values={form:$s.form,places:{key:"places",columns:[{id:"name",label:"Places"}],rows:$places,active:false,context:[],background_context:[]},location:$s.location,name:$s.name,files:{key:$s.folder,revision:$s.revision,sort:$s.sort,ascending:$s.ascending,columns:[{id:"name",label:"Name",min_width:250},{id:"size",label:"Size",min_width:80,align:"right"},{id:"modified",label:"Modified",min_width:95,align:"right"}],rows:$rows,active:true,context:[],background_context:[]},toolbar:[ch_item("parent","Parent folder"),ch_item("home","Home"),$hidden,ch_item("refresh","Refresh")],options:$options,footer:[ch_item("cancel","Cancel"),ch_item("accept",$s.request.accept_label)],status:$s.error}
  return {values:$values,focus:$s.focus,appearance:{scheme:"studio",mode:"dark",style:"default"},save_hidden:$s.request.mode!="save",options_hidden:len($options)==0,effect:$s.effect,ready:true,request:$s.id,folder:$s.folder,selected:$s.selected,choices:$s.choices,current_filter:$s.request.current_filter,name:$s.name,serial:$s.serial}
end
fn ch_publish($s)
  send "viu-local" "scenes.model" body={generation:viu_context().generation,value:ch_project($s)}
  if $rc!=0 then raise("MODEL_PUBLISH",to_string($result)) end
end
on chooser.open
  try
    $r=$event.args.request;$name=""
    if $r.current_name!=nil then $name=viu_files("name",{name:$r.current_name}) end
    $choices={};for $c in $r.choices $choices[$c.id]=$c.default end
    $s={id:$event.args.id,request:$r,folder:$r.current_folder,home:$event.args.home,name:$name,raw_name:$r.current_name,hidden:false,rows:[],selected:[],anchor:nil,choices:$choices,error:"",form:{open:false,title:"",body:"",field:nil,choices:[]},pending:nil,serial:0,effect:nil}
    $s.sort="name";$s.ascending=true;$s.expanded={};$s.revision=0
    $s.location=viu_files("display-path",{path:$s.folder})
    if $r.mode=="save" then
      $parts=split($name,".");$stem=if len($parts)>1 then join(slice($parts,0,len($parts)-1),".") else $name end
      $s.focus={id:"name",selection:[0,if $stem!="" then len($stem) else len($name) end]}
    end
    $configuration=if $event.args.profile==nil then $config.dp_defaults() else $config.dp_load_config(path_join($event.args.profile,"config.conf.mix")).value end
    $s.places=$config.dp_places($configuration)
    $s=ch_scan($s);ch_publish($s);reply(0,json_encode({ready:true}))
  catch $message,$error reply(10,json_encode({error_code:$error.code,message:$message})) end
end
on chooser.call
  try
    $a=$event.args;$candidate=$s;$candidate.effect=nil;$candidate.error="";$candidate.focus=nil
    if $a.command=="result" then
      if $a.rc!=0 then
        if $a.body.error_code=="EXISTS" then
          $candidate.form={open:true,title:"Replace existing files?",body:"The selected destination already exists. Replace it?",field:nil,instance:$candidate.serial,choices:[{id:"cancel",label:"Cancel",enabled:true,cancel:true},{id:"replace",label:"Replace",enabled:true,default:true}]}
        else $candidate.error=$a.body.message ?? json_encode($a.body) end
      end
    elif $a.command=="key" then $candidate=ch_key($candidate,$a)
    elif $a.command=="intent" then
      $id=$a.id;$action=$a.action;$v=$a.value
      if $id=="places" then
        $i=to_number($v.key)
        if $i<0 or $i>=len($candidate.places) then raise("INVALID_ARGUMENT","Unknown place") end
        $candidate=ch_go($candidate,$candidate.places[$i].path)
      elif $id=="location" then
        if $action=="submit" then $candidate=ch_go($candidate,$v)
        elif $action=="set" then $candidate.location=$v
        elif contains(["cancel","blur"],$action) then $candidate.location=viu_files("display-path",{path:$candidate.folder}) end
      elif $id=="name" then
        if $action=="cancel" then $candidate=ch_effect($candidate,"cancel",{request:$candidate.id})
        else
          $candidate.name=$v;$candidate.raw_name=nil
          if $action=="submit" then $candidate=ch_accept($candidate,false) end
        end
      elif $id=="form" then
        if not deep_eq($v.instance,$candidate.form.instance) then raise("STALE_FORM","Replace confirmation has changed") end
        if $v.choice=="replace" then $candidate.pending.replace=true;$candidate=ch_effect($candidate,"accept",$candidate.pending) end
        $candidate.form.open=false
      elif $id=="files" then
        if $action=="sort" then
          if not contains(["name","size","modified"],$v.column) then raise("INVALID_ARGUMENT","Unknown column") end
          $candidate.ascending=if $candidate.sort==$v.column then not $candidate.ascending else true end
          $candidate.sort=$v.column;$candidate=ch_scan($candidate)
        else
        $row=filter($candidate.rows,fn($r)=$r.key==$v.key)[0]
        if $row==nil then raise("INVALID_ARGUMENT","The row is no longer present") end
        if $action=="expand" then $candidate.expanded[$row.key]=$v.expanded;$candidate=ch_scan($candidate)
        elif $action=="activate" then
          if $row.dir then $candidate=ch_go($candidate,$row.key)
          else $candidate.selected=[$row.key];$candidate=ch_accept($candidate,false) end
        elif $action=="select" then
          $candidate.cursor=$row.key
          if $candidate.request.multiple and $v.shift and $candidate.anchor!=nil then
            $keys=map($candidate.rows,fn($r)=$r.key);$a=index_of($keys,$candidate.anchor);$b=index_of($keys,$row.key)
            $candidate.selected=slice($keys,min($a,$b),max($a,$b)+1)
          elif $candidate.request.multiple and $v.ctrl then
            $candidate.selected=if contains($candidate.selected,$row.key) then filter($candidate.selected,fn($p)=$p!=$row.key) else concat($candidate.selected,[$row.key]) end
            $candidate.anchor=$row.key
          else $candidate.selected=[$row.key];$candidate.anchor=$row.key end
          if not $row.dir and $candidate.request.mode=="save" then $candidate.name=$row.name;$candidate.raw_name=viu_files("leaf",{path:$row.key}) end
        end
        end
      elif contains(["toolbar","footer","options"],$id) then
        $c=$v.command
        if $c=="parent" then $candidate=ch_go($candidate,viu_files("parent",{path:$candidate.folder}))
        elif $c=="home" then $candidate=ch_go($candidate,$candidate.home)
        elif $c=="refresh" then $candidate=ch_scan($candidate)
        elif $c=="hidden" then $candidate.hidden=not $candidate.hidden;$candidate=ch_scan($candidate)
        elif $c=="cancel" then $candidate=ch_effect($candidate,"cancel",{request:$candidate.id})
        elif $c=="accept" then $candidate=ch_accept($candidate,false)
        elif starts_with($c,"filter:") then $candidate.request.current_filter=$candidate.request.filters[to_number(slice($c,7))];$candidate=ch_scan($candidate)
        elif starts_with($c,"choice:") then $parts=split($c,":");$candidate.choices[$candidate.request.choices[to_number($parts[1])].id]=$parts[2]
        elif starts_with($c,"option:") then $parts=split($c,":");$choice=$candidate.request.choices[to_number($parts[1])];$candidate.choices[$choice.id]=$choice.options[to_number($parts[2])].id
        else raise("UNKNOWN_ACTION",$c) end
      end
    else raise("UNKNOWN_COMMAND","Unknown chooser command") end
    $s=$candidate;ch_publish($s);reply(0,json_encode({ok:true}))
  catch $message,$error
    $s.error=$message;ch_publish($s);reply(10,json_encode({error_code:$error.code,message:$message}))
  end
end
