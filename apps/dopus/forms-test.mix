-- version: 0.1.0
$app=require("reducer.mix")
fn forms_test_check($ok,$message)
  if not $ok then raise("CHECK_FAILED",$message) end
end
$state={next_token:0,form:$app.dp_closed_form(),reservation:nil,busy:false,reply:{}}
$state=$app.dp_form($state,"delete","First","first pinned path",nil,{kind:"delete",sources:["/first"]})
$first=$state.form.instance
$state=$app.dp_form($state,"delete","Second","second pinned path",nil,{kind:"delete",sources:["/second"]})
forms_test_check($state.form.title=="First" and len($state.form_queue)==1,"second confirmation queues")
$state=$app.dp_answer($state,"cancel")
forms_test_check($state.form.title=="Second" and $state.form.instance!=$first,"queued form has a fresh render identity")
forms_test_check($state.reservation.operation.sources[0]=="/second","queued selection stays pinned")
$state.busy=true
$state=$app.dp_answer($state,"ok")
forms_test_check(not $state.form.open and $state.reply.error_code=="BUSY","busy acceptance consumes its reservation exactly once")
$refused=false
try $app.dp_answer($state,"ok") catch $message $refused=true end
forms_test_check($refused,"second acceptance cannot execute")
$state.busy=false
$state=$app.dp_form($state,"rename","Rename","","original",{kind:"rename",source:"/original"})
$state.form.field="../bad"
$state=$app.dp_answer($state,"ok")
forms_test_check($state.form.open and $state.form.error!="" and $state.reservation.operation.source=="/original","bad name retains the pinned reservation")
$refused=false
try $app.dp_form($state,"mkdir","Another","","new",{}) catch $message $refused=true end
forms_test_check($refused,"only one name edit can be pending")
$view=require("presentation.mix")
$legacy=$view.dp_legacy_view($state)
forms_test_check($legacy.kind=="name" and $legacy.name=="../bad","legacy name envelope retains the actual prompt text")
$state=$app.dp_answer($state,"cancel")
forms_test_check($view.dp_legacy_view($state)==nil,"closed legacy envelope is nil")
$state=$app.dp_form($state,"message","About Dopus","About body",nil,{legacy_kind:"about"})
$legacy=$view.dp_legacy_view($state)
forms_test_check($legacy.kind=="about" and $legacy.body=="About body" and $legacy.buttons[0].id=="done","legacy message envelope has a typed Done button")
-- Explicit pane actions work without a window and preserve both selections.
$contract={actions:[{id:"nav.pane-left"},{id:"nav.pane-right"},{id:"file.new-folder"}],action_aliases:{}}
$state={headless:true,active:1,busy:false,next_token:0,form:$app.dp_closed_form(),panes:[{path:"/left",selected_paths:["/left/a"]},{path:"/right",selected_paths:[]}],info:"Select a file or folder"}
for $target in [{id:"nav.pane-left",index:0},{id:"nav.pane-left",index:0},{id:"nav.pane-right",index:1},{id:"nav.pane-right",index:1}]
  $before=$state.panes
  $state=$app.dp_action($state,$contract,$target.id,{})
  forms_test_check($state.active==$target.index and deep_eq($state.panes,$before),"explicit focus is idempotent and preserves panes headlessly")
  $state=$app.dp_action($state,$contract,"file.new-folder",{})
  forms_test_check($state.reservation.operation.destination==$state.panes[$target.index].path,"new folder uses the explicitly active pane")
  $state=$app.dp_answer($state,"cancel")
end
$state.panes[0].entries=[{path:"/left/a",name:"a\nb",dir:false,symlink:false,size:1024},{path:"/left/Folder",name:"Folder",dir:true,symlink:false,size:nil}]
$state.active=0
forms_test_check($view.dp_selection_info($state)=="a�b — File — 1.0 KiB","single selection includes safe name, kind and size")
$state.panes[0].selected_paths=["/left/Folder"]
forms_test_check($view.dp_selection_info($state)=="Folder — Folder — —","directory size is explicitly unknown")
$state.panes[0].selected_paths=["/left/a","/left/Folder"]
forms_test_check($view.dp_selection_info($state)=="2 selected — 1.0 KiB (known sizes)","mixed selection does not claim recursive directory sizes")
$state.info="Operation failed"
forms_test_check($view.dp_selection_info($state)=="Operation failed","operation errors remain visible")
$before=$state
$state.panes[0].selected_paths=[]
$state=$app.dp_selection_notice($before,$state)
forms_test_check($view.dp_selection_info($state)=="Select a file or folder","deselection clears old notices")
$state.info="Copying";$state.busy=true;$before=$state
$state.active=1
$state=$app.dp_selection_notice($before,$state)
forms_test_check($view.dp_selection_info($state)=="Copying","busy operation notice survives pane changes")
$state.busy=false;$before=$state;$state.active=0
$state=$app.dp_selection_notice($before,$state)
forms_test_check($view.dp_selection_info($state)=="Select a file or folder","pane change clears a completed notice")
print(json_encode({checks:25,result:"passed"}))
