-- version: 0.1.0
-- App-owned projection into reusable Viu controls. Shared data is deliberately
-- consumed by both language drivers; no native file-manager reducer is called.
$dp=require("core.mix")
fn dp_rows($pane)
  -- Retain the established per-cell fallback for unrepresentable timestamps.
  for $entry in unique_by($pane.entries,fn($r)=[type($r.modified),$r.modified])
    if $entry.modified!=nil then
      try date_format($entry.modified,"%d/%m/%y %H:%M") catch $message return dp_rows_interpreted($pane) end
    end
  end
  $expanded=$pane.expanded
  -- File-manager choices are data and expressions owned by this Mix app.
  $icons={png:"file-image",jpg:"file-image",jpeg:"file-image",gif:"file-image",webp:"file-image",svg:"file-image",avif:"file-image",mp3:"file-music",flac:"file-music",wav:"file-music",ogg:"file-music",mp4:"file-video-camera",m4v:"file-video-camera",mkv:"file-video-camera",webm:"file-video-camera",zip:"file-archive",gz:"file-archive",tar:"file-archive","7z":"file-archive",rs:"file-code",mix:"file-code",c:"file-code",h:"file-code",toml:"file-code",yaml:"file-code",yml:"file-code",json:"file-code",txt:"file-text",log:"file-text",conf:"file-text",md:"file-text",html:"file-text",htm:"file-text",css:"file-text",csv:"file-text",xml:"file-text",pdf:"file-text"}
  return rows_project($pane.entries,fn($r)={key:$r.path,cells:[$r.name,$r.dir ? ($r.child_count==nil ? "" : to_string($r.child_count)..($r.child_count==1 ? " item" : " items")) : ($r.size==nil ? "—" : $r.size<1024 ? fmt("%d B",$r.size) : $r.size<1048576 ? fmt("%.1f KiB",$r.size/1024) : $r.size<1073741824 ? fmt("%.1f MiB",$r.size/1048576) : fmt("%.1f GiB",$r.size/1073741824)),$r.modified==nil ? "—" : date_format($r.modified,"%d/%m/%y %H:%M")],depth:$r.depth,branch:$r.dir,expanded:$expanded[$r.path] ?? false,selected:false,focused:false,icon:$r.dir ? (($expanded[$r.path] ?? false) ? "folder-open" : "folder") : (len(split($r.name,"."))>1 ? ($icons[lower(split($r.name,".")[len(split($r.name,"."))-1])] ?? "file") : "file")})
end
fn dp_rows_interpreted($pane)
  $rows=[]
  for $r in $pane.entries
    $r.expanded=$pane.expanded[$r.path] ?? false
    push($rows,{key:$r.path,cells:[$r.name,if $r.dir then $dp.dp_count($r.child_count) else $dp.dp_size($r.size) end,$dp.dp_date($r.modified)],depth:$r.depth,branch:$r.dir,expanded:$r.expanded,selected:false,focused:false,icon:dp_icon($r)})
  end
  return $rows
end
fn dp_prepare_rows($state,$cache)
  for $i=0 to 1
    $pane=$state.panes[$i]
    $stamp={path:$pane.path,revision:$pane.revision}
    if not deep_eq($cache[$i].stamp,$stamp) then
      $cache[$i]={stamp:$stamp,rows:dp_rows($pane)}
    end
  end
  return $cache
end
fn dp_icon($row)
  if $row.dir then return if $row.expanded ?? false then "folder-open" else "folder" end end
  $ext=$dp.dp_extension($row.path)
  if contains(["png","jpg","jpeg","gif","webp","svg","avif"],$ext) then return "file-image"
  elif contains(["mp3","flac","wav","ogg"],$ext) then return "file-music"
  elif contains(["mp4","m4v","mkv","webm"],$ext) then return "file-video-camera"
  elif contains(["zip","gz","tar","7z"],$ext) then return "file-archive"
  elif contains(["rs","mix","c","h","toml","yaml","yml","json"],$ext) then return "file-code"
  elif contains(["txt","log","conf","md","html","htm","css","csv","xml","pdf"],$ext) then return "file-text" end
  return "file"
end
fn dp_enabled($state,$id)
  if ($state.headless ?? false) and contains(["location.focus","view.toggle-places","view.toggle-properties"],$id) then return false end
  $p=$state.panes[$state.active]
  $n=len($p.selected_paths)
  if $id=="file.open" then return $n>0
  elif $id=="file.mail" then return $n>0 and all(filter($p.entries,fn($r)=contains($p.selected_paths,$r.path)),fn($r)=$r.file)
  elif $id=="file.rename" then return $n==1 and not $state.busy
  elif contains(["file.copy-other-pane","file.move-other-pane","file.delete"],$id) then return $n>0 and not $state.busy
  elif $id=="file.new-folder" then return not $state.busy
  end
  return true
end
fn dp_command($state,$contract,$id)
  $a=filter($contract.actions,fn($a)=$a.id==$id)[0]
  if $a==nil then raise("UNKNOWN_ACTION",$id) end
  $id=$contract.action_aliases[$id] ?? $id
  $a.enabled=dp_enabled($state,$id)
  $a.shortcut=$a.keys[0]
  $p=$state.panes[$state.active]
  if $id=="nav.back" then $a.enabled=len($p.back)>0
  elif $id=="nav.forward" then $a.enabled=len($p.forward)>0 end
  $a.checked=if $id=="view.toggle-hidden" then $p.show_hidden elif $id=="view.toggle-previews" then $p.previews elif $id=="view.toggle-places" then $state.places_open elif $id=="view.toggle-properties" then $state.properties_open elif contains(["theme.scheme-session","theme.mode-session","theme.style-session"],$id) then $state.appearance_choice[replace(slice($id,len("theme.")),"-session","")]==nil elif starts_with($id,"theme.decorations-") then ($state.window_choice["window.decorations"] ?? "auto")==slice($id,len("theme.decorations-")) elif starts_with($id,"theme.captions-") then ($state.window_choice["window.caption_side"] ?? "auto")==slice($id,len("theme.captions-")) elif starts_with($id,"theme.scheme-") then $state.appearance_choice.scheme==slice($id,13) elif starts_with($id,"theme.style-") then $state.appearance_choice.style==slice($id,12) elif starts_with($id,"theme.mode-") then $state.appearance_choice.mode==slice($id,11) else nil end
  return $a
end
fn dp_menus($state,$contract)
  return map($contract.menus,fn($item)=dp_toolbar_item($state,$contract,$item))
end
fn dp_toolbar_item($state,$contract,$item)
  if $item.separator ?? false then return $item end
  if $contract.ui_labels[$item.id]!=nil then $item.label=$contract.ui_labels[$item.id] end
  if $item.children!=nil then
    $children=[]
    for $child in $item.children push($children,dp_toolbar_item($state,$contract,$child)) end
    $item.children=$children
  else
    $command=dp_command($state,$contract,$item.id)
    $item.enabled=$command.enabled;$item.checked=$command.checked;$item.shortcut=$command.shortcut
  end
  return $item
end
fn dp_toolbar($state,$contract)
  $out=[]
  for $item in $contract.toolbar push($out,dp_toolbar_item($state,$contract,$item)) end
  return $out
end
fn dp_kind($path,$st)
  if $st.is_symlink then return "Symbolic link"
  elif $st.is_dir then return "Folder" end
  $ext=$dp.dp_extension($path)
  $types={txt:"text/plain",log:"text/plain",conf:"text/plain",md:"text/markdown",html:"text/html",htm:"text/html",css:"text/css",csv:"text/csv",json:"application/json",xml:"application/xml",pdf:"application/pdf",zip:"application/zip",gz:"application/gzip",tar:"application/x-tar","7z":"application/x-7z-compressed",png:"image/png",jpg:"image/jpeg",jpeg:"image/jpeg",gif:"image/gif",webp:"image/webp",svg:"image/svg+xml",avif:"image/avif",mp3:"audio/mpeg",flac:"audio/flac",wav:"audio/wav",ogg:"audio/ogg",mp4:"video/mp4",m4v:"video/mp4",mkv:"video/x-matroska",webm:"video/webm",rs:"text/plain",mix:"text/plain",c:"text/plain",h:"text/plain",toml:"text/plain",yaml:"text/plain",yml:"text/plain"}
  return if $ext=="" then "File" else upper($ext).." file" end.." ("..($types[$ext] ?? "application/octet-stream")..", guessed)"
end
fn dp_properties($pane)
  if $pane.selected==nil then return [{label:"Folder",value:$dp.dp_display($pane.path)},{label:"Contents",value:$pane.summary}] end
  $path=$pane.selected
  $st=$dp.dp_lstat($path)
  if $st==nil then return [{label:"Unavailable",value:"Entry no longer exists"}] end
  $row=filter($pane.entries,fn($r)=$r.path==$path)[0]
  $fields=[{label:"Name",value:$dp.dp_leaf_text($path)},{label:"Kind",value:dp_kind($path,$st)},{label:"Size",value:if $st.is_dir then $dp.dp_count($row.child_count) else $dp.dp_size($st.size) end},{label:"Modified",value:$dp.dp_date($st.mtime)},{label:"Created",value:$dp.dp_date($st.btime)},{label:"Accessed",value:$dp.dp_date($st.atime)},{label:"Permissions",value:$dp.dp_permissions($st.perm)},{label:"Owner and group",value:$dp.dp_identity("/etc/passwd",$st.uid,2)..":"..$dp.dp_identity("/etc/group",$st.gid,2)}]
  if $st.is_symlink then push($fields,{label:"Link target",value:$dp.dp_display(viu_files("display-link",{path:$path}))}) end
  push($fields,{label:"Path",value:$dp.dp_display($path)})
  return $fields
end
-- Original typed dialog envelope. Rendering and native automation continue
-- to consume the same Viu form; old Bus readers retain their named fields.
fn dp_legacy_view($s)
  if not $s.form.open then return nil end
  $kind=$s.reservation.kind
  $buttons=[]
  if $kind=="delete" then
    $buttons=[{id:"yes",label:"Yes",role:"default"},{id:"no",label:"No",role:"cancel"}]
  elif $kind=="message" then
    $buttons=[{id:"done",label:"Done",role:"default"}]
  else
    for $c in $s.form.choices
      push($buttons,{id:$c.id,label:$c.label,role:if $c.cancel ?? false then "cancel" elif $c.default ?? false then "default" else "other" end})
    end
  end
  $out={kind:if contains(["mkdir","rename"],$kind) then "name" elif $kind=="message" then $s.reservation.operation.legacy_kind ?? "message" else $kind end,title:$s.form.title,buttons:$buttons,status:$s.dialog_status}
  if $s.form.field!=nil then $out.name=$s.form.field elif $s.reservation.operation.legacy_kind!="shortcuts" then $out.body=$s.form.body end
  if $kind=="drop" then $out.paths=$s.reservation.operation.sources;$out.path=$s.reservation.operation.destination end
  return $out
end
fn dp_project($state,$contract,$cache)
  $window=$state.window ?? {}
  for $key in keys($state.window_choice ?? {})
    if $state.window_choice[$key]!="auto" then $window[$key]=$state.window_choice[$key] end
  end
  $title_align=$window["window.title_align"] ?? "auto"
  if not contains(["left","center","right"],$title_align) then $title_align=if $window["window.style"]=="win11" then "left" else "center" end end
  $menu_side=$window["window.menu_side"] ?? "left"
  if not contains(["left","center","right"],$menu_side) then $menu_side="left" end
  $actions_align=$window["window.actions_align"] ?? "right"
  if not contains(["left","center","right"],$actions_align) then $actions_align="right" end
  $compact=contains(["button","titlebar"],$window["window.menu_style"])
  $caption_side=$window["window.caption_side"] ?? "right"
  if not contains(["left","center","right"],$caption_side) then $caption_side="right" end
  $header_groups={menu:{preferred:if $compact then 36 else 180 end,minimum:if $compact then 36 else 120 end,align:$menu_side,shrink:1,order:0},toolbar:{preferred:280,minimum:80,align:$actions_align,shrink:1,order:2},"caption-title":{preferred:"content",minimum:0,align:$title_align,shrink:0,order:1},window:{preferred:"window.captions",minimum:"window.captions",align:$caption_side,shrink:nil,order:3}}
  if $window["viu.hosted-menu"] ?? false then $header_groups.menu.preferred=0;$header_groups.menu.minimum=0 end
  if $window["viu.hosted-actions"] ?? false then $header_groups.toolbar.preferred=0;$header_groups.toolbar.minimum=0 end
  $caption_control={id:"caption-title",kind:"label",label:"",initial:"",properties:{align:$title_align,emphasis:true,truncate:true}}
  $context=map($contract.context,fn($id)=dp_command($state,$contract,$id))
  $background=map($contract.background_context,fn($id)=dp_command($state,$contract,$id))
  $values={"caption-title":$dp.dp_display($state.panes[$state.active].path),menu:dp_menus($state,$contract),toolbar:dp_toolbar($state,$contract),status:$state.info,properties:dp_properties($state.panes[$state.active]),form:$state.form}
  $values.window={side:$caption_side,enabled:true}
  $values.form.dialog=dp_legacy_view($state)
  $panes=[]
  for $i=0 to 1
    $p=$state.panes[$i]
    $side=if $i==0 then "left" else "right" end
    $rows=$cache[$i].rows
    $values[$side.."-location"]=$state.locations[$i]
    $values[$side.."-summary"]=$p.summary
    $values[$side.."-tree"]={key:$p.path,revision:$p.revision,active:$state.active==$i,columns:$contract.columns,sort:$p.sort,ascending:$p.ascending,rows:$rows,selected_keys:$p.selected_paths,focused_key:$p.selected,context:$context,background_context:$background}
    $expanded=[]
    for $path in keys($p.expanded) if $p.expanded[$path] then push($expanded,$path) end end
    push($panes,{path:$p.path,generation:$p.generation,show_hidden:$p.show_hidden,previews:$p.previews,sort:$p.sort,ascending:$p.ascending,selected:$p.selected,selected_paths:filter(map($p.entries,fn($r)=$r.path),fn($path)=contains($p.selected_paths,$path)),expanded:sort($expanded),summary:$p.summary,rows:len($p.entries),error:$p.error})
  end
  $place_rows=[]
  $place_icons={Home:"house",Filesystem:"hard-drive",Documents:"file-text",Downloads:"download",Music:"music",Pictures:"image",Videos:"film"}
  for $i=0 to len($state.places)-1
    $p=$state.places[$i]
    push($place_rows,{key:"place."..to_string($i),path:$p.path,cells:[$dp.dp_display($p.name)],depth:0,branch:false,expanded:false,selected:$state.panes[$state.active].path==$p.path,focused:false,icon:$place_icons[$p.name] ?? "folder"})
  end
  $values.places={key:"places",revision:0,active:false,columns:[{id:"name",label:"Places"}],rows:$place_rows,context:[],background_context:[]}
  $values.preview=if $state.preview_slots==nil then {phase:"none"} else $state.preview_slots[$state.active].value end
  $layout={form:{edge:"top",size:0},topbar:{edge:"top",size:34},"status-pane":{edge:"bottom",size:32},"places-pane":{edge:"left",fraction:$state.places_width,resizable:true,panel:true,min_fraction:0.1,max_fraction:0.3,minimum_window_width:640},"properties-pane":{edge:"right",fraction:$state.properties_width,resizable:true,panel:true,min_fraction:0.1,max_fraction:0.3,minimum_window_width:640},"center-pane":{edge:"fill",panel:true}}
  return {window_settings:$window,topbar_hidden:($window["viu.hosted-menu"] ?? false) and ($window["viu.hosted-actions"] ?? false),actions:map($contract.actions,fn($a)=dp_command($state,$contract,$a.id)),values:$values,panes:$panes,active:$state.active,split:$state.split,layout:$layout,header_groups:$header_groups,caption_control:$caption_control,pane_outlines:{left:if $state.active==0 then "design.selection.background" else nil end,right:if $state.active==1 then "design.selection.background" else nil end},places_hidden:not $state.places_open,properties_hidden:not $state.properties_open,appearance:$state.appearance,busy:$state.busy,serial:$state.serial,focus:$state.focus,info:$state.info,ready:true}
end
