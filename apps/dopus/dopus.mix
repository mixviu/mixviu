$c = require("core.mix")
$dir = dirname(script_path())
$root = env("DOPUS_DEMO_ROOT", env("XDG_DATA_HOME", env("HOME") .. "/.local/share") .. "/mixviu/dopus-demo")
$demo = require("demo.mix")
$demo.prepare_demo($root)
$ctx = viu_context()
$s = $c.new_state($root, $root .. "/left", $root .. "/right")
$new_name = ""
fn paint_state($state)
  $t = monotonic()
  send "viu-local" "scenes.model" body={name: $ctx.name, generation: $ctx.generation, value: $c.model($state)} timeout=5
  if $rc != 0 then raise("MODEL_REFUSED", json_encode($result)) end
  return (monotonic() - $t) * 1000
end
fn event_args()
  $a = $event.args ?? {}
  if type($event.body) == "string" and $event.body != "" then
    try $a = json_parse($event.body) catch $e end
  end
  return $a
end
fn safe_apply($state, $command, $params)
  try
    return $c.apply($state, $command, $params)
  catch $message, $error
    $state.status = $error.code .. ": " .. $message
    return $state
  end
end
fn row_pick($state, $pane, $a)
  if type($a.item) != "map" or type($a.item.id) != "string" then
    $state.status = "INVALID_ROW: select a listed file"
    return $state
  end
  $ids = map($state.panes[$pane].entries, fn($r) = $r.id)
  $index = index_of($ids, $a.item.id)
  if $index < 0 then
    $state.status = "STALE_ROW: refresh and select the row again"
    return $state
  end
  $modifiers = $a.modifiers ?? {}
  return safe_apply($state, "pick", {pane: $pane, index: $index, ctrl: $modifiers.ctrl ?? false, shift: $modifiers.shift ?? false})
end
paint_state($s)
on pick_left
  $s = row_pick($s, 0, event_args()); paint_state($s); reply(0, {})
end
on pick_right
  $s = row_pick($s, 1, event_args()); paint_state($s); reply(0, {})
end
on path_left
  $s = safe_apply($s, "open", {pane: 0, path: event_args().value}); paint_state($s); reply(0, {})
end
on path_right
  $s = safe_apply($s, "open", {pane: 1, path: event_args().value}); paint_state($s); reply(0, {})
end
on name_changed
  $new_name = event_args().value
  reply(0, {})
end
on switch
  $s = safe_apply($s, "switch", {}); paint_state($s); reply(0, {})
end
on parent
  $s = safe_apply($s, "parent", {}); paint_state($s); reply(0, {})
end
on back
  $s = safe_apply($s, "back", {}); paint_state($s); reply(0, {})
end
on hidden
  $s = safe_apply($s, "hidden", {}); paint_state($s); reply(0, {})
end
on refresh
  $s = safe_apply($s, "refresh", {}); paint_state($s); reply(0, {})
end
on expand
  $s = safe_apply($s, "expand", {}); paint_state($s); reply(0, {})
end
on open_selected
  $s = safe_apply($s, "open", {path: $s.panes[$s.active].focus}); paint_state($s); reply(0, {})
end
on mkdir
  $s = safe_apply($s, "mkdir", {name: $new_name}); paint_state($s); reply(0, {})
end
on rename
  $s = safe_apply($s, "rename", {name: $new_name}); paint_state($s); reply(0, {})
end
on copy
  $s = safe_apply($s, "copy", {}); paint_state($s); reply(0, {})
end
on move
  $s = safe_apply($s, "move", {}); paint_state($s); reply(0, {})
end
on sort_name_left
  $s = safe_apply($s, "sort", {pane: 0, key: "name"}); paint_state($s); reply(0, {})
end
on sort_size_left
  $s = safe_apply($s, "sort", {pane: 0, key: "size"}); paint_state($s); reply(0, {})
end
on sort_modified_left
  $s = safe_apply($s, "sort", {pane: 0, key: "modified"}); paint_state($s); reply(0, {})
end
on sort_name_right
  $s = safe_apply($s, "sort", {pane: 1, key: "name"}); paint_state($s); reply(0, {})
end
on sort_size_right
  $s = safe_apply($s, "sort", {pane: 1, key: "size"}); paint_state($s); reply(0, {})
end
on sort_modified_right
  $s = safe_apply($s, "sort", {pane: 1, key: "modified"}); paint_state($s); reply(0, {})
end
