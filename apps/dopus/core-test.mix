-- SPDX-License-Identifier: MIT OR Apache-2.0
-- version: 0.1.0
-- Real filesystem checks; the supplied test directory must not exist.
$dp=require("core.mix")
$ops=require("operations.mix")
$view=require("presentation.mix")
$base=args()[0]
if type($base)!="string" or not starts_with($base,"/") or exists($base) then raise("TEST_ROOT","Supply a fresh absolute disposable directory") end
mkdir($base)
fn dptest_assert($ok,$message)
  if not $ok then raise("CHECK_FAILED",$message) end
end
fn dptest_refuses($call)
  try $call() catch $message return true end
  return false
end
$checks=[]
mkdir($base.."/left/Folder/Child")
mkdir($base.."/right")
write_file($base.."/left/first.txt","first content\n")
write_file($base.."/left/second.txt","second content\n")
write_file($base.."/left/.hidden","hidden")
write_file($base.."/left/Folder/inside.txt","inside")
symlink("first.txt",$base.."/left/link")
symlink("absent",$base.."/left/dangling")
chmod($base.."/left/Folder",0o750)

dptest_assert($dp.dp_size(1536)=="1.5 KiB","binary size formatting")
dptest_assert($dp.dp_permissions(0o4755)=="rwsr-xr-x (4755)","special permission bits")
dptest_assert($dp.dp_display("a\nb")=="a�b","display sanitises controls")
push($checks,"formatters")
$p=$dp.dp_pane({path:$base.."/left"})
dptest_assert(not any($p.entries,fn($r)=$r.name==".hidden"),"hidden files initially absent")
dptest_assert($p.entries[0].dir,"directories stay first")
$p=$dp.dp_expand($p,$base.."/left/Folder")
dptest_assert(any($p.entries,fn($r)=$r.depth==1 and $r.name=="inside.txt"),"tree expands actual children")
$p=$dp.dp_pick($p,$base.."/left/first.txt",false,false)
$p=$dp.dp_pick($p,$base.."/left/second.txt",true,false)
dptest_assert(len($p.selected_paths)==2,"ctrl adds selection")
$p=$dp.dp_pick($p,$base.."/left/second.txt",true,false)
dptest_assert(len($p.selected_paths)==1,"ctrl removes selection")
dptest_assert($p.selected==$base.."/left/first.txt","ctrl removal focuses first remaining visible row")
$p=$dp.dp_pick($p,$base.."/left/Folder",false,false)
$p=$dp.dp_pick($p,$base.."/left/first.txt",true,false)
$p=$dp.dp_pick($p,$base.."/left/second.txt",true,true)
dptest_assert(contains($p.selected_paths,$base.."/left/Folder"),"ctrl-shift adds range without losing prior selection")
$p=$dp.dp_pick($p,$base.."/left/Folder",false,false)
$p=$dp.dp_select_key($p,"End",false,true)
dptest_assert(len($p.selected_paths)==len($p.entries),"shift range uses visible tree ordering")
$before=$p
dptest_assert(dptest_refuses(fn()=$dp.dp_pick($p,"missing",false,false)),"missing row refuses")
dptest_assert(deep_eq($p,$before),"refused selection leaves input state intact")
push($checks,"tree-selection")
$refreshed=$dp.dp_refresh($p)
dptest_assert(deep_eq($refreshed.selected_paths,$p.selected_paths),"projection refresh preserves current selection")
$relisted=$dp.dp_relist($p)
dptest_assert($relisted.selected==nil and len($relisted.selected_paths)==0 and len($relisted.expanded)==0,"root relist clears selection and expansion")
dptest_assert($relisted.generation==$p.generation+1 and all($relisted.entries,fn($r)=$r.depth==0),"root relist advances generation and removes children")
push($checks,"relist-generation-selection")
$p=$dp.dp_navigate($p,$base.."/right")
$p=$dp.dp_history($p,true)
dptest_assert($p.path==$base.."/left","back restores path")
$p=$dp.dp_history($p,false)
dptest_assert($p.path==$base.."/right","forward restores path")
$p=$dp.dp_history($p,true)
$p=$dp.dp_navigate($p,$base.."/left/Folder")
dptest_assert(len($p.forward)==0,"new navigation clears forward history")
push($checks,"navigation-history")

write_file($base.."/right/second.txt","retained collision")
dptest_assert(dptest_refuses(fn()=$ops.dp_batch("copy",[$base.."/left/first.txt",$base.."/left/second.txt"],$base.."/right")),"batch collision refuses")
dptest_assert(not exists($base.."/right/first.txt"),"preflight prevents earlier copy")
dptest_assert(read_file($base.."/right/second.txt")=="retained collision","existing content survives")
dptest_assert(dptest_refuses(fn()=$ops.dp_transfer_one("copy",$base.."/left/first.txt",$base.."/right/second.txt")),"direct copy collision refuses before cleanup")
dptest_assert(read_file($base.."/right/second.txt")=="retained collision","direct refusal never removes existing destination")
remove($base.."/right/second.txt")
push($checks,"batch-preflight-no-overwrite")
$r=$ops.dp_batch("copy",[$base.."/left/first.txt",$base.."/left/link",$base.."/left/dangling",$base.."/left/Folder"],$base.."/right")
dptest_assert($r.ok and len($r.completed)==4,"copy batch completes")
dptest_assert(read_file($base.."/right/first.txt")=="first content\n","file content equality")
dptest_assert(read_link($base.."/right/link")=="first.txt","relative symlink target preserved")
dptest_assert(read_link($base.."/right/dangling")=="absent","dangling symlink preserved")
dptest_assert(read_file($base.."/right/Folder/inside.txt")=="inside","recursive directory content")
dptest_assert(stat($base.."/right/Folder").perm==0o750,"directory permission bits preserved")
push($checks,"recursive-copy-and-links")
dptest_assert(dptest_refuses(fn()=$ops.dp_batch("copy",[$base.."/left/Folder"],$base.."/left/Folder/Child")),"self-descendant copy refuses")
dptest_assert(dptest_refuses(fn()=$ops.dp_batch("move",[$base.."/left/Folder",$base.."/left/Folder/inside.txt"],$base.."/right")),"overlapping move sources refuse")
push($checks,"containment-and-overlap")
$r=$ops.dp_execute_operation({kind:"mkdir",destination:$base.."/right",name:" New folder "})
dptest_assert(is_dir($base.."/right/New folder"),"trimmed new-folder name")
dptest_assert(dptest_refuses(fn()=$ops.dp_execute_operation({kind:"mkdir",destination:$base.."/right",name:"../escape"})),"invalid name refuses")
$r=$ops.dp_execute_operation({kind:"rename",source:$base.."/right/New folder",name:"Renamed"})
dptest_assert(is_dir($base.."/right/Renamed") and not exists($base.."/right/New folder"),"rename moves exact entry")
push($checks,"new-folder-and-rename")
$r=$ops.dp_batch("move",[$base.."/left/second.txt"],$base.."/right")
dptest_assert($r.ok and not exists($base.."/left/second.txt") and read_file($base.."/right/second.txt")=="second content\n","move content equality")
push($checks,"move")
dptest_assert(dptest_refuses(fn()=$ops.dp_batch("delete",[$base.."/right/first.txt",$base.."/missing"],nil)),"delete preflights missing sources")
dptest_assert(exists($base.."/right/first.txt"),"failed delete keeps earlier source")
$r=$ops.dp_batch("delete",[$base.."/right/first.txt",$base.."/right/Folder",$base.."/right/dangling"],nil)
dptest_assert($r.ok and not exists($base.."/right/Folder") and $dp.dp_lstat($base.."/right/dangling")==nil,"delete removes actual entries")
dptest_assert(exists($base.."/left/first.txt"),"deleting copied link/tree never touches source")
push($checks,"delete")
-- Exercise actual listing metadata for links to files/directories and dangling links.
symlink("Folder",$base.."/left/directory-link")
for $name in [".bashrc",".hidden.txt","trailing.","normal.TXT"]
  write_file($base.."/left/"..$name,"x")
end
$p=$dp.dp_pane({path:$base.."/left",show_hidden:true})
for $name in [".bashrc",".hidden.txt","trailing.","normal.TXT"]
  $p.selected_paths=[$base.."/left/"..$name]
  $expected=if $name=="normal.TXT" then "TXT file" else "File" end
  dptest_assert($view.dp_selection_info({info:$dp.dp_idle_info,active:0,panes:[$p]})==$name.." — "..$expected.." — 1 B","hidden/trailing-dot selection kind: "..$name)
end
for $name in ["link","directory-link","dangling"]
  $path=$base.."/left/"..$name
  $p.selected_paths=[$path]
  dptest_assert(contains($view.dp_selection_info({info:$dp.dp_idle_info,active:0,panes:[$p]}),"Symbolic link"),"single link kind: "..$name)
  $p.selected_paths=[$path,$base.."/left/normal.TXT"]
  dptest_assert($view.dp_selection_info({info:$dp.dp_idle_info,active:0,panes:[$p]})=="2 selected — 1 B (known sizes)","link bytes excluded from known total: "..$name)
end
push($checks,"selection-links-and-hidden-names")
print(json_encode({ok:true,groups:$checks,root:$base}))
remove_dir($base)
