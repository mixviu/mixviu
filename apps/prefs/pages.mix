$n=require("navigation.mix")
fn stored($s,$key)
  if contains(keys($s.queue_changes ?? {}),$key) and $s.queue_changes[$key]!=nil then return $s.queue_changes[$key] end
  if contains(keys($s.inflight_changes ?? {}),$key) and $s.inflight_changes[$key]!=nil then return $s.inflight_changes[$key] end
  if contains(keys($s.values),$key) and $s.values[$key]!=nil then return $s.values[$key] end
  $found=filter($s.catalog,fn($k)=$k.path==$key)
  return if len($found)==1 then $found[0].default else nil end
end
fn store_blocked($s)
  if $s.uncertain then return "authority_unreachable" end
  if $s.role=="mirror" and $s.stale then return "stale" end
  if $s.revision==nil or not contains(["authority","mirror"],$s.role) then return "unread" end
  return nil
end
fn store_view($s)
  return {role:$s.role,stale:$s.stale,unreachable:$s.uncertain,blocked:store_blocked($s),described:len($s.catalog)>0,revision:$s.revision,writing:$s.busy and ($s.pending ?? {}).op=="write",waiting:[],error:if starts_with($s.status,"Settings failed:") then $s.status else nil end}
end
fn row_blocked($s,$p,$r)
  if $p.backend!=nil then return $n.text_for($p.backend) end
  if $r.backend!=nil then return $r.backend end
  if $p.id=="appearance" then
    if contains(["mode","auto"],$r.id) and stored($s,"appearance.source")!=nil then return $n.text_for("row-appearance-mode-pinned") end
    if $r.id=="auto" and stored($s,"state.appearance.daylight")==nil then return $n.text_for("row-appearance-auto-no-daylight") end
  end
  $blocked=store_blocked($s)
  if $blocked!=nil and ($r.key!=nil or $r.control.control=="reset") then return $n.text_for("store-"..if $blocked=="authority_unreachable" then "unreachable" else $blocked end) end
  return nil
end
fn row_view($s,$p,$r)
  return {id:$r.id,title:$r.title,control:$r.control,key:$r.key,value:if $r.key!=nil then stored($s,$r.key) else nil end,shown:$n.shown($s,$p,$r),blocked:row_blocked($s,$p,$r)}
end
fn sections_view($s,$p,$sections)
  $out=[]
  for $sec in $sections
    push($out,{id:$sec.id,title:$sec.title,shown:true,rows:map($sec.rows,fn($r)=row_view($s,$p,$r)),items:if $sec.source==nil then nil else {source:$sec.source,items:[]} end})
  end
  return $out
end
fn page_view($s,$name)
  $p=$n.page($name ?? $s.nav.page)
  return {page:$p.id,title:$p.title,parent:$p.parent,kind:$p.kind,backend:if $p.backend!=nil then $n.text_for($p.backend) else nil end,children:map(filter($n.pages,fn($x)=$x.parent==$p.id),fn($x)=$x.id),sections:sections_view($s,$p,$p.sections),drawers:map($p.drawers,fn($d)={id:$d.id,sections:sections_view($s,$p,$d.sections)}),open:$s.nav.page==$p.id,drawer:$s.nav.drawer,store:store_view($s)}
end
fn pages_view($s)
  return {pages:map($n.pages,fn($p)={id:$p.id,title:$p.title,parent:$p.parent,icon:$p.icon,kind:$p.kind,backend:$p.backend}),open:$s.nav.page}
end
fn open_page($s,$name,$row)
  $p=$n.page($name);$found=[]
  if $row!=nil then
    for $sec in $n.row_sections($p) $found=concat($found,filter($sec.rows,fn($r)=$r.id==$row)) end
    if len($found)!=1 then raise("ARGUMENT",$p.id..": no row "..to_string($row)) end
  end
  if $s.ui.dialog!=nil or $s.quitting then raise("BUSY",$n.text_for("command-disabled")) end
  $custom={term:"apps_term",email:"apps_email",ced:"apps_ced",software:"software"}
  if contains(keys($custom),$p.id) then $s=$n.set_section($s,{name:$custom[$p.id]}) end
  $s.nav.page=$p.id;$s.nav.drawer=nil;$s.nav.focus=nil
  if $row!=nil then
    for $d in $p.drawers
      if any($d.sections,fn($sec)=any($sec.rows,fn($r)=$r.id==$row)) then $s.nav.drawer=$d.id end
    end
    if $n.shown($s,$p,$found[0]) then $s.nav.focus=[$p.id,$row] end
  end
  $s.nav.query="";$s.nav.searching=false;$s.nav.sidebar=false
  return $s
end
fn row_for($p,$id)
  for $sec in $n.row_sections($p)
    for $r in $sec.rows if $r.id==$id then return $r end end
  end
  raise("ARGUMENT","Unknown page row")
end
fn control_for($s,$key)
  for $p in $n.pages
    for $sec in $n.row_sections($p)
      for $r in $sec.rows
        if $r.key==$key then
          $why=row_blocked($s,$p,$r)
          if $why!=nil then raise("FAILED",$why) end
          return {page:$p,row:$r}
        end
      end
    end
  end
  raise("FAILED","No control in Preferences for "..to_string($key))
end
fn browser_row($s,$p,$r)
  $v=row_view($s,$p,$r);$c=$r.control;$kind=$c.control
  $v.description=$n.translated("row-"..$p.id.."-"..$r.id.."-desc")
  $v.kind="info";$v.choices=nil
  if contains(["toggle","flag","auto_mode","hint_accent"],$kind) then
    $v.kind="toggle"
    if $kind=="flag" then $v.value=deep_eq($v.value,$c.on)
    elif $kind=="auto_mode" then $v.value=$v.value=="auto"
    elif $kind=="hint_accent" then $v.value=$v.value=="accent" end
  elif $kind=="mode" then
    $v.kind="previews";$v.choices=[{value:"dark",label:"Dark",colour:"#262626"},{value:"light",label:"Light",colour:"#dddddd"}]
  elif $kind=="choice" then
    $v.kind="choice";$v.choices=map(filter($c.options,fn($o)=$o.listed),fn($o)={value:$o.value,label:$n.text_for($o.label),description:if $o.description!=nil then $n.text_for($o.description) else nil end})
  elif $kind=="scheme" then
    $v.kind="choice";$v.choices=map(["mixos","ocean","crimson","stone","forest","sunset","mono","pro","studio","classic","breeze","adwaita"],fn($x)={value:$x,label:upper(substr($x,0,1))..substr($x,1)})
  elif $kind=="accent" then
    $v.kind="swatches";$v.choices=map(["auto","#a4c2e9","#e8a4ff","#ff9db8","#ff9f9f","#ffa600","#fae65b","#93d19f","#cbbdb6"],fn($x)={value:$x,label:$x,colour:if $x=="auto" then "#63cddd" else $x end})
  elif contains(["colour","pick","text"],$kind) then $v.kind="text";$v.value=$v.value ?? ""
  elif contains(["slider","spin"],$kind) then $v.kind="number";$v.min=$c.min;$v.max=$c.max;$v.step=$c.step
  elif contains(["drawer","link","page"],$kind) then $v.kind="link"
  elif $kind=="reset" then $v.kind="button" end
  return $v
end
fn browser_sections($s,$p,$sections)
  return map($sections,fn($sec)={id:$sec.id,title:$sec.title,shown:true,rows:map($sec.rows,fn($r)=browser_row($s,$p,$r))})
end
fn browser($s)
  $p=$n.page($s.nav.page);$root=$p
  while $root.parent!=nil $root=$n.page($root.parent) end
  $drawer=nil
  if $s.nav.drawer!=nil then
    $ds=filter($p.drawers,fn($d)=$d.id==$s.nav.drawer)
    if len($ds)==1 then $drawer={title:$n.text_for("drawer-"..$p.id.."-"..$ds[0].id),sections:browser_sections($s,$p,$ds[0].sections)} end
  end
  $notice=if $p.kind=="pending" then $n.text_for("page-pending") elif $p.backend!=nil then $n.text_for($p.backend) else "" end
  $visual={}
  for $key in keys($s.values) if starts_with($key,"appearance.") or starts_with($key,"window.") then $visual[$key]=$s.values[$key] end end
  return {title:$p.title,page:$p.id,root:$root.id,parent:$p.parent,parent_title:if $p.parent!=nil then $n.page($p.parent).title else "" end,query:$s.nav.query,search_hint:$n.text_for("search-hint"),searching:$s.nav.searching,search_focus:$s.ui.search_focus,sidebar_open:$s.nav.sidebar,results_title:$n.text_for("search-results"),hits:$n.search_view($s,$s.nav.query).hits,pages:map($n.pages,fn($p)={id:$p.id,title:$p.title,parent:$p.parent,icon:$p.icon}),sections:browser_sections($s,$p,$p.sections),children:map(filter($n.pages,fn($x)=$x.parent==$p.id),fn($x)={id:$x.id,title:$x.title,icon:$x.icon,description:$n.translated("page-"..$x.id.."-desc")}),drawer:$drawer,notice:$notice,settings:$visual}
end
