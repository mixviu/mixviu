on job.run
  try
    $comp=$event.args.comp
    send $comp "comp.window.wait" body={match:{app_id:"dev.mixos.prefs"},until:"mapped",timeout_ms:10000} timeout=12
    if $rc!=0 then raise("SHOW",to_string($result)) end
    send $comp "comp.windows.list" body={} timeout=5
    if $rc!=0 then raise("SHOW",to_string($result)) end
    $window=filter($reply.windows,fn($w)=$w.app_id=="dev.mixos.prefs" and $w.pid==pid())[0]
    if $window==nil then raise("SHOW","window not known to compd") end
    $target={id:$window.id,generation:$window.generation}
    send $comp "comp.window.restore" body=$target timeout=5
    if $rc!=0 or $reply.minimized!=false then raise("SHOW",to_string($result)) end
    $target.raise=true
    send $comp "comp.window.focus" body=$target timeout=5
    if $rc!=0 or $reply.focused!=true then raise("SHOW",to_string($result)) end
    reply(0,json_encode({shown:true,target:$reply}))
  catch $message reply(10,json_encode({error_code:"SHOW",message:$message})) end
end
