-- version: 0.1.0
$c=require("core.mix")
$s=$c.initial("example")
$s.catalog=[{path:"appearance.mode",kind:"enum",variants:["light","dark"],class:"stored",default:"dark"},{path:"accessibility.text_scale",kind:"number",min:0.5,max:3,class:"stored",default:1},{path:"email.accounts",kind:"list",class:"stored",default:[]}]
$s.role="authority";$s.stale=false;$s.incarnation="inc";$s.revision="9007199254740993"
-- settings.get's values view includes defaults and nulls. Those are readback
-- data, while admission checks the proposed values, as gold's Store does.
$s.values={"appearance.mode":"dark","appearance.font_family":nil,"terminal.padding":8,"accessibility.text_scale":1}
$r=$c.admitted($s,"appearance.mode","light")
if $r.expected_revision!=$s.revision or $r.changes["appearance.mode"]!="light" then raise("FENCE","Revision must remain exact decimal text") end
for $v in ["bogus",true,1]
  $refused=false
  try $c.admitted($s,"appearance.mode",$v) catch $message $refused=true end
  if not $refused then raise("ENUM","Invalid enum accepted") end
end
for $pair in [["accessibility.text_scale",4],["email.accounts",[]],["missing",true]]
  $refused=false
  try $c.admitted($s,$pair[0],$pair[1]) catch $message $refused=true end
  if not $refused then raise("TYPE","Invalid value/owner accepted") end
end
$s.stale=true;$refused=false
try $c.admitted($s,"appearance.mode","light") catch $message $refused=true end
if not $refused then raise("STALE","Mirror must inhibit writes") end
print("prefs: exact revision fence, type/range/owner and stale refusals pass")

$s.stale=false
for $key in ["shell.panels.top.enabled","shell.panels.top.edge"]
  $value=if ends_with($key,"enabled") then true else "bottom" end
  $r=$c.admitted($s,$key,$value)
  if $r.scene.args.name!="panel" then raise("PANEL","Scene alias did not use common admission") end
  for $flag in ["busy","uncertain","stale"]
    $blocked=$s;$blocked[$flag]=true;$refused=false
    try $c.admitted($blocked,$key,$value) catch $message $refused=true end
    if not $refused then raise("PANEL","Scene edit bypassed "..$flag) end
  end
  for $field in ["revision","incarnation"]
    $blocked=$s;$blocked[$field]=nil;$refused=false
    try $c.admitted($blocked,$key,$value) catch $message $refused=true end
    if not $refused then raise("PANEL","Scene edit bypassed unread "..$field) end
  end
  $blocked=$s;$blocked.role="unknown";$refused=false
  try $c.admitted($blocked,$key,$value) catch $message $refused=true end
  if not $refused then raise("PANEL","Scene edit bypassed role") end
  $blocked=$s;$blocked.catalog=concat($s.catalog,[{path:$key,kind:"bool",class:"state"}]);$refused=false
  try $c.admitted($blocked,$key,$value) catch $message $refused=true end
  if not $refused then raise("PANEL","Scene edit bypassed read-only catalogue class") end
end
for $pair in [["shell.panels.top.enabled","yes"],["shell.panels.top.edge","middle"]]
  $refused=false
  try $c.admitted($s,$pair[0],$pair[1]) catch $message $refused=true end
  if not $refused then raise("PANEL","Scene edit bypassed type/enum admission") end
end
print("prefs panel: shared state/class/type admission passes")

$model=$c.framed($c.initial("example"))
if $model.values["gold-title"]!="Preferences" or $model.browser.kind!="settings-browser" then raise("FRAME","Prefs must publish the shared frame and page browser") end
