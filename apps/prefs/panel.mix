-- The scene loader owns the live bar, including while its behaviour is off.
$n=require("navigation.mix")
$EDGES=["top","bottom","left","right"]
fn supports($key)
  return contains(["shell.panels.top.enabled","shell.panels.top.edge"],$key)
end
fn definition($key)
  return if $key=="shell.panels.top.enabled" then {path:$key,kind:"bool",class:"applied",default:true,owner:"scenes"}
    else {path:$key,kind:"enum",variants:$EDGES,class:"applied",default:"bottom",owner:"scenes"} end
end
fn from_inventory($inventory)
  for $row in $inventory.scenes ?? []
    if $row.name=="panel" then return {enabled:$row.enabled,edge:$row.edge ?? "bottom",position_supported:$row.position_supported ?? true} end
  end
  return nil
end
fn refresh($s)
  send "scenes" "scenes.list" body={} timeout=5
  return refreshed($s,$rc,$reply)
end
fn refreshed($s,$code,$body)
  -- A transport failure is not evidence that a confirmed scene disappeared.
  if $code==0 then
    if type($body)!="map" or type($body.scenes)!="list" then
      $s.panel_error=$n.text_for("panel-inventory-invalid")
      return $s
    end
    $s.panel=from_inventory($body);$s.panel_error=nil
  end
  return $s
end
fn hint($s)
  -- Fixed trailing deadline: a burst schedules one read, without starvation.
  if ($s.panel_refresh_at ?? nil)==nil then $s.panel_refresh_at=monotonic()+0.15 end
  return $s
end
fn due($s)
  return ($s.panel_refresh_at ?? nil)!=nil and monotonic()>=$s.panel_refresh_at
end
fn request($key,$value)
  if not supports($key) then raise("ARGUMENT",$n.text_for("panel-setting-invalid")) end
  if $key=="shell.panels.top.enabled" then
    if $value==nil then $value=true end
    if type($value)!="bool" then raise("ARGUMENT",$n.text_for("panel-enabled-invalid")) end
    $command=if $value then "scenes.enable" else "scenes.disable" end
    return {command:$command,args:{name:"panel"}}
  else
    if $value==nil then $value="bottom" end
    if not contains($EDGES,$value) then raise("ARGUMENT",$n.text_for("panel-edge-invalid")) end
    return {command:"scenes.move",args:{name:"panel",edge:$value}}
  end
end
fn apply_request($s,$req)
  send "scenes" $req.command body=$req.args timeout=5
  if $rc!=0 then raise("FAILED",$n.text_for("panel-change-refused").." "..to_string($result)) end
  $s=confirmed($s,$req)
  return refresh($s)
end
fn confirmed($s,$req)
  -- The successful command confirms these fields even if readback times out.
  $s.panel=$s.panel ?? {}
  if $req.command=="scenes.move" then $s.panel.edge=$req.args.edge
  else $s.panel.enabled=$req.command=="scenes.enable" end
  return $s
end
