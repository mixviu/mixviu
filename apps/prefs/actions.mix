$n=require("navigation.mix")
$email=require("email.mix")
$registry=json_parse(read_file(path_join(dirname(script_path()),"actions.json")))
fn theme_choice($s)
  return {scheme:$s.ui.theme_scheme,mode:$s.ui.theme_mode,style:$s.ui.theme_style,decorations:$s.ui.theme_decorations,caption_side:$s.ui.theme_captions}
end
fn choose_theme($s,$args)
  $allowed={scheme:["mixos","ocean","crimson","stone","forest","sunset","mono","pro","studio","classic","breeze","adwaita"],mode:["light","dark"],style:["own","plain","pro","studio","classic","breeze","adwaita"],decorations:["auto","csd","ssd"],caption_side:["auto","left","center","right"]}
  for $axis in keys($allowed)
    if contains(keys($args),$axis) and $args[$axis]!=nil and not contains($allowed[$axis],$args[$axis]) then raise("ARGUMENT","unknown "..$axis.." "..json_encode($args[$axis])) end
  end
  for $axis in keys($allowed)
    if contains(keys($args),$axis) then $s.ui[if $axis=="caption_side" then "theme_captions" else "theme_"..$axis end]=$args[$axis] end
  end
  return $s
end
fn theme_view($s)
  $choice=theme_choice($s)
  $decorations=$choice.decorations ?? $s.values["window.decorations"] ?? "auto"
  return merge($choice,{effective:{scheme:$choice.scheme ?? $s.values["appearance.scheme"] ?? "mixos",mode:$choice.mode ?? $s.values["appearance.mode"] ?? "dark",decorations:if $decorations=="auto" then "csd" else $decorations end,decorations_reason:if $decorations=="auto" then "no_server_protocol" else "choice" end}})
end
fn selected($s)
  return filter($n.apps_view($s).visible,fn($r)=$r.app==$s.ui.selected)[0]
end
fn enabled($s,$id)
  $free=$s.ui.dialog==nil and not $s.quitting
  $look=$s.look ?? {}
  if $id=="help.macros" then return $s.ui.macros_open or $free end
  if starts_with($id,"apps.") then
    $ready=$s.ui.section=="software" and $free and not $s.release_busy and $s.connected and $s.releases!="missing" and len($s.apps)>0 and ($s.release_uncertain ?? nil)==nil
    if not $ready then return false end
    $r=selected($s)
    if $id=="apps.check" then return true end
    if $id=="apps.update_all" then return any($n.apps_view($s).visible,fn($r)=$r.status=="update") end
    if $r==nil then return false end
    if $id=="apps.install" then return contains(["update","not installed"],$r.status) or ($r.installed==nil and $r.status=="unchecked") end
    return $r.installed!=nil
  end
  if $id=="page.back" then return $free and $n.page($s.nav.page).parent!=nil end
  if starts_with($id,"appearance.") then
    if not $free then return false end
    if $id=="appearance.revert" then return len(keys($look.edited ?? {}))>0 or ($look.hold ?? false) end
    if $id=="appearance.keep" then return len($look.conflicts ?? [])>0 end
    if $id=="appearance.recheck" then return ($look.uncertain ?? nil)!=nil end
    return len(keys($look.edited ?? {}))>0 and $look.job==nil and not $look.syncing and len($look.conflicts ?? [])==0
  end
  if starts_with($id,"email.") then
    $e=$s.email ?? {}
    if not $free then return false end
    if $id=="email.account.add" then return $s.revision!=nil end
    if $id=="email.account.revert" then return $e.form!=nil and ($e.dirty ?? false) end
    if contains(["email.password.set","email.password.forget","email.account.connect"],$id) then return $s.ui.email_account!=nil and $s.connected and $e.task==nil and ($id!="email.password.set" or ($e.password ?? "")!="") end
    if not $email.view($s).can_edit then return false end
    if $id=="email.reset" then return true end
    if $id=="email.account.save" then return $e.form!=nil and (($e.dirty ?? false) or $e.form.id==nil) end
    if $s.ui.email_account==nil then return false end
    $list=$email.accounts($s);$at=index_of(map($list,fn($a)=$a.id),$s.ui.email_account)
    if $id=="email.account.up" then return $at>0 end
    if $id=="email.account.down" then return $at>=0 and $at+1<len($list) end
    if $id=="email.account.default" then return $s.values["email.default_account"]!=$s.ui.email_account end
    return $id!="email.account.remove" or $e.task==nil
  end
  if $id=="view.refresh" or $id=="terminal.reset" then return $free and $s.connected and not $s.busy end
  return $free
end
fn action_list($s)
  $out=[]
  for $a in $registry
    $a.enabled=enabled($s,$a.id);$a.reason=if $a.enabled then nil else "disabled" end;$a.checked=nil
    $parts=split($a.id,".")
    if len($parts)==3 and $parts[0]=="view" then
      $field={theme:"theme_scheme",style:"theme_style",mode:"theme_mode",decorations:"theme_decorations",captions:"theme_captions"}[$parts[1]]
      if $field!=nil then
        $value=$s.ui[$field]
        if $value==nil and contains(["decorations","captions"],$parts[1]) then $value="auto" end
        $a.checked=if $parts[2]=="session" then $value==nil else $value==$parts[2] end
      end
    elif $a.id=="view.mode" then $a.checked=($s.ui.theme_mode ?? $s.values["appearance.mode"] ?? "dark")=="light" end
    push($out,$a)
  end
  return {actions:$out}
end
fn menus($s)
  $all=action_list($s).actions;$out=[]
  for $name in ["File","View","Help"]
    $children=[];$themes=[]
    for $a in filter($all,fn($a)=$a.menu==$name)
      $item={id:$a.id,label:$a.label,enabled:$a.enabled}
      if $a.checked!=nil then $item.checked=$a.checked end
      if starts_with($a.id,"view.theme.") or starts_with($a.id,"view.style.") or starts_with($a.id,"view.mode.") or starts_with($a.id,"view.decorations.") or starts_with($a.id,"view.captions.") then push($themes,$item)
      else push($children,$item) end
    end
    if len($themes)>0 then push($children,{id:"theme",label:"Theme",enabled:true,children:$themes}) end
    push($out,{id:lower($name),label:$name,enabled:true,children:$children})
  end
  return $out
end
fn dialog_form($s)
  $d=$s.ui.dialog
  if $d==nil then return {open:false,title:"",body:"",choices:[]} end
  $choices=[{id:"cancel",label:"Close",enabled:true,cancel:true,default:true}]
  if $d=="about" then return {open:true,title:"About Preferences",body:"Preferences\nMixOS Preferences 0.1.2\nMIT OR Apache-2.0",choices:$choices} end
  if $d=="shortcuts" then
    $lines=[]
    for $a in $registry if $a.shortcut!=nil then push($lines,$a.shortcut.."    "..$a.label) end end
    return {open:true,title:"Keyboard shortcuts",body:join($lines,"\n"),choices:$choices}
  end
  $verb=if type($d)=="map" and contains(keys($d),"remove") then "Remove" elif $d=="reset_email" then "Reset email settings" else "Confirm" end
  return {open:true,title:$verb.."?",body:if type($d)=="map" then json_encode($d) else $verb end,choices:[{id:"cancel",label:"Cancel",enabled:true,cancel:true,default:true},{id:"confirm",label:$verb,enabled:true}]}
end
