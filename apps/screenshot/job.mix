-- version: 0.1.0
on job.run
  $a=$event.args
  if $a.op=="copy" then
    $owner="screenshot-copy-"..to_string(pid()).."-"..date_format(time(),"%Y%m%d%H%M%S")
    send "blobd" "blob.put" body={path:$a.source,mime:"image/png",owner:$owner} timeout=8
    if $rc!=0 then raise("BLOB","Native image ingestion refused") end
    $blob=$reply
    try
      send "clipd" "clipboard.set" body={mime:"image/png",blob:$blob} timeout=8
      if $rc!=0 then raise("CLIPBOARD","Native clipboard refused image reference") end
      $copy=$reply
      reply(0,json_encode({op:"copy",clipboard:$copy,blob:$blob}))
    finally
      send "blobd" "blob.unpin" body={blob:$blob.blob,owner:$owner} timeout=5
    end
  elif $a.op=="export" then
    $info=viu_image("export",$a.source,$a.path)
    reply(0,json_encode({path:$a.path,image:$info,op:"export"}))
  else
    $r=$a.request
    if $r.delay>0 then sleep($r.delay) end
    send $a.comp "comp.window.minimize" body=$a.own timeout=5
    if $rc!=0 or $reply.minimized!=true then raise("HIDE","Compositor did not confirm minimisation") end
    $frame={path:$a.path,cursor:$r.cursor}
    if $r.output!=nil then $frame.output=$r.output end
    if $r.window!=nil then $frame.window=$r.window end
    if $r.region!=nil then $frame.region=$r.region
    elif $r.mode=="region" then
      $select={timeout_ms:55000}
      if $r.output!=nil then $select.output=$r.output end
      send $a.comp "comp.region.select" body=$select timeout=60
      if $rc!=0 or $reply.status!="selected" then raise("SELECTION",json_encode($reply)) end
      $frame.output=$reply.output;$frame.region=$reply.region;$frame.output_generation=$reply.output_generation
    end
    send $a.comp "comp.capture.frame" body=$frame timeout=8
    if $rc!=0 then raise("CAPTURE",to_string($result)) end
    $metadata=$reply
    chmod($a.path,0o600)
    $info=viu_image("info",$a.path)
    reply(0,json_encode({op:"capture",path:$a.path,image:$info,metadata:$metadata}))
  end
end
