-- SPDX-License-Identifier: MIT OR Apache-2.0
-- version: 0.2.0
-- lint: globals app_args
$states=require("state.mix");$op=require("operations.mix");$events=require("events.mix");$model=require("model.mix")
$ctx=viu_context()
$state=$states.initial($app_args[0] ?? env("MIXOS_COMP_SERVICE","comp"),$app_args[1],$app_args[2])
$options=$ctx.options ?? {}
$state.headless=$options.headless ?? false
$state=$op.refresh($state)
fn publish_model($s)
  send "viu-local" "scenes.model" body={generation:$ctx.generation,value:$model.render($s)}
end
fn command($s,$name,$args)
  $result=$op.dispatch($s,$name,$args)
  publish_model($result.state)
  if not $result.deferred then reply($result.rc,json_encode($result.body)) end
  return $result.state
end
publish_model($state)
on viu.job.completed
  $state=$events.completed($state,$event.args,$ctx.citizen);publish_model($state)
end
on screenshot.intent
  $state=$events.intent($state,$event.args);publish_model($state)
end
on viu.frame.intent
  $state=$events.intent($state,$event.args);publish_model($state)
end
on viu.frame.close
  $state=$op.request($state,{op:"quit"});publish_model($state)
end
on viu.key
  $state=$events.key($state,$event.args);publish_model($state)
end
on viu.session.changed
  $state.effective=$event.args.appearance;$state.keymap=$event.args.keymap;publish_model($state)
end
on bus.connected
  $state.connected=true;$state=$op.refresh($state);publish_model($state)
end
on bus.disconnected
  $state.connected=false;$state.status="The Bus is disconnected";publish_model($state)
end

on HELP
  $state=command($state,"HELP",$event.args)
end

on app.describe
  $state=command($state,"app.describe",$event.args)
end

on screenshot.ping
  $state=command($state,"screenshot.ping",$event.args)
end

on screenshot.info
  $state=command($state,"screenshot.info",$event.args)
end

on screenshot.capture
  $state=command($state,"screenshot.capture",$event.args)
end

on screenshot.take
  $state=command($state,"screenshot.take",$event.args)
end

on screenshot.cancel
  $state=command($state,"screenshot.cancel",$event.args)
end

on screenshot.open
  $state=command($state,"screenshot.open",$event.args)
end

on screenshot.annotate
  $state=command($state,"screenshot.annotate",$event.args)
end

on screenshot.move
  $state=command($state,"screenshot.move",$event.args)
end

on screenshot.delete
  $state=command($state,"screenshot.delete",$event.args)
end

on screenshot.crop
  $state=command($state,"screenshot.crop",$event.args)
end

on screenshot.undo
  $state=command($state,"screenshot.undo",$event.args)
end

on screenshot.redo
  $state=command($state,"screenshot.redo",$event.args)
end

on screenshot.export
  $state=command($state,"screenshot.export",$event.args)
end

on screenshot.save
  $state=command($state,"screenshot.save",$event.args)
end

on screenshot.recent
  $state=command($state,"screenshot.recent",$event.args)
end

on screenshot.select
  $state=command($state,"screenshot.select",$event.args)
end

on screenshot.actions
  $state=command($state,"screenshot.actions",$event.args)
end

on screenshot.execute
  $state=command($state,"screenshot.execute",$event.args)
end

on screenshot.show
  $state=command($state,"screenshot.show",$event.args)
end

on screenshot.quit
  $state=command($state,"screenshot.quit",$event.args)
end

on screenshot.theme
  $state=command($state,"screenshot.theme",$event.args)
end

on screenshot.dialog
  $state=command($state,"screenshot.dialog",$event.args)
end
