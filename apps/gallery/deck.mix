-- Deck composition constructors. Nested maps are flattened to ordinary scene
-- nodes by scene(); no native compound widget or application policy is hidden.
$tokens = require("../../libraries/design/deck.tokens.mix")

fn deck_text($text, $style, $role)
  $mono=contains(["date","chip","pr","topic_no","rail","rail_compact","series_footer","code","terminal","tree"],$style)
  $weight=if contains(["headline","topic_title","wordmark","stat","panel_title"],$style) then 700 else 400 end
  $node={widget:"text", text:$text, size:$tokens.type[$style], color:$tokens.colour[$role],font:if $mono then "Noto Sans Mono" else "Liberation Sans" end,mono_font:"Noto Sans Mono",mono:$mono,weight:if $style=="panel_title" then 500 else $weight end}
  if $style=="panel_title" then $node.letter_spacing=$node.size*0.08 end
  if $style=="headline" then $node.letter_spacing=$node.size*(-0.01) end
  if $style=="stat" or $style=="topic_title" then $node.letter_spacing=$node.size*(-0.02) end
  return $node
end
fn inline($runs, $style, $mono)
  $styled = []
  $plain = ""
  for $run in $runs
    $plain = $plain .. $run.text
    $role = $run.role ?? "text"
    $semantic = if contains(["text","keyword","function","string","comment","value","ok","bad","warn","acc","mut"],$role) then $role else "text" end
    push($styled, merge($run, {role:$semantic,color:$run.color ?? $tokens.colour[$role] ?? $tokens.colour.text}))
  end
  return {widget:"text", text:$plain, spans:$styled, size:$tokens.type[$style], mono:$mono,mono_font:"Noto Sans Mono",font:if $mono then "Noto Sans Mono" else "Liberation Sans" end}
end
fn column($items, $gap)
  return {widget:"column", children:$items, gap:$gap}
end
fn row($items, $gap)
  return {widget:"row", children:$items, gap:$gap, align:"center"}
end
fn weighted_row($items,$weights,$width,$gap,$insets=[])
  $children=[]
  for $i=0 to len($items)-1
    $child={}
    for $key in keys($items[$i]) if $key!="fill" then $child[$key]=$items[$i][$key] end end
    push($children,merge($child,{grow:$weights[$i],basis:$insets[$i] ?? 0}))
  end
  return merge(row($children,$gap),{align:"start",min_width:$width,fill:true})
end
fn card($title, $items, $tone,$mono_title=false)
  $heading=deck_text($title, "panel_title", $tone)
  if $mono_title then $heading.mono=true;$heading.font="Noto Sans Mono" end
  $content = [$heading]
  for $item in $items
    push($content, $item)
  end
  return merge(column($content,16),{padding_left:$tokens.space.card_x,padding_right:$tokens.space.card_x,padding_top:$tokens.space.card_y,padding_bottom:$tokens.space.card_y,background:$tokens.colour.panel,radius:$tokens.space.card_radius,outline:$tokens.colour[if $tone=="bad" then "before" elif $tone=="ok" then "after" else "line" end],outline_width:1})
end
fn chip($text, $caption, $role)
  return merge(row([deck_text($text,"chip",$role),deck_text($caption,"chip_caption","mut")],8), {padding_left:14,padding_right:14,padding_top:8,padding_bottom:8,background:$tokens.colour.background2,radius:10,outline:$tokens.colour.line,outline_width:1})
end
fn kicker($text, $prs)
  $items = [deck_text($text,"kicker","mut")]
  for $pr in $prs
    $pill=pr_pill($pr.text,$pr.role ?? "acc")
    push($items,$pill)
  end
  return row($items,16)
end
fn pr_pill($text,$role="acc")
  return merge(column([merge(deck_text($text,"pr","background"),{weight:600})],0),{padding_left:14,padding_right:14,padding_top:4,padding_bottom:4,background:$tokens.colour[$role],radius:8})
end
fn header($text,$prs=[],$mark=false)
  $node=kicker(upper($text),$prs)
  $node.children[0].letter_spacing=$tokens.type.kicker*0.04
  if $mark then
    $node.children=concat([{widget:"image",src:"brand:cyclops",w:34,h:34}],$node.children)
  end
  return $node
end
fn compact_rail($chapters,$active,$date)
  $node=chapter_rail($chapters,$active,$date)
  $node.children[0].gap=$tokens.space.compact_rail_gap
  for $i=0 to len($node.children[0].children)-1
    $node.children[0].children[$i].padding_left=9
    $node.children[0].children[$i].padding_right=9
    $node.children[0].children[$i].padding_top=3
    $node.children[0].children[$i].padding_bottom=3
    $node.children[0].children[$i].radius=5
    $node.children[0].children[$i].children[0].size=16
  end
  $node.children[1].font="Liberation Sans"
  $node.children[1].mono=false
  $node.children[1].letter_spacing=0.96
  $node.children[1]=merge(column([$node.children[1]],0),{padding_right:9})
  return $node
end
fn compact_card($title,$items,$tone="mut")
  $node=card($title,$items,$tone)
  $node.fill=true
  $node.padding_left=$tokens.space.compact_card_x
  $node.padding_right=$tokens.space.compact_card_x
  $node.padding_top=$tokens.space.compact_card_y
  $node.padding_bottom=$tokens.space.compact_card_y
  $node.gap=$tokens.space.compact_heading_gap
  $node.children[0]=merge($node.children[0],{size:21,weight:500,letter_spacing:1.68})
  $node.children=[$node.children[0],column($items,7)]
  return $node
end
fn compact_chip($text,$caption,$role="text",$found=false)
  $node=chip($text,$caption,$role)
  $node.padding_left=$tokens.space.compact_chip_x;$node.padding_right=$tokens.space.compact_chip_x
  $node.padding_top=$tokens.space.compact_chip_y;$node.padding_bottom=$tokens.space.compact_chip_y
  $node.background=$tokens.colour.chip_background
  $node.outline=if $found then $tokens.colour.warn else $tokens.colour.line end
  $node.gap=6
  $node.children[0].size=20
  $node.children[1].size=17
  return $node
end
fn compact_table($rows)
  $lines=[];$index=0
  for $cells in $rows
    $items=[]
    for $cell in $cells
      $label=merge(deck_text($cell[0],"caption",$cell[1]),{size:if $index==0 then 17 else 20 end,weight:if $index==0 then 500 else 400 end,wrap:true})
      push($items,merge(column([$label],0),{grow:1,padding_left:10,padding_right:10,padding_top:5,padding_bottom:6}))
    end
    push($lines,merge(row($items,0),{align:"start",fill:true}))
    $index=$index+1
  end
  return merge(column($lines,0),{fill:true})
end
fn compact_tags($labels)
  $tags=[]
  for $label in $labels
    push($tags,merge(column([merge(deck_text($label,"chip","text"),{size:19})],0),{padding_left:11,padding_right:11,padding_top:5,padding_bottom:5,background:$tokens.colour.panel,outline:$tokens.colour.line,outline_width:1,radius:8}))
  end
  return merge(row($tags,8),{wrap:true,fill:true})
end
fn headline($text, $small)
  return column([deck_text($text,"headline","text"),deck_text($small,"small","mut")],10)
end
fn bullets($items, $role)
  $lines = []
  for $item in $items
    push($lines,row([deck_text("●","list",$role),deck_text($item,"list","text")],22))
  end
  return column($lines,20)
end
fn flow($nodes)
  $items = []
  for $node in $nodes
    if len($items) > 0 then
      $arrow=[deck_text("→","arrow","mut")]
      if ($node.via ?? "")!="" then push($arrow,deck_text($node.via,"arrow_label","mut")) end
      push($items,column($arrow,0))
    end
    push($items,merge(column([deck_text($node.label ?? "","node_label","mut"),deck_text($node.text,"node",$node.role ?? "text")],6),{padding_left:22,padding_right:22,padding_top:18,padding_bottom:18,background:$tokens.colour.background2,radius:14,outline:$tokens.colour[$node.role ?? "line"],outline_width:2}))
  end
  return row($items,$tokens.space.flow)
end
fn compact_flow($nodes)
  $node=flow($nodes)
  $node.gap=8
  for $i=0 to len($node.children)-1
    $child=$node.children[$i]
    if $i%2==0 then
      $child.padding_left=14;$child.padding_right=14
      $child.padding_top=10;$child.padding_bottom=10
      $child.children[0]=merge($child.children[0],{text:upper($child.children[0].text),size:20,weight:500,letter_spacing:1.6,line_height:25,wrap:true,max_width:$tokens.space.compact_flow_label,align:"center"})
      $child.children[1]=merge($child.children[1],{size:19,line_height:23.75,align:"center"})
    else $child.children[0].size=40 end
    $node.children[$i]=$child
  end
  return $node
end
fn code($lines,$highlighted=[],$size=nil,$leading=nil,$inset=31)
  $items = []
  $index=0
  for $line in $lines
    $label=inline($line,"code",true)
    if $size!=nil then $label.size=$size end
    if $leading!=nil then $label.line_height=$leading end
    if len($highlighted)>0 then
      $label=merge(column([$label],0),{fill:true,padding_left:$inset,padding_right:$inset})
      if contains($highlighted,$index) then $label.background=$tokens.colour.code_highlight end
    end
    push($items,$label)
    $index=$index+1
  end
  return merge(column($items,0),{fill:true,padding_left:if len($highlighted)>0 then 0 else $inset end,padding_right:if len($highlighted)>0 then 0 else $inset end,padding_top:27,padding_bottom:27,background:$tokens.colour.code_background,radius:16,outline:$tokens.colour.line,outline_width:1})
end
fn terminal($title, $lines)
  $items = [deck_text($title,"node_label","mut")]
  for $line in $lines
    push($items,merge(inline($line,"terminal",true),{min_height:$tokens.space.terminal_row,max_height:$tokens.space.terminal_row}))
  end
  return merge(column($items,0),{height:len($lines)*$tokens.space.terminal_row+64,padding_left:22,padding_right:22,padding_top:18,padding_bottom:18,background:$tokens.colour.code_background,radius:14})
end
fn tree($entries)
  $items = []
  for $entry in $entries
    $parts = [merge(deck_text($entry.text,"tree",$entry.role ?? "text"),{mono:true})]
    if $entry.badge != nil then
      push($parts,chip($entry.badge,"",$entry.allow == true ? "ok" : "warn"))
    end
    push($items,merge(row($parts,12),{height:$tokens.space.tree_row}))
  end
  return column($items,0)
end
fn deck_stat($number, $caption, $role, $animate=true)
  $text = deck_text($number,"stat",$role)
  $target = to_number($number)
  if $animate and $target != nil then $text.number = {to:$target,ms:$tokens.motion.count_ms,delay_ms:$tokens.motion.count_delay_ms} end
  return column([$text,merge(deck_text(upper($caption),"stat_label","mut"),{letter_spacing:$tokens.type.stat_label*0.06})],0)
end
fn chapter_rail($chapters,$active,$series)
  $chips=[]
  for $name in $chapters
    $current=$name==$active
    push($chips,merge(column([merge(deck_text($name,"rail",if $current then "background" else "mut" end),{mono:true,mono_font:"Noto Sans Mono",bold:$current,weight:if $current then 700 else 400 end,size:$tokens.type.rail})],0),{padding_left:$tokens.space.rail_x,padding_right:$tokens.space.rail_x,padding_top:$tokens.space.rail_y,padding_bottom:$tokens.space.rail_y,radius:$tokens.space.rail_radius,background:if $current then $tokens.colour.acc else $tokens.colour.rail end,outline:if $current then $tokens.colour.acc else $tokens.colour.line end,outline_width:1}))
  end
  return merge(row([row($chips,$tokens.space.rail_gap),merge(deck_text($series,"rail","mut"),{size:$tokens.type.series_footer})],0),{fill:true,justify:"between"})
end
fn mock($title, $items)
  return merge(column([deck_text($title,"node_label","mut"),bullets($items,"acc")],6),{padding_left:20,padding_right:20,padding_top:14,padding_bottom:14,background:$tokens.colour.panel,radius:12})
end
fn brand($name, $tagline, $date)
  return column([{widget:"image",src:"brand:cyclops",w:200,h:200},deck_text($name,"wordmark","acc"),deck_text($tagline,"tagline","mut"),deck_text($date,"date","text")],28)
end
fn closing($name,$tagline,$address,$height=716)
  $title=merge(deck_text($name,"wordmark","text"),{size:110,line_height:110,letter_spacing:-3.3,align:"center"})
  if $name=="MixViu" then $title.spans=[{text:"Mix",color:$tokens.colour.text},{text:"Viu",color:$tokens.colour.acc}] end
  $subtitle=merge(deck_text($tagline,"tagline","mut"),{size:38,line_height:49.4,max_width:1250,wrap:true,align:"center"})
  $link=merge(deck_text($address,"date","text"),{size:32,align:"center"})
  return merge(column([{widget:"image",src:"brand:cyclops",w:230,h:230},{widget:"spacer",size:30},$title,{widget:"spacer",size:26},$subtitle,{widget:"spacer",size:26},$link],0),{fill:true,align:"center",justify:"center",height:$height-40,padding_bottom:40})
end
-- Opening sting: all geometry and continuous motion remain scene data.
fn sting($title, $subtitle)
  $k=280/512*1.3
  $effects=[{preset:"draw"},{preset:"float"}]
  $shadow={colour:[242,70,70,77],offset:[0,30],blur:70}
  $ring={kind:"arc",centre:[140,140],radius:[142*$k,142*$k],start:63.21,sweep:-306.42,dash_length:770*$k,effects:$effects}
  $eye={kind:"ellipse",centre:[140,140],effects:[{preset:"pop",delay:0.05},{preset:"blink"},{preset:"float"}]}
  $logo={widget:"drawing",w:280,h:280,shadow:$shadow,primitives:[merge($ring,{width:74.15*$k,colour:"#000000"}),merge($ring,{width:68*$k,colour:"#ffffff"}),merge($eye,{radius:[49.08*$k,49.08*$k],colour:"#000000"}),merge($eye,{radius:[46*$k,46*$k],colour:"#ff0000"})]}
  $brandline={widget:"text",text:"MIXVIU",spans:[{text:"MIX",color:$tokens.colour.text,bold:true},{text:"VIU",color:$tokens.colour.acc,bold:false}],size:34,bold:true,letter_spacing:10.88,align:"center"}
  $heading={widget:"text",text:$title,size:104,bold:true,letter_spacing:-2.08,color:$tokens.colour.text,align:"center"}
  $sub={widget:"text",text:$subtitle,size:36,mono:true,letter_spacing:1.44,color:$tokens.colour.acc,align:"center"}
  $bar={widget:"drawing",w:260,h:8,primitives:[{kind:"bar",centre:[130,4],radius:[130,4],colour:$tokens.colour.acc,end_colour:$tokens.colour.blue}]}
  -- Compensate native role line boxes so painted centres match the CSS stack.
  return merge(column([{widget:"spacer",size:10},$logo,{widget:"spacer",size:28},$brandline,{widget:"spacer",size:18.5},$heading,{widget:"spacer",size:14},$sub,{widget:"spacer",size:30},$bar],0),{align:"center",min_width:1600,height:900,padding_top:127,padding_bottom:40,background:$tokens.colour.background})
end
fn topic($number, $title, $subtitle,$height=708)
  return merge(column([deck_text($number,"topic_no","acc"),{widget:"spacer",size:10},deck_text($title,"topic_title","text"),{widget:"spacer",size:22},deck_text($subtitle,"topic_sub","mut")],0),{height:$height-40,padding_bottom:40,justify:"center"})
end
fn flatten($tree, $id)
  $nodes = {}
  $node = $tree
  if $tree.children != nil then
    $node.children = []
    $i = 0
    for $child in $tree.children
      $key = $id .. "." .. to_string($i)
      $node.children = push($node.children,$key)
      $nodes = merge($nodes,flatten($child,$key))
      $i = $i + 1
    end
  end
  $nodes[$id] = $node
  return $nodes
end
fn scene($tree)
  return "---\nscene: 1\nname: deck-gallery\ncitizen: gallery\n---\n```mix\n" .. json_encode(flatten($tree,"root")) .. "\n```\n"
end
