-- SPDX-License-Identifier: MIT OR Apache-2.0
-- version: 0.1.0
-- Mix application composition and behaviour. No Rust gallery controller called.
$widgets = [
 {id:"label",kind:"label",label:"Label",initial:"Shared Viu typography"},
 {id:"button",kind:"button",label:"Button",initial:"Ready"},
 {id:"field",kind:"field",label:"Text field",initial:"Edit this text"},
 {id:"multiline",kind:"multiline",label:"Multiline editor",initial:"A small editable note"},
 {id:"checkbox",kind:"checkbox",label:"Checkbox",initial:true},
 {id:"toggle",kind:"toggle",label:"Toggle",initial:false},
 {id:"radio",kind:"radio",label:"Radio group",initial:"Alpha"},
 {id:"tabs",kind:"tabs",label:"Tabs",initial:"Beta"},
 {id:"slider",kind:"slider",label:"Slider",initial:35},
 {id:"number",kind:"number",label:"Number / spin control",initial:42},
 {id:"progress",kind:"progress",label:"Progress indicator",initial:65},
 {id:"combo",kind:"combo",label:"Combo box",initial:"Alpha"},
 {id:"list",kind:"list",label:"Virtual list · 1,000 items",initial:1},
 {id:"table",kind:"table",label:"Virtual table · 1,000 rows",initial:0},
 {id:"tree",kind:"tree",label:"Tree rows",initial:0},
 {id:"collapse",kind:"collapse",label:"Disclosure",initial:false},
 {id:"menu",kind:"menu",label:"Menu",initial:"Alpha"},
 {id:"dialog",kind:"dialog",label:"Confirmation dialog",initial:false},
 {id:"split",kind:"split",label:"Resizable split",initial:50},
 {id:"colour",kind:"colour",label:"Colour picker",initial:[70,150,210]},
 {id:"canvas",kind:"canvas",label:"Canvas",initial:"Ready"},
 {id:"link",kind:"link",label:"Local link",initial:"Ready"},
 {id:"tooltip",kind:"tooltip",label:"Tooltip",initial:"Hover for help"},
 {id:"separator",kind:"separator",label:"Separator",initial:"Section boundary"},
 {id:"icon",kind:"icon",label:"Vector icon button",initial:{name:"copy",size:24,colour:[80,180,230],enabled:true,selected:false}},
 {id:"toolbar",kind:"toolbar",label:"Icon toolbar",initial:"copy"}
]
for $i=0 to len($widgets)-1
  $kind=$widgets[$i].kind
  $props={}
  if $kind=="button" then $props={text:"Press me",icon:"play"}
  elif $kind=="icon" then $props={text:""}
  elif $kind=="toolbar" then $props={items:[{id:"copy",icon:"copy",text:"Copy",enabled:true},{id:"save",icon:"save",text:"Save",enabled:true},{id:"trash",icon:"trash",text:"Trash",enabled:false}]}
  elif $kind=="checkbox" then $props={text:"Enabled"}
  elif $kind=="toggle" then $props={text:"Power"}
  elif $kind=="radio" or $kind=="combo" then $props={choices:["Alpha","Beta","Gamma"]}
  elif $kind=="tabs" then $props={choices:["Alpha","Beta","Gamma"],pages:{Alpha:"Alpha page content",Beta:"Beta page content",Gamma:"Gamma page content"}}
  elif $kind=="menu" then $props={text:"Actions",choices:["Alpha","Beta","Gamma"],choice_icons:{Alpha:"folder",Beta:"file",Gamma:"star"}}
  elif contains(["list","table","tree"],$kind) then $props={dataset:"examples",row_count:1000,columns:["Name","Size"],parent:"Example folder",context_action:"Choose item",row_icon:"file-text",parent_icon:"folder-open",context_icon:"check"}
  elif $kind=="collapse" then $props={text:"Details",body:"Reusable Viu content"}
  elif $kind=="dialog" then $props={text:"Open confirmation…",title:"Gallery confirmation",body:"The same dialog in Rust and Mix."}
  elif $kind=="link" then $props={text:"Activate a safe local link"}
  elif $kind=="tooltip" then $props={body:"Shared Viu tooltip; identical in both languages."}
  elif $kind=="canvas" then $props={shapes:[{kind:"line",from:[0,1],to:[1,0]},{kind:"circle",at:[0.5,0.5],radius:7}]}
  end
  $widgets[$i].properties=$props
end
$rows=json_parse(read_file(dirname(script_path()).."/rows.json"))
$state = {widgets:$widgets,datasets:{examples:$rows},values:{},expanded:{tree:true},sorted:{table:false},serial:0,activations:0,last_activation:nil,last:"Ready"}
for $widget in $widgets
  $state.values[$widget.id] = $widget.initial
end
fn publish_gallery($ctx, $model)
  send "viu-local" "scenes.model" body={generation:$ctx.generation,value:$model}
  if $rc != 0 then raise("MODEL_PUBLISH",to_string($result)) end
end
$ctx = viu_context()
on gallery.execute
  $a = $event.args
  if $a.action != "reset" then
    $matches=filter($widgets,fn($w)=$w.id==$a.id)
    if len($matches)!=1 then raise("UNKNOWN_WIDGET",to_string($a.id)) end
    viu_widget_admit($matches[0],{values:$state.values},$a.action,$a.value)
    if not contains(["set","submit","expand","sort","accept","cancel","activate"],$a.action) then raise("UNKNOWN_ACTION",to_string($a.action)) end
  end
  if $a.action == "reset" then
    for $widget in $widgets
      $state.values[$widget.id] = $widget.initial
    end
    $state.serial = 0
    $state.activations = 0
    $state.last_activation = nil
    $state.last = "Ready"
    $state.expanded = {tree:true}
    $state.sorted = {table:false}
  else
    if $a.action == "set" or $a.action == "submit" then
      $state.values[$a.id] = $a.value
    elif $a.action == "expand" then
      $state.expanded[$a.id] = $a.value
    elif $a.action == "sort" then
      $state.sorted[$a.id] = $a.value
    elif $a.action == "accept" or $a.action == "cancel" then
      $state.values[$a.id] = false
      $state.activations = $state.activations + 1
    elif $a.action == "activate" then
      $state.activations = $state.activations + 1
      $state.last_activation = {id:$a.id,value:$a.value}
      if $a.id=="toolbar" then $state.values[$a.id]=$a.value end
    else
      raise("UNKNOWN_ACTION",to_string($a.action))
    end
    $state.serial = $state.serial + 1
    $state.last = $a.id .. "." .. $a.action
  end
  publish_gallery($ctx,$state)
  reply(0,"{}")
end
publish_gallery($ctx,$state)

on gallery.state
  reply(0,json_encode($state))
end
on gallery.describe
  reply(0,json_encode({widgets:$widgets,execute:"gallery.execute {id,action,value}",host:"viu.state / viu.ui.* / viu.capture / viu.quit"}))
end
