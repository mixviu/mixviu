-- version: 0.2.0
-- lint: globals app_args
if not deep_eq($app_args,["--probe"]) then viu_exit(2,"--probe runs alone: no wallpaper or service option goes with it");exit(0) end
$ctx=viu_context();$outputs={};$reported={};$clicks=0;$last=nil;$serial=0
fn probe_value($surface)
  return {nodes:[{kind:"panel",children:[{kind:"centered",children:[{kind:"space",fraction:1/3},{kind:"heading",text:"backdrop probe"},{kind:"label",text:to_string($surface.width).." × "..to_string($surface.height).." at scale "..fmt("%.2f",$surface.scale)},{kind:"label",text:if $last==nil then "no clicks yet" else to_string($clicks).." clicks, the last at "..fmt("%.0f",$last.x)..", "..fmt("%.0f",$last.y) end}]}]}]}
end
fn probe_show()
  $root={id:"root",kind:"composition",label:"",initial:{nodes:[]}}
  $model={root:$root,serial:$serial,values:{root:probe_value({width:0,height:0,scale:1})},surfaces:{},layer:{observe_input:true,observe_presentation:true}}
  for $name in keys($outputs) $model.surfaces[$name]={root:$root,serial:$serial,values:{root:probe_value($outputs[$name])}} end
  send "viu-local" "scenes.model" body={generation:$ctx.generation,value:$model}
end
probe_show()
on viu.layer.configure
  $outputs[$event.args.output]=$event.args;$serial=$serial+1;probe_show()
end
on viu.layer.removed
  $outputs=delete($outputs,$event.args.output);$serial=$serial+1;probe_show()
end
on viu.layer.input
  $clicks=$clicks+1;$last={x:$event.args.x,y:$event.args.y};$serial=$serial+1
  print(json_encode({event:"click",output:$event.args.output,x:$last.x,y:$last.y}))
  probe_show()
end
on viu.layer.presented
  $a=$event.args
  if not deep_eq($reported[$a.output],$a) then
    $reported[$a.output]=$a
    print(json_encode({event:"drawn",output:$a.output,width:$a.width,height:$a.height,scale:$a.scale}))
  end
end
