-- version: 0.2.0
$e=require("engine.mix");$s=require("schedule.mix");$p=require("projection.mix")
fn check($condition,$message)
  if not $condition then raise("ENGINE_TEST",$message) end
end
$state=$e.fresh()
$state=$e.stage($state,{schema:1,default:{colour:"#1234ab"}},{op:"set",token:"1"})
check($state.active==0 and $state.pending.revision==1,"staging never changes applied state")
$state=$e.apply($state,0)
check($state.active==1 and $p.model($state,0).values.root.phase=="none","solid commit")
$state=$e.stage($state,{schema:1,default:{image:"/w/a.png"}},{op:"set",token:"2"})
check($state.active==1 and len($state.pending.jobs)==1,"image waits for decode")
$state=$e.refuse($state,"corrupt","/w/a.png",1)
check($state.active==1 and $state.error=="corrupt" and $state.config.default.colour=="#1234ab","failed image keeps applied config")
$state=$e.stage($state,{schema:1,default:{image:"/w/a.png"}},{op:"set",token:"3"})
$state=$e.stage($state,{schema:1,default:{colour:"#ffffff"}},{op:"set",token:"4"})
$state=$e.received($state,3,{kind:"load",path:"/w/a.png",image:{handle:"stale"}})
check(len(keys($state.pending.images))==0,"stale completion discarded")
$state=$e.apply($state,2)
check($state.active==4 and $state.error==nil,"replacement clears last refusal")
$config={schema:1,default:{slideshow:{images:["/w/a.png","/w/b.png","/w/c.png"],interval_s:5}},outputs:{"DP-1":{slideshow:{images:["/w/d.png","/w/e.png"],interval_s:600}}}}
$state=$e.stage($state,$config,{op:"startup",token:nil})
$state.pending.jobs=[]
$state=$e.received($state,5,{kind:"resolve",key:"",path:"/w/a.png",image:{handle:"a"},schedule:$s.schedule(["/w/a.png","/w/b.png","/w/c.png"],5,false,0)})
$state=$e.received($state,5,{kind:"resolve",key:"DP-1",path:"/w/d.png",image:{handle:"d"},schedule:$s.schedule(["/w/d.png","/w/e.png"],600,false,0)})
$state=$e.apply($state,3)
check($state.schedules[""].due==8 and $state.schedules["DP-1"].due==603,"independent schedules start at completion")
$state=$e.advance($state,[""],{op:"timer",token:nil},8)
check($state.pending.images["/w/d.png"].handle=="d" and len($state.pending.jobs)==1,"advance reuses unrelated resident sources")
$state=$e.refuse($state,"bad b","/w/b.png",9)
check($s.current($state.schedules[""])=="/w/a.png" and $state.schedules[""].due==14 and $state.schedules["DP-1"].due==603,"failed advance skips proposal and defers only its output")
$state=$e.advance($state,[""],{op:"next",token:"5"},14)
check($state.pending.jobs[0].path=="/w/c.png","next tries entry following failed decode")
$state.pending.jobs=[]
$state=$e.received($state,7,{kind:"load",path:"/w/c.png",image:{handle:"c"}})
$state=$e.apply($state,15)
check($state.fade==15 and $state.previous.images["/w/a.png"].handle=="a","advance retains outgoing pixels for crossfade")
$native=$e.state($state,"backdrop",nil,[])
check($native.slideshows[0].fading and $native.slideshows[0].current_path=="/w/c.png" and $native.slideshows[1].fading==false,"state projects per-output fades")
check($p.model($state,15.1).values.root.handle=="c","renderer receives decoded handle")
print("backdrop engine: staging/refusal/supersession, decode-before-commit, independent advances, failed traversal and crossfade ownership pass")
