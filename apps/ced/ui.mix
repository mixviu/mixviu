-- Ced composes reusable controls; command and dialog policy stays here.
fn ui_form($open,$title,$body,$field=nil,$instance=0)
  return {open:$open,title:$title,body:$body,field:$field,instance:$instance,choices:[{id:"ok",label:"OK",enabled:true,default:true},{id:"cancel",label:"Cancel",enabled:true,cancel:true}]}
end
fn ced_menus($s)
  $menus=[];$rows=action_rows($s)
  for $menu in ["File","Edit","Search","View","Tabs","Help"]
    $children=[]
    for $a in filter($rows,fn($a)=$a.menu==$menu)
      $row={id:$a.id,label:$a.label,enabled:$a.enabled,shortcut:join($a.keys," / ")}
      if starts_with($a.id,"view.markdown.") then $row.checked=len($s.tabs)>0 and ($s.previews[current($s).document] ?? "source")==split($a.id,".")[2]
      elif contains(["view.whitespace","view.line_numbers","view.remote_carets","view.problems","view.output"],$a.id) then $row.checked=$s[split($a.id,".")[1]] end
      push($children,$row)
    end
    push($menus,{id:"menu-"..lower($menu),label:$menu,enabled:true,children:$children})
  end
  return $menus
end
fn ced_toolbar($s)
  return [{id:"help.macros",macro_anchor:true,label:"Macros",icon:"scroll-text",icon_only:true,enabled:true},{id:"view.search",label:"Find",icon:"search",icon_only:true,enabled:true},{id:"help.keys",label:"Keyboard Shortcuts",icon:"keyboard",icon_only:true,enabled:true},{id:"view.mode",label:"Toggle light/dark mode",icon:if $s.look.appearance.mode=="dark" then "sun" else "moon" end,icon_only:true,enabled:true}]
end
fn ced_status($s,$t)
  $right=[]
  if len($s.tabs)>0 then
    $right=[if $t.overwrite then "OVR" else "INS" end,$t.language,"UTF-8"..if $t.bom then " BOM" else "" end.." · "..if $t.eol=="crlf" then "CRLF" else "LF" end,"rev "..to_string($t.rev),if $t.dirty then "Modified" elif $t.path!=nil then "Saved" else "Unsaved" end]
    if $t.phase!="live" then push($right,"Reconnecting…") end
    if $t.pending>0 then push($right,to_string($t.pending).." pending") end
    push($right,"Ln "..to_string($t.selection.head.line)..", Col "..to_string($t.selection.head.col))
  end
  return {left:if starts_with($s.status,"Failed:") then $s.status else "" end,right:$right,icon:if $s.edit.epoch!=nil then "plug" else "unplug" end,error:$s.edit.epoch==nil}
end
fn ced_ui_model($s,$model)
  $has=len($s.tabs)>0;$t=if $has then current($s) else {path:nil} end
  $items=[]
  for $i=0 to len($s.tabs)-1
    $tab=$s.tabs[$i]
    push($items,{id:to_string($i),name:basename($tab.path ?? "untitled-"..$tab.document),title:$tab.path ?? "untitled-"..$tab.document,meta:$tab.language,dirty:$tab.dirty,opening:$tab.phase=="bootstrapping"})
  end
  $model.tabs={id:"tabs",kind:"document-tabs",label:"Documents",initial:{items:$items,selected:to_string($s.active)}}
  $model.local_mode=$s.local_mode
  $model.settings_reload=$s.settings_reload ?? 0
  $model.find_open=$s.find.open;$model.values["find-bar"]=merge($s.find,{instance:$s.find_instance ?? 0})
  $model.values["close-dialog"]={open:$s.close_dialog!=nil,title:"Save changes?",body:"Save this document before closing?",choices:[{id:"save",label:"Save",enabled:true,default:true},{id:"discard",label:"Discard",enabled:true},{id:"cancel",label:"Cancel",enabled:true,cancel:true}]}
  $model.values["save-dialog"]=ui_form($s.save_dialog,"Save As","File path",$s.save_path ?? ($t.path ?? ""),$s.dialog_instance ?? 0)
  $model.values["goto-dialog"]=ui_form($s.goto_dialog,"Go to Line","Line[:column]",$s.goto_text ?? "",$s.dialog_instance ?? 0)
  $body=if $s.help=="keys" then join(map(action_rows($s),fn($a)=$a.label.."    "..join($a.keys," / ")),"\n") elif $s.help=="about" then "MixOS Editor\nAn editor over the edit Bus service.\nMixOS 0.1.2" else "" end
  $model.values["help-dialog"]=ui_form(contains(["keys","about"],$s.help),if $s.help=="keys" then "Keyboard Shortcuts" else "About MixOS Editor" end,$body)
  $model.values["macros-dialog"]={app:"ced",open:$s.macros_open ?? false}
  $model.values["notice-actions"]=[];$model.notice=""
  if $has then
    if $t.detached_copy then $model.notice="The document changed while disconnected. Choose which text to keep.";$model.values["notice-actions"]=[{id:"keep-mine",label:"Keep mine",enabled:true},{id:"take-theirs",label:"Take theirs",enabled:true}]
    elif $t.conflicts>0 then $model.notice="Edits set aside after concurrent changes; "..to_string($t.conflicts).." conflict(s)."
    elif $s.notices[$t.document]!=nil then $model.notice=$s.notices[$t.document] end
  end
  $model.show_notice=$model.notice!=""
  $model.show_problems=$s.problems;$model.show_output=$s.output
  $model.problems_text=if $has and $s.problems then join(map(viu_document("problems",$t.document,{}),fn($p)=to_string($p.line)..":"..to_string($p.col ?? 1).."  "..$p.severity.."  "..$p.code.."  "..$p.message),"\n") else "" end
  if $model.problems_text=="" then $model.problems_text="No problems" end
  $model.values["problems-list"]=if $has then viu_document("problems",$t.document,{}) else [] end
  $model.output_text="No output yet."
  $model.mail_fields={enabled:true,fields:[],attachments:[],attachment_label:"Attachments",attach_label:"Attach…",remove_label:"Remove",chooser:{open:false,title:"Attach…",directory:"/"}};$model.show_mail=$has and $s.mail[$t.document]!=nil
  if $model.show_mail then
    $m=$s.mail[$t.document]
    $fields=[]
    for $key in ["from","to","cc","bcc","reply_to","subject"]
      $actions=[]
      if $key=="to" then
        for $row in [{id:"cc",label:"Show Cc",icon:"copy"},{id:"bcc",label:"Show Bcc",icon:"eye-off"},{id:"reply_to",label:"Show Reply-To",icon:"reply"}]
          $row.selected=($m.shown[$row.id] ?? false) or $m.headers[$row.id]!="";push($actions,$row)
        end
      end
      push($fields,{id:$key,label:({from:"From",to:"To",cc:"Cc",bcc:"Bcc",reply_to:"Reply-To",subject:"Subject"})[$key],value:$m.headers[$key],visible:contains(["from","to","subject"],$key) or ($m.shown[$key] ?? false) or $m.headers[$key]!="",focus:$m.focus==$key,actions:$actions,read_only:false})
    end
    if $m.headers.in_reply_to!=nil then push($fields,{id:"in_reply_to",label:"In-Reply-To",value:$m.headers.in_reply_to,visible:true,read_only:true,actions:[]}) end
    if len($m.headers.references)>0 then push($fields,{id:"references",label:"References",value:join($m.headers.references," "),visible:true,read_only:true,actions:[]}) end
    $model.mail_fields={identity:$t.document,enabled:not $m.saving and not $m.sending,fields:$fields,attachments:$m.headers.attachments,attachment_label:"Attachments",attach_label:"Attach…",remove_label:"Remove",focus_instance:$m.focus_instance ?? 0,notice:$m.notice,chooser:{open:$m.chooser ?? false,title:"Attach…",directory:if $m.path!=nil then dirname($m.path) else "/" end,instance:$m.chooser_instance ?? 0}}
  end
  $model.values["mail-fields"]=$model.mail_fields
  $model.top_height=if $has then 32 else 0 end
  if $model.find_open then $model.top_height=$model.top_height+if $s.find.replace then 84 else 42 end end
  if $model.show_notice then $model.top_height=$model.top_height+64 end
  if $model.show_mail then $model.top_height=$model.top_height+180 end
  $model.placements={"top-controls":{edge:"top",size:"content"},"problems-panel":{edge:"bottom",size:140,resizable:true,max_fraction:0.3},"output-panel":{edge:"bottom",size:120,resizable:true,max_fraction:0.3},body:{edge:"fill"}}
  return $model
end
fn ced_ui_intent($s,$a)
  if $a.id=="problems-list" then $s=do_action($s,"search.goto_line",{line:$a.value.line,col:$a.value.col ?? 1}).state
  elif $a.id=="close-dialog" then
    $i=tab_index($s,{tab:to_number($s.close_dialog)});$s.close_dialog=nil
    if $i>=0 and $a.value.choice!="cancel" then
      $s.active=$i
      $s=do_action($s,"file.close",if $a.value.choice=="save" then {save:true} else {force:true} end).state
    end
  elif $a.id=="find-bar" then
    if $a.action=="edit" then $s.find=$a.value
    elif $a.action=="close" then $s.find.open=false
    else $id=if $a.action=="next" then "search.find_next" elif $a.action=="prev" then "search.find_prev" elif $a.action=="replace-all" then "search.replace_all" else "search.replace" end;$s=do_action($s,$id,$s.find).state end
  elif $a.id=="save-dialog" or $a.id=="goto-dialog" then
    $save=$a.id=="save-dialog";$key=if $save then "save_path" else "goto_text" end
    $s[$key]=if $a.action=="edit" then $a.value else $a.value.field end
    if $a.action=="answer" then
      if $a.value.choice=="ok" then
        $args=if $save then {path:$s[$key]} else {line:to_number(split($s[$key],":")[0]),col:to_number(split($s[$key],":")[1] ?? "1")} end
        $s=do_action($s,if $save then "file.save_as" else "search.goto_line" end,$args).state
      end
      $s[if $save then "save_dialog" else "goto_dialog" end]=false
    end
  elif $a.id=="help-dialog" then $s.help=nil
  elif $a.id=="macros-dialog" then
    $s.macros_open=false
  elif $a.id=="mail-fields" then
    $t=current($s);$key=$t.document
    if $a.action=="edit" then $s=mail_preview($s,$key,$a.value)
    elif $a.action=="commit" then $s=mail_commit($s,$key)
    elif $a.action=="command" then
      $s=mail_commit($s,$key)
      if $a.value=="attach" then $s.mail[$key].chooser=true;$s.mail[$key].chooser_instance=($s.mail[$key].chooser_instance ?? 0)+1
      else $s.mail[$key].shown=merge($s.mail[$key].shown ?? {},{($a.value):true}) end
    elif $a.action=="cancel" then $s.mail[$key].chooser=false
    elif $a.action=="picked" or $a.action=="remove" then
      $s=mail_commit($s,$key);$h=$s.mail[$key].headers
      if $a.action=="picked" then $h.attachments=concat($h.attachments,$a.value);$s.mail[$key].chooser=false
      else $h.attachments=concat(slice($h.attachments,0,$a.value),slice($h.attachments,$a.value+1)) end
      $s=mail_headers($s,$key,$h)
    end
  elif $a.id=="notice-actions" then $s=operation($s,$a.value.command,{})
  end
  return pump($s)
end
