  contracts: {
  "shell.scene.load": {
    "params": {
      "source?": "string (otherwise raw body is the scene document)",
      "model_generation?": "integer 0..9007199254740990",
      "preempt_dialog?": "bool",
      "output?": "string"
    },
    "reply": "{scene:string,revision:number,digest:string}",
    "source": "engines/viu/src/store.rs:483"
  },
  "shell.scene.validate": {
    "params": {
      "body": "raw scene document"
    },
    "reply": "{scene:string,valid:true,diagnostics:Diagnostic[]}",
    "source": "engines/viu/src/store.rs:483"
  },
  "shell.scene.patch": {
    "params": {
      "scene": "string",
      "path": "string (model[.key...] or node.port)",
      "value": "JSON",
      "generation?": "integer",
      "output?": "string"
    },
    "reply": "{scene:string,revision:number,digest:string}",
    "source": "engines/viu/src/store.rs:483"
  },
  "shell.scene.frame": {
    "params": {
      "scene": "string"
    },
    "reply": "{armed:true}",
    "source": "engines/viu/src/runtime.rs:993"
  },
  "shell.scene.get": {
    "params": {
      "scene": "string",
      "format?": "string (source selects authored source)",
      "path?": "string (node.port)",
      "output?": "string"
    },
    "reply": "ResolvedScene | JSON port value | {scene:string,revision:number,source:string}",
    "source": "engines/viu/src/store.rs:483"
  },
  "shell.scene.describe": {
    "params": {
      "family?": "string",
      "output?": "string"
    },
    "reply": "PortDescribe[] | map<family,PortDescribe[]>",
    "source": "engines/viu/src/store.rs:483"
  },
  "shell.scene.unload": {
    "params": {
      "scene": "string",
      "output?": "string"
